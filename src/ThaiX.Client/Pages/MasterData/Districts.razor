@page "/master-data/districts"
@attribute [Authorize(Policy = PermissionNames.MasterDataRead)]
@using ThaiX.Client.Components.MasterData
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IMasterDataService MasterDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<PageTitle>@L[RK.MasterData.Districts] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">@L[RK.MasterData.Districts]</RadzenText>
                    @if (_canWrite)
                    {
                        <ResponsiveIconButton Text="@L[RK.MasterData.Create]" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialogAsync" />
                    }
                </RadzenStack>

                <RadzenRow Gap="0.75rem" RowGap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.MasterData.SearchLabel]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_searchTerm"
                                           Placeholder="@L[RK.MasterData.SearchPlaceholder]"
                                           Change="@(_ => ApplySearchAsync())" />
                            <InputGroupSearchButton Click="@ApplySearchAsync" />
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="@L[RK.MasterData.City]" />
                        <AsyncSearchSelect TItem="CityListItemDto"
                                           Value="@_filterCityCode"
                                           ValueChanged="OnFilterCityChanged"
                                           LoadDataAsync="LoadCitiesForSelectAsync"
                                           GetText="x => x.Name"
                                           GetValue="x => x.Code"
                                           Placeholder="@L[RK.MasterData.SelectPlaceholder]"
                                           SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]"
                                           LoadingText="@L[RK.Common.Loading]"
                                           EmptyText="@L[RK.MasterData.SelectEmpty]"
                                           MoreHint="@L[RK.MasterData.SelectScrollMore]"
                                           AllowClear="true"
                                           Class="w-100" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.Body1 : TextStyle.H6)" class="mb-0">@L[RK.MasterData.ListTitle]</RadzenText>
                    <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>

                @if (!Viewport.IsMobile)
                {
                    <RadzenDataGrid @ref="_grid"
                                    TItem="DistrictListItemDto"
                                    Data="@_items"
                                    Count="@_totalCount"
                                    LoadData="@LoadDataAsync"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    FilterMode="FilterMode.Advanced"
                                    PageSize="@DefaultPageSize"
                                    PageSizeOptions="@PageSizeOptions"
                                    ShowPagingSummary="true"
                                    Density="Density.Compact"
                                    RowSelect="@OpenEditDialogAsync"
                                    IsLoading="@_isLoading">
                        <Columns>
                            <RadzenDataGridColumn TItem="DistrictListItemDto" Property="Code" Title="@L[RK.MasterData.Code]" />
                            <RadzenDataGridColumn TItem="DistrictListItemDto" Property="Name" Title="@L[RK.MasterData.Name]" />
                            <RadzenDataGridColumn TItem="DistrictListItemDto" Property="CityName" Title="@L[RK.MasterData.City]" />
                        </Columns>
                    </RadzenDataGrid>
                }

                @if (Viewport.IsMobile)
                {
                    <RadzenStack Gap="0.75rem">
                        @if (_isLoading)
                        {
                            <RadzenText>@L[RK.Common.Loading]</RadzenText>
                        }
                        else if (_items.Count == 0)
                        {
                            <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
                        }
                        else
                        {
                            <div class="ThaiX-simple-list" role="list">
                                @foreach (var district in _items)
                                {
                                    <button type="button"
                                            class="ThaiX-simple-list__row"
                                            role="listitem"
                                            @onclick="@(() => OpenEditDialogAsync(district))">
                                        <span class="ThaiX-simple-list__code">@district.Code</span>
                                        <span class="ThaiX-simple-list__body">
                                            <span class="ThaiX-simple-list__name">@district.Name</span>
                                            <span class="ThaiX-simple-list__meta">@district.CityName</span>
                                        </span>
                                        <RadzenIcon Icon="chevron_right" class="ThaiX-simple-list__chevron" />
                                    </button>
                                }
                            </div>
                        }

                        <AdminListPager TotalCount="@_totalCount"
                                        PageSize="@_pageSize"
                                        CurrentPage="@_currentPage"
                                        CurrentPageChanged="@GoToPageAsync"
                                        Disabled="@_isLoading" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>

        @if (_canWrite)
        {
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenLabel Text="@L[RK.MasterData.ImportCsv]" />
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <InputFile OnChange="OnFileSelected" accept=".csv" class="form-control flex-grow-1" />
                        <ResponsiveIconButton Text="@L[RK.MasterData.ImportButton]"
                                      Icon="upload"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@ImportFileAsync"
                                      IsBusy="@_isImporting"
                                      Disabled="@(_selectedFile is null || _isImporting)" />
                    </div>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
</div>

@code {
    private const int DefaultPageSize = 10;

    private static readonly IEnumerable<int> PageSizeOptions = new[] { 10, 25, 50, 100 };

    private RadzenDataGrid<DistrictListItemDto>? _grid;
    private IReadOnlyList<DistrictListItemDto> _items = [];
    private int _totalCount;
    private bool _isLoading;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private string? _searchTerm;
    private string? _filterCityCode;
    private bool _canWrite;
    private bool _canDelete;
    private bool _isImporting;
    private IBrowserFile? _selectedFile;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.MasterDataWrite);
        _canDelete = user.HasClaim("scope", PermissionNames.MasterDataDelete);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Viewport.IsMobile)
        {
            await LoadDataAsync(new LoadDataArgs { Skip = 0, Top = _pageSize });
        }
        else if (_grid is not null)
        {
            await _grid.Reload();
        }
        else
        {
            await LoadDataAsync(new LoadDataArgs { Skip = 0, Top = _pageSize });
        }
    }

    private async Task<(IReadOnlyList<CityListItemDto> items, int totalCount)> LoadCitiesForSelectAsync(int pageNumber, int pageSize, string? search, CancellationToken cancellationToken)
    {
        try
        {
            var result = await MasterDataService.GetCitiesAsync(new MasterDataListWithParentRequest
            {
                PageNumber = pageNumber,
                PageSize = pageSize,
                SortBy = "name",
                SearchTerm = string.IsNullOrWhiteSpace(search) ? null : search.Trim()
            }, cancellationToken);
            return (result.Data ?? [], result.Metadata.TotalCount);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.MasterData.LoadFailed], ex.GetDisplayDetail());
            return ([], 0);
        }
    }

    private async Task OnFilterCityChanged(string? value)
    {
        _filterCityCode = value;
        await ApplySearchAsync();
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _isLoading = true;

        try
        {
            _pageSize = args.Top ?? DefaultPageSize;
            _currentPage = _pageSize <= 0 ? 1 : ((args.Skip ?? 0) / _pageSize) + 1;
            var sort = args.Sorts?.FirstOrDefault();
            var sortBy = sort?.Property?.ToLowerInvariant();
            var result = await MasterDataService.GetDistrictsAsync(new MasterDataListWithParentRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                SortBy = sortBy switch
                {
                    "name" => "name",
                    "cityname" => "cityname",
                    "citycode" => "citycode",
                    _ => "name"
                },
                SortDescending = sort?.SortOrder == SortOrder.Descending,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                ParentCode = string.IsNullOrWhiteSpace(_filterCityCode) ? null : _filterCityCode.Trim()
            });

            _items = result.Data ?? [];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.MasterData.LoadFailed], ex.GetDisplayDetail());
            _items = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
            if (Viewport.IsMobile)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ApplySearchAsync()
    {
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadDataAsync(new LoadDataArgs
        {
            Skip = (_currentPage - 1) * _pageSize,
            Top = _pageSize
        });
    }

    private async Task GoToPageAsync(int page)
    {
        _currentPage = page;
        await ReloadAsync();
    }

    private async Task OpenCreateDialogAsync()
    {
        var shouldReload = await DialogService.OpenAsync<DistrictDialog>(L[RK.MasterData.CreateTitle], new Dictionary<string, object?>
        {
            [nameof(DistrictDialog.CanDelete)] = false
        }, MasterDataDialogOptions.Build());

        if (shouldReload is true)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(DistrictListItemDto item)
    {
        var shouldReload = await DialogService.OpenAsync<DistrictDialog>(L[RK.MasterData.EditTitle], new Dictionary<string, object?>
        {
            [nameof(DistrictDialog.DistrictId)] = item.Id,
            [nameof(DistrictDialog.CityCode)] = item.CityCode,
            [nameof(DistrictDialog.Code)] = item.Code,
            [nameof(DistrictDialog.Name)] = item.Name,
            [nameof(DistrictDialog.CanDelete)] = _canDelete
        }, MasterDataDialogOptions.Build());

        if (shouldReload is true)
        {
            await ReloadAsync();
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
    }

    private async Task ImportFileAsync()
    {
        if (_selectedFile is null || _isImporting || !_canWrite)
        {
            return;
        }

        _isImporting = true;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024);
            var result = await MasterDataService.ImportDistrictsAsync(stream, _selectedFile.Name);
            var message = string.Format(L[RK.MasterData.ImportResult], result.InsertedCount, result.UpdatedCount, result.SkippedCount);
            NotificationService.NotifySuccess(L[RK.MasterData.ImportSuccess], message);
            _selectedFile = null;
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.MasterData.ImportFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isImporting = false;
        }
    }

}
