@page "/market-data/bank-deposit-rates"
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Localization
@using ThaiX.Client.Models.Api
@using ThaiX.Client.Models.ExternalData
@using ThaiX.Client.Services.ExternalData
@using Microsoft.Extensions.Localization
@inject IExternalDataService ExternalDataService
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<style>
    .responsive-grid .rz-cell-data {
        white-space: normal !important;
        word-wrap: break-word;
    }
</style>

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="mb-1">
        @L[RK.BankDepositRates.Title]
    </RadzenText>

    <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-3">
        @L[RK.BankDepositRates.Subtitle]
    </RadzenText>

    @if (_loadErrorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" Class="mb-3">
            @_loadErrorMessage
        </RadzenAlert>
    }

    @if (_updatedAtText is not null)
    {
        <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-3">
            @string.Format(L[RK.BankDepositRates.UpdatedAt], _updatedAtText)
        </RadzenText>
    }

    @if (Viewport.IsMobile)
    {
        @if (_isLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
        }
        else
        {
            <RadzenStack Gap="1rem">
                <DebouncedSearchBox Value="@_searchTerm"
                                    ValueChanged="OnSearchChanged"
                                    Placeholder="@L[RK.BankDepositRates.SearchPlaceholder]"
                                    Name="BankDepositRatesSearch"
                                    CssClass="w-100"
                                    DebounceMilliseconds="300" />

                @RenderMobileChannel(RK.BankDepositRates.OnlineChannel, Filter(_onlineRates))
                @RenderMobileChannel(RK.BankDepositRates.OfflineChannel, Filter(_offlineRates))
            </RadzenStack>
        }
    }
    else
    {
        <RadzenStack Gap="1.5rem">
            @RenderDesktopChannel(RK.BankDepositRates.OnlineChannel, _onlineRates)
            @RenderDesktopChannel(RK.BankDepositRates.OfflineChannel, _offlineRates)
        </RadzenStack>
    }
</RadzenCard>

@code {
    private List<BankDepositRateItemDto> _onlineRates = [];
    private List<BankDepositRateItemDto> _offlineRates = [];
    private bool _isLoading;
    private string? _loadErrorMessage;
    private string? _updatedAtText;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _loadErrorMessage = null;

        try
        {
            var onlineTask = ExternalDataService.GetBankDepositRatesAsync(BankDepositRateTypes.Online);
            var offlineTask = ExternalDataService.GetBankDepositRatesAsync(BankDepositRateTypes.Offline);

            await Task.WhenAll(onlineTask, offlineTask);

            var onlineResponse = await onlineTask;
            var offlineResponse = await offlineTask;

            _onlineRates = ExtractRates(onlineResponse);
            _offlineRates = ExtractRates(offlineResponse);

            if (onlineResponse is not { Success: true } || offlineResponse is not { Success: true })
            {
                _loadErrorMessage = L[RK.BankDepositRates.LoadFailed];
            }

            var lastUpdate = _onlineRates.Concat(_offlineRates)
                .Where(x => x.UpdatedAt.HasValue)
                .Select(x => x.UpdatedAt!.Value)
                .DefaultIfEmpty()
                .Max();

            if (lastUpdate != default)
            {
                _updatedAtText = lastUpdate.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
            }
        }
        catch
        {
            _loadErrorMessage = L[RK.BankDepositRates.LoadFailed];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<BankDepositRateItemDto> ExtractRates(ApiResponse<BankDepositRatesResponseDto> response)
    {
        return response is { Success: true, Data: not null }
            ? response.Data.Data
            : [];
    }

    private IEnumerable<BankDepositRateItemDto> Filter(List<BankDepositRateItemDto> rates)
    {
        return string.IsNullOrWhiteSpace(_searchTerm)
            ? rates
            : rates.Where(x => x.BankName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private static string FormatRate(decimal? rate) => rate.HasValue ? $"{rate.Value:0.##}%" : "-";

    private Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        return Task.CompletedTask;
    }

    private RenderFragment RenderMobileChannel(string titleKey, IEnumerable<BankDepositRateItemDto> rates) => @<RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H5" Class="mb-0">@L[titleKey]</RadzenText>

        @if (!rates.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                @L[RK.Common.NoDataFound]
            </RadzenAlert>
        }
        else
        {
            @foreach (var item in rates)
            {
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="mb-2">
                        @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                        {
                            <img src="@item.LogoUrl" alt="@item.BankName" style="height:24px;width:24px;object-fit:contain;" />
                        }
                        <RadzenText TextStyle="TextStyle.Subtitle1"><strong>@item.BankName</strong></RadzenText>
                    </RadzenStack>

                    <RadzenRow>
                        <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.Caption" Class="mb-0 text-muted">@L[RK.BankInterestRates.Month1]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>@FormatRate(item.Month1)</strong></RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.Caption" Class="mb-0 text-muted">@L[RK.BankInterestRates.Month3]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>@FormatRate(item.Month3)</strong></RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenText TextStyle="TextStyle.Caption" Class="mb-0 text-muted">@L[RK.BankInterestRates.Month6]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>@FormatRate(item.Month6)</strong></RadzenText>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Class="mt-2">
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Class="mb-0 text-muted">@L[RK.BankInterestRates.Month9]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>@FormatRate(item.Month9)</strong></RadzenText>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Caption" Class="mb-0 text-muted">@L[RK.BankInterestRates.Month12]</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>@FormatRate(item.Month12)</strong></RadzenText>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (!string.IsNullOrWhiteSpace(item.Note))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Class="mt-2 mb-0 text-muted">@item.Note</RadzenText>
                    }
                </RadzenCard>
            }
        }
    </RadzenStack>;

    private RenderFragment RenderDesktopChannel(string titleKey, IEnumerable<BankDepositRateItemDto> rates) => @<RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H5" Class="mb-0">@L[titleKey]</RadzenText>

        <div class="w-100 overflow-auto">
            <RadzenDataGrid Class="@(Viewport.IsTablet ? "responsive-grid" : string.Empty)"
                            IsLoading="@_isLoading"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Advanced"
                            AllowPaging="true"
                            PageSize="10"
                            AllowSorting="true"
                            Data="@rates"
                            TItem="BankDepositRateItemDto"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@L[RK.Grid.PagingSummaryFormat]"
                            PageSizeOptions="@(new[] { 10, 25, 50, 100 })">
                <EmptyTemplate>
                    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                        @L[RK.Common.NoDataFound]
                    </RadzenAlert>
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto"
                                          Property="BankName"
                                          Title="@L[RK.BankDepositRates.Bank]"
                                          Frozen="true"
                                          Width="200px">
                        <Template Context="item">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                @if (!string.IsNullOrWhiteSpace(item.LogoUrl))
                                {
                                    <img src="@item.LogoUrl" alt="@item.BankName" style="height:22px;width:22px;object-fit:contain;" />
                                }
                                <span>@item.BankName</span>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto" Property="Month1" Title="@L[RK.BankInterestRates.Month1]" Width="110px">
                        <Template Context="item">
                            @FormatRate(item.Month1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto" Property="Month3" Title="@L[RK.BankInterestRates.Month3]" Width="110px">
                        <Template Context="item">
                            @FormatRate(item.Month3)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto" Property="Month6" Title="@L[RK.BankInterestRates.Month6]" Width="110px">
                        <Template Context="item">
                            @FormatRate(item.Month6)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto" Property="Month9" Title="@L[RK.BankInterestRates.Month9]" Width="110px">
                        <Template Context="item">
                            @FormatRate(item.Month9)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto" Property="Month12" Title="@L[RK.BankInterestRates.Month12]" Width="110px">
                        <Template Context="item">
                            @FormatRate(item.Month12)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BankDepositRateItemDto"
                                          Property="Note"
                                          Title="@L[RK.BankDepositRates.Note]"
                                          Visible="@(!Viewport.IsTablet)">
                        <Template Context="item">
                            @(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </RadzenStack>;
}
