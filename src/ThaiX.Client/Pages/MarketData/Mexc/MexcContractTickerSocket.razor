@page "/market-data/mexc/contract-ticker-socket"
@using ThaiX.Client.Components
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Localization
@using ThaiX.Client.Models.ExternalData
@using ThaiX.Client.Services.MarketData
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using ThaiX.Client.Models.JsonBins
@using ThaiX.Client.Services.JsonBins
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJsonBinService JsonBinService
@inject ThaiX.Client.Services.Http.Demo.ApiConnectivityState ConnectivityState
@inject ILogger<MexcContractTickerSocket> Logger
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@inject NotificationService NotificationService
@inject IMexcContractTickerSocketService ContractSocketService
@inherits ThaiXPageBase

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Gap="0.75rem"
                 Wrap="FlexWrap.Wrap"
                 Class="mb-3">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="mb-0">
            @L[RK.MexcContractTickers.SocketTitle]
        </RadzenText>
    </RadzenStack>

    <RadzenStack Gap="1rem" Class="mb-3">
        <RadzenCard Class="mb-0">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.H6" Class="mb-0">@L[RK.MexcDemoTrading.Title]</RadzenText>
                    <RadzenButton Icon="settings" Text="@L[RK.MexcDemoTrading.Settings]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => _showSettings = !_showSettings)" />
                </RadzenStack>
                <RadzenRow Gap="0.75rem">
                    <RadzenColumn Size="6" SizeMD="3"><RadzenLabel Text="@L[RK.MexcDemoTrading.InitialCapital]" /><RadzenNumeric TValue="decimal" Value="@_portfolio.InitialCapital" Disabled="true" Format="N2" Class="w-100" /></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenLabel Text="@L[RK.MexcDemoTrading.FeePercent]" /><RadzenNumeric TValue="decimal" Value="@_portfolio.FeePercent" Disabled="true" Format="0.####" Class="w-100" /></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenLabel Text="@L[RK.MexcDemoTrading.CapitalPerTradePercent]" /><RadzenNumeric TValue="decimal" Value="@_portfolio.CapitalPerTradePercent" Disabled="true" Format="0.##" Class="w-100" /></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenLabel Text="@L[RK.MexcDemoTrading.Leverage]" /><RadzenDropDown TValue="int" Data="@LeverageOptions" Value="@_portfolio.Leverage" ValueChanged="@OnLeverageChangedAsync" TextProperty="Text" ValueProperty="Value" Class="w-100" /></RadzenColumn>
                </RadzenRow>
                @if (_showSettings)
                {
                    <RadzenDivider />
                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.MexcDemoTrading.Settings]</RadzenText>
                    <RadzenRow Gap="0.75rem">
                        <RadzenColumn Size="12" SizeMD="4"><RadzenLabel Text="@L[RK.MexcDemoTrading.InitialCapital]" /><RadzenNumeric TValue="decimal" @bind-Value="_draftInitialCapital" Min="1m" Step="100m" Format="N2" Class="w-100" /></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4"><RadzenLabel Text="@L[RK.MexcDemoTrading.FeePercent]" /><RadzenNumeric TValue="decimal" @bind-Value="_draftFeePercent" Min="0m" Max="5m" Step="0.01m" Format="0.####" Class="w-100" /></RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4"><RadzenLabel Text="@L[RK.MexcDemoTrading.CapitalPerTradePercent]" /><RadzenNumeric TValue="decimal" @bind-Value="_draftCapitalPerTradePercent" Min="1m" Max="100m" Step="1m" Format="0.##" Class="w-100" /></RadzenColumn>
                    </RadzenRow>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="@L[RK.Common.Cancel]" ButtonStyle="ButtonStyle.Light" Click="@CancelSettings" />
                        <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@SaveSettingsAsync" />
                    </RadzenStack>
                }
                <RadzenRow Gap="0.75rem">
                    <RadzenColumn Size="6" SizeMD="3"><RadzenCard Class="p-2"><RadzenText TextStyle="TextStyle.Caption">@L[RK.MexcDemoTrading.CurrentCapital]</RadzenText><RadzenText TextStyle="TextStyle.H6" Class="mb-0">@CurrentEquity.ToString("N2") USDT</RadzenText></RadzenCard></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenCard Class="p-2"><RadzenText TextStyle="TextStyle.Caption">@L[RK.MexcDemoTrading.AvailableCapital]</RadzenText><RadzenText TextStyle="TextStyle.H6" Class="mb-0">@AvailableCapital.ToString("N2") USDT</RadzenText></RadzenCard></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenCard Class="p-2"><RadzenText TextStyle="TextStyle.Caption">@L[RK.MexcDemoTrading.UnrealizedPnl]</RadzenText><RadzenText TextStyle="TextStyle.H6" Class="mb-0" Style="@PnlStyle(UnrealizedPnl)">@UnrealizedPnl.ToString("+0.00;-0.00;0.00") USDT</RadzenText></RadzenCard></RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="3"><RadzenCard Class="p-2"><RadzenText TextStyle="TextStyle.Caption">@L[RK.MexcDemoTrading.RealizedPnl]</RadzenText><RadzenText TextStyle="TextStyle.H6" Class="mb-0" Style="@PnlStyle(_portfolio.RealizedPnl)">@_portfolio.RealizedPnl.ToString("+0.00;-0.00;0.00") USDT</RadzenText></RadzenColumn>
                </RadzenRow>
                <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@L[RK.MexcDemoTrading.DemoDisclaimer]</RadzenText>
            </RadzenStack>
        </RadzenCard>

        @if (_isLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
        }
        else if (!_allTickers.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                @L[RK.MexcContractTickers.NoDataFound]
            </RadzenAlert>
        }
    </RadzenStack>

    @if (!Viewport.IsMobile && !_isLoading && _allTickers.Any())
    {
        <div class="w-100 overflow-auto">
            <RadzenDataGrid @ref="_dataGrid"
                            TItem="MexcContractTickerDto"
                            Data="@DisplayTickers"
                            Count="@_allTickers.Count"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Advanced"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="10"
                            PageSizeOptions="@(new[] { 10, 20, 50, 100 })"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@L[RK.Grid.PagingSummaryFormat]"
                            Class="responsive-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="MexcContractTickerDto" Title="" Sortable="false" Filterable="false" Width="8.5rem">
                        <Template Context="ticker">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.1rem" AlignItems="AlignItems.Center">
                                <RadzenButton Icon="push_pin" ButtonStyle="@(IsPinned(ticker.Symbol) ? ButtonStyle.Primary : ButtonStyle.Light)" Variant="Variant.Text" Size="ButtonSize.Small" title="@L[IsPinned(ticker.Symbol) ? RK.MexcContractTickers.Unpin : RK.MexcContractTickers.Pin]" Click="@(() => TogglePinnedAsync(ticker.Symbol))" />
                                <RadzenButton Text="Buy" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Disabled="@(!HasValidPrice(ticker.LastPrice))" Click="@(() => OpenPositionAsync(ticker, DemoPositionSide.Long))" />
                                <RadzenButton Text="Sell" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@(!HasValidPrice(ticker.LastPrice))" Click="@(() => OpenPositionAsync(ticker, DemoPositionSide.Short))" />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Symbol" Title="@L[RK.MexcContractTickers.Symbol]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="LastPrice" Title="@L[RK.MexcContractTickers.LastPrice]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="RiseFallRate" Title="@L[RK.MexcContractTickers.RiseFallRate]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Bid1" Title="@L[RK.MexcContractTickers.Bid1]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Ask1" Title="@L[RK.MexcContractTickers.Ask1]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Volume24" Title="@L[RK.MexcContractTickers.Volume24]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Amount24" Title="@L[RK.MexcContractTickers.Amount24]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="High24Price" Title="@L[RK.MexcContractTickers.High24Price]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Low24Price" Title="@L[RK.MexcContractTickers.Low24Price]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="IndexPrice" Title="@L[RK.MexcContractTickers.IndexPrice]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="FairPrice" Title="@L[RK.MexcContractTickers.FairPrice]" />
                    <RadzenDataGridColumn MinWidth="12.5rem" TItem="MexcContractTickerDto" Property="Timestamp" Title="@L[RK.MexcContractTickers.Timestamp]">
                        <Template Context="ticker">
                            @(ticker.Timestamp.HasValue && ticker.Timestamp.Value > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(ticker.Timestamp.Value).LocalDateTime.ToString("g") : "-")
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }

    <RadzenCard Class="mt-3">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">@L[RK.MexcDemoTrading.OpenPositions]</RadzenText>
            @if (_portfolio.Positions.Count == 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter">@L[RK.MexcDemoTrading.NoOpenPositions]</RadzenAlert>
            }
            else
            {
                <div class="w-100 overflow-auto">
                    <RadzenDataGrid TItem="DemoFuturesPosition" Data="@OpenPositionsWithPrices" AllowPaging="true" PageSize="5" Class="responsive-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Property="Symbol" Title="@L[RK.MexcContractTickers.Symbol]" />
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.Side]"><Template Context="position">@L[position.Side == DemoPositionSide.Long ? RK.MexcDemoTrading.Long : RK.MexcDemoTrading.Short]</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.EntryPrice]"><Template Context="position">@position.EntryPrice.ToString("0.########")</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.MarkPrice]"><Template Context="position">@GetMarkPrice(position).ToString("0.########")</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.Quantity]"><Template Context="position">@position.Quantity.ToString("0.########")</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.Leverage]"><Template Context="position">@position.Leverage x</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title="@L[RK.MexcDemoTrading.UnrealizedPnl]"><Template Context="position"><span style="@PnlStyle(GetPositionPnl(position))">@GetPositionPnl(position).ToString("+0.00;-0.00;0.00")</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DemoFuturesPosition" Title=""><Template Context="position"><RadzenButton Text="@L[RK.MexcDemoTrading.ClosePosition]" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => ClosePositionAsync(position.Id))" /></Template></RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </RadzenStack>
    </RadzenCard>

    @if (Viewport.IsMobile && !_isLoading && _allTickers.Any())
    {
        <RadzenStack Gap="1rem">
            <div>
                <label class="rz-label mb-1">@L[RK.MexcContractTickers.SearchPlaceholder]</label>
                <AsyncSearchSelect TItem="MexcContractTickerDto"
                                   Value="@_selectedSymbol"
                                   ValueChanged="OnSelectedSymbolChanged"
                                   LoadDataAsync="LoadSymbolsAsync"
                                   GetText="@(x => x.Symbol)"
                                   GetValue="@(x => x.Symbol)"
                                   Placeholder="@L[RK.MexcContractTickers.SearchPlaceholder]"
                                   SearchPlaceholder="@L[RK.Common.Search]"
                                   LoadingText="@L[RK.Common.Loading]"
                                   EmptyText="@L[RK.Common.NoDataFound]"
                                   MoreHint="@L[RK.MasterData.SelectScrollMore]"
                                   AllowClear="true"
                                   Class="w-100" />
            </div>

            <ClientSortBar TItem="MexcContractTickerDto"
                           Options="@SortOptions"
                           SortKey="@_sortKey"
                           SortKeyChanged="OnSortKeyChanged"
                           Ascending="@_sortAscending"
                           AscendingChanged="OnSortDirectionChanged"
                           Label="@L[RK.Common.SortBy]"
                           Placeholder="@L[RK.Common.SortBy]"
                           AscendingLabel="@L[RK.Common.Ascending]"
                           DescendingLabel="@L[RK.Common.Descending]" />

            <Virtualize Items="@_mobileViewTickers" Context="ticker" OverscanCount="5">
                <RadzenCard Class="p-3 mb-3">
                    <RadzenStack Gap="0.4rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenText TextStyle="TextStyle.Subtitle1"><strong>@ticker.Symbol</strong></RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                                <RadzenButton Icon="push_pin" ButtonStyle="@(IsPinned(ticker.Symbol) ? ButtonStyle.Primary : ButtonStyle.Light)" Variant="Variant.Text" Size="ButtonSize.Small" title="@L[IsPinned(ticker.Symbol) ? RK.MexcContractTickers.Unpin : RK.MexcContractTickers.Pin]" Click="@(() => TogglePinnedAsync(ticker.Symbol))" />
                                <RadzenButton Text="Buy" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Disabled="@(!HasValidPrice(ticker.LastPrice))" Click="@(() => OpenPositionAsync(ticker, DemoPositionSide.Long))" />
                                <RadzenButton Text="Sell" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@(!HasValidPrice(ticker.LastPrice))" Click="@(() => OpenPositionAsync(ticker, DemoPositionSide.Short))" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.LastPrice]: @(ticker.LastPrice?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.RiseFallRate]: @(ticker.RiseFallRate?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Bid1]: @(ticker.Bid1?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Ask1]: @(ticker.Ask1?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Volume24]: @(ticker.Volume24?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Amount24]: @(ticker.Amount24?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.High24Price]: @(ticker.High24Price?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Low24Price]: @(ticker.Low24Price?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.IndexPrice]: @(ticker.IndexPrice?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.FairPrice]: @(ticker.FairPrice?.ToString() ?? "-")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">@L[RK.MexcContractTickers.Timestamp]: @(ticker.Timestamp.HasValue && ticker.Timestamp.Value > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(ticker.Timestamp.Value).LocalDateTime.ToString("g") : "-")</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </Virtualize>
        </RadzenStack>
    }
</RadzenCard>

@code {
    private const string PinnedStorageKey = "thaix:mexc:contract-ticker:pinned";
    private const string PinnedJsonBinName = "MEXC Contract Pinned Tickers";
    private const string PinnedJsonBinCodeSuffix = "MEXC_CONTRACT_PINNED";
    private string _activePinnedStorageKey = PinnedStorageKey;
    private Guid? _authenticatedUserId;
    private Guid? _pinnedJsonBinId;
    private bool _canSyncPinnedSymbols;
    private bool _cloudSyncRunning;
    private bool _cloudSyncRequested;
    private readonly Dictionary<string, MexcContractTickerDto> _tickerMap = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _pinnedSymbols = [];
    private List<MexcContractTickerDto> _allTickers = [];
    private List<MexcContractTickerDto> _mobileViewTickers = [];
    private RadzenDataGrid<MexcContractTickerDto>? _dataGrid;
    private bool _isLoading = true;
    private const string DemoPortfolioStorageKey = "thaix:mexc:contract-futures-demo:v1";
    private DemoFuturesPortfolio _portfolio = new();
    private bool _portfolioLoaded;
    private bool _showSettings;
    private decimal _draftInitialCapital = 1000m;
    private decimal _draftFeePercent = 0.05m;
    private decimal _draftCapitalPerTradePercent = 10m;
    private static readonly IReadOnlyList<LeverageOption> LeverageOptions =
        Enumerable.Range(1, 20).Select(value => new LeverageOption($"{value}x", value))
            .Concat(new[] { new LeverageOption("25x", 25), new LeverageOption("50x", 50), new LeverageOption("75x", 75), new LeverageOption("100x", 100) }).ToList();
    private decimal UnrealizedPnl => _portfolio.Positions.Sum(GetPositionPnl);
    private decimal CurrentEquity => _portfolio.InitialCapital + _portfolio.RealizedPnl + UnrealizedPnl;
    private decimal UsedMargin => _portfolio.Positions.Sum(position => position.EntryPrice * position.Quantity / Math.Max(position.Leverage, 1));
    private decimal AvailableCapital => Math.Max(0m, CurrentEquity - UsedMargin);
    private IReadOnlyList<DemoFuturesPosition> OpenPositionsWithPrices => _portfolio.Positions.ToList();
    private static string PnlStyle(decimal value) => value > 0m ? "color: var(--rz-success);" : value < 0m ? "color: var(--rz-danger);" : string.Empty;
    private string? _selectedSymbol;
    private string? _sortKey;
    private bool _sortAscending = true;

    private IReadOnlyList<MexcContractTickerDto> DisplayTickers => _allTickers
        .OrderBy(ticker => GetPinnedOrder(ticker.Symbol))
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst("sub")?.Value;

        if (user.Identity?.IsAuthenticated == true
            && Guid.TryParse(userIdClaim, out var userId))
        {
            _authenticatedUserId = userId;
            _activePinnedStorageKey = $"{PinnedStorageKey}:{userId:N}";
        }
        else
        {
            _activePinnedStorageKey = $"{PinnedStorageKey}:anonymous";
        }

        await LoadPinnedSymbolsFromLocalAsync();
        await LoadDemoPortfolioAsync();

        if (_authenticatedUserId.HasValue && !ConnectivityState.IsDemoMode)
        {
            await InitializePinnedSymbolsCloudSyncAsync();
        }

        ApplyMobileView();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsPinned(string symbol) =>
        _pinnedSymbols.Contains(symbol, StringComparer.OrdinalIgnoreCase);

    private int GetPinnedOrder(string symbol)
    {
        var index = _pinnedSymbols.FindIndex(pinned => pinned.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : int.MaxValue;
    }

    private async Task TogglePinnedAsync(string symbol)
    {
        var index = _pinnedSymbols.FindIndex(pinned => pinned.Equals(symbol, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            _pinnedSymbols.RemoveAt(index);
        }
        else
        {
            _pinnedSymbols.Add(symbol);
        }

        ApplyMobileView();
        StateHasChanged();
        await Task.Yield();

        await SavePinnedSymbolsToLocalAsync();
        _ = SyncPinnedSymbolsToCloudAsync();
    }

    private async Task LoadPinnedSymbolsFromLocalAsync()
    {
        try
        {
            var savedSymbols = await JS.InvokeAsync<string?>("localStorage.getItem", _activePinnedStorageKey);
            _pinnedSymbols = DeserializePinnedSymbols(savedSymbols) ?? [];
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not read pinned tickers from local storage.");
            _pinnedSymbols = [];
        }
    }

    private async Task SavePinnedSymbolsToLocalAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", _activePinnedStorageKey,
                JsonSerializer.Serialize(new PinnedTickerConfiguration(1, _pinnedSymbols)));
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not save pinned tickers to local storage.");
            NotificationService.NotifyError(L[RK.MexcContractTickers.LoadFailed]);
        }
    }

    private async Task InitializePinnedSymbolsCloudSyncAsync()
    {
        if (!_authenticatedUserId.HasValue)
        {
            return;
        }

        var code = GetPinnedJsonBinCode(_authenticatedUserId.Value);

        try
        {
            var bin = await JsonBinService.GetByCodeAsync(code);
            if (bin is null)
            {
                var createModel = new CreateJsonBinModel
                {
                    Code = code,
                    Name = PinnedJsonBinName,
                    Category = JsonBinCategories.Config,
                    ContentType = "application/json",
                    ContentJson = JsonSerializer.Serialize(new PinnedTickerConfiguration(1, _pinnedSymbols)),
                    Tags = "user-preference,mexc,contract,pinned"
                };

                try
                {
                    await JsonBinService.CreateAsync(createModel);
                }
                catch (Exception createException)
                {
                    bin = await JsonBinService.GetByCodeAsync(code);
                    if (bin is null)
                    {
                        throw new InvalidOperationException("Could not create or load the pinned ticker JsonBin.", createException);
                    }
                }

                bin ??= await JsonBinService.GetByCodeAsync(code);
            }

            if (bin is null)
            {
                return;
            }

            _pinnedJsonBinId = bin.Id;
            var cloudSymbols = DeserializePinnedSymbols(bin.ContentJson);
            if (cloudSymbols is not null)
            {
                _pinnedSymbols = cloudSymbols;
                await SavePinnedSymbolsToLocalAsync();
            }
            else
            {
                Logger.LogWarning("Pinned ticker JsonBin {Code} has an unsupported payload; preserving local data.", code);
            }

            _canSyncPinnedSymbols = true;
        }
        catch (Exception ex)
        {
            _canSyncPinnedSymbols = false;
            Logger.LogWarning(ex, "Could not initialize pinned ticker cloud sync.");
        }
    }

    private async Task SyncPinnedSymbolsToCloudAsync()
    {
        if (!_authenticatedUserId.HasValue || ConnectivityState.IsDemoMode || !_canSyncPinnedSymbols || !_pinnedJsonBinId.HasValue)
        {
            return;
        }

        _cloudSyncRequested = true;
        if (_cloudSyncRunning)
        {
            return;
        }

        _cloudSyncRunning = true;
        try
        {
            while (_cloudSyncRequested)
            {
                _cloudSyncRequested = false;
                var payload = JsonSerializer.Serialize(new PinnedTickerConfiguration(1, _pinnedSymbols.ToList()));
                var update = new UpdateJsonBinModel
                {
                    Name = PinnedJsonBinName,
                    Category = JsonBinCategories.Config,
                    ContentType = "application/json",
                    ContentJson = payload,
                    Compress = false,
                    Tags = "user-preference,mexc,contract,pinned"
                };

                try
                {
                    await JsonBinService.UpdateAsync(_pinnedJsonBinId.Value, update);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not sync pinned tickers to JsonBin; local data was retained.");
                }
            }
        }
        finally
        {
            _cloudSyncRunning = false;
            if (_cloudSyncRequested)
            {
                _ = SyncPinnedSymbolsToCloudAsync();
            }
        }
    }

    private static string GetPinnedJsonBinCode(Guid userId) =>
        $"USERPREF_{userId:N}_{PinnedJsonBinCodeSuffix}";

    private static List<string>? DeserializePinnedSymbols(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind == JsonValueKind.Array)
            {
                return JsonSerializer.Deserialize<List<string>>(json)?
                    .Where(symbol => !string.IsNullOrWhiteSpace(symbol))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            var configuration = JsonSerializer.Deserialize<PinnedTickerConfiguration>(
                json,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));

            if (configuration?.Version != 1 || configuration.PinnedSymbols is null)
            {
                return null;
            }

            return configuration.PinnedSymbols
                .Where(symbol => !string.IsNullOrWhiteSpace(symbol))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private sealed record PinnedTickerConfiguration(int Version, List<string> PinnedSymbols);

    private IReadOnlyList<SortOption<MexcContractTickerDto>> SortOptions =>
    [
        new("symbol",       L[RK.MexcContractTickers.Symbol],       x => x.Symbol),
        new("lastPrice",    L[RK.MexcContractTickers.LastPrice],    x => x.LastPrice),
        new("riseFallRate", L[RK.MexcContractTickers.RiseFallRate], x => x.RiseFallRate),
        new("volume24",     L[RK.MexcContractTickers.Volume24],     x => x.Volume24),
        new("amount24",     L[RK.MexcContractTickers.Amount24],     x => x.Amount24),
        new("indexPrice",   L[RK.MexcContractTickers.IndexPrice],   x => x.IndexPrice),
        new("fairPrice",    L[RK.MexcContractTickers.FairPrice],    x => x.FairPrice),
        new("timestamp",    L[RK.MexcContractTickers.Timestamp],    x => x.Timestamp)
    ];

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ContractSocketService.TickersUpdated += OnTickersUpdated;
        ContractSocketService.StreamError += OnStreamError;
        _ = ContractSocketService.StartAsync();
    }

    private async void OnTickersUpdated(
    IReadOnlyCollection<MexcContractTickerDto> tickers)
    {
        if (tickers.Count == 0)
        {
            return;
        }

        var hasChanges = false;

        foreach (var ticker in tickers)
        {
            if (string.IsNullOrWhiteSpace(ticker.Symbol)
                || !ticker.Symbol.EndsWith("_USDT", StringComparison.OrdinalIgnoreCase)
                || !HasValidPrice(ticker.LastPrice))
            {
                continue;
            }

            if (_tickerMap.TryGetValue(ticker.Symbol, out var existingTicker))
            {
                if (HasContractTickerChanged(existingTicker, ticker))
                {
                    UpdateTickerInPlace(existingTicker, ticker);
                    hasChanges = true;
                }
            }
            else
            {
                _tickerMap[ticker.Symbol] = ticker;
                _allTickers.Add(ticker);
                hasChanges = true;
            }
        }

        if (!hasChanges && !_isLoading)
        {
            return;
        }

        _isLoading = false;

        ApplyMobileView();

        if (_dataGrid is null)
        {
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await _dataGrid.Reload();
            });
        }
    }

    private static bool HasContractTickerChanged(MexcContractTickerDto existing, MexcContractTickerDto incoming)
    {
        return existing.LastPrice != incoming.LastPrice
            || existing.RiseFallRate != incoming.RiseFallRate
            || existing.Bid1 != incoming.Bid1
            || existing.Ask1 != incoming.Ask1
            || existing.High24Price != incoming.High24Price
            || existing.Low24Price != incoming.Low24Price
            || existing.Volume24 != incoming.Volume24
            || existing.Amount24 != incoming.Amount24
            || existing.IndexPrice != incoming.IndexPrice
            || existing.FairPrice != incoming.FairPrice
            || existing.Timestamp != incoming.Timestamp;
    }

    private static bool HasValidPrice(decimal? price) => price.HasValue && price.Value > 0m;

    private async Task LoadDemoPortfolioAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", DemoPortfolioStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var saved = JsonSerializer.Deserialize<DemoFuturesPortfolio>(json, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                if (saved is not null && saved.InitialCapital > 0m && saved.Positions is not null)
                    _portfolio = saved;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load futures demo portfolio from local storage.");
        }

        _portfolioLoaded = true;
        _draftInitialCapital = _portfolio.InitialCapital;
        _draftFeePercent = _portfolio.FeePercent;
        _draftCapitalPerTradePercent = _portfolio.CapitalPerTradePercent;
    }

    private async Task PersistDemoPortfolioAsync()
    {
        if (!_portfolioLoaded) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DemoPortfolioStorageKey, JsonSerializer.Serialize(_portfolio, new JsonSerializerOptions(JsonSerializerDefaults.Web)));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not save futures demo portfolio to local storage.");
            NotificationService.NotifyError(L[RK.MexcContractTickers.LoadFailed]);
        }
    }

    private async Task OnLeverageChangedAsync(int value)
    {
        _portfolio.Leverage = value;
        await PersistDemoPortfolioAsync();
    }

    private void CancelSettings()
    {
        _draftInitialCapital = _portfolio.InitialCapital;
        _draftFeePercent = _portfolio.FeePercent;
        _draftCapitalPerTradePercent = _portfolio.CapitalPerTradePercent;
        _showSettings = false;
    }

    private async Task SaveSettingsAsync()
    {
        if (_draftInitialCapital <= 0m || _draftFeePercent < 0m || _draftFeePercent > 5m || _draftCapitalPerTradePercent < 1m || _draftCapitalPerTradePercent > 100m)
        {
            NotificationService.NotifyError(L[RK.MexcDemoTrading.InvalidSettings]);
            return;
        }

        _portfolio.InitialCapital = _draftInitialCapital;
        _portfolio.FeePercent = _draftFeePercent;
        _portfolio.CapitalPerTradePercent = _draftCapitalPerTradePercent;
        _showSettings = false;
        await PersistDemoPortfolioAsync();
    }

    private async Task OpenPositionAsync(MexcContractTickerDto ticker, DemoPositionSide side)
    {
        if (!HasValidPrice(ticker.LastPrice)) return;
        var equity = CurrentEquity;
        var margin = Math.Min(equity * _portfolio.CapitalPerTradePercent / 100m, AvailableCapital);
        var notional = margin * _portfolio.Leverage;
        if (margin <= 0m || notional <= 0m || ticker.LastPrice!.Value <= 0m)
        {
            NotificationService.NotifyError(L[RK.MexcDemoTrading.InsufficientCapital]);
            return;
        }

        var quantity = notional / ticker.LastPrice.Value;
        var entryFee = notional * _portfolio.FeePercent / 100m;
        _portfolio.Positions.Add(new DemoFuturesPosition
        {
            Id = Guid.NewGuid(), Symbol = ticker.Symbol, Side = side, EntryPrice = ticker.LastPrice.Value,
            Quantity = quantity, Leverage = _portfolio.Leverage, EntryFee = entryFee, OpenedAtUtc = DateTimeOffset.UtcNow
        });
        await PersistDemoPortfolioAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClosePositionAsync(Guid positionId)
    {
        var position = _portfolio.Positions.FirstOrDefault(item => item.Id == positionId);
        if (position is null) return;
        var markPrice = GetMarkPrice(position);
        if (markPrice <= 0m) return;
        var direction = position.Side == DemoPositionSide.Long ? 1m : -1m;
        var grossPnl = (markPrice - position.EntryPrice) * position.Quantity * direction;
        var exitFee = markPrice * position.Quantity * _portfolio.FeePercent / 100m;
        _portfolio.RealizedPnl += grossPnl - position.EntryFee - exitFee;
        _portfolio.Positions.Remove(position);
        await PersistDemoPortfolioAsync();
        await InvokeAsync(StateHasChanged);
    }

    private decimal GetMarkPrice(DemoFuturesPosition position) =>
        _tickerMap.TryGetValue(position.Symbol, out var ticker) && HasValidPrice(ticker.LastPrice) ? ticker.LastPrice!.Value : position.EntryPrice;

    private decimal GetPositionPnl(DemoFuturesPosition position)
    {
        var direction = position.Side == DemoPositionSide.Long ? 1m : -1m;
        var markPrice = GetMarkPrice(position);
        var grossPnl = (markPrice - position.EntryPrice) * position.Quantity * direction;
        var estimatedExitFee = markPrice * position.Quantity * _portfolio.FeePercent / 100m;
        return grossPnl - position.EntryFee - estimatedExitFee;
    }

    private Task OnSelectedSymbolChanged(string? value)
    {
        _selectedSymbol = value;
        ApplyMobileView();
        return Task.CompletedTask;
    }

    private void OnSortKeyChanged(string? key)
    {
        _sortKey = key;
        ApplyMobileView();
    }

    private void OnSortDirectionChanged(bool asc)
    {
        _sortAscending = asc;
        ApplyMobileView();
    }

    private void ApplyMobileView()
    {
        IEnumerable<MexcContractTickerDto> result = string.IsNullOrWhiteSpace(_selectedSymbol)
            ? _allTickers
            : _allTickers.Where(x => x.Symbol.Equals(_selectedSymbol, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(_sortKey))
        {
            var opt = SortOptions.FirstOrDefault(o => o.Key == _sortKey);
            if (opt is not null)
            {
                result = _sortAscending
                    ? result.OrderBy(ticker => GetPinnedOrder(ticker.Symbol)).ThenBy(opt.KeySelector)
                    : result.OrderBy(ticker => GetPinnedOrder(ticker.Symbol)).ThenByDescending(opt.KeySelector);
            }
        }
        else
        {
            result = result.OrderBy(ticker => GetPinnedOrder(ticker.Symbol));
        }

        _mobileViewTickers = result.ToList();
    }

    private Task<(IReadOnlyList<MexcContractTickerDto>, int)> LoadSymbolsAsync(int page, int pageSize, string? search, CancellationToken cancellationToken)
    {
        IEnumerable<MexcContractTickerDto> query = _allTickers;
        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(x => x.Symbol.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        var symbols = query
            .GroupBy(x => x.Symbol, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(x => x.Symbol, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var total = symbols.Count;
        var items = symbols.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        return Task.FromResult<(IReadOnlyList<MexcContractTickerDto>, int)>((items, total));
    }

    private void OnStreamError(string errorMessage)
    {
        _ = InvokeAsync(() =>
        {
            _isLoading = false;
            NotificationService.NotifyError(L[RK.MexcContractTickers.LoadFailed]);
            StateHasChanged();
        });
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            ContractSocketService.TickersUpdated -= OnTickersUpdated;
            ContractSocketService.StreamError -= OnStreamError;
            _ = ContractSocketService.StopAsync();
        }
        base.Dispose(disposing);
    }

