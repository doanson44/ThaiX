    private static void UpdateTickerInPlace(MexcContractTickerDto existing, MexcContractTickerDto updated)
    {
        existing.LastPrice = updated.LastPrice;
        existing.RiseFallRate = updated.RiseFallRate;
        existing.Bid1 = updated.Bid1;
        existing.Ask1 = updated.Ask1;
        existing.Volume24 = updated.Volume24;
        existing.Amount24 = updated.Amount24;
        existing.High24Price = updated.High24Price;
        existing.Low24Price = updated.Low24Price;
        existing.IndexPrice = updated.IndexPrice;
        existing.FairPrice = updated.FairPrice;
        existing.Timestamp = updated.Timestamp;
    }
