@layout AuthLayout
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys
<RadzenText TextStyle="TextStyle.H4">@L[RK.Auth.AccessDeniedTitle]</RadzenText>
<RadzenText TextStyle="TextStyle.Body1">@L[RK.Auth.AccessDeniedDescription]</RadzenText>

<div class="d-flex gap-2 mt-3">
    <RadzenButton Text="@L[RK.Auth.Login]"
                  Icon="login"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => Navigation.NavigateTo("/auth/login"))" />
    <RadzenButton Text="@L[RK.Common.Home]"
                  Icon="home"
                  ButtonStyle="ButtonStyle.Secondary"
                  Click="@(() => Navigation.NavigateTo("/"))" />
</div>
