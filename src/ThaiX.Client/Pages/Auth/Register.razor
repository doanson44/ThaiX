@page "/auth/register"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Constants
<PageTitle>@L[RK.Auth.Register] - ThaiX</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L[RK.Auth.RegisterTitle]</RadzenText>
<RadzenText TextStyle="TextStyle.Body1">@L[RK.Auth.RegisterDescription]</RadzenText>

<RadzenTemplateForm Data="@_model" Submit="@((RegisterFormModel _) => OnSubmitAsync())">
    <div class="mb-3">
        <RadzenLabel Text="@L[RK.Auth.Email]" class="mb-1" />
        <RadzenTextBox Name="email"
                       @bind-Value="_model.Email"
                       Placeholder="@L[RK.Auth.EmailPlaceholder]"
                       class="w-100" />
        <RadzenRequiredValidator Component="email"
                                 Text="@L[RK.Validation.Required]"
                                 Popup="false" />
        <RadzenEmailValidator Component="email"
                              Text="@L[RK.Validation.Email]"
                              Popup="false" />
    </div>

    <div class="mb-3">
        <RadzenLabel Text="@L[RK.Auth.Password]" class="mb-1" />
        <RadzenPassword Name="password"
                        @bind-Value="_model.Password"
                        Placeholder="@L[RK.Auth.PasswordPlaceholder]"
                        class="w-100" />
        <RadzenRequiredValidator Component="password"
                                 Text="@L[RK.Validation.Required]"
                                 Popup="false" />
    </div>

    <div class="mb-3">
        <RadzenLabel Text="@L[RK.Auth.ConfirmPassword]" class="mb-1" />
        <RadzenPassword Name="confirmPassword"
                        @bind-Value="_model.ConfirmPassword"
                        Placeholder="@L[RK.Auth.ConfirmPasswordPlaceholder]"
                        class="w-100" />
        <RadzenRequiredValidator Component="confirmPassword"
                                 Text="@L[RK.Validation.Required]"
                                 Popup="false" />
        <RadzenCompareValidator Component="confirmPassword"
                                Value="@_model.Password"
                                Text="@L[RK.Validation.PasswordMismatch]"
                                Popup="false" />
    </div>

    <div class="mb-3">
        <RadzenButton Text="@L[RK.Auth.Register]"
                      Icon="person_add"
                      ButtonType="ButtonType.Submit"
                      Disabled="@_isSubmitting"
                      IsBusy="@_isSubmitting"
                      BusyText="@L[RK.Common.Loading]"
                      ButtonStyle="ButtonStyle.Primary"
                      class="w-100" />
    </div>
</RadzenTemplateForm>

<div class="mt-3 d-flex flex-column gap-1">
    <RadzenLink Path="@($"/{RouteSegments.Login}")" Text="@L[RK.Auth.RegisterLink]" />
    <RadzenLink href="@ResendConfirmationUrl" Text="@L[RK.Auth.ResendConfirmationLink]" />
</div>

@code {
    private RegisterFormModel _model = new();
    private bool _isSubmitting;

    private string ResendConfirmationUrl => string.IsNullOrWhiteSpace(_model.Email)
        ? $"/{RouteSegments.ResendConfirmation}"
        : $"/{RouteSegments.ResendConfirmation}?email={Uri.EscapeDataString(_model.Email.Trim())}";

    private async Task OnSubmitAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await AuthService.RegisterAsync(new RegisterRequest
            {
                Email = _model.Email.Trim(),
                Password = _model.Password,
                ConfirmPassword = _model.ConfirmPassword
            });

            if (result.RequiresEmailConfirmation)
            {
                NotificationService.NotifyInfo(L[RK.Auth.RegisterSuccess], L[RK.Auth.RegisterConfirmEmailDetail], 8000);
                Navigation.NavigateTo(
                    $"/{RouteSegments.ResendConfirmation}?email={Uri.EscapeDataString(result.Email)}");
            }
            else
            {
                NotificationService.NotifySuccess(L[RK.Auth.RegisterSuccess], L[RK.Auth.RegisterSuccessDetail]);
                Navigation.NavigateTo($"/{RouteSegments.Login}");
            }
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Auth.RegisterFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class RegisterFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
