@page "/auth/resend-confirmation"
@layout AuthLayout
@inject IAuthService AuthService
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys
<PageTitle>@L[RK.Account.ResendConfirmationTitle] - ThaiX</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L[RK.Account.ResendConfirmationTitle]</RadzenText>
<RadzenText TextStyle="TextStyle.Body1">@L[RK.Account.ResendConfirmationDescription]</RadzenText>

@if (_submitted)
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true">
        @L[RK.Account.ResendConfirmationSuccess]
    </RadzenAlert>
    <div class="mt-3">
        <RadzenLink Path="/auth/login" Text="@L[RK.Auth.LoginLinkGoToLogin]" />
    </div>
}
else
{
    <RadzenTemplateForm Data="@_model" Submit="@((ResendConfirmationFormModel _) => OnSubmitAsync())">
        <div class="mb-3">
            <RadzenLabel Text="@L[RK.Auth.Email]" class="mb-1" />
            <RadzenTextBox Name="email"
                           @bind-Value="_model.Email"
                           Placeholder="@L[RK.Auth.EmailPlaceholder]"
                           class="w-100" />
            <RadzenRequiredValidator Component="email"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />
            <RadzenEmailValidator Component="email"
                                  Text="@L[RK.Validation.Email]"
                                  Popup="false" />
        </div>

        <div class="mb-3">
            <RadzenButton Text="@L[RK.Account.ResendConfirmationSubmit]"
                          Icon="email"
                          ButtonType="ButtonType.Submit"
                          Disabled="@_isSubmitting"
                          IsBusy="@_isSubmitting"
                          BusyText="@L[RK.Common.Loading]"
                          ButtonStyle="ButtonStyle.Primary"
                          class="w-100" />
        </div>
    </RadzenTemplateForm>

    <div class="mt-3">
        <RadzenLink Path="/auth/login" Text="@L[RK.Auth.LoginLinkGoToLogin]" />
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private ResendConfirmationFormModel _model = new();
    private bool _isSubmitting;
    private bool _submitted;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _model.Email = Email.Trim();
        }
    }

    private async Task OnSubmitAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;

        try
        {
            await AuthService.ResendConfirmationAsync(new ResendConfirmationRequest
            {
                Email = _model.Email.Trim()
            });
            _submitted = true;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Account.ResendConfirmationFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ResendConfirmationFormModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
