@page "/auth/lockout"
@layout AuthLayout
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys
<PageTitle>@L[RK.Account.LockoutTitle] - ThaiX</PageTitle>

<div class="d-flex flex-column align-items-center text-center">
    <RadzenIcon Icon="lock" class="mb-3" Style="font-size: 3rem; color: #94a3b8;" />
    <RadzenText TextStyle="TextStyle.H4">@L[RK.Account.LockoutTitle]</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="mt-2">@L[RK.Account.LockoutDescription]</RadzenText>
    <div class="mt-3">
        <RadzenLink Path="/auth/login" Text="@L[RK.Auth.LoginLinkGoToLogin]" />
    </div>
</div>
