@page "/auth/reset-password"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys
<PageTitle>@L[RK.Account.ResetPasswordTitle] - ThaiX</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L[RK.Account.ResetPasswordTitle]</RadzenText>

@if (UserId == null || string.IsNullOrEmpty(Token))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
        @L[RK.Account.ResetPasswordInvalidLink]
    </RadzenAlert>
}
else if (_resetDone)
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true">
        @L[RK.Account.ResetPasswordSuccess]
    </RadzenAlert>
    <div class="mt-3">
        <RadzenLink Path="/auth/login" Text="@L[RK.Auth.LoginLinkGoToLogin]" />
    </div>
}
else
{
    <RadzenTemplateForm Data="@_model" Submit="@((ResetPasswordFormModel _) => OnSubmitAsync())">
        <div class="mb-3">
            <RadzenLabel Text="@L[RK.Auth.Password]" class="mb-1" />
            <RadzenPassword Name="password"
                            @bind-Value="_model.Password"
                            Placeholder="@L[RK.Auth.PasswordPlaceholder]"
                            class="w-100" />
            <RadzenRequiredValidator Component="password"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />
        </div>

        <div class="mb-3">
            <RadzenLabel Text="@L[RK.Auth.ConfirmPassword]" class="mb-1" />
            <RadzenPassword Name="confirmPassword"
                            @bind-Value="_model.ConfirmPassword"
                            Placeholder="@L[RK.Auth.ConfirmPasswordPlaceholder]"
                            class="w-100" />
            <RadzenRequiredValidator Component="confirmPassword"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />
            <RadzenCompareValidator Component="confirmPassword"
                                    Value="@_model.Password"
                                    Text="@L[RK.Validation.PasswordMismatch]"
                                    Popup="false" />
        </div>

        <div class="mb-3">
            <RadzenButton Text="@L[RK.Account.ResetPasswordSubmit]"
                          Icon="lock_reset"
                          ButtonType="ButtonType.Submit"
                          Disabled="@_isSubmitting"
                          IsBusy="@_isSubmitting"
                          BusyText="@L[RK.Common.Loading]"
                          ButtonStyle="ButtonStyle.Primary"
                          class="w-100" />
        </div>
    </RadzenTemplateForm>
}

@code {
    [SupplyParameterFromQuery] public Guid? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private ResetPasswordFormModel _model = new();
    private bool _isSubmitting;
    private bool _resetDone;

    private async Task OnSubmitAsync()
    {
        if (_isSubmitting || UserId == null || string.IsNullOrEmpty(Token)) return;
        _isSubmitting = true;

        try
        {
            await AuthService.ResetPasswordAsync(new AccountResetPasswordRequest
            {
                UserId = UserId.Value,
                Token = Token,
                Password = _model.Password,
                ConfirmPassword = _model.ConfirmPassword
            });
            _resetDone = true;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Account.ResetPasswordFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ResetPasswordFormModel
    {
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
