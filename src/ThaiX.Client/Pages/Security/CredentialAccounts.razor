@page "/security/credential-accounts"
@attribute [Authorize(Policy = PermissionNames.CredentialAccountRead)]
@inherits ThaiXPageBase
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Components.Security
@using ThaiX.Client.Models.CredentialAccounts
@using ThaiX.Client.Services.CredentialAccounts
@inject ICredentialAccountService CredentialAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L[RK.CredentialAccounts.Title] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <div>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" class="mb-0">
                            @L[RK.CredentialAccounts.Title]
                        </RadzenText>
                        <RadzenText class="text-muted">@L[RK.CredentialAccounts.ListTitle]</RadzenText>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <ResponsiveIconButton Text="@L[RK.Common.Refresh]"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@ReloadAsync" />
                        @if (_canWrite)
                        {
                            <ResponsiveIconButton Text="@L[RK.CredentialAccounts.CreateTitle]"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@OpenCreateEditorAsync" />
                        }
                    </div>
                </RadzenStack>

                <RadzenRow Gap="0.75rem" RowGap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.Common.Search]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_searchTerm"
                                           Placeholder="@L[RK.CredentialAccounts.SearchPlaceholder]"
                                           Change="@(_ => ApplyFiltersAsync())" />
                            <InputGroupSearchButton Click="@ApplyFiltersAsync" />
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenLabel Text="@L[RK.CredentialAccounts.FilterStatus]" />
                        <RadzenDropDown Data="@_statusOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        TValue="string"
                                        @bind-Value="_selectedStatusFilter"
                                        class="w-100"
                                        Change="@(_ => ApplyFiltersAsync())" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenRow Gap="1rem" RowGap="1rem">
            <RadzenColumn Size="12">
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     Wrap="FlexWrap.Wrap"
                                     Gap="0.5rem">
                            <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.Body1 : TextStyle.H6)" class="mb-0">
                                @L[RK.CredentialAccounts.ListTitle]
                            </RadzenText>
                            <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                        </RadzenStack>

                        @if (!Viewport.IsMobile)
                        {
                            <RadzenDataGrid @ref="_grid"
                                            TItem="CredentialAccountDto"
                                            Data="@_items"
                                            Count="@_totalCount"
                                            LoadData="@LoadDataAsync"
                                            AllowPaging="true"
                                            AllowSorting="true"
                                            AllowFiltering="true"
                                            FilterMode="FilterMode.Advanced"
                                            PageSize="@DefaultPageSize"
                                            PageSizeOptions="@PageSizeOptions"
                                            ShowPagingSummary="true"
                                            Density="Density.Compact"
                                            IsLoading="@_isLoading">
                                <Columns>
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.Username)"
                                                          Title="@L[RK.CredentialAccounts.Username]" />
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.Description)"
                                                          Title="@L[RK.CredentialAccounts.Description]">
                                        <Template Context="item">
                                            @(string.IsNullOrWhiteSpace(item.Description) ? "--" : item.Description)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.IsUsed)"
                                                          Title="@L[RK.CredentialAccounts.Status]">
                                        <Template Context="item">
                                            <RadzenBadge Text="@(item.IsUsed ? L[RK.CredentialAccounts.Used] : L[RK.CredentialAccounts.Unused])"
                                                         BadgeStyle="@(item.IsUsed ? BadgeStyle.Warning : BadgeStyle.Success)" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.UsedAt)"
                                                          Title="@L[RK.CredentialAccounts.LastUsed]">
                                        <Template Context="item">
                                            @if (string.IsNullOrWhiteSpace(item.LastUsedAgo))
                                            {
                                                <span class="text-muted">--</span>
                                            }
                                            else
                                            {
                                                <RadzenBadge Text="@item.LastUsedAgo"
                                                             BadgeStyle="@GetLastUsedBadgeStyle(item.UsedAt)" />
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.UsedBy)"
                                                          Title="@L[RK.CredentialAccounts.UsedBy]">
                                        <Template Context="item">
                                            @(string.IsNullOrWhiteSpace(item.UsedBy) ? "--" : item.UsedBy)
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Property="@nameof(CredentialAccountDto.UsageCount)"
                                                          Title="@L[RK.CredentialAccounts.UsageCount]" />
                                    <RadzenDataGridColumn TItem="CredentialAccountDto"
                                                          Title="@L[RK.CredentialAccounts.Actions]"
                                                          Sortable="false"
                                                          Filterable="false">
                                        <Template Context="item">
                                            <div class="d-flex flex-wrap gap-1">
                                                <RadzenButton Icon="content_copy"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.Small"
                                                              title="@L[RK.CredentialAccounts.CopyUsername]"
                                                              aria-label="@L[RK.CredentialAccounts.CopyUsername]"
                                                              Click="@(() => CopyUsernameAsync(item.Username))" />
                                                @if (_canViewPassword)
                                                {
                                                    <RadzenButton Icon="key"
                                                                  ButtonStyle="ButtonStyle.Secondary"
                                                                  Size="ButtonSize.Small"
                                                                  title="@L[RK.CredentialAccounts.CopyPassword]"
                                                                  aria-label="@L[RK.CredentialAccounts.CopyPassword]"
                                                                  Click="@(() => CopyPasswordAsync(item))" />
                                                    <RadzenButton Icon="assignment"
                                                                  ButtonStyle="ButtonStyle.Info"
                                                                  Size="ButtonSize.Small"
                                                                  title="@L[RK.CredentialAccounts.CopyAll]"
                                                                  aria-label="@L[RK.CredentialAccounts.CopyAll]"
                                                                  Click="@(() => CopyAllAsync(item))" />
                                                    <RadzenButton Icon="visibility"
                                                                  ButtonStyle="ButtonStyle.Info"
                                                                  Size="ButtonSize.Small"
                                                                  title="@L[RK.CredentialAccounts.ViewPassword]"
                                                                  aria-label="@L[RK.CredentialAccounts.ViewPassword]"
                                                                  Click="@(() => ViewPasswordAsync(item))" />
                                                }
                                                <RadzenButton Icon="history"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.Small"
                                                              title="@L[RK.CredentialAccounts.ViewAuditLogs]"
                                                              aria-label="@L[RK.CredentialAccounts.ViewAuditLogs]"
                                                              Click="@(() => OpenAuditLogsAsync(item))" />
                                                @if (_canWrite)
                                                {
                                                    @if (item.IsUsed)
                                                    {
                                                        <RadzenButton Icon="restart_alt"
                                                                      ButtonStyle="ButtonStyle.Warning"
                                                                      Size="ButtonSize.Small"
                                                                      title="@L[RK.CredentialAccounts.ResetUsed]"
                                                                      aria-label="@L[RK.CredentialAccounts.ResetUsed]"
                                                                      Click="@(() => ResetUsedAsync(item))" />
                                                    }
                                                    else
                                                    {
                                                        <RadzenButton Icon="check_circle"
                                                                      ButtonStyle="ButtonStyle.Success"
                                                                      Size="ButtonSize.Small"
                                                                      title="@L[RK.CredentialAccounts.MarkUsed]"
                                                                      aria-label="@L[RK.CredentialAccounts.MarkUsed]"
                                                                      Click="@(() => MarkUsedAsync(item))" />
                                                    }
                                                    <RadzenButton Icon="edit"
                                                                  ButtonStyle="ButtonStyle.Primary"
                                                                  Size="ButtonSize.Small"
                                                                  title="@L[RK.CredentialAccounts.EditTitle]"
                                                                  aria-label="@L[RK.CredentialAccounts.EditTitle]"
                                                                  Click="@(() => OpenEditEditorAsync(item))" />
                                                }
                                                @if (_canDelete)
                                                {
                                                    <RadzenButton Icon="delete"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Size="ButtonSize.Small"
                                                                  title="@L[RK.Common.Delete]"
                                                                  aria-label="@L[RK.Common.Delete]"
                                                                  Click="@(() => ConfirmDeleteAsync(item))" />
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                        else
                        {
                            <RadzenStack Gap="0.75rem">
                                @if (_isLoading)
                                {
                                    <RadzenText>@L[RK.Common.Loading]</RadzenText>
                                }
                                else if (_items.Count == 0)
                                {
                                    <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
                                }
                                else
                                {
                                    <Virtualize Items="@_items" TItem="CredentialAccountDto" Context="item" OverscanCount="5">
                                        <div class="mb-2">
                                            <RadzenCard class="p-3 m-0">
                                                <RadzenStack Gap="0.5rem">
                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                        <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0 text-break">
                                                            @item.Username
                                                        </RadzenText>
                                                        <RadzenBadge Text="@(item.IsUsed ? L[RK.CredentialAccounts.Used] : L[RK.CredentialAccounts.Unused])"
                                                                     BadgeStyle="@(item.IsUsed ? BadgeStyle.Warning : BadgeStyle.Success)" />
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                                    {
                                                        <RadzenText class="text-muted small mb-0">@item.Description</RadzenText>
                                                    }
                                                    <RadzenText class="text-muted small mb-0">
                                                        @L[RK.CredentialAccounts.LastUsed]:
                                                        @(string.IsNullOrWhiteSpace(item.LastUsedAgo) ? "--" : item.LastUsedAgo)
                                                    </RadzenText>
                                                    <RadzenText class="text-muted small mb-0">
                                                        @L[RK.CredentialAccounts.UsedBy]:
                                                        @(string.IsNullOrWhiteSpace(item.UsedBy) ? "--" : item.UsedBy)
                                                    </RadzenText>
                                                    <RadzenText class="text-muted small mb-0">
                                                        @L[RK.CredentialAccounts.UsageCount]: @item.UsageCount
                                                    </RadzenText>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        <RadzenButton Text="@L[RK.CredentialAccounts.CopyUsername]"
                                                                      Icon="content_copy"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => CopyUsernameAsync(item.Username))" />
                                                        @if (_canViewPassword)
                                                        {
                                                            <RadzenButton Text="@L[RK.CredentialAccounts.CopyPassword]"
                                                                          Icon="key"
                                                                          ButtonStyle="ButtonStyle.Secondary"
                                                                          Size="ButtonSize.Small"
                                                                          Click="@(() => CopyPasswordAsync(item))" />
                                                            <RadzenButton Text="@L[RK.CredentialAccounts.CopyAll]"
                                                                          Icon="assignment"
                                                                          ButtonStyle="ButtonStyle.Info"
                                                                          Size="ButtonSize.Small"
                                                                          Click="@(() => CopyAllAsync(item))" />
                                                            <ResponsiveIconButton Text="@L[RK.CredentialAccounts.ViewPassword]"
                                                                          Icon="visibility"
                                                                          ButtonStyle="ButtonStyle.Info"
                                                                          Size="ButtonSize.Small"
                                                                          Click="@(() => ViewPasswordAsync(item))" />
                                                        }
                                                        <ResponsiveIconButton Text="@L[RK.CredentialAccounts.ViewAuditLogs]"
                                                                      Icon="history"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => OpenAuditLogsAsync(item))" />
                                                        @if (_canWrite)
                                                        {
                                                            @if (item.IsUsed)
                                                            {
                                                                <RadzenButton Text="@L[RK.CredentialAccounts.ResetUsed]"
                                                                              Icon="restart_alt"
                                                                              ButtonStyle="ButtonStyle.Warning"
                                                                              Size="ButtonSize.Small"
                                                                              Click="@(() => ResetUsedAsync(item))" />
                                                            }
                                                            else
                                                            {
                                                                <RadzenButton Text="@L[RK.CredentialAccounts.MarkUsed]"
                                                                              Icon="check_circle"
                                                                              ButtonStyle="ButtonStyle.Success"
                                                                              Size="ButtonSize.Small"
                                                                              Click="@(() => MarkUsedAsync(item))" />
                                                            }
                                                            <ResponsiveIconButton Text="@L[RK.CredentialAccounts.EditTitle]"
                                                                          Icon="edit"
                                                                          ButtonStyle="ButtonStyle.Primary"
                                                                          Size="ButtonSize.Small"
                                                                          Click="@(() => OpenEditEditorAsync(item))" />
                                                        }
                                                        @if (_canDelete)
                                                        {
                                                            <ResponsiveIconButton Text="@L[RK.Common.Delete]"
                                                                          Icon="delete"
                                                                          ButtonStyle="ButtonStyle.Danger"
                                                                          Size="ButtonSize.Small"
                                                                          Click="@(() => ConfirmDeleteAsync(item))" />
                                                        }
                                                    </div>
                                                </RadzenStack>
                                            </RadzenCard>
                                        </div>
                                    </Virtualize>
                                }

                                <AdminListPager TotalCount="@_totalCount"
                                                PageSize="@_pageSize"
                                                CurrentPage="@_currentPage"
                                                CurrentPageChanged="@GoToPageAsync"
                                                Disabled="@_isLoading" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
</div>

@code {
    private const int DefaultPageSize = 10;
    private static readonly IEnumerable<int> PageSizeOptions = [10, 20, 50, 100];

    private RadzenDataGrid<CredentialAccountDto>? _grid;
    private List<CredentialAccountDto> _items = [];
    private int _totalCount;
    private bool _isLoading;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private string _searchTerm = string.Empty;
    private string _selectedStatusFilter = "all";
    private IReadOnlyList<StatusOption> _statusOptions = [];
    private bool _canWrite;
    private bool _canDelete;
    private bool _canViewPassword;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.CredentialAccountWrite);
        _canDelete = user.HasClaim("scope", PermissionNames.CredentialAccountDelete);
        _canViewPassword = user.HasClaim("scope", PermissionNames.CredentialAccountViewPassword);

        _statusOptions =
        [
            new("all", L[RK.CredentialAccounts.FilterAll]),
            new("used", L[RK.CredentialAccounts.FilterUsed]),
            new("unused", L[RK.CredentialAccounts.FilterUnused])
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadPageAsync();
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _pageSize = args.Top ?? DefaultPageSize;
        _currentPage = _pageSize <= 0 ? 1 : ((args.Skip ?? 0) / _pageSize) + 1;

        var sort = args.Sorts?.FirstOrDefault();
        await LoadPageAsync(MapSort(sort?.Property), sort?.SortOrder == SortOrder.Descending);
    }

    private async Task LoadPageAsync(string? sortBy = null, bool sortDescending = false)
    {
        _isLoading = true;

        try
        {
            var result = await CredentialAccountService.GetListAsync(new CredentialAccountsListRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                SortBy = string.IsNullOrWhiteSpace(sortBy) ? "username" : sortBy,
                SortDescending = sortDescending,
                IsUsed = GetIsUsedFilter()
            });

            _items = result.Data?.ToList() ?? [];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.LoadFailed], ex.GetDisplayDetail());
            _items = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;

        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.GoToPage(0);
            return;
        }

        await LoadPageAsync();
    }

    private async Task ReloadAsync()
    {
        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadPageAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.GoToPage(page - 1);
            return;
        }

        _currentPage = page;
        await LoadPageAsync();
    }

    private async Task OpenCreateEditorAsync()
    {
        await OpenEditorDialogAsync();
    }

    private async Task OpenEditEditorAsync(CredentialAccountDto item)
    {
        await OpenEditDialogAsync(item.Id);
    }

    private async Task OpenEditDialogAsync(Guid id)
    {
        var detail = await CredentialAccountService.GetByIdAsync(id);
        await OpenEditorDialogAsync(detail);
    }

    private async Task OpenEditorDialogAsync(CredentialAccountDetailDto? detail = null)
    {
        var title = detail is null ? L[RK.CredentialAccounts.CreateTitle] : L[RK.CredentialAccounts.EditTitle];

        var result = await DialogService.OpenAsync<CredentialAccountEditor>(
            title,
            new Dictionary<string, object?>
            {
                [nameof(CredentialAccountEditor.AccountId)] = detail?.Id,
                [nameof(CredentialAccountEditor.InitialUsername)] = detail?.Username,
                [nameof(CredentialAccountEditor.InitialDescription)] = detail?.Description,
                [nameof(CredentialAccountEditor.IsUsed)] = detail?.IsUsed ?? false,
                [nameof(CredentialAccountEditor.UsedBy)] = detail?.UsedBy,
                [nameof(CredentialAccountEditor.UsageCount)] = detail?.UsageCount ?? 0,
                [nameof(CredentialAccountEditor.LastUsedAgo)] = detail?.LastUsedAgo,
                [nameof(CredentialAccountEditor.UseDialog)] = true
            },
            BuildDialogOptions());

        if (result is true)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenAuditLogsAsync(CredentialAccountDto item)
    {
        await DialogService.OpenAsync<CredentialAccountAuditLogsDialog>(
            L[RK.CredentialAccounts.AuditLogsTitle],
            new Dictionary<string, object?>
            {
                [nameof(CredentialAccountAuditLogsDialog.AccountId)] = item.Id,
                [nameof(CredentialAccountAuditLogsDialog.Username)] = item.Username
            },
            BuildDialogOptions());
    }

    private async Task ViewPasswordAsync(CredentialAccountDto item)
    {
        try
        {
            var result = await CredentialAccountService.ViewPasswordAsync(item.Id);

            await DialogService.OpenAsync<CredentialAccountPasswordDialog>(
                L[RK.CredentialAccounts.PasswordDialogTitle],
                new Dictionary<string, object?>
                {
                    [nameof(CredentialAccountPasswordDialog.Username)] = result.Username,
                    [nameof(CredentialAccountPasswordDialog.Password)] = result.Password
                },
                BuildDialogOptions());
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.ViewPasswordFailed], ex.GetDisplayDetail());
        }
    }

    private async Task CopyUsernameAsync(string username)
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("copyTextToClipboard", username);
            if (!copied)
            {
                throw new InvalidOperationException("Clipboard copy command failed.");
            }

            NotificationService.NotifySuccess(L[RK.CredentialAccounts.CopySuccess]);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.CopyFailed], ex.Message);
        }
    }

    private async Task CopyPasswordAsync(CredentialAccountDto item)
    {
        try
        {
            var result = await CredentialAccountService.CopyPasswordAsync(item.Id);
            var copied = await JS.InvokeAsync<bool>("copyTextToClipboard", result.Password);
            if (!copied)
            {
                throw new InvalidOperationException("Clipboard copy command failed.");
            }

            NotificationService.NotifySuccess(L[RK.CredentialAccounts.CopySuccess]);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.CopyFailed], ex.GetDisplayDetail());
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.CopyFailed], ex.Message);
        }
    }

    private async Task CopyAllAsync(CredentialAccountDto item)
    {
        try
        {
            var result = await CredentialAccountService.CopyPasswordAsync(item.Id);
            var payload = $"Username: {result.Username}{Environment.NewLine}Password: {result.Password}";
            var copied = await JS.InvokeAsync<bool>("copyTextToClipboard", payload);
            if (!copied)
            {
                throw new InvalidOperationException("Clipboard copy command failed.");
            }

            NotificationService.NotifySuccess(L[RK.CredentialAccounts.CopySuccess]);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.CopyFailed], ex.GetDisplayDetail());
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.CopyFailed], ex.Message);
        }
    }

    private async Task MarkUsedAsync(CredentialAccountDto item)
    {
        try
        {
            await CredentialAccountService.MarkUsedAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.CredentialAccounts.MarkUsedSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.MarkUsedFailed], ex.GetDisplayDetail());
        }
    }

    private async Task ResetUsedAsync(CredentialAccountDto item)
    {
        try
        {
            await CredentialAccountService.ResetUsedAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.CredentialAccounts.ResetUsedSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.ResetUsedFailed], ex.GetDisplayDetail());
        }
    }

    private async Task ConfirmDeleteAsync(CredentialAccountDto item)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.CredentialAccounts.ConfirmDelete]);

        if (confirmed is not true)
        {
            return;
        }

        try
        {
            await CredentialAccountService.DeleteAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.CredentialAccounts.DeleteSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.DeleteFailed], ex.GetDisplayDetail());
        }
    }

    private bool? GetIsUsedFilter()
    {
        return _selectedStatusFilter switch
        {
            "used" => true,
            "unused" => false,
            _ => null
        };
    }

    private static string MapSort(string? property)
    {
        return property?.ToLowerInvariant() switch
        {
            "usedat" => "usedat",
            "usedby" => "usedby",
            "usagecount" => "usagecount",
            "createdat" => "createdat",
            _ => "username"
        };
    }

    private BadgeStyle GetLastUsedBadgeStyle(DateTime? usedAt)
    {
        if (!usedAt.HasValue)
        {
            return BadgeStyle.Secondary;
        }

        var elapsed = DateTime.UtcNow - usedAt.Value;
        if (elapsed.TotalDays < 1)
        {
            return BadgeStyle.Success;
        }

        if (elapsed.TotalDays <= 7)
        {
            return BadgeStyle.Info;
        }

        if (elapsed.TotalDays <= 30)
        {
            return BadgeStyle.Warning;
        }

        return BadgeStyle.Danger;
    }

    private DialogOptions BuildDialogOptions()
    {
        return new DialogOptions
        {
            Width = Viewport.IsMobile ? "96vw" : "min(720px, 96vw)",
            Height = "auto",
            Resizable = false,
            Draggable = false,
            CloseDialogOnEsc = true,
            ShowClose = true,
            CloseDialogOnOverlayClick = false
        };
    }

    private sealed record StatusOption(string Value, string Text);
}
