@page "/security/api-clients"
@attribute [Authorize(Policy = PermissionNames.ApiClientRead)]
@inherits ThaiXPageBase
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Components.Security
@inject IApiClientService ApiClientService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L[RK.ApiClients.Title] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <div>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" class="mb-0">@L[RK.ApiClients.Title]</RadzenText>
                        <RadzenText class="text-muted">@L[RK.ApiClients.ListTitle]</RadzenText>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <ResponsiveIconButton Text="@L[RK.Common.Refresh]"
                                      Icon="refresh"
                                      ButtonStyle="ButtonStyle.Light"
                                      Click="@ReloadAsync" />
                        @if (_canWrite)
                        {
                            <ResponsiveIconButton Text="@L[RK.ApiClients.CreateTitle]"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@OpenCreateDialogAsync" />
                        }
                    </div>
                </RadzenStack>

                <RadzenRow Gap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.Common.Search]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_searchTerm"
                                           Placeholder="@L[RK.ApiClients.SearchPlaceholder]"
                                           Change="@(_ => ApplySearch())" />
                            <InputGroupSearchButton Click="@ApplySearch" />
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.H6" class="mb-0">@L[RK.ApiClients.ListTitle]</RadzenText>
                    <RadzenBadge Text="@_filtered.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>

                @if (_isLoading)
                {
                    <RadzenText>@L[RK.Common.Loading]</RadzenText>
                }
                else
                {
                    @if (!Viewport.IsMobile)
                    {
                        <RadzenDataGrid TItem="ApiClientDto"
                                        Data="@_filtered"
                                        AllowPaging="true"
                                        AllowSorting="true"
                                        PageSize="10"
                                        PageSizeOptions="@(new[] { 10, 20, 50 })"
                                        ShowPagingSummary="true"
                                        Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn TItem="ApiClientDto" Property="ClientId" Title="@L[RK.ApiClients.ClientId]" />
                                <RadzenDataGridColumn TItem="ApiClientDto" Property="Name" Title="@L[RK.ApiClients.Name]" />
                                <RadzenDataGridColumn TItem="ApiClientDto" Property="Description" Title="@L[RK.ApiClients.Description]" />
                                <RadzenDataGridColumn TItem="ApiClientDto" Property="IsActive" Title="@L[RK.ApiClients.IsActive]" Width="100px">
                                    <Template Context="item">
                                        <RadzenBadge Text="@(item.IsActive ? L[RK.ApiClients.Active] : L[RK.ApiClients.Inactive])"
                                                     BadgeStyle="@(item.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ApiClientDto" Property="Scopes" Title="@L[RK.ApiClients.Scopes]">
                                    <Template Context="item">
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var scope in item.Scopes.Take(3))
                                            {
                                                <RadzenBadge Text="@scope" BadgeStyle="BadgeStyle.Info" />
                                            }
                                            @if (item.Scopes.Count > 3)
                                            {
                                                <RadzenBadge Text="@($"+{item.Scopes.Count - 3}")" BadgeStyle="BadgeStyle.Light" />
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ApiClientDto" Title="@L[RK.ApiClients.Actions]" Sortable="false" Width="240px">
                                    <Template Context="item">
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (_canWrite)
                                            {
                                                <RadzenButton Icon="edit"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => OpenEditDialogAsync(item))"
                                                              title="@L[RK.ApiClients.ActionEdit]" />
                                                @if (item.IsActive)
                                                {
                                                    <RadzenButton Icon="pause_circle"
                                                                  ButtonStyle="ButtonStyle.Warning"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => DeactivateAsync(item))"
                                                                  title="@L[RK.ApiClients.ActionDeactivate]" />
                                                }
                                                else
                                                {
                                                    <RadzenButton Icon="play_circle"
                                                                  ButtonStyle="ButtonStyle.Success"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => ActivateAsync(item))"
                                                                  title="@L[RK.ApiClients.ActionActivate]" />
                                                }
                                                <RadzenButton Icon="vpn_key"
                                                              ButtonStyle="ButtonStyle.Secondary"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => ConfirmRegenerateSecretAsync(item))"
                                                              title="@L[RK.ApiClients.ActionRegenerateSecret]" />
                                            }
                                            @if (_canManageScopes)
                                            {
                                                <RadzenButton Icon="shield"
                                                              ButtonStyle="ButtonStyle.Info"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => OpenScopesDialogAsync(item))"
                                                              title="@L[RK.ApiClients.ActionManageScopes]" />
                                            }
                                            @if (_canDelete)
                                            {
                                                <RadzenButton Icon="delete"
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => ConfirmDeleteAsync(item))"
                                                              title="@L[RK.Common.Delete]" />
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    
                    }

                    @if (Viewport.IsMobile)
                    {
                        <RadzenStack Gap="0.75rem">
                            @if (_filtered.Count == 0)
                            {
                                <RadzenText class="text-muted">@L[RK.ApiClients.NoData]</RadzenText>
                            }
                            else
                            {
                                @foreach (var item in _filtered)
                                {
                                    <RadzenCard class="p-3">
                                        <RadzenStack Gap="0.5rem">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">@item.Name</RadzenText>
                                                <RadzenBadge Text="@(item.IsActive ? L[RK.ApiClients.Active] : L[RK.ApiClients.Inactive])"
                                                             BadgeStyle="@(item.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                                            </div>
                                            <RadzenText class="text-muted small mb-0">@item.ClientId</RadzenText>
                                            @if (!string.IsNullOrEmpty(item.Description))
                                            {
                                                <RadzenText class="text-muted small mb-0">@item.Description</RadzenText>
                                            }
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var scope in item.Scopes.Take(3))
                                                {
                                                    <RadzenBadge Text="@scope" BadgeStyle="BadgeStyle.Info" />
                                                }
                                                @if (item.Scopes.Count > 3)
                                                {
                                                    <RadzenBadge Text="@($"+{item.Scopes.Count - 3}")" BadgeStyle="BadgeStyle.Light" />
                                                }
                                            </div>
                                            <div class="d-flex flex-wrap gap-2">
                                                @if (_canWrite)
                                                {
                                                    <ResponsiveIconButton Text="@L[RK.ApiClients.EditTitle]"
                                                                  Icon="edit"
                                                                  ButtonStyle="ButtonStyle.Primary"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => OpenEditDialogAsync(item))" />
                                                    @if (item.IsActive)
                                                    {
                                                        <ResponsiveIconButton Text="@L[RK.ApiClients.ActionDeactivate]"
                                                                      Icon="pause_circle"
                                                                      ButtonStyle="ButtonStyle.Warning"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => DeactivateAsync(item))" />
                                                    }
                                                    else
                                                    {
                                                        <ResponsiveIconButton Text="@L[RK.ApiClients.ActionActivate]"
                                                                      Icon="play_circle"
                                                                      ButtonStyle="ButtonStyle.Success"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => ActivateAsync(item))" />
                                                    }
                                                    <ResponsiveIconButton Text="@L[RK.ApiClients.ActionRegenerateSecret]"
                                                                  Icon="vpn_key"
                                                                  ButtonStyle="ButtonStyle.Secondary"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => ConfirmRegenerateSecretAsync(item))" />
                                                }
                                                @if (_canManageScopes)
                                                {
                                                    <ResponsiveIconButton Text="@L[RK.ApiClients.ScopesTitle]"
                                                                  Icon="shield"
                                                                  ButtonStyle="ButtonStyle.Info"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => OpenScopesDialogAsync(item))" />
                                                }
                                                @if (_canDelete)
                                                {
                                                    <ResponsiveIconButton Text="@L[RK.Common.Delete]"
                                                                  Icon="delete"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => ConfirmDeleteAsync(item))" />
                                                }
                                            </div>
                                        </RadzenStack>
                                    </RadzenCard>
                                }
                            }
                        </RadzenStack>
                    
                    }
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
</div>

@code {
    private IReadOnlyList<ApiClientDto> _all = [];
    private List<ApiClientDto> _filtered = [];
    private bool _isLoading;
    private string? _searchTerm;
    private bool _canWrite;
    private bool _canDelete;
    private bool _canManageScopes;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.ApiClientWrite);
        _canDelete = user.HasClaim("scope", PermissionNames.ApiClientDelete);
        _canManageScopes = user.HasClaim("scope", PermissionNames.ApiClientManageScopes);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _all = await ApiClientService.GetAllAsync();
            ApplySearch();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.LoadFailed], ex.GetDisplayDetail());
            _all = [];
            _filtered = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filtered = _all.ToList();
        }
        else
        {
            var term = _searchTerm.Trim();
            _filtered = _all
                .Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                         || c.ClientId.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var result = await DialogService.OpenAsync<ApiClientDialog>(
            L[RK.ApiClients.CreateTitle],
            new Dictionary<string, object?>
            {
                [nameof(ApiClientDialog.IsEdit)] = false
            },
            new DialogOptions { Width = "520px", CloseDialogOnEsc = true });

        if (result is CreateApiClientResponse created)
        {
            await ShowSecretDialogAsync(created.ClientId, created.ClientSecret);
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(ApiClientDto item)
    {
        var result = await DialogService.OpenAsync<ApiClientDialog>(
            L[RK.ApiClients.EditTitle],
            new Dictionary<string, object?>
            {
                [nameof(ApiClientDialog.IsEdit)] = true,
                [nameof(ApiClientDialog.ClientGuid)] = item.Id,
                [nameof(ApiClientDialog.InitialName)] = item.Name,
                [nameof(ApiClientDialog.InitialDescription)] = item.Description
            },
            new DialogOptions { Width = "520px", CloseDialogOnEsc = true });

        if (result is true)
        {
            await ReloadAsync();
        }
    }

    private async Task OpenScopesDialogAsync(ApiClientDto item)
    {
        var result = await DialogService.OpenAsync<ApiClientScopesDialog>(
            L[RK.ApiClients.ScopesTitle],
            new Dictionary<string, object?>
            {
                [nameof(ApiClientScopesDialog.ClientGuid)] = item.Id,
                [nameof(ApiClientScopesDialog.CurrentScopes)] = item.Scopes
            },
            new DialogOptions { Width = "520px", CloseDialogOnEsc = true });

        if (result is true)
        {
            await ReloadAsync();
        }
    }

    private async Task ActivateAsync(ApiClientDto item)
    {
        try
        {
            await ApiClientService.ActivateAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.ApiClients.ActivateSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.ActivateFailed], ex.GetDisplayDetail());
        }
    }

    private async Task DeactivateAsync(ApiClientDto item)
    {
        try
        {
            await ApiClientService.DeactivateAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.ApiClients.DeactivateSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.DeactivateFailed], ex.GetDisplayDetail());
        }
    }

    private async Task ConfirmRegenerateSecretAsync(ApiClientDto item)
    {
        var confirmed = await DialogService.Confirm(
            L[RK.ApiClients.ConfirmRegenerateSecret],
            L[RK.ApiClients.ActionRegenerateSecret],
            new ConfirmOptions { OkButtonText = L[RK.Common.Yes], CancelButtonText = L[RK.Common.Cancel] });

        if (confirmed is not true) return;

        try
        {
            var result = await ApiClientService.RegenerateSecretAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.ApiClients.RegenerateSecretSuccess]);
            await ShowSecretDialogAsync(result.ClientId, result.ClientSecret);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.RegenerateSecretFailed], ex.GetDisplayDetail());
        }
    }

    private async Task ConfirmDeleteAsync(ApiClientDto item)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.ApiClients.ConfirmDelete]);

        if (confirmed is not true) return;

        try
        {
            await ApiClientService.DeleteAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.ApiClients.DeleteSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.DeleteFailed], ex.GetDisplayDetail());
        }
    }

    private async Task ShowSecretDialogAsync(string clientId, string secret)
    {
        await DialogService.OpenAsync<ApiClientSecretDialog>(
            L[RK.ApiClients.SecretTitle],
            new Dictionary<string, object?>
            {
                [nameof(ApiClientSecretDialog.ClientId)] = clientId,
                [nameof(ApiClientSecretDialog.ClientSecret)] = secret
            },
            new DialogOptions { Width = "520px", CloseDialogOnEsc = false, ShowClose = false });
    }
}
