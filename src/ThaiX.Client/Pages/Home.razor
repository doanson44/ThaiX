@page "/"
@using ThaiX.Client.Components.MarketData.Dashboard
@using ThaiX.Client.Models.ExternalData
@using ThaiX.Client.Services.ExternalData
@inject Microsoft.Extensions.Localization.IStringLocalizer<ThaiX.Client.Localization.SharedResource> L
@inject NavigationManager Navigation
@inject IExternalDataService ExternalDataService
@using RK = ThaiX.Client.Constants.ResourceKeys
<PageTitle>@L[RK.Menu.Home] - ThaiX</PageTitle>

<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H3">@L[RK.HomePage.Welcome]</RadzenText>
        <RadzenText>@L[RK.HomePage.Description]</RadzenText>

        <AuthorizeView>
            <Authorized Context="auth">
                <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat">
                    @L[RK.HomePage.AuthenticatedAs] @auth.User.FindFirst("email")?.Value
                </RadzenAlert>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="@L[RK.Menu.Profile]" Icon="account_circle" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Navigation.NavigateTo("/account/profile"))" />
                    @if (auth.User.HasClaim("scope", PermissionNames.UserRead))
                    {
                        <RadzenButton Text="@L[RK.Menu.Users]" Icon="groups" ButtonStyle="ButtonStyle.Info"
                                      Click="@(() => Navigation.NavigateTo("/admin/users"))" />
                    }
                </RadzenStack>
            </Authorized>
            <NotAuthorized>
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
                    @L[RK.HomePage.NotAuthenticated]
                </RadzenAlert>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="@L[RK.Menu.Login]" Icon="login" ButtonStyle="ButtonStyle.Primary"
                                  Click="@(() => Navigation.NavigateTo("/auth/login"))" />
                    <RadzenButton Text="@L[RK.Menu.Register]" Icon="person_add" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => Navigation.NavigateTo("/auth/register"))" />
                </RadzenStack>
            </NotAuthorized>
        </AuthorizeView>
    </RadzenStack>
</RadzenCard>

<RadzenStack Gap="1rem" class="mt-4">
    @if (_isLoadingMarketDashboard)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
    }
    else if (_marketDashboard is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @L[RK.BitcoinMarket.LoadFailed]
        </RadzenAlert>
    }
    else
    {
        <RadzenRow class="align-items-stretch g-3">
            <RadzenColumn Size="12" SizeMD="6" SizeLG="6" class="d-flex">
                <MarketAnalysisWidget Data="@CreateVixCard()" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" SizeLG="6" class="d-flex">
                <MarketAnalysisWidget Data="@CreateVnIndexCard()" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow class="align-items-stretch g-3">
            <RadzenColumn Size="12" SizeMD="6" SizeLG="6" class="d-flex">
                <MarketAnalysisWidget Data="@CreateBitcoinCard()" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6" SizeLG="6" class="d-flex">
                <MarketAnalysisWidget Data="@CreateGoldCard()" />
            </RadzenColumn>
        </RadzenRow>
    }

    <AuthorizeView>
        <Authorized>
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="mb-0">
                        @L[RK.Vix.AiAssessmentTitle]
                    </RadzenText>
                    <RadzenButton Text="@L[RK.Vix.GetAiAssessment]" Icon="auto_awesome"
                                  ButtonStyle="ButtonStyle.Primary" Click="GetAiAssessmentAsync"
                                  Disabled="@(!CanGetAiAssessment || _isLoadingAiAssessment)" />
                    @if (_isLoadingAiAssessment)
                    {
                        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_aiAssessmentError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                            @_aiAssessmentError
                        </RadzenAlert>
                    }
                    else if (_aiAssessment is not null)
                    {
                        <RadzenText TextStyle="TextStyle.Body1" Style="white-space: pre-line">
                            @_aiAssessment.Commentary
                        </RadzenText>
                    }
                </RadzenStack>
            </RadzenCard>
        </Authorized>
    </AuthorizeView>

    <RadzenRow class="align-items-stretch g-3">
        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" class="d-flex">
            <VnDirectChangePricesWidget />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" class="d-flex">
            <CommoditiesWidget />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6" SizeLG="4" class="d-flex">
            <CurrenciesWidget />
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    private MarketDashboardResponseDto? _marketDashboard;
    private CombinedMarketAssessmentResponseDto? _aiAssessment;
    private string? _aiAssessmentError;
    private bool _isLoadingMarketDashboard = true;
    private bool _isLoadingAiAssessment;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await ExternalDataService.GetMarketDashboardAsync();
            _marketDashboard = response.Data;
        }
        catch
        {
            _marketDashboard = null;
        }
        finally
        {
            _isLoadingMarketDashboard = false;
        }
    }

    private bool CanGetAiAssessment =>
        _marketDashboard is
        {
            Vix.Success: true,
            VnIndex.Success: true,
            Bitcoin.Success: true,
            Gold.Success: true
        };

    private MarketAnalysisCardDto CreateVixCard()
    {
        var data = _marketDashboard!.Vix!;
        var change = data.CurrentPrice.HasValue && data.PreviousClose.HasValue
            ? data.CurrentPrice.Value - data.PreviousClose.Value
            : (decimal?)null;
        var changePct = data.PreviousClose is > 0m && change.HasValue
            ? change.Value / data.PreviousClose.Value * 100m
            : (decimal?)null;

        return new MarketAnalysisCardDto
        {
            Title = L[RK.Vix.Title],
            Symbol = data.Symbol,
            Success = data.Success,
            Message = data.Message,
            Price = data.CurrentValue,
            Change = change,
            ChangePct = changePct,
            PreviousClose = data.PreviousClose,
            High = data.DayHigh,
            Low = data.DayLow,
            LastUpdated = data.LastUpdateTime?.ToString("yyyy-MM-dd HH:mm"),
            EmaFast = data.Ema10,
            EmaMedium = data.Ema20,
            EmaFastLabel = L[RK.Vix.Ema10],
            EmaMediumLabel = L[RK.Vix.Ema20],
            Trend = data.Ema10.HasValue && data.Ema20.HasValue
                ? data.Ema10 > data.Ema20 ? "Up" : "Down"
                : null,
            Momentum3D = data.Momentum3D,
            Momentum5D = data.Momentum5D,
            Regime = data.Regime,
            Percentile = (decimal)data.Percentile,
            IsSpike = data.IsSpike
        };
    }

    private MarketAnalysisCardDto CreateVnIndexCard()
    {
        var data = _marketDashboard!.VnIndex!;
        return new MarketAnalysisCardDto
        {
            Title = L[RK.VnIndexAnalysis.Title],
            Symbol = data.Symbol,
            Success = data.Success,
            Message = data.Message,
            Price = data.Close,
            PreviousClose = data.PreviousClose,
            Change = data.Change,
            ChangePct = data.ChangePct,
            Open = data.Open,
            High = data.High,
            Low = data.Low,
            Volume = data.Volume,
            HistoryCount = data.HistoryCount,
            LastUpdated = data.LatestTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
            EmaFast = data.Ema9,
            EmaMedium = data.Ema21,
            EmaSlow = data.Ema50,
            EmaFastLabel = L[RK.GoldMarket.Ema9],
            EmaMediumLabel = L[RK.GoldMarket.Ema21],
            EmaSlowLabel = L[RK.GoldMarket.Ema50],
            EmaFastLabel = L[RK.BitcoinMarket.Ema9],
            EmaMediumLabel = L[RK.BitcoinMarket.Ema21],
            EmaSlowLabel = L[RK.BitcoinMarket.Ema50],
            Rsi14 = data.Rsi14,
            Atr14 = data.Atr14,
            AverageVolume20 = data.AverageVolume20,
            HighestHigh20 = data.HighestHigh20,
            LowestLow20 = data.LowestLow20,
            Trend = data.Trend,
            Momentum = data.Momentum,
            Setup = data.Setup,
            Signal = data.Signal,
            Confidence = data.Confidence,
            Entry = data.Entry,
            StopLoss = data.StopLoss,
            TakeProfit1 = data.TakeProfit1,
            TakeProfit2 = data.TakeProfit2
        };
    }

    private MarketAnalysisCardDto CreateBitcoinCard()
    {
        var data = _marketDashboard!.Bitcoin!;
        return new MarketAnalysisCardDto
        {
            Title = L[RK.BitcoinMarket.Title],
            Symbol = data.Symbol,
            Success = data.Success,
            Message = data.Message,
            Price = data.Price,
            Change = data.Change,
            ChangePct = data.ChangePct,
            PreviousClose = data.PreviousClose,
            Open = data.Open,
            High = data.High,
            Low = data.Low,
            Volume = data.Volume,
            QuoteVolume = data.QuoteVolume,
            HistoryCount = data.HistoryCount,
            LastUpdated = data.LastUpdated,
            EmaFast = data.Ema9,
            EmaMedium = data.Ema21,
            EmaSlow = data.Ema50,
            Rsi14 = data.Rsi14,
            Atr14 = data.Atr14,
            AverageVolume20 = data.AverageVolume20,
            HighestHigh20 = data.HighestHigh20,
            LowestLow20 = data.LowestLow20,
            Trend = data.Trend,
            Momentum = data.Momentum,
            Setup = data.Setup,
            Signal = data.Signal,
            Confidence = data.Confidence,
            Entry = data.Entry,
            StopLoss = data.StopLoss,
            TakeProfit1 = data.TakeProfit1,
            TakeProfit2 = data.TakeProfit2,
            History = data.History.Select(candle => new MarketAnalysisCandleDto
            {
                DateLabel = candle.DateLabel,
                Close = candle.Close
            }).ToList()
        };
    }

    private MarketAnalysisCardDto CreateGoldCard()
    {
        var data = _marketDashboard!.Gold!;
        return new MarketAnalysisCardDto
        {
            Title = L[RK.GoldMarket.Title],
            Symbol = data.Symbol,
            Success = data.Success,
            Message = data.Message,
            Price = data.Price,
            Change = data.Change,
            ChangePct = data.ChangePct,
            PreviousClose = data.PreviousClose,
            Open = data.BopPrice,
            High = data.High,
            Low = data.Low,
            Volume = data.Volume,
            QuoteVolume = data.QuoteVolume,
            HistoryCount = data.HistoryCount,
            LastUpdated = data.LastUpdated,
            EmaFast = data.Ema9,
            EmaMedium = data.Ema21,
            EmaSlow = data.Ema50,
            Rsi14 = data.Rsi14,
            Atr14 = data.Atr14,
            AverageVolume20 = data.AverageVolume20,
            HighestHigh20 = data.HighestHigh20,
            LowestLow20 = data.LowestLow20,
            Trend = data.Trend,
            Momentum = data.Momentum,
            Setup = data.Setup,
            Signal = data.Signal,
            Confidence = data.Confidence,
            Entry = data.Entry,
            StopLoss = data.StopLoss,
            TakeProfit1 = data.TakeProfit1,
            TakeProfit2 = data.TakeProfit2,
            History = data.History.Select(candle => new MarketAnalysisCandleDto
            {
                DateLabel = candle.DateLabel,
                Close = candle.Close
            }).ToList()
        };
    }

    private async Task GetAiAssessmentAsync()
    {
        var vix = _marketDashboard?.Vix;
        var vnIndex = _marketDashboard?.VnIndex;
        var bitcoin = _marketDashboard?.Bitcoin;
        var gold = _marketDashboard?.Gold;

        if (vix is not { Success: true } || vnIndex is not { Success: true } ||
            bitcoin is not { Success: true } || gold is not { Success: true } || _isLoadingAiAssessment)
            return;

        _isLoadingAiAssessment = true;
        _aiAssessment = null;
        _aiAssessmentError = null;
        try
        {
            _aiAssessment = await ExternalDataService.GetCombinedMarketAssessmentAsync(new CombinedMarketAssessmentRequestDto
            {
                Vix = new GetVixVerdictRequest
                {
                    Symbol = vix.Symbol,
                    CurrentValue = vix.CurrentValue,
                    Ema10 = vix.Ema10,
                    Ema20 = vix.Ema20,
                    Momentum3D = vix.Momentum3D,
                    Momentum5D = vix.Momentum5D,
                    Percentile = vix.Percentile,
                    IsSpike = vix.IsSpike,
                    Regime = vix.Regime
                },
                VnIndex = new GetVnIndexVerdictRequestDto
                {
                    Symbol = vnIndex.Symbol,
                    Close = vnIndex.Close,
                    Ema9 = vnIndex.Ema9,
                    Ema21 = vnIndex.Ema21,
                    Ema50 = vnIndex.Ema50,
                    Rsi14 = vnIndex.Rsi14,
                    Atr14 = vnIndex.Atr14,
                    AverageVolume20 = vnIndex.AverageVolume20,
                    HighestHigh20 = vnIndex.HighestHigh20,
                    LowestLow20 = vnIndex.LowestLow20,
                    Trend = vnIndex.Trend,
                    Momentum = vnIndex.Momentum,
                    Setup = vnIndex.Setup,
                    Signal = vnIndex.Signal,
                    Confidence = vnIndex.Confidence,
                    HistoryCount = vnIndex.HistoryCount
                },
                Bitcoin = new GetBitcoinMarketAssessmentRequestDto
                {
                    Symbol = bitcoin.Symbol,
                    Price = bitcoin.Price,
                    ChangePct = bitcoin.ChangePct,
                    Ema9 = bitcoin.Ema9,
                    Ema21 = bitcoin.Ema21,
                    Ema50 = bitcoin.Ema50,
                    Rsi14 = bitcoin.Rsi14,
                    Atr14 = bitcoin.Atr14,
                    AverageVolume20 = bitcoin.AverageVolume20,
                    HighestHigh20 = bitcoin.HighestHigh20,
                    LowestLow20 = bitcoin.LowestLow20,
                    Trend = bitcoin.Trend,
                    Momentum = bitcoin.Momentum,
                    Setup = bitcoin.Setup,
                    Signal = bitcoin.Signal,
                    Confidence = bitcoin.Confidence,
                    HistoryCount = bitcoin.HistoryCount,
                    Entry = bitcoin.Entry,
                    StopLoss = bitcoin.StopLoss,
                    TakeProfit1 = bitcoin.TakeProfit1,
                    TakeProfit2 = bitcoin.TakeProfit2
                },
                Gold = new GetGoldMarketAssessmentRequestDto
                {
                    Symbol = gold.Symbol,
                    Price = gold.Price,
                    ChangePct = gold.ChangePct,
                    Ema9 = gold.Ema9,
                    Ema21 = gold.Ema21,
                    Ema50 = gold.Ema50,
                    Rsi14 = gold.Rsi14,
                    Atr14 = gold.Atr14,
                    AverageVolume20 = gold.AverageVolume20,
                    HighestHigh20 = gold.HighestHigh20,
                    LowestLow20 = gold.LowestLow20,
                    Trend = gold.Trend,
                    Momentum = gold.Momentum,
                    Setup = gold.Setup,
                    Signal = gold.Signal,
                    Confidence = gold.Confidence,
                    HistoryCount = gold.HistoryCount,
                    Entry = gold.Entry,
                    StopLoss = gold.StopLoss,
                    TakeProfit1 = gold.TakeProfit1,
                    TakeProfit2 = gold.TakeProfit2
                }
            });
        }
        catch
        {
            _aiAssessmentError = L[RK.Vix.AiAssessmentLoadFailed];
        }
        finally
        {
            _isLoadingAiAssessment = false;
        }
    }
}
