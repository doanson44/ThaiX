@page "/admin/json-bins"
@attribute [Authorize(Policy = PermissionNames.JsonBinRead)]
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.JsonBins
@using ThaiX.Client.Services.Api
@using ThaiX.Client.Services.JsonBins
@inject IJsonBinService JsonBinService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<PageTitle>@L[RK.JsonBins.Title] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <div>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" Class="mb-0">
                            @L[RK.JsonBins.Title]
                        </RadzenText>
                        <RadzenText Class="text-muted">@L[RK.JsonBins.ListTitle]</RadzenText>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <ResponsiveIconButton Text="@L[RK.Common.Refresh]"
                                              Icon="refresh"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@ReloadAsync" />
                        @if (_canWrite)
                        {
                            <ResponsiveIconButton Text="@L[RK.JsonBins.Create]"
                                                  Icon="add"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Click="@(() => Navigation.NavigateTo("/admin/json-bins/create"))" />
                        }
                    </div>
                </RadzenStack>

                <RadzenRow Gap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.Common.Search]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_search"
                                           Placeholder="@L[RK.JsonBins.SearchPlaceholder]"
                                           Change="@(_ => ApplySearchAsync())" />
                            <InputGroupSearchButton Click="@ApplySearchAsync" />
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.Body1 : TextStyle.H6)" Class="mb-0">
                        @L[RK.JsonBins.ListTitle]
                    </RadzenText>
                    <RadzenBadge Text="@_total.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>

                @if (!Viewport.IsMobile)
                {
                    <RadzenDataGrid @ref="_grid"
                                    TItem="JsonBinListItemModel"
                                    Data="@_items"
                                    Count="@_total"
                                    LoadData="@OnLoadData"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    PageSize="@_pageSize"
                                    PageSizeOptions="@PageSizeOptions"
                                    ShowPagingSummary="true"
                                    Density="Density.Compact"
                                    IsLoading="@_isLoading">
                        <Columns>
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Property="Code" Title="@L[RK.JsonBins.Code]" />
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Property="Name" Title="@L[RK.JsonBins.Name]" />
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Property="Category" Title="@L[RK.JsonBins.Category]" Width="100px" />
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Property="SizeBytes" Title="@L[RK.JsonBins.Size]" Width="110px">
                                <Template Context="row">@FormatSize(row.SizeBytes)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Property="ExpiredAtUtc" Title="@L[RK.JsonBins.Expires]" Width="160px">
                                <Template Context="row">
                                    @(row.ExpiredAtUtc?.ToString("u") ?? "—")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="JsonBinListItemModel" Title="@L[RK.JsonBins.Actions]" Sortable="false" Filterable="false" Width="120px">
                                <Template Context="row">
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (_canWrite)
                                        {
                                            <RadzenButton Icon="edit"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small"
                                                          title="@L[RK.JsonBins.Edit]"
                                                          Click="@(() => Navigation.NavigateTo($"/admin/json-bins/{row.Id}"))" />
                                            <RadzenButton Icon="delete"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Size="ButtonSize.Small"
                                                          title="@L[RK.Common.Delete]"
                                                          Click="@(() => ConfirmDeleteAsync(row))" />
                                        }
                                        else
                                        {
                                            <RadzenButton Icon="visibility"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small"
                                                          title="@L[RK.Common.View]"
                                                          Click="@(() => Navigation.NavigateTo($"/admin/json-bins/{row.Id}"))" />
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }

                @if (Viewport.IsMobile)
                {
                    <RadzenStack Gap="0.75rem">
                        @if (_isLoading)
                        {
                            <RadzenText>@L[RK.Common.Loading]</RadzenText>
                        }
                        else if (_items.Count == 0)
                        {
                            <RadzenText Class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
                        }
                        else
                        {
                            @foreach (var row in _items)
                            {
                                <RadzenCard Class="p-3">
                                    <RadzenStack Gap="0.5rem">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" Class="mb-0 text-break">@row.Name</RadzenText>
                                            <RadzenBadge Text="@row.Category.ToString()" BadgeStyle="BadgeStyle.Info" />
                                        </div>
                                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0 text-break">
                                            @L[RK.JsonBins.Code]: @row.Code
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">
                                            @L[RK.JsonBins.Size]: @FormatSize(row.SizeBytes)
                                            @if (row.ExpiredAtUtc.HasValue)
                                            {
                                                <span> · @L[RK.JsonBins.Expires]: @row.ExpiredAtUtc.Value.ToString("u")</span>
                                            }
                                        </RadzenText>
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (_canWrite)
                                            {
                                                <ResponsiveIconButton Text="@L[RK.JsonBins.Edit]"
                                                                      Icon="edit"
                                                                      ButtonStyle="ButtonStyle.Primary"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => Navigation.NavigateTo($"/admin/json-bins/{row.Id}"))" />
                                                <ResponsiveIconButton Text="@L[RK.Common.Delete]"
                                                                      Icon="delete"
                                                                      ButtonStyle="ButtonStyle.Danger"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => ConfirmDeleteAsync(row))" />
                                            }
                                            else
                                            {
                                                <ResponsiveIconButton Text="@L[RK.Common.View]"
                                                                      Icon="visibility"
                                                                      ButtonStyle="ButtonStyle.Light"
                                                                      Size="ButtonSize.Small"
                                                                      Click="@(() => Navigation.NavigateTo($"/admin/json-bins/{row.Id}"))" />
                                            }
                                        </div>
                                    </RadzenStack>
                                </RadzenCard>
                            }
                        }

                        <AdminListPager TotalCount="@_total"
                                        PageSize="@_pageSize"
                                        CurrentPage="@_pageNumber"
                                        CurrentPageChanged="@GoToPageAsync"
                                        Disabled="@_isLoading" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
</div>

@code {
    private const int DefaultPageSize = 10;
    private static readonly IEnumerable<int> PageSizeOptions = new[] { 10, 20, 50 };

    private RadzenDataGrid<JsonBinListItemModel>? _grid;
    private IReadOnlyList<JsonBinListItemModel> _items = Array.Empty<JsonBinListItemModel>();
    private int _total;
    private int _pageSize = DefaultPageSize;
    private int _pageNumber = 1;
    private string? _search;
    private bool _isLoading;
    private bool _canWrite;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.JsonBinWrite);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (Viewport.IsMobile)
            await LoadAsync();
        else if (_grid is not null)
            await _grid.Reload();
        else
            await LoadAsync();
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        _pageSize = args.Top is > 0 ? args.Top.Value : _pageSize;
        _pageNumber = (_pageSize <= 0 ? 1 : (args.Skip ?? 0) / _pageSize) + 1;
        await LoadAsync();
    }

    private async Task ApplySearchAsync()
    {
        _pageNumber = 1;
        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadAsync();
    }

    private async Task ReloadAsync() => await ApplySearchAsync();

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = page < 1 ? 1 : page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var result = await JsonBinService.SearchAsync(new JsonBinSearchRequest
            {
                PageNumber = _pageNumber,
                PageSize = _pageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim()
            });
            _items = result.Data?.ToList() ?? [];
            _total = result.Metadata.TotalCount;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.JsonBins.LoadFailed], ex.GetDisplayDetail());
            _items = [];
            _total = 0;
        }
        finally
        {
            _isLoading = false;
            if (Viewport.IsMobile)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmDeleteAsync(JsonBinListItemModel row)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.JsonBins.ConfirmDelete]);
        if (confirmed != true)
            return;

        try
        {
            await JsonBinService.DeleteAsync(row.Id);
            NotificationService.NotifySuccess(L[RK.JsonBins.DeleteSuccess]);
            if (!Viewport.IsMobile && _grid is not null)
                await _grid.Reload();
            else
                await LoadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.JsonBins.DeleteFailed], ex.GetDisplayDetail());
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes / (1024d * 1024d):0.#} MB"
    };
}
