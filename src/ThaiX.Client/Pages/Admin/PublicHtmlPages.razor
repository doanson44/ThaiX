@page "/admin/public-html"
@attribute [Authorize(Policy = PermissionNames.FileRead)]
@using Microsoft.AspNetCore.Components.Forms
@using ThaiX.Client.Constants
@using ThaiX.Client.Models.PublicHtml
@using ThaiX.Client.Services.PublicHtml
@using RK = ThaiX.Client.Constants.ResourceKeys
@inherits ThaiXPageBase
@inject IPublicHtmlPageService PublicHtmlService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L[RK.PublicHtmlPages.Title] - ThaiX</PageTitle>

<div class="container-fluid py-3">
    <RadzenStack Gap="1.25rem">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H5 : TextStyle.H3)" TagName="TagName.H1" Class="mb-1">
                    @L[RK.PublicHtmlPages.Title]
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-0">@L[RK.PublicHtmlPages.Description]</RadzenText>
            </div>
            @if (_canWrite)
            {
                <RadzenButton Text="@L[RK.PublicHtmlPages.Upload]"
                              Icon="upload_file"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@OpenUploadDialogAsync" />
            }
        </div>

        @if (!_isLoading || _pages.Count > 0)
        {
            <RadzenRow Gap="0.75rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Class="h-100">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <div class="rounded p-2 bg-secondary bg-opacity-10">
                                <RadzenIcon Icon="description" IconStyle="IconStyle.Secondary" Style="font-size: 1.5rem;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-1">@L[RK.PublicHtmlPages.TotalPages]</RadzenText>
                                <RadzenText TextStyle="TextStyle.H4" Class="mb-0">@_pages.Count</RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Class="h-100">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <div class="rounded p-2 bg-success bg-opacity-10">
                                <RadzenIcon Icon="public" IconStyle="IconStyle.Success" Style="font-size: 1.5rem;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-1">@L[RK.PublicHtmlPages.PublishedCount]</RadzenText>
                                <RadzenText TextStyle="TextStyle.H4" Class="mb-0">@(_pages.Count(page => page.IsPublished))</RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenCard Class="h-100">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                            <div class="rounded p-2 bg-warning bg-opacity-10">
                                <RadzenIcon Icon="visibility_off" IconStyle="IconStyle.Warning" Style="font-size: 1.5rem;" />
                            </div>
                            <div>
                                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-1">@L[RK.PublicHtmlPages.UnpublishedCount]</RadzenText>
                                <RadzenText TextStyle="TextStyle.H4" Class="mb-0">@(_pages.Count(page => !page.IsPublished))</RadzenText>
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        }

        @if (_isLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
        }
        else
        {
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="@L[RK.Common.Search]" Class="w-100">
                                <RadzenTextBox @bind-Value="_searchTerm" Placeholder="@L[RK.PublicHtmlPages.SearchPlaceholder]" Class="w-100" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L[RK.PublicHtmlPages.Status]" Class="w-100">
                                <RadzenDropDown TValue="string" Data="@StatusFilterOptions" TextProperty="Text" ValueProperty="Value"
                                                @bind-Value="_statusFilter" Class="w-100" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    @if (_pages.Count == 0)
                    {
                        <div class="py-4 text-center">
                            <RadzenIcon Icon="description" IconStyle="IconStyle.Secondary" Style="font-size: 2.5rem;" />
                            <RadzenText TextStyle="TextStyle.Body1" Class="mt-2 mb-0">@L[RK.PublicHtmlPages.NoPages]</RadzenText>
                        </div>
                    }
                    else if (!FilteredPages.Any())
                    {
                        <div class="py-4 text-center">
                            <RadzenIcon Icon="search_off" IconStyle="IconStyle.Secondary" Style="font-size: 2.5rem;" />
                            <RadzenText TextStyle="TextStyle.Body1" Class="mt-2 mb-0">@L[RK.PublicHtmlPages.NoFilteredPages]</RadzenText>
                        </div>
                    }
                    else if (!Viewport.IsDesktop)
                    {
                        <RadzenStack Gap="0.75rem">
                            <Virtualize Items="@FilteredPages.ToList()" Context="item" OverscanCount="5">
                                <RadzenCard Class="p-3">
                                    <RadzenStack Gap="0.75rem">
                                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <RadzenIcon Icon="description" IconStyle="IconStyle.Secondary" />
                                                <RadzenText TextStyle="TextStyle.Subtitle1" Class="mb-0 text-break">@item.Title</RadzenText>
                                            </div>
                                            <RadzenBadge Text="@(item.IsPublished ? L[RK.PublicHtmlPages.Published].Value : L[RK.PublicHtmlPages.Unpublished].Value)"
                                                         BadgeStyle="@(item.IsPublished ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                                        </div>
                                        <div>
                                            <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-1">@L[RK.PublicHtmlPages.Slug]</RadzenText>
                                            @if (_editingSlugId == item.Id && _canWrite)
                                            {
                                                <RadzenTextBox @bind-Value="item.EditSlug" Class="w-100" MaxLength="80" />
                                                <div class="d-flex flex-wrap gap-2 mt-2">
                                                    <RadzenButton Text="@L[RK.PublicHtmlPages.Rename]" Icon="check" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                                  Disabled="@(_busyPageIds.Contains(item.Id) || string.IsNullOrWhiteSpace(item.EditSlug) || item.EditSlug == item.Slug)"
                                                                  Click="@(() => RenameAsync(item))" />
                                                    <RadzenButton Text="@L[RK.Common.Cancel]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                  Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => CancelRename(item))" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <span class="text-break">@item.Slug</span>
                                                    @if (_canWrite)
                                                    {
                                                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                                      Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => BeginRename(item))" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-3">
                                            <div>
                                                <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@L[RK.PublicHtmlPages.Size]</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" Class="mb-0">@item.SizeBytes.ToString("N0") @L[RK.PublicHtmlPages.Bytes]</RadzenText>
                                            </div>
                                            <div>
                                                <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@L[RK.PublicHtmlPages.Created]</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" Class="mb-0">@item.CreatedAtUtc.ToLocalTime().ToString("g")</RadzenText>
                                            </div>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            @if (item.IsPublished)
                                            {
                                                <RadzenButton Text="@L[RK.PublicHtmlPages.View]" Icon="open_in_new" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                              Click="@(() => Navigation.NavigateTo($"/html/{Uri.EscapeDataString(item.Slug)}", true))" />
                                            }
                                            @if (_canWrite)
                                            {
                                                <RadzenButton Text="@(item.IsPublished ? L[RK.PublicHtmlPages.Unpublish].Value : L[RK.PublicHtmlPages.Publish].Value)"
                                                              Icon="@(item.IsPublished ? "visibility_off" : "publish")" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                              Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => TogglePublishedAsync(item))" />
                                            }
                                            @if (_canDelete)
                                            {
                                                <RadzenButton Text="@L[RK.PublicHtmlPages.Delete]" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                              Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => DeleteAsync(item))" />
                                            }
                                        </div>
                                    </RadzenStack>
                                </RadzenCard>
                            </Virtualize>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenDataGrid TItem="PublicHtmlPageModel" Data="@FilteredPages" AllowPaging="true" PageSize="10"
                                        PageSizeOptions="@_pageSizeOptions" ShowPagingSummary="true" Responsive="true">
                            <Columns>
                                <RadzenDataGridColumn TItem="PublicHtmlPageModel" Property="Title" Title="@L[RK.PublicHtmlPages.PageTitle]">
                                    <Template Context="item">
                                        <div class="d-flex align-items-center gap-2">
                                            <RadzenIcon Icon="description" IconStyle="IconStyle.Secondary" />
                                            <div>
                                                <div class="fw-semibold text-break">@item.Title</div>
                                                <div class="small text-muted">/html/@item.Slug</div>
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PublicHtmlPageModel" Title="@L[RK.PublicHtmlPages.Slug]">
                                    <Template Context="item">
                                        @if (_editingSlugId == item.Id && _canWrite)
                                        {
                                            <RadzenStack Gap="0.35rem">
                                                <RadzenTextBox @bind-Value="item.EditSlug" Class="w-100" MaxLength="80" />
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                                    <RadzenButton Text="@L[RK.PublicHtmlPages.Rename]" Icon="check" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                                  Disabled="@(_busyPageIds.Contains(item.Id) || string.IsNullOrWhiteSpace(item.EditSlug) || item.EditSlug == item.Slug)"
                                                                  Click="@(() => RenameAsync(item))" />
                                                    <RadzenButton Text="@L[RK.Common.Cancel]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                  Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => CancelRename(item))" />
                                                </RadzenStack>
                                            </RadzenStack>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-break">@item.Slug</span>
                                                @if (_canWrite)
                                                {
                                                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                                                  Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => BeginRename(item))" />
                                                }
                                            </div>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PublicHtmlPageModel" Title="@L[RK.PublicHtmlPages.Size]" Width="110px">
                                    <Template Context="item">@item.SizeBytes.ToString("N0") @L[RK.PublicHtmlPages.Bytes]</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PublicHtmlPageModel" Title="@L[RK.PublicHtmlPages.Created]" Width="165px">
                                    <Template Context="item">@item.CreatedAtUtc.ToLocalTime().ToString("g")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PublicHtmlPageModel" Title="@L[RK.PublicHtmlPages.Actions]" Width="250px">
                                    <Template Context="item">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                            @if (item.IsPublished)
                                            {
                                                <RadzenButton Icon="open_in_new" Text="@L[RK.PublicHtmlPages.View]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                              Click="@(() => Navigation.NavigateTo($"/html/{Uri.EscapeDataString(item.Slug)}", true))" />
                                            }
                                            @if (_canWrite)
                                            {
                                                <RadzenButton Icon="@(item.IsPublished ? "visibility_off" : "publish")"
                                                              Text="@(item.IsPublished ? L[RK.PublicHtmlPages.Unpublish].Value : L[RK.PublicHtmlPages.Publish].Value)"
                                                              Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@_busyPageIds.Contains(item.Id)"
                                                              Click="@(() => TogglePublishedAsync(item))" />
                                            }
                                            @if (_canDelete)
                                            {
                                                <RadzenButton Icon="delete" Text="@L[RK.PublicHtmlPages.Delete]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                              Disabled="@_busyPageIds.Contains(item.Id)" Click="@(() => DeleteAsync(item))" />
                                            }
                                        </RadzenStack>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
</div>

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50];

    private List<PublicHtmlPageModel> _pages = [];
    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private Guid? _editingSlugId;
    private bool _isLoading = true;
    private bool _canWrite;
    private bool _canDelete;
    private readonly HashSet<Guid> _busyPageIds = [];

    private IEnumerable<PublicHtmlPageModel> FilteredPages =>
        _pages.Where(page =>
            (string.IsNullOrWhiteSpace(_searchTerm)
                || page.Title.Contains(_searchTerm.Trim(), StringComparison.OrdinalIgnoreCase)
                || page.Slug.Contains(_searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
            && (_statusFilter == "all"
                || (_statusFilter == "published" && page.IsPublished)
                || (_statusFilter == "unpublished" && !page.IsPublished)));

    private IEnumerable<StatusFilterOption> StatusFilterOptions =>
    [
        new("all", L[RK.PublicHtmlPages.AllStatuses].Value),
        new("published", L[RK.PublicHtmlPages.Published].Value),
        new("unpublished", L[RK.PublicHtmlPages.Unpublished].Value)
    ];

    private sealed record StatusFilterOption(string Value, string Text);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canWrite = authState.User.HasClaim("scope", PermissionNames.FileWrite);
        _canDelete = authState.User.HasClaim("scope", PermissionNames.FileDelete);
        await LoadAsync();
    }

    private void BeginRename(PublicHtmlPageModel page)
    {
        _editingSlugId = page.Id;
        page.EditSlug = page.Slug;
    }

    private void CancelRename(PublicHtmlPageModel page)
    {
        page.EditSlug = page.Slug;
        _editingSlugId = null;
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var pages = await PublicHtmlService.GetAllAsync();
            foreach (var page in pages)
                page.EditSlug = page.Slug;
            _pages = pages.ToList();
        }
        catch
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.PublicHtmlPages.LoadFailed]);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenUploadDialogAsync()
    {
        var result = await DialogService.OpenAsync<ThaiX.Client.Components.Administration.PublicHtmlUploadDialog>(
            L[RK.PublicHtmlPages.Upload].Value,
            options: new DialogOptions
            {
                Width = "min(600px, 95vw)",
                CloseDialogOnOverlayClick = false
            });

        if (result is true)
            await LoadAsync();
    }

    private async Task RenameAsync(PublicHtmlPageModel page)
    {
        _busyPageIds.Add(page.Id);
        try
        {
            await PublicHtmlService.RenameAsync(page.Id, page.EditSlug.Trim());
            _editingSlugId = null;
            NotificationService.Notify(NotificationSeverity.Success, L[RK.PublicHtmlPages.RenameSuccess]);
            await LoadAsync();
        }
        catch
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.PublicHtmlPages.RenameFailed]);
        }
        finally
        {
            _busyPageIds.Remove(page.Id);
        }
    }

    private async Task TogglePublishedAsync(PublicHtmlPageModel page)
    {
        _busyPageIds.Add(page.Id);
        try
        {
            await PublicHtmlService.SetPublishedAsync(page.Id, !page.IsPublished);
            await LoadAsync();
        }
        catch
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.PublicHtmlPages.PublishFailed]);
        }
        finally
        {
            _busyPageIds.Remove(page.Id);
        }
    }

    private async Task DeleteAsync(PublicHtmlPageModel page)
    {
        var confirmed = await DialogService.Confirm(
            L[RK.PublicHtmlPages.DeleteConfirm],
            L[RK.PublicHtmlPages.Delete],
            new ConfirmOptions
            {
                OkButtonText = L[RK.PublicHtmlPages.Delete],
                CancelButtonText = L[RK.Common.Cancel]
            });
        if (confirmed != true)
            return;

        _busyPageIds.Add(page.Id);
        try
        {
            await PublicHtmlService.DeleteAsync(page.Id);
            NotificationService.Notify(NotificationSeverity.Success, L[RK.PublicHtmlPages.DeleteSuccess]);
            await LoadAsync();
        }
        catch
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.PublicHtmlPages.DeleteFailed]);
        }
        finally
        {
            _busyPageIds.Remove(page.Id);
        }
    }

    private static string Slugify(string value)
    {
        var chars = value.Trim().ToLowerInvariant()
            .Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-')
            .ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }
}
