@page "/admin/blog/posts"
@attribute [Authorize(Policy = PermissionNames.BlogRead)]
@using Microsoft.AspNetCore.Components.Authorization
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.Blog
@using ThaiX.Client.Services.Blog
@using ThaiX.Client.Services.Api
@inject IBlogService BlogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<PageTitle>@L[RK.Blog.Posts.Title] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" class="mb-0">@L[RK.Blog.Posts.Title]</RadzenText>
                    @if (_canWrite)
                    {
                        <ResponsiveIconButton Text="@L[RK.Blog.Posts.New]"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => Navigation.NavigateTo("/admin/blog/posts/new"))" />
                    }
                </RadzenStack>

                <RadzenRow Gap="0.75rem" RowGap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.Common.Search]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_searchTerm"
                                           Placeholder="@L[RK.Blog.Posts.SearchPlaceholder]"
                                           Change="@(_ => ReloadAsync())" />
                            <InputGroupSearchButton Click="@ReloadAsync" />
                        </div>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenDropDown TValue="string"
                                        @bind-Value="_statusFilter"
                                        Data="@_statusOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        class="w-100"
                                        Change="@(_ => ReloadAsync())" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenDropDown TValue="Guid?"
                                        @bind-Value="_categoryFilter"
                                        Data="@_categories"
                                        TextProperty="Name"
                                        ValueProperty="Id"
                                        AllowClear="true"
                                        Placeholder="@L[RK.Blog.Posts.ColumnCategory]"
                                        class="w-100"
                                        Change="@(_ => ReloadAsync())" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            @if (!Viewport.IsMobile)
            {
                <RadzenDataGrid @ref="_grid"
                                TItem="PostListItemDto"
                                Data="@_items"
                                Count="@_totalCount"
                                LoadData="@LoadDataAsync"
                                AllowPaging="true"
                                AllowSorting="true"
                                PageSize="@DefaultPageSize"
                                PageSizeOptions="@PageSizeOptions"
                                ShowPagingSummary="true"
                                Density="Density.Compact"
                                IsLoading="@_isLoading">
                    <Columns>
                        <RadzenDataGridColumn TItem="PostListItemDto" Property="Title" Title="@L[RK.Blog.Posts.ColumnTitle]">
                            <Template Context="item">
                                <a href="javascript:void(0)" @onclick="@(() => Navigation.NavigateTo($"/admin/blog/posts/{item.Id}"))">@item.Title</a>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PostListItemDto" Title="@L[RK.Blog.Posts.ColumnStatus]" Width="130px">
                            <Template Context="item">
                                <RadzenBadge Text="@StatusLabel(item.Status)" BadgeStyle="@StatusBadgeStyle(item.Status)" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PostListItemDto" Property="CategoryName" Title="@L[RK.Blog.Posts.ColumnCategory]" />
                        <RadzenDataGridColumn TItem="PostListItemDto" Title="@L[RK.Blog.Posts.ColumnPublishedAt]" Width="150px">
                            <Template Context="item">
                                @((item.PublishedAt ?? item.ScheduledAt)?.ToString("g"))
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PostListItemDto" Property="ReadTimeMinutes" Title="@L[RK.Blog.Posts.ColumnReadTime]" Width="90px" />
                        @if (_canWrite)
                        {
                            <RadzenDataGridColumn TItem="PostListItemDto" Title="" Width="220px" Sortable="false" Filterable="false">
                                <Template Context="item">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Click="@(() => Navigation.NavigateTo($"/admin/blog/posts/{item.Id}"))" />
                                        <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Click="@(() => DuplicateAsync(item))" />
                                        @if (item.Status is "Draft" or "Scheduled")
                                        {
                                            <RadzenButton Icon="publish" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                          Click="@(() => PublishAsync(item))" />
                                        }
                                        @if (item.Status is "Published" or "Scheduled")
                                        {
                                            <RadzenButton Icon="unpublished" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                          Click="@(() => UnpublishAsync(item))" />
                                        }
                                        @if (_canDelete)
                                        {
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                          Click="@(() => DeleteAsync(item))" />
                                        }
                                    </RadzenStack>
                                </Template>
                            </RadzenDataGridColumn>
                        }
                    </Columns>
                </RadzenDataGrid>
            
            }

            @if (Viewport.IsMobile)
            {
                <RadzenStack Gap="0.75rem">
                    @if (_isLoading)
                    {
                        <RadzenText>@L[RK.Common.Loading]</RadzenText>
                    }
                    else if (_items.Count == 0)
                    {
                        <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
                    }
                    else
                    {
                        @foreach (var item in _items)
                        {
                            <RadzenCard class="p-3">
                                <RadzenStack Gap="0.5rem">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <a href="javascript:void(0)" @onclick="@(() => Navigation.NavigateTo($"/admin/blog/posts/{item.Id}"))">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">@item.Title</RadzenText>
                                        </a>
                                        <RadzenBadge Text="@StatusLabel(item.Status)" BadgeStyle="@StatusBadgeStyle(item.Status)" />
                                    </div>
                                    <RadzenText class="text-muted small mb-0">
                                        @PostSummaryLine(item)
                                    </RadzenText>
                                    @if (_canWrite)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          Click="@(() => Navigation.NavigateTo($"/admin/blog/posts/{item.Id}"))" />
                                            <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                          Click="@(() => DuplicateAsync(item))" />
                                            @if (item.Status is "Draft" or "Scheduled")
                                            {
                                                <RadzenButton Icon="publish" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                              Click="@(() => PublishAsync(item))" />
                                            }
                                            @if (item.Status is "Published" or "Scheduled")
                                            {
                                                <RadzenButton Icon="unpublished" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                              Click="@(() => UnpublishAsync(item))" />
                                            }
                                            @if (_canDelete)
                                            {
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                              Click="@(() => DeleteAsync(item))" />
                                            }
                                        </div>
                                    }
                                </RadzenStack>
                            </RadzenCard>
                        }
                    }

                    <AdminListPager TotalCount="@_totalCount"
                                    PageSize="@_pageSize"
                                    CurrentPage="@_currentPage"
                                    CurrentPageChanged="@GoToPageAsync"
                                    Disabled="@_isLoading" />
                </RadzenStack>
            
            }
        </RadzenCard>
    </RadzenStack>
</div>

@code {
    private const int DefaultPageSize = 10;
    private static readonly IEnumerable<int> PageSizeOptions = [10, 20, 50, 100];

    private RadzenDataGrid<PostListItemDto>? _grid;
    private IReadOnlyList<PostListItemDto> _items = [];
    private IReadOnlyList<CategoryDto> _categories = [];
    private int _totalCount;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private bool _isLoading;
    private bool _canWrite;
    private bool _canDelete;
    private bool _canPublish;
    private string? _searchTerm;
    private string _statusFilter = "";
    private Guid? _categoryFilter;

    private readonly List<StatusOption> _statusOptions =
    [
        new("", "All statuses"),
        new("Draft", "Draft"),
        new("Scheduled", "Scheduled"),
        new("Published", "Published"),
        new("Archived", "Archived")
    ];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.BlogWrite);
        _canDelete = user.HasClaim("scope", PermissionNames.BlogDelete);
        _canPublish = user.HasClaim("scope", PermissionNames.BlogPublish);

        _statusOptions[0] = new StatusOption("", L[RK.Blog.Posts.FilterAllStatuses]);
        _statusOptions[1] = new StatusOption("Draft", L[RK.Blog.Posts.StatusDraft]);
        _statusOptions[2] = new StatusOption("Scheduled", L[RK.Blog.Posts.StatusScheduled]);
        _statusOptions[3] = new StatusOption("Published", L[RK.Blog.Posts.StatusPublished]);
        _statusOptions[4] = new StatusOption("Archived", L[RK.Blog.Posts.StatusArchived]);

        try
        {
            _categories = await BlogService.GetCategoriesAsync();
        }
        catch (ApiException)
        {
            _categories = [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid is not null)
        {
            await _grid.Reload();
        }
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            _pageSize = args.Top ?? DefaultPageSize;
            _currentPage = _pageSize <= 0 ? 1 : ((args.Skip ?? 0) / _pageSize) + 1;
            var sort = args.Sorts?.FirstOrDefault();

            var result = await BlogService.GetPostsAsync(new PostsListRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                SortBy = sort?.Property,
                SortDescending = sort?.SortOrder == SortOrder.Descending,
                Status = string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
                CategoryId = _categoryFilter,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm
            });

            _items = result.Data ?? [];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Blog.Posts.LoadFailed], ex.GetDisplayDetail());
            _items = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        if (_grid is null) return;
        await _grid.Reload();
    }

    private async Task GoToPageAsync(int page)
    {
        if (_grid is null) return;
        await _grid.GoToPage(page - 1);
    }

    private async Task DuplicateAsync(PostListItemDto item)
    {
        try
        {
            var newId = await BlogService.DuplicatePostAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.Blog.Posts.ActionSuccess]);
            Navigation.NavigateTo($"/admin/blog/posts/{newId}");
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Blog.Posts.ActionFailed], ex.GetDisplayDetail());
        }
    }

    private async Task PublishAsync(PostListItemDto item)
    {
        if (!_canPublish) return;
        try
        {
            await BlogService.PublishPostAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.Blog.Posts.ActionSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Blog.Posts.ActionFailed], ex.GetDisplayDetail());
        }
    }

    private async Task UnpublishAsync(PostListItemDto item)
    {
        if (!_canPublish) return;
        try
        {
            await BlogService.UnpublishPostAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.Blog.Posts.ActionSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Blog.Posts.ActionFailed], ex.GetDisplayDetail());
        }
    }

    private async Task DeleteAsync(PostListItemDto item)
    {
        if (!_canDelete) return;

        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.Blog.Posts.ConfirmDeleteMessage]);

        if (confirmed != true) return;

        try
        {
            await BlogService.DeletePostAsync(item.Id);
            NotificationService.NotifySuccess(L[RK.Blog.Posts.ActionSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Blog.Posts.ActionFailed], ex.GetDisplayDetail());
        }
    }

    private string PostSummaryLine(PostListItemDto item)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.CategoryName)) parts.Add(item.CategoryName);
        var date = (item.PublishedAt ?? item.ScheduledAt)?.ToString("g");
        if (!string.IsNullOrWhiteSpace(date)) parts.Add(date);
        parts.Add($"{item.ReadTimeMinutes} {L[RK.Blog.Posts.ColumnReadTime]}");
        return string.Join(" | ", parts);
    }

    private string StatusLabel(string status) => status switch
    {
        "Draft" => L[RK.Blog.Posts.StatusDraft],
        "Scheduled" => L[RK.Blog.Posts.StatusScheduled],
        "Published" => L[RK.Blog.Posts.StatusPublished],
        "Archived" => L[RK.Blog.Posts.StatusArchived],
        _ => status
    };

    private static BadgeStyle StatusBadgeStyle(string status) => status switch
    {
        "Draft" => BadgeStyle.Light,
        "Scheduled" => BadgeStyle.Info,
        "Published" => BadgeStyle.Success,
        "Archived" => BadgeStyle.Warning,
        _ => BadgeStyle.Light
    };

    private sealed record StatusOption(string Value, string Text);
}
