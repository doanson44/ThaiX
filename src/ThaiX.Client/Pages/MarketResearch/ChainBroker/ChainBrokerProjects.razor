</RadzenCard>

@code {
    private List<ChainBrokerProjectDto> _all = [];
    private List<ChainBrokerProjectDto> _filtered = [];
    private List<ChainBrokerFundDto> _allFunds = [];
    private bool _isLoading;
    private string? _search;
    private string? _selectedFundId;
    private string? _sortKey;
    private bool _sortAscending = true;
    private bool _isSyncing;
    private bool _canSync;

    private IReadOnlyList<SortOption<ChainBrokerProjectDto>> SortOptions =>
    [
        new("rank",            L[RK.ChainBrokerProjects.ColRank],            x => x.Rank),
        new("name",            L[RK.ChainBrokerProjects.ColName],            x => x.Name),
        new("ticker",          L[RK.ChainBrokerProjects.ColTicker],          x => x.Ticker),
        new("currentPrice",    L[RK.ChainBrokerProjects.ColCurrentPrice],    x => x.CurrentPriceUsd),
        new("publicRoi",       L[RK.ChainBrokerProjects.ColPublicRoi],       x => x.PublicRoi),
        new("privateRoi",      L[RK.ChainBrokerProjects.ColPrivateRoi],      x => x.PrivateRoi),
        new("publicAthRoi",    L[RK.ChainBrokerProjects.ColPublicAthRoi],    x => x.PublicAthRoi),
        new("privateAthRoi",   L[RK.ChainBrokerProjects.ColPrivateAthRoi],   x => x.PrivateAthRoi),
        new("brokerScore",     L[RK.ChainBrokerProjects.ColBrokerScore],     x => x.BrokerScore),
        new("securityScore",   L[RK.ChainBrokerProjects.ColSecurityScore],   x => x.SecurityScore),
        new("marketCap",       L[RK.ChainBrokerProjects.ColMarketCap],       x => x.MarketCapUsd),
        new("volume24h",       L[RK.ChainBrokerProjects.ColVolume24h],       x => x.Volume24hUsd),
        new("priceChange24h",  L[RK.ChainBrokerProjects.ColPriceChange24h],  x => x.PriceChange24h),
        new("priceChange7d",   L[RK.ChainBrokerProjects.ColPriceChange7d],   x => x.PriceChange7d),
        new("priceChange30d",  L[RK.ChainBrokerProjects.ColPriceChange30d],  x => x.PriceChange30d),
        new("totalRaise",      L[RK.ChainBrokerProjects.ColTotalRaise],      x => x.TotalRaiseUsd),
        new("listingDate",     L[RK.ChainBrokerProjects.ColListingDate],     x => x.ListingDate),
        new("nextUnlockDate",  L[RK.ChainBrokerProjects.ColNextUnlockDate],  x => x.NextUnlockDate),
        new("fundCount",       L[RK.ChainBrokerProjects.ColFundCount],       x => x.FundCount),
    ];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canSync = auth.User.HasClaim("scope", PermissionNames.ChainBrokerDataSync);

        _isLoading = true;
        try
        {
            var response = await ExternalDataService.GetChainBrokerProjectsAsync();
            var fundsResponse = await ExternalDataService.GetChainBrokerFundsAsync();
            _all = response.Data ?? [];
            _allFunds = (fundsResponse.Data ?? []).OrderBy(f => f.Name ?? f.Slug).ToList();
            _filtered = _all;
        }
        catch
        {
            NotificationService.NotifyError(L[RK.ChainBrokerProjects.LoadFailed]);
            _all = [];
            _filtered = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<ChainBrokerProjectDto> result = _all;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            result = result.Where(x =>
                (x.Name != null && x.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
                || x.Slug.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (x.Ticker != null && x.Ticker.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrEmpty(_selectedFundId) && Guid.TryParse(_selectedFundId, out var fundId))
        {
            result = result.Where(x => x.Funds.Contains(fundId));
        }

        if (!string.IsNullOrEmpty(_sortKey))
        {
            var option = SortOptions.FirstOrDefault(o => o.Key == _sortKey);
            if (option is not null)
                result = _sortAscending
                    ? result.OrderBy(option.KeySelector)
                    : result.OrderByDescending(option.KeySelector);
        }

        _filtered = result.ToList();
    }

    private void OnSortKeyChanged(string? key)
    {
        _sortKey = key;
        ApplyFilter();
    }

    private void OnSortDirectionChanged(bool ascending)
    {
        _sortAscending = ascending;
        ApplyFilter();
    }

    private void OnFundFilterChanged(string? value)
    {
        _selectedFundId = value;
        ApplyFilter();
    }

    private Task<(IReadOnlyList<ChainBrokerFundDto>, int)> LoadFundsAsync(
        int page, int pageSize, string? search, CancellationToken _)
    {
        var filtered = string.IsNullOrWhiteSpace(search)
            ? _allFunds
            : _allFunds
                .Where(f => (f.Name ?? f.Slug).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

        IReadOnlyList<ChainBrokerFundDto> paged = filtered
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        return Task.FromResult((paged, filtered.Count));
    }

    private static string GetChangeClass(decimal? value) =>
        value switch
        {
            null => string.Empty,
            > 0 => "text-success fw-semibold",
            < 0 => "text-danger fw-semibold",
            _ => string.Empty
        };

    private static string FormatPercent(decimal? value)
    {
        if (value is null) return "-";
        var s = value.Value.ToString("0.##") + "%";
        return value > 0 ? $"+{s}" : s;
    }

    private static string FormatUsd(decimal? value)
    {
        if (value is null) return "-";
        if (value >= 1_000_000_000) return $"${value.Value / 1_000_000_000:0.##}B";
        if (value >= 1_000_000) return $"${value.Value / 1_000_000:0.##}M";
        if (value >= 1_000) return $"${value.Value / 1_000:0.##}K";
        return $"${value.Value:0.######}";
    }

    private static string FormatNumber(decimal? value)
    {
        if (value is null) return "-";
        return value.Value.ToString("N2");
    }

    private static string FormatDate(DateOnly? value)
    {
        return value?.ToString("yyyy-MM-dd") ?? "-";
    }

    private async Task OnSyncClickAsync()
    {
        var confirmed = await DialogService.Confirm(
            L[RK.ChainBrokerProjects.SyncConfirmMessage],
            L[RK.ChainBrokerProjects.SyncConfirmTitle],
            new ConfirmOptions { OkButtonText = L[RK.Common.Yes], CancelButtonText = L[RK.Common.Cancel] });

        if (confirmed != true) return;

        _isSyncing = true;
        try
        {
            await ExternalDataService.TriggerChainBrokerProjectsSyncAsync();
            NotificationService.NotifySuccess(L[RK.ChainBrokerProjects.SyncSuccess]);
        }
        catch
        {
            NotificationService.NotifyError(L[RK.ChainBrokerProjects.SyncFailed]);
        }
        finally
        {
            _isSyncing = false;
        }
    }

}
