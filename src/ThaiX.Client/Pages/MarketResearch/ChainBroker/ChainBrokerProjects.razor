                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="TotalRaiseUsd" Title="@L[RK.ChainBrokerProjects.ColTotalRaise]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.TotalRaiseUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PriceChange24h" Title="@L[RK.ChainBrokerProjects.ColPriceChange24h]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PriceChange24h)">@FormatPercent(item.PriceChange24h)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PriceChange7d" Title="@L[RK.ChainBrokerProjects.ColPriceChange7d]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PriceChange7d)">@FormatPercent(item.PriceChange7d)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PriceChange30d" Title="@L[RK.ChainBrokerProjects.ColPriceChange30d]" MinWidth="12.5rem">
                        <Template Context="item">
