                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PrivateRaiseUsd" Title="@L[RK.ChainBrokerProjects.ColPrivateRaise]" MinWidth="12.5rem">
                        <Template Context="item">
