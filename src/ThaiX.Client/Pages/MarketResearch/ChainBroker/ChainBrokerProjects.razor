                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PriceChange1y" Title="@L[RK.ChainBrokerProjects.ColPriceChange1y]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PriceChange1y)">@FormatPercent(item.PriceChange1y)</span>
