                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColPrivateAnnounceDate]: @FormatDate(item.PrivateAnnounceDate)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColListingDate]: @FormatDate(item.ListingDate)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColIdoDate]: @FormatDate(item.IdoDate)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColNextUnlockDate]: @FormatDate(item.NextUnlockDate)</RadzenText>
