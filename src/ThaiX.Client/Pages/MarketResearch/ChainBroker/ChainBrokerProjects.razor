@page "/market-research/chainbroker/projects"
@attribute [Authorize(Policy = PermissionNames.ChainBrokerDataRead)]
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Constants
@using ThaiX.Client.Localization
@using ThaiX.Client.Models.ExternalData
@using ThaiX.Client.Services.ExternalData
@using ThaiX.Client.Components
@using Microsoft.Extensions.Localization
@inject IExternalDataService ExternalDataService
@inject IStringLocalizer<SharedResource> L
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inherits ThaiXPageBase

<RadzenCard>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="FlexWrap.Wrap" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="mb-0">
            @L[RK.ChainBrokerProjects.Title]
        </RadzenText>
        @if (_canSync)
        {
            <RadzenButton Text="@L[RK.ChainBrokerProjects.SyncButton]"
                          Icon="sync"
                          ButtonStyle="ButtonStyle.Secondary"
                          Size="ButtonSize.Small"
                          IsBusy="@_isSyncing"
                          Disabled="@_isSyncing"
                          Click="OnSyncClickAsync" />
        }
    </RadzenStack>

    <RadzenStack Gap="1rem" Class="mb-3">
        <div>
            <label class="rz-label mb-1">@L[RK.ChainBrokerProjects.SearchPlaceholder]</label>
            <RadzenTextBox @bind-Value="_search"
                           Placeholder="@L[RK.ChainBrokerProjects.SearchPlaceholder]"
                           @oninput="OnSearchInput"
                           Class="w-100" />
        </div>

        <div>
            <label class="rz-label mb-1">@L[RK.ChainBrokerProjects.FilterByFund]</label>
            <AsyncSearchSelect TItem="ChainBrokerFundDto"
                               Value="@_selectedFundId"
                               ValueChanged="OnFundFilterChanged"
                               LoadDataAsync="LoadFundsAsync"
                               GetText="@(x => x.Name ?? x.Slug)"
                               GetValue="@(x => x.Id.ToString())"
                               Placeholder="@L[RK.ChainBrokerProjects.FilterByFund]"
                               SearchPlaceholder="@L[RK.Common.Search]"
                               LoadingText="@L[RK.Common.Loading]"
                               EmptyText="@L[RK.Common.NoDataFound]"
                               MoreHint="@L[RK.MasterData.SelectScrollMore]"
                               AllowClear="true"
                               Class="w-100" />
        </div>

        @if (_isLoading)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
        }
        else if (!_filtered.Any())
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                @L[RK.ChainBrokerProjects.NoDataFound]
            </RadzenAlert>
        }
    </RadzenStack>

    @if (!Viewport.IsMobile && !_isLoading && _filtered.Any())
    {
        <div style="width: 100%; overflow-x: auto;">
            <RadzenDataGrid TItem="ChainBrokerProjectDto"
                            Data="@_filtered"
                            Count="@_filtered.Count"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Advanced"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="10"
                            PageSizeOptions="@(new[] { 10, 20, 50, 100 })"
                            IsLoading="@_isLoading"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@L[RK.Grid.PagingSummaryFormat]"
                            Class="responsive-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="Rank" Title="@L[RK.ChainBrokerProjects.ColRank]" MinWidth="12.5rem" />
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="Name" Title="@L[RK.ChainBrokerProjects.ColName]" MinWidth="12.5rem">
                        <Template Context="item">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                @if (!string.IsNullOrEmpty(item.Logo))
                                {
                                    <SafeImage Src="@item.Logo"
                                               Alt="@item.Name"
                                               Style="width:24px;height:24px;border-radius:50%;object-fit:cover;"
                                               FallbackIcon="business"
                                               FallbackClass="safe-image-fallback"
                                               Width="24"
                                               Height="24" />
                                }
                                <span>@(item.Name ?? item.Slug)</span>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="Ticker" Title="@L[RK.ChainBrokerProjects.ColTicker]" MinWidth="12.5rem" />
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="CurrentPriceUsd" Title="@L[RK.ChainBrokerProjects.ColCurrentPrice]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.CurrentPriceUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PublicPriceUsd" Title="@L[RK.ChainBrokerProjects.ColPublicPrice]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.PublicPriceUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PrivatePriceUsd" Title="@L[RK.ChainBrokerProjects.ColPrivatePrice]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.PrivatePriceUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="AthPriceUsd" Title="@L[RK.ChainBrokerProjects.ColAthPrice]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.AthPriceUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PublicRoi" Title="@L[RK.ChainBrokerProjects.ColPublicRoi]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PublicRoi)">@FormatPercent(item.PublicRoi)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PrivateRoi" Title="@L[RK.ChainBrokerProjects.ColPrivateRoi]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PrivateRoi)">@FormatPercent(item.PrivateRoi)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PublicAthRoi" Title="@L[RK.ChainBrokerProjects.ColPublicAthRoi]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PublicAthRoi)">@FormatPercent(item.PublicAthRoi)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PrivateAthRoi" Title="@L[RK.ChainBrokerProjects.ColPrivateAthRoi]" MinWidth="12.5rem">
                        <Template Context="item">
                            <span class="@GetChangeClass(item.PrivateAthRoi)">@FormatPercent(item.PrivateAthRoi)</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="BrokerScore" Title="@L[RK.ChainBrokerProjects.ColBrokerScore]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatNumber(item.BrokerScore)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="SecurityScore" Title="@L[RK.ChainBrokerProjects.ColSecurityScore]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatNumber(item.SecurityScore)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="TwitterScore" Title="@L[RK.ChainBrokerProjects.ColTwitterScore]" MinWidth="12.5rem" />
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PublicRaiseUsd" Title="@L[RK.ChainBrokerProjects.ColPublicRaise]" MinWidth="12.5rem">
