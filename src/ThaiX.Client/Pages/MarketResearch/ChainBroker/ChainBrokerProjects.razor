                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="MarketCapUsd" Title="@L[RK.ChainBrokerProjects.ColMarketCap]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.MarketCapUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="FdmcUsd" Title="@L[RK.ChainBrokerProjects.ColFdmc]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.FdmcUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="Volume24hUsd" Title="@L[RK.ChainBrokerProjects.ColVolume24h]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatUsd(item.Volume24hUsd)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="CurrentCirculation" Title="@L[RK.ChainBrokerProjects.ColCurrentCirculation]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatNumber(item.CurrentCirculation)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="TotalCirculation" Title="@L[RK.ChainBrokerProjects.ColTotalCirculation]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatNumber(item.TotalCirculation)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PercentCirculating" Title="@L[RK.ChainBrokerProjects.ColPercentCirculating]" MinWidth="12.5rem">
                        <Template Context="item">
