                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="PrivateAnnounceDate" Title="@L[RK.ChainBrokerProjects.ColPrivateAnnounceDate]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatDate(item.PrivateAnnounceDate)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="ListingDate" Title="@L[RK.ChainBrokerProjects.ColListingDate]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatDate(item.ListingDate)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="IdoDate" Title="@L[RK.ChainBrokerProjects.ColIdoDate]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatDate(item.IdoDate)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="NextUnlockDate" Title="@L[RK.ChainBrokerProjects.ColNextUnlockDate]" MinWidth="12.5rem">
                        <Template Context="item">
                            @FormatDate(item.NextUnlockDate)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="FundCount" Title="@L[RK.ChainBrokerProjects.ColFundCount]" MinWidth="12.5rem">
                        <Template Context="item">
                            @item.FundCount
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ChainBrokerProjectDto" Property="Blockchains" Title="@L[RK.ChainBrokerProjects.ColBlockchains]" MinWidth="12.5rem" Filterable="false" Sortable="false">
                        <Template Context="item">
                            @string.Join(", ", item.Blockchains)
                        </Template>
