    @if (Viewport.IsMobile && !_isLoading && _filtered.Any())
    {
        <RadzenStack Gap="1rem">
            <ClientSortBar TItem="ChainBrokerProjectDto"
                           Options="@SortOptions"
                           SortKey="@_sortKey"
                           SortKeyChanged="OnSortKeyChanged"
                           Ascending="@_sortAscending"
                           AscendingChanged="OnSortDirectionChanged"
                           Label="@L[RK.Common.SortBy]"
                           Placeholder="@L[RK.Common.SortBy]"
                           AscendingLabel="@L[RK.Common.Ascending]"
                           DescendingLabel="@L[RK.Common.Descending]" />
            <Virtualize Items="@_filtered" Context="item" OverscanCount="5">
                <div class="mb-3">
                    <RadzenCard Class="p-3 m-0">
                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                @if (!string.IsNullOrEmpty(item.Logo))
                                {
                                    <SafeImage Src="@item.Logo"
                                               Alt="@item.Name"
                                               Style="width:28px;height:28px;border-radius:50%;object-fit:cover;"
                                               FallbackIcon="business"
                                               FallbackClass="safe-image-fallback"
                                               Width="28"
                                               Height="28" />
                                }
                                <RadzenText TextStyle="TextStyle.Subtitle1">
                                    <strong>@(item.Name ?? item.Slug)</strong>
                                    @if (!string.IsNullOrEmpty(item.Ticker))
                                    {
                                        <span class="text-muted ms-1 fs-6">(@item.Ticker)</span>
                                    }
                                </RadzenText>
                                @if (item.Rank.HasValue)
                                {
                                    <RadzenBadge Text="@($"#{item.Rank}")" BadgeStyle="BadgeStyle.Light" />
                                }
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColCurrentPrice]: @FormatUsd(item.CurrentPriceUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColPublicPrice]: @FormatUsd(item.PublicPriceUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColPrivatePrice]: @FormatUsd(item.PrivatePriceUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColAthPrice]: @FormatUsd(item.AthPriceUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PublicRoi)">@L[RK.ChainBrokerProjects.ColPublicRoi]: @FormatPercent(item.PublicRoi)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PrivateRoi)">@L[RK.ChainBrokerProjects.ColPrivateRoi]: @FormatPercent(item.PrivateRoi)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PublicAthRoi)">@L[RK.ChainBrokerProjects.ColPublicAthRoi]: @FormatPercent(item.PublicAthRoi)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PrivateAthRoi)">@L[RK.ChainBrokerProjects.ColPrivateAthRoi]: @FormatPercent(item.PrivateAthRoi)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColBrokerScore]: @FormatNumber(item.BrokerScore)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColSecurityScore]: @FormatNumber(item.SecurityScore)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColTwitterScore]: @(item.TwitterScore?.ToString() ?? "-")</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColPublicRaise]: @FormatUsd(item.PublicRaiseUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColPrivateRaise]: @FormatUsd(item.PrivateRaiseUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColTotalRaise]: @FormatUsd(item.TotalRaiseUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PriceChange24h)">@L[RK.ChainBrokerProjects.ColPriceChange24h]: @FormatPercent(item.PriceChange24h)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PriceChange7d)">@L[RK.ChainBrokerProjects.ColPriceChange7d]: @FormatPercent(item.PriceChange7d)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PriceChange30d)">@L[RK.ChainBrokerProjects.ColPriceChange30d]: @FormatPercent(item.PriceChange30d)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" Class="@GetChangeClass(item.PriceChange1y)">@L[RK.ChainBrokerProjects.ColPriceChange1y]: @FormatPercent(item.PriceChange1y)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColVolume24h]: @FormatUsd(item.Volume24hUsd)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColCurrentCirculation]: @FormatNumber(item.CurrentCirculation)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@L[RK.ChainBrokerProjects.ColTotalCirculation]: @FormatNumber(item.TotalCirculation)</RadzenText>
