@page "/portfolio/list"
@attribute [Authorize(Policy = PermissionNames.PortfolioRead)]
@inherits ThaiXPageBase
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Components.Portfolio.Portfolios
@inject IPortfolioService PortfolioService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IFileDownloadService FileDownloadService
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation

<PageTitle>@L[RK.Portfolios.ListTitle] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">@L[RK.Portfolios.Title]</RadzenText>
                    <div class="d-flex flex-wrap gap-2">
                        <ResponsiveIconButton Text="@L[RK.Portfolios.Export]"
                                      Icon="download"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@ExportAsync"
                                      IsBusy="@_isExporting"
                                      Disabled="@_isExporting" />
                        @if (_canWrite)
                        {
                            <ResponsiveIconButton Text="@L[RK.Portfolios.CreateTitle]" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@OpenCreateDialogAsync" />
                        }
                    </div>
                </RadzenStack>

                <RadzenRow Gap="0.75rem" RowGap="0.75rem">
                    <RadzenColumn Size="12">
                        <RadzenLabel Text="@L[RK.Common.Search]" />
                        <div class="ThaiX-input-group">
                            <RadzenTextBox @bind-Value="_searchTerm"
                                           Placeholder="@L[RK.Portfolios.SearchPlaceholder]"
                                           Change="@(_ => ApplySearchAsync())" />
                            <InputGroupSearchButton Click="@ApplySearchAsync" />
                        </div>
                    </RadzenColumn>

                    @if (_canWrite)
                    {
                        <RadzenColumn Size="12">
                            <RadzenText class="text-muted small mb-1">@L[RK.Portfolios.ImportTemplateNote]</RadzenText>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <ResponsiveIconButton Text="@L[RK.Portfolios.ImportDownloadTemplate]"
                                              Icon="download"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@DownloadTemplateAsync"
                                              IsBusy="@_downloadingTemplate"
                                              Disabled="@_downloadingTemplate" />
                            </div>
                            <RadzenLabel Text="@L[RK.Portfolios.ImportCsv]" />
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <InputFile OnChange="OnFileSelected" accept=".csv" class="form-control flex-grow-1" />
                                <ResponsiveIconButton Text="@L[RK.Portfolios.ImportButton]"
                                              Icon="upload"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small"
                                              Click="@ImportFileAsync"
                                              IsBusy="@_isImporting"
                                              Disabled="@(_selectedFile is null || _isImporting)" />
                            </div>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Wrap="FlexWrap.Wrap"
                             Gap="0.5rem">
                    <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.Body1 : TextStyle.H6)" class="mb-0">@L[RK.Portfolios.ListTitle]</RadzenText>
                    <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>

                @if (!Viewport.IsMobile)
                {
                    <RadzenDataGrid @ref="_grid"
                                    TItem="PortfolioListItemDto"
                                    Data="@_items"
                                    Count="@_totalCount"
                                    LoadData="@LoadDataAsync"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    PageSize="@DefaultPageSize"
                                    PageSizeOptions="@PageSizeOptions"
                                    ShowPagingSummary="true"
                                    Density="Density.Compact"
                                    IsLoading="@_isLoading">
                        <Columns>
                            <RadzenDataGridColumn TItem="PortfolioListItemDto" Property="Name" Title="@L[RK.Portfolios.Name]" />
                            <RadzenDataGridColumn TItem="PortfolioListItemDto" Property="PortfolioType" Title="@L[RK.Portfolios.PortfolioType]" Width="120px" />
                            <RadzenDataGridColumn TItem="PortfolioListItemDto" Property="Description" Title="@L[RK.Portfolios.Description]" />
                            <RadzenDataGridColumn TItem="PortfolioListItemDto" Property="CreatedAt" Title="@L[RK.Common.CreatedAt]">
                                <Template Context="item">
                                    @item.CreatedAt.ToString("yyyy-MM-dd")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PortfolioListItemDto" Title="@L[RK.Contacts.Actions]" Sortable="false" Width="140px">
                                <Template Context="item">
                                    <div class="d-flex gap-1">
                                        <RadzenButton Icon="visibility"
                                                      ButtonStyle="ButtonStyle.Info"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => Navigation.NavigateTo($"/portfolio/{item.Id}"))" />
                                        @if (_canWrite)
                                        {
                                            <RadzenButton Icon="edit"
                                                          ButtonStyle="ButtonStyle.Light"
                                                          Size="ButtonSize.Small"
                                                          Click="@(() => OpenEditDialogAsync(item))" />
                                        }
                                        @if (_canDelete)
                                        {
                                            <RadzenButton Icon="delete"
                                                          ButtonStyle="ButtonStyle.Danger"
                                                          Size="ButtonSize.Small"
                                                          Click="@(() => ConfirmDeleteAsync(item))" />
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }

                @if (Viewport.IsMobile)
                {
                    <RadzenStack Gap="0.75rem">
                        @if (_isLoading)
                        {
                            <RadzenText>@L[RK.Common.Loading]</RadzenText>
                        }
                        else if (_items.Count == 0)
                        {
                            <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
                        }
                        else
                        {
                            <Virtualize Items="@_items" TItem="PortfolioListItemDto" Context="portfolio" OverscanCount="5">
                                <div class="mb-2">
                                <RadzenCard class="p-3 m-0">
                                    <RadzenStack Gap="0.5rem">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">@portfolio.Name</RadzenText>
                                            <RadzenBadge Text="@portfolio.PortfolioType" BadgeStyle="BadgeStyle.Info" />
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(portfolio.Description))
                                        {
                                            <RadzenText class="text-muted small mb-0">@portfolio.Description</RadzenText>
                                        }
                                        <div class="d-flex flex-wrap gap-2">
                                            <ResponsiveIconButton Text="@L[RK.Common.View]"
                                                          Icon="visibility"
                                                          ButtonStyle="ButtonStyle.Info"
                                                          Size="ButtonSize.Small"
                                                          Click="@(() => Navigation.NavigateTo($"/portfolio/{portfolio.Id}"))" />
                                            @if (_canWrite)
                                            {
                                                <ResponsiveIconButton Text="@L[RK.Portfolios.EditTitle]"
                                                              Icon="edit"
                                                              ButtonStyle="ButtonStyle.Primary"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => OpenEditDialogAsync(portfolio))" />
                                            }
                                            @if (_canDelete)
                                            {
                                                <ResponsiveIconButton Text="@L[RK.Common.Delete]"
                                                              Icon="delete"
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Size="ButtonSize.Small"
                                                              Click="@(() => ConfirmDeleteAsync(portfolio))" />
                                            }
                                        </div>
                                    </RadzenStack>
                                </RadzenCard>
                                </div>
                            </Virtualize>
                        }

                        <AdminListPager TotalCount="@_totalCount"
                                        PageSize="@_pageSize"
                                        CurrentPage="@_currentPage"
                                        CurrentPageChanged="@GoToPageAsync"
                                        Disabled="@_isLoading" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
</div>

@code {
    private const int DefaultPageSize = 10;
    private static readonly IEnumerable<int> PageSizeOptions = [10, 20, 50, 100];

    private RadzenDataGrid<PortfolioListItemDto>? _grid;
    private List<PortfolioListItemDto> _items = [];
    private int _totalCount;
    private bool _isLoading;
    private bool _isExporting;
    private bool _downloadingTemplate;
    private bool _isImporting;
    private IBrowserFile? _selectedFile;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private string? _searchTerm;
    private bool _canWrite;
    private bool _canDelete;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canWrite = user.HasClaim("scope", PermissionNames.PortfolioWrite);
        _canDelete = user.HasClaim("scope", PermissionNames.PortfolioDelete);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (_grid is not null)
        {
            await _grid.Reload();
        }
        else
        {
            await LoadDataAsync(new LoadDataArgs { Skip = 0, Top = _pageSize });
        }
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            _pageSize = args.Top ?? DefaultPageSize;
            _currentPage = _pageSize <= 0 ? 1 : ((args.Skip ?? 0) / _pageSize) + 1;
            var sort = args.Sorts?.FirstOrDefault();

            var result = await PortfolioService.GetListAsync(new PortfoliosListRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                SortBy = sort?.Property?.ToLowerInvariant(),
                SortDescending = sort?.SortOrder == SortOrder.Descending,
                SearchTerm = _searchTerm
            }, _cts.Token);

            _items = [.. result.Data ?? []];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.Portfolios.LoadFailed]);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        if (_grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadDataAsync(new LoadDataArgs
        {
            Skip = (_currentPage - 1) * _pageSize,
            Top = _pageSize
        });
    }

    private async Task ApplySearchAsync()
    {
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _currentPage = page;
        await ReloadAsync();
    }

    private async Task OpenCreateDialogAsync()
    {
        var result = await DialogService.OpenAsync<CreatePortfolioDialog>(
            L[RK.Portfolios.CreateTitle],
            options: new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.CreateSuccess]);
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(PortfolioListItemDto item)
    {
        var result = await DialogService.OpenAsync<EditPortfolioDialog>(
            L[RK.Portfolios.EditTitle],
            parameters: new Dictionary<string, object?> { ["PortfolioId"] = item.Id, ["PortfolioName"] = item.Name, ["PortfolioDescription"] = item.Description ?? string.Empty, ["CurrentPortfolioType"] = item.PortfolioType },
            options: new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.UpdateSuccess]);
            await ReloadAsync();
        }
    }

    private async Task ConfirmDeleteAsync(PortfolioListItemDto item)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.Portfolios.ConfirmDelete]);

        if (confirmed is true)
        {
            try
            {
                await PortfolioService.DeleteAsync(item.Id, _cts.Token);
                NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.DeleteSuccess]);
                await ReloadAsync();
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Error, L[RK.Portfolios.DeleteFailed]);
            }
        }
    }

    private async Task DownloadTemplateAsync()
    {
        if (_downloadingTemplate || !_canWrite)
        {
            return;
        }

        _downloadingTemplate = true;
        try
        {
            var file = await PortfolioService.GetImportTemplateAsync(_cts.Token);
            await FileDownloadService.DownloadAsync(file.FileName, file.ContentType, file.FileContent, _cts.Token);
            NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.ImportDownloadTemplate], file.FileName);
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.Portfolios.ImportFailed]);
        }
        finally
        {
            _downloadingTemplate = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
    }

    private async Task ImportFileAsync()
    {
        if (_selectedFile is null || _isImporting || !_canWrite)
        {
            return;
        }

        _isImporting = true;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            var result = await PortfolioService.ImportAsync(stream, _selectedFile.Name, _cts.Token);
            var message = string.Format(L[RK.Portfolios.ImportResult], result.InsertedCount, result.UpdatedCount, result.SkippedCount);
            NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.ImportSuccess], message);
            _selectedFile = null;
            await ReloadAsync();
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.Portfolios.ImportFailed]);
        }
        finally
        {
            _isImporting = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_isExporting)
        {
            return;
        }

        _isExporting = true;
        try
        {
            var file = await PortfolioService.ExportAsync(new PortfolioExportRequest
            {
                SearchTerm = _searchTerm
            }, _cts.Token);

            await FileDownloadService.DownloadAsync(file.FileName, file.ContentType, file.FileContent, _cts.Token);
            NotificationService.Notify(NotificationSeverity.Success, L[RK.Portfolios.ExportSuccess], file.FileName);
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.Portfolios.ExportFailed]);
        }
        finally
        {
            _isExporting = false;
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _cts.Cancel();
            _cts.Dispose();
        }
        base.Dispose(disposing);
    }
}
