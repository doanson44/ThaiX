        else
        {
            @RenderMobileCards(
                _transfers,
                t => t.Amount.ToString("N2"),
                t => t.TransferredOn.ToString("yyyy-MM-dd"),
                t => t.Note,
                "transfers",
                t => OpenEditTransferAsync(t),
                t => ConfirmDeleteAsync(ExpenseResourceKind.Transfer, t.Id))
        }
    };

    private RenderFragment RenderBudgets(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseBudgetDto" Data="@_budgets" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseBudgetDto" Property="Period" Title="@L[RK.ExpenseTracker.Period]" />
                    <RadzenDataGridColumn TItem="ExpenseBudgetDto" Property="Amount" Title="@L[RK.ExpenseTracker.Amount]" />
                    <RadzenDataGridColumn TItem="ExpenseBudgetDto" Property="StartDate" Title="@L[RK.ExpenseTracker.StartDate]" />
                    <RadzenDataGridColumn TItem="ExpenseBudgetDto" Property="EndDate" Title="@L[RK.ExpenseTracker.EndDate]" />
                    <RadzenDataGridColumn TItem="ExpenseBudgetDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("budgets", () => OpenEditBudgetAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Budget, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
