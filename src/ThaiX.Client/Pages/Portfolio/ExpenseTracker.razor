            <RadzenDataGrid TItem="ExpenseSavingGoalDto" Data="@_savingGoals" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseSavingGoalDto" Property="Name" Title="@L[RK.ExpenseTracker.Name]" />
                    <RadzenDataGridColumn TItem="ExpenseSavingGoalDto" Property="TargetAmount" Title="@L[RK.ExpenseTracker.TargetAmount]" />
                    <RadzenDataGridColumn TItem="ExpenseSavingGoalDto" Property="CurrentAmount" Title="@L[RK.ExpenseTracker.CurrentAmount]" />
                    <RadzenDataGridColumn TItem="ExpenseSavingGoalDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("saving-goals", () => OpenEditSavingGoalAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.SavingGoal, item.Id))
                        </Template>
