    private async Task ConfirmDeleteAsync(ExpenseResourceKind kind, Guid id)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.ExpenseTracker.ConfirmDelete]);
        if (confirmed is not true) return;

        try
        {
            switch (kind)
            {
                case ExpenseResourceKind.Wallet:
                    await ExpenseTrackerService.DeleteWalletAsync(id);
                    break;
                case ExpenseResourceKind.Category:
                    await ExpenseTrackerService.DeleteCategoryAsync(id);
                    break;
                case ExpenseResourceKind.Transaction:
                    await ExpenseTrackerService.DeleteTransactionAsync(id);
                    break;
                case ExpenseResourceKind.Transfer:
                    await ExpenseTrackerService.DeleteTransferAsync(id);
                    break;
                case ExpenseResourceKind.Budget:
                    await ExpenseTrackerService.DeleteBudgetAsync(id);
                    break;
                case ExpenseResourceKind.SavingGoal:
                    await ExpenseTrackerService.DeleteSavingGoalAsync(id);
                    break;
                case ExpenseResourceKind.Tag:
                    await ExpenseTrackerService.DeleteTagAsync(id);
                    break;
                case ExpenseResourceKind.TransactionTag:
                    await ExpenseTrackerService.DeleteTransactionTagAsync(id);
                    break;
                case ExpenseResourceKind.Recurring:
                    await ExpenseTrackerService.DeleteRecurringTransactionAsync(id);
                    break;
            }

            NotificationService.NotifySuccess(L[RK.ExpenseTracker.DeleteSuccess]);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ExpenseTracker.DeleteFailed], ex.GetDisplayDetail());
        }
    }
