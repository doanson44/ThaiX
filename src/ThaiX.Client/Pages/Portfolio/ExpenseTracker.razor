@page "/portfolio/expense-tracker"
@attribute [Authorize(Policy = PermissionNames.ExpenseTransactionRead)]
@inherits ThaiXPageBase
@using ThaiX.Client.Models.ExpenseTracker
@using ThaiX.Client.Components.Portfolio
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject ThaiX.Client.Services.ExpenseTracker.IExpenseTrackerService ExpenseTrackerService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L[RK.ExpenseTracker.Title] - ThaiX</PageTitle>

<div class="container-fluid py-2">
    <RadzenStack Gap="1rem">
        <RadzenCard>
            <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" class="mb-0">
                @L[RK.ExpenseTracker.Title]
            </RadzenText>
        </RadzenCard>

        @if (_isLoading)
        {
            <RadzenCard>
                <RadzenText>@L[RK.Common.Loading]</RadzenText>
            </RadzenCard>
        }
        else
        {
            <RadzenCard>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.ExpenseTracker.TotalAsset]</RadzenText>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">
                            @_dashboard?.Summary.TotalAsset.ToString("N2")
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.ExpenseTracker.IncomeToday]</RadzenText>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">
                            @_dashboard?.Summary.IncomeToday.ToString("N2")
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.ExpenseTracker.ExpenseToday]</RadzenText>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">
                            @_dashboard?.Summary.ExpenseToday.ToString("N2")
                        </RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.ExpenseTracker.CashFlow]</RadzenText>
                        <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)">
                            @_dashboard?.CashFlow.ToString("N2")
                        </RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>

            @if (Viewport.IsMobile)
            {
                <RadzenCard>
                    <RadzenStack Gap="0.75rem">
                        <RadzenDropDown TValue="string"
                                        Data="@_sectionOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        @bind-Value="_selectedSection"
                                        Style="width:100%"
                                        Change="@(_ => StateHasChanged())" />
                        @RenderSectionToolbar(_selectedSection)
                        @RenderSectionBody(_selectedSection)
                    </RadzenStack>
                </RadzenCard>
            }
            else
            {
                <RadzenTabs @bind-SelectedIndex="_selectedTabIndex">
                    <Tabs>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Wallets]">
                            @RenderSectionToolbar("wallets")
                            @RenderWallets(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Categories]">
                            @RenderSectionToolbar("categories")
                            @RenderCategories(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Transactions]">
                            @RenderSectionToolbar("transactions")
                            @RenderTransactions(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Transfers]">
                            @RenderSectionToolbar("transfers")
                            @RenderTransfers(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Budgets]">
                            @RenderSectionToolbar("budgets")
                            @RenderBudgets(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.SavingGoals]">
                            @RenderSectionToolbar("saving-goals")
                            @RenderSavingGoals(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.Tags]">
                            @RenderSectionToolbar("tags")
                            @RenderTags(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.TransactionTags]">
                            @RenderSectionToolbar("transaction-tags")
                            @RenderTransactionTags(desktop: true)
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="@L[RK.ExpenseTracker.RecurringTransactions]">
                            @RenderSectionToolbar("recurring")
                            @RenderRecurring(desktop: true)
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            }
        }
    </RadzenStack>
</div>

@code {
    private ExpenseDashboardDataDto? _dashboard;
    private IReadOnlyList<ExpenseWalletDto> _wallets = [];
    private IReadOnlyList<ExpenseCategoryDto> _categories = [];
    private IReadOnlyList<ExpenseTransactionDto> _transactions = [];
    private IReadOnlyList<ExpenseTransferDto> _transfers = [];
    private IReadOnlyList<ExpenseBudgetDto> _budgets = [];
    private IReadOnlyList<ExpenseSavingGoalDto> _savingGoals = [];
    private IReadOnlyList<ExpenseTagDto> _tags = [];
    private IReadOnlyList<ExpenseTransactionTagDto> _transactionTags = [];
    private IReadOnlyList<ExpenseRecurringTransactionDto> _recurringTransactions = [];
    private bool _isLoading = true;
    private int _selectedTabIndex;
    private string _selectedSection = "wallets";
    private List<SectionOption> _sectionOptions = [];
    private readonly Dictionary<string, bool> _canWrite = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> _canDelete = new(StringComparer.OrdinalIgnoreCase);

    private sealed record SectionOption(string Value, string Text);

    protected override async Task OnInitializedAsync()
    {
        _sectionOptions =
        [
            new("wallets", L[RK.ExpenseTracker.Wallets]),
            new("categories", L[RK.ExpenseTracker.Categories]),
            new("transactions", L[RK.ExpenseTracker.Transactions]),
            new("transfers", L[RK.ExpenseTracker.Transfers]),
            new("budgets", L[RK.ExpenseTracker.Budgets]),
            new("saving-goals", L[RK.ExpenseTracker.SavingGoals]),
            new("tags", L[RK.ExpenseTracker.Tags]),
            new("transaction-tags", L[RK.ExpenseTracker.TransactionTags]),
            new("recurring", L[RK.ExpenseTracker.RecurringTransactions])
        ];

        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        SetPerm("wallets", user, PermissionNames.WalletWrite, PermissionNames.WalletDelete);
        SetPerm("categories", user, PermissionNames.ExpenseCategoryWrite, PermissionNames.ExpenseCategoryDelete);
        SetPerm("transactions", user, PermissionNames.ExpenseTransactionWrite, PermissionNames.ExpenseTransactionDelete);
        SetPerm("transfers", user, PermissionNames.TransferWrite, PermissionNames.TransferDelete);
        SetPerm("budgets", user, PermissionNames.BudgetWrite, PermissionNames.BudgetDelete);
        SetPerm("saving-goals", user, PermissionNames.SavingGoalWrite, PermissionNames.SavingGoalDelete);
        SetPerm("tags", user, PermissionNames.ExpenseTagWrite, PermissionNames.ExpenseTagDelete);
        SetPerm("transaction-tags", user, PermissionNames.TransactionTagWrite, PermissionNames.TransactionTagDelete);
        SetPerm("recurring", user, PermissionNames.RecurringTransactionWrite, PermissionNames.RecurringTransactionDelete);

        await ReloadAsync();
    }

    private void SetPerm(string section, System.Security.Claims.ClaimsPrincipal user, string write, string delete)
    {
        _canWrite[section] = user.HasClaim("scope", write);
        _canDelete[section] = user.HasClaim("scope", delete);
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        try
        {
            _dashboard = await ExpenseTrackerService.GetDashboardAsync();
            var request = new ExpenseListRequest { PageNumber = 1, PageSize = 50, SortBy = "createdat", SortDescending = true };
            _wallets = (await ExpenseTrackerService.GetWalletsAsync(request)).Data ?? [];
            _categories = (await ExpenseTrackerService.GetCategoriesAsync(request)).Data ?? [];
            _transactions = (await ExpenseTrackerService.GetTransactionsAsync(request)).Data ?? [];
            _transfers = (await ExpenseTrackerService.GetTransfersAsync(request)).Data ?? [];
            _budgets = (await ExpenseTrackerService.GetBudgetsAsync(request)).Data ?? [];
            _savingGoals = (await ExpenseTrackerService.GetSavingGoalsAsync(request)).Data ?? [];
            _tags = (await ExpenseTrackerService.GetTagsAsync(request)).Data ?? [];
            _transactionTags = (await ExpenseTrackerService.GetTransactionTagsAsync(request)).Data ?? [];
            _recurringTransactions = (await ExpenseTrackerService.GetRecurringTransactionsAsync(request)).Data ?? [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private RenderFragment RenderSectionBody(string section) => section switch
    {
        "categories" => RenderCategories(desktop: false),
        "transactions" => RenderTransactions(desktop: false),
        "transfers" => RenderTransfers(desktop: false),
        "budgets" => RenderBudgets(desktop: false),
        "saving-goals" => RenderSavingGoals(desktop: false),
        "tags" => RenderTags(desktop: false),
        "transaction-tags" => RenderTransactionTags(desktop: false),
        "recurring" => RenderRecurring(desktop: false),
        _ => RenderWallets(desktop: false)
    };

    private RenderFragment RenderSectionToolbar(string section) => __builder =>
    {
        if (_canWrite.GetValueOrDefault(section))
        {
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="mb-2">
                <ResponsiveIconButton Text="@L[RK.ExpenseTracker.CreateTitle]"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => OpenCreateAsync(ToKind(section)))" />
            </RadzenStack>
        }
    };

    private static ExpenseResourceKind ToKind(string section) => section switch
    {
        "categories" => ExpenseResourceKind.Category,
        "transactions" => ExpenseResourceKind.Transaction,
        "transfers" => ExpenseResourceKind.Transfer,
        "budgets" => ExpenseResourceKind.Budget,
        "saving-goals" => ExpenseResourceKind.SavingGoal,
        "tags" => ExpenseResourceKind.Tag,
        "transaction-tags" => ExpenseResourceKind.TransactionTag,
        "recurring" => ExpenseResourceKind.Recurring,
        _ => ExpenseResourceKind.Wallet
    };

    private RenderFragment RenderWallets(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseWalletDto" Data="@_wallets" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseWalletDto" Property="Name" Title="@L[RK.ExpenseTracker.Name]" />
                    <RadzenDataGridColumn TItem="ExpenseWalletDto" Property="WalletType" Title="@L[RK.ExpenseTracker.Type]" />
                    <RadzenDataGridColumn TItem="ExpenseWalletDto" Property="Currency" Title="@L[RK.ExpenseTracker.Currency]" />
                    <RadzenDataGridColumn TItem="ExpenseWalletDto" Property="CurrentBalance" Title="@L[RK.ExpenseTracker.Balance]" />
                    <RadzenDataGridColumn TItem="ExpenseWalletDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("wallets", () => OpenEditWalletAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Wallet, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            @RenderMobileCards(
                _wallets,
                w => w.Name,
                w => $"{w.WalletType} · {w.Currency}",
                w => w.CurrentBalance.ToString("N2"),
                "wallets",
                w => OpenEditWalletAsync(w),
                w => ConfirmDeleteAsync(ExpenseResourceKind.Wallet, w.Id))
        }
    };

    private RenderFragment RenderCategories(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseCategoryDto" Data="@_categories" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseCategoryDto" Property="Name" Title="@L[RK.ExpenseTracker.Name]" />
                    <RadzenDataGridColumn TItem="ExpenseCategoryDto" Property="CategoryType" Title="@L[RK.ExpenseTracker.Type]" />
                    <RadzenDataGridColumn TItem="ExpenseCategoryDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("categories", () => OpenEditCategoryAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Category, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            @RenderMobileCards(
                _categories,
                c => c.Name,
                c => c.CategoryType,
                _ => null,
                "categories",
                c => OpenEditCategoryAsync(c),
                c => ConfirmDeleteAsync(ExpenseResourceKind.Category, c.Id))
        }
    };

    private RenderFragment RenderTransactions(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseTransactionDto" Data="@_transactions" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseTransactionDto" Property="TransactionType" Title="@L[RK.ExpenseTracker.Type]" />
                    <RadzenDataGridColumn TItem="ExpenseTransactionDto" Property="Amount" Title="@L[RK.ExpenseTracker.Amount]" />
                    <RadzenDataGridColumn TItem="ExpenseTransactionDto" Property="OccurredOn" Title="@L[RK.Common.CreatedAt]" />
                    <RadzenDataGridColumn TItem="ExpenseTransactionDto" Property="Note" Title="@L[RK.ExpenseTracker.Note]" />
                    <RadzenDataGridColumn TItem="ExpenseTransactionDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("transactions", () => OpenEditTransactionAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Transaction, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            @RenderMobileCards(
                _transactions,
                t => t.TransactionType,
                t => $"{t.Amount:N2} · {t.OccurredOn:yyyy-MM-dd}",
                t => t.Note,
                "transactions",
                t => OpenEditTransactionAsync(t),
                t => ConfirmDeleteAsync(ExpenseResourceKind.Transaction, t.Id))
        }
    };

    private RenderFragment RenderTransfers(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseTransferDto" Data="@_transfers" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseTransferDto" Property="Amount" Title="@L[RK.ExpenseTracker.Amount]" />
                    <RadzenDataGridColumn TItem="ExpenseTransferDto" Property="TransferredOn" Title="@L[RK.Common.CreatedAt]" />
                    <RadzenDataGridColumn TItem="ExpenseTransferDto" Property="Note" Title="@L[RK.ExpenseTracker.Note]" />
                    <RadzenDataGridColumn TItem="ExpenseTransferDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("transfers", () => OpenEditTransferAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Transfer, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
