        }
    };

    private RenderFragment RenderRowActions(string section, Func<Task> onEdit, Func<Task> onDelete) => __builder =>
    {
        <div class="d-flex gap-1">
            @if (_canWrite.GetValueOrDefault(section))
            {
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(_ => onEdit())" />
            }
            @if (_canDelete.GetValueOrDefault(section))
            {
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(_ => onDelete())" />
            }
        </div>
    };

    private RenderFragment RenderMobileCards<T>(
        IReadOnlyList<T> items,
        Func<T, string> title,
        Func<T, string> subtitle,
        Func<T, string?> detail,
        string section,
        Func<T, Task> onEdit,
        Func<T, Task> onDelete)
    {
        return __builder =>
        {
            if (items.Count == 0)
            {
                <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
            }
            else
            {
                <RadzenStack Gap="0.75rem">
                    @foreach (var item in items)
                    {
                        <RadzenCard class="p-3 m-0">
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">@title(item)</RadzenText>
                                    @RenderRowActions(section, () => onEdit(item), () => onDelete(item))
                                </RadzenStack>
                                <RadzenText class="text-muted small mb-0">@subtitle(item)</RadzenText>
                                @{
                                    var d = detail(item);
                                }
                                @if (!string.IsNullOrWhiteSpace(d))
                                {
                                    <RadzenText class="text-muted small mb-0">@d</RadzenText>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            }
        };
    }

    private static DialogOptions BuildDialogOptions() => new()
    {
        Width = "min(520px, 96vw)",
        Height = "auto",
        Resizable = false,
        Draggable = false,
        CloseDialogOnEsc = true,
        ShowClose = true,
        CloseDialogOnOverlayClick = false
    };

    private async Task OpenDialogAsync(ExpenseTrackerFormState state)
    {
        var result = await DialogService.OpenAsync<ExpenseTrackerDialog>(
            state.IsEdit ? L[RK.ExpenseTracker.EditTitle] : L[RK.ExpenseTracker.CreateTitle],
            new Dictionary<string, object?>
            {
                [nameof(ExpenseTrackerDialog.State)] = state,
                [nameof(ExpenseTrackerDialog.Wallets)] = _wallets,
                [nameof(ExpenseTrackerDialog.Categories)] = _categories,
                [nameof(ExpenseTrackerDialog.Transactions)] = _transactions,
                [nameof(ExpenseTrackerDialog.Tags)] = _tags
            },
            BuildDialogOptions());

        if (result is true)
            await ReloadAsync();
    }

