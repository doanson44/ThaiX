                _budgets,
                b => b.Period,
                b => b.Amount.ToString("N2"),
                b => $"{b.StartDate:yyyy-MM-dd} → {b.EndDate:yyyy-MM-dd}",
                "budgets",
                b => OpenEditBudgetAsync(b),
                b => ConfirmDeleteAsync(ExpenseResourceKind.Budget, b.Id))
        }
    };

