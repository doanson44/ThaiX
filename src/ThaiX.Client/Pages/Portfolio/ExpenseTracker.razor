        }
        else
        {
            @RenderMobileCards(
                _recurringTransactions,
                r => r.TransactionType,
                r => $"{r.Frequency} · {r.Amount:N2}",
                r => r.NextRun.ToString("yyyy-MM-dd"),
                "recurring",
                r => OpenEditRecurringAsync(r),
