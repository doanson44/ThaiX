    };

    private RenderFragment RenderRecurring(bool desktop) => __builder =>
    {
        if (desktop)
        {
            <RadzenDataGrid TItem="ExpenseRecurringTransactionDto" Data="@_recurringTransactions" AllowPaging="false" AllowSorting="true" Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="ExpenseRecurringTransactionDto" Property="TransactionType" Title="@L[RK.ExpenseTracker.Type]" />
                    <RadzenDataGridColumn TItem="ExpenseRecurringTransactionDto" Property="Frequency" Title="@L[RK.ExpenseTracker.Frequency]" />
                    <RadzenDataGridColumn TItem="ExpenseRecurringTransactionDto" Property="Amount" Title="@L[RK.ExpenseTracker.Amount]" />
                    <RadzenDataGridColumn TItem="ExpenseRecurringTransactionDto" Property="NextRun" Title="@L[RK.ExpenseTracker.NextRun]" />
                    <RadzenDataGridColumn TItem="ExpenseRecurringTransactionDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="100px">
                        <Template Context="item">
                            @RenderRowActions("recurring", () => OpenEditRecurringAsync(item), () => ConfirmDeleteAsync(ExpenseResourceKind.Recurring, item.Id))
                        </Template>
                    </RadzenDataGridColumn>
