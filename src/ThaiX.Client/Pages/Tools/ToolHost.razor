    private async Task RunAsync(string actionId)
    {
        _busy = true;
        _warning = null;
        if (UsesInputValidity())
            _inputValid = null;
        _toolErrorBoundary?.Recover();
        try
        {
            switch (actionId)
            {
                case "pretty": _state.Output = JsonToolTransforms.PrettyPrint(_state.Input); break;
                case "minify": _state.Output = JsonToolTransforms.Minify(_state.Input); break;
                case "validate":
                    JsonToolTransforms.Validate(_state.Input);
                    _inputValid = true;
                    break;
                case "compare": _state.Output = JsonToolTransforms.Compare(_state.Input, _state.Input2); break;
                case "decode":
                    _state.Output = EncodeToolTransforms.DecodeJwt(
                        _state.Input,
                        L[RK.Tools.JwtDecoder.UnverifiedWarning].Value,
                        L[RK.Tools.JwtDecoder.Header].Value,
                        L[RK.Tools.JwtDecoder.Payload].Value,
                        L[RK.Tools.JwtDecoder.SignaturePresent].Value,
                        L[RK.Tools.JwtDecoder.SignatureMissing].Value);
                    break;
                case "b64e": _state.Output = EncodeToolTransforms.Base64Encode(_state.Input); break;
                case "b64d": _state.Output = EncodeToolTransforms.Base64Decode(_state.Input); break;
                case "b64ue": _state.Output = EncodeToolTransforms.Base64UrlEncode(_state.Input); break;
                case "b64ud": _state.Output = EncodeToolTransforms.Base64UrlDecodeText(_state.Input); break;
                case "urle": _state.Output = EncodeToolTransforms.UrlEncode(_state.Input); break;
                case "urld": _state.Output = EncodeToolTransforms.UrlDecode(_state.Input); break;
                case "urlce": _state.Output = EncodeToolTransforms.UrlEncodeComponent(_state.Input); break;
                case "urlcd": _state.Output = EncodeToolTransforms.UrlDecodeComponent(_state.Input); break;
                case "sha": _state.Output = EncodeToolTransforms.Sha256Hex(_state.Input); break;
                case "uuid": _state.Output = EncodeToolTransforms.NewUuid(_state.Flag, _state.Option); break;
                case "toUnix": _state.Output = EncodeToolTransforms.UnixConvert(_state.Input, toUnix: true); break;
                case "toUnixMs": _state.Output = EncodeToolTransforms.UnixConvert(_state.Input, toUnix: true, milliseconds: true); break;
                case "fromUnix": _state.Output = EncodeToolTransforms.UnixConvert(_state.Input, toUnix: false, milliseconds: false); break;
                case "fromUnixMs": _state.Output = EncodeToolTransforms.UnixConvert(_state.Input, toUnix: false, milliseconds: true); break;
                case "yamlVal":
                    ConvertToolTransforms.ValidateYaml(_state.Input);
                    _inputValid = true;
                    break;
                case "y2j": _state.Output = ConvertToolTransforms.YamlToJson(_state.Input); break;
                case "j2y": _state.Output = ConvertToolTransforms.JsonToYaml(_state.Input); break;
                case "xml": _state.Output = ConvertToolTransforms.FormatXml(_state.Input); break;
                case "c2j": _state.Output = ConvertToolTransforms.CsvToJson(_state.Input); break;
                case "j2c": _state.Output = ConvertToolTransforms.JsonToCsv(_state.Input); break;
                case "cs": _state.Output = ConvertToolTransforms.JsonToCsharp(_state.Input); break;
                case "ts": _state.Output = ConvertToolTransforms.JsonToTypescript(_state.Input); break;
                case "sql": _state.Output = TextToolTransforms.FormatSql(_state.Input); break;
                case "html": _state.Output = await JS.InvokeAsync<string>("ThaiXBeautify", "html", _state.Input); break;
                case "css": _state.Output = await JS.InvokeAsync<string>("ThaiXBeautify", "css", _state.Input); break;
                case "js": _state.Output = await JS.InvokeAsync<string>("ThaiXBeautify", "js", _state.Input); break;
                case "md":
                    if (_mdPreviewMode)
                    {
                        ShowMarkdownEditor();
                    }
                    else
                    {
                        await RefreshMarkdownAsync();
                        _mdPreviewMode = true;
                    }
                    break;
                case "h2m": _state.Output = TextToolTransforms.HtmlToMarkdownRough(_state.Input); break;
                case "m2h": _state.Output = TextToolTransforms.MarkdownToHtml(_state.Input); break;
                case "diff":
                    _state.Output = _state.Flag
                        ? TextToolTransforms.DiffSideBySide(_state.Input, _state.Input2, _state.IgnoreWhitespace)
                        : TextToolTransforms.Diff(_state.Input, _state.Input2);
                    break;
                case "re":
                    _state.Output = TextToolTransforms.RegexTest(
                        _state.Input2,
                        _state.Input,
                        null,
                        ignoreCase: _state.Flag,
                        matchesLabel: L[RK.Tools.Regex.Matches].Value,
                        groupLabel: L[RK.Tools.Regex.Group].Value,
                        replaceLabel: L[RK.Tools.Regex.Replace].Value,
                        multiline: _state.RegexMultiline,
                        singleline: _state.RegexSingleline);
                    break;
                case "reReplace":
                    _state.Output = TextToolTransforms.RegexTest(
                        _state.Input2,
                        _state.Input,
                        _state.Option,
                        ignoreCase: _state.Flag,
                        matchesLabel: L[RK.Tools.Regex.Matches].Value,
                        groupLabel: L[RK.Tools.Regex.Group].Value,
                        replaceLabel: L[RK.Tools.Regex.Replace].Value,
                        multiline: _state.RegexMultiline,
                        singleline: _state.RegexSingleline);
                    break;
                case "pw": _state.Output = GeneratorToolTransforms.GeneratePassword(_state.Number, _state.Flag); break;
                case "pws":
                    _state.Output = GeneratorToolTransforms.PasswordStrength(
                        _state.Input,
                        L[RK.Tools.PasswordStrength.Score].Value,
                        L[RK.Tools.PasswordStrength.Weak].Value,
                        L[RK.Tools.PasswordStrength.Fair].Value,
                        L[RK.Tools.PasswordStrength.Good].Value,
                        L[RK.Tools.PasswordStrength.Strong].Value,
                        L[RK.Tools.PasswordStrength.Length].Value,
                        L[RK.Tools.PasswordStrength.Disclaimer].Value);
                    break;
                case "cron":
                    _state.Output = GeneratorToolTransforms.DescribeCron(
                        _state.Option,
                        cronLabel: L[RK.Tools.Cron.ExpressionLabel].Value,
                        nextRunsLabel: L[RK.Tools.Cron.NextRunsUtc].Value);
                    break;
                case "qr":
                    _qrSvg = GeneratorToolTransforms.QrSvg(_state.Input, _state.Number, _state.Option);
                    _state.Output = L[RK.Tools.Qr.Generated].Value;
                    break;
                case "curl":
                    _state.Output = GeneratorToolTransforms.BuildCurl(
                        string.IsNullOrWhiteSpace(_state.Option) ? "GET" : _state.Option,
                        _state.Input, _state.Input2, "");
                    break;
                case "gi": _state.Output = GeneratorToolTransforms.GitignorePreset(_state.Option); break;
                case "cc":
                    var bits = (_state.Option ?? "feat").Split('/', 2, StringSplitOptions.TrimEntries);
                    _state.Output = GeneratorToolTransforms.ConventionalCommit(
                        bits[0], bits.Length > 1 ? bits[1] : "", _state.Input, _state.Flag, _state.Input2);
                    break;
            }

            await ScheduleLocalSaveAsync();
        }
        catch (Exception ex)
        {
            if (actionId is "validate" or "yamlVal")
                _inputValid = false;
            ReportToolIssue(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadQrAsync()
    {
        if (string.IsNullOrWhiteSpace(_qrSvg)) return;
        try
        {
            var fileName = $"ThaiX-qr-{DateTime.Now:yyyyMMdd-HHmmss}.png";
            await JS.InvokeVoidAsync("ThaiXDownloadQrPng", _qrSvg, fileName);
        }
        catch (Exception ex)
        {
            ReportToolIssue(ex);
        }
    }

    private Task RefreshMarkdownAsync()
    {
        try
        {
            _previewHtml = TextToolTransforms.MarkdownToHtml(_state.Input);
            _previewEpoch++;
            _previewDirty = true;
            _warning = null;
        }
        catch (Exception ex)
        {
            _previewHtml = string.Empty;
            _previewEpoch++;
            _previewDirty = true;
            ReportToolIssue(ex);
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_previewDirty || !IsMarkdownPreview()) return;
        _previewDirty = false;

        var epoch = _previewEpoch;
        var html = _previewHtml;
        try
        {
            // JS owns the preview DOM; epoch cancels stale Mermaid work when user pastes B over A.
            await JS.InvokeVoidAsync("ThaiXSetMarkdownPreview", _previewRef, html, epoch);
        }
        catch (JSDisconnectedException)
        {
            /* circuit/page going away */
        }
        catch (Exception ex)
        {
            if (epoch != _previewEpoch) return;
            ReportToolIssue(ex);
            try { await InvokeAsync(StateHasChanged); }
            catch { /* ignore */ }
        }
    }

    private async Task OnMarkdownInputChanged(string? value)
    {
        _state.Input = value ?? string.Empty;
        try
        {
            // Live dual-pane preview; Preview button switches to focus mode.
            await RefreshMarkdownAsync();
            _ = ScheduleLocalSaveAsync();
        }
        catch (Exception ex)
        {
            ReportToolIssue(ex);
        }
    }

    private Task CopyPreviewTextAsync() =>
        CopyPreviewAsync("ThaiXCopyMarkdownPreviewText", L[RK.Tools.MarkdownPreview.CopyAllSuccess]);

    private Task CopyPreviewHtmlAsync() =>
        CopyPreviewAsync("ThaiXCopyMarkdownPreviewHtml", L[RK.Tools.MarkdownPreview.CopyHtmlSuccess]);

    private async Task CopyPreviewAsync(string jsFunction, string successMessage)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>(jsFunction, _previewRef);
            if (!ok) throw new InvalidOperationException("Clipboard copy returned false.");
            NotificationService.NotifySuccess(successMessage);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.Tools.MarkdownPreview.CopyFailed], L[RK.Tools.ValidationBrowser]);
        }
    }

