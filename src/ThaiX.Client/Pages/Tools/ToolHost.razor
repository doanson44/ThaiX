@page "/tools/{Slug}"
@attribute [AllowAnonymous]
@implements IDisposable
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using ThaiX.Client.Services.Ui
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Services.Tools
@using ThaiX.Client.Services.Tools.Calculators
@using ThaiX.Client.Services.Tools.Transforms
@inject IStringLocalizer<SharedResource> L
@inject IToolStateStore ToolStateStore
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject IFileDownloadService FileDownloadService
@inherits ThaiXPageBase

<PageTitle>@(_tool is null ? L[RK.Tools.HubTitle] : L[_tool.TitleKey]) - ThaiX</PageTitle>

@if (_tool is null)
{
    <div class="container-fluid py-2">
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
            @L[RK.Tools.NotFound]
        </RadzenAlert>
    </div>
}
else
{
    <ToolPageShell Tool="_tool"
                   Title="@L[_tool.TitleKey]"
                   Description="@L[_tool.DescriptionKey]"
                   GetStateJson="SerializeState"
                   OnDraftCleared="OnDraftCleared"
                   OnRunShortcut="RunPrimaryActionAsync"
                   OnExitFullscreen="ExitFullscreenAsync"
                   IsFullscreen="_isFullscreen">
        <ActionButtons>
            @if (_saveStatusKey is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" Class="text-muted align-self-center">@L[_saveStatusKey]</RadzenText>
            }
            <ResponsiveIconButton Text="@L[RK.Tools.ExportWorkspace]"
                                  Icon="download"
                                  ButtonStyle="ButtonStyle.Light"
                                  Disabled="@_busy"
                                  Click="ExportWorkspaceAsync" />
            <InputFile OnChange="ImportWorkspaceAsync"
                       accept=".json,application/json"
                       class="form-control form-control-sm"
                       aria-label="@L[RK.Tools.ImportWorkspace]" />
            @if (!IsCalculator())
            {
                @foreach (var action in GetActions())
                {
                    <ResponsiveIconButton Text="@action.Label"
                                          Icon="@action.Icon"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Disabled="@_busy"
                                          Click="@(() => RunAsync(action.Id))" />
                }
            }
        </ActionButtons>

        <ChildContent>
        <ErrorBoundary @ref="_toolErrorBoundary">
            <ChildContent>
        @if (IsCalculator())
        {
            <CalculatorToolView Tool="_tool"
                                State="_state"
                                StateChanged="OnCalculatorStateChanged"
                                AutoCalculateToken="_calculatorAutoCalculateToken" />
        }
        else
        {
        @if (!string.IsNullOrWhiteSpace(_warning))
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning"
                         Shade="Shade.Lighter"
                         Variant="Variant.Flat"
                         AllowClose="true"
                         Close="@(() => _warning = null)"
                         class="rz-mb-2">
                <strong>@L[RK.Tools.ValidationTitle]</strong>
                <div class="rz-mt-1">@_warning</div>
            </RadzenAlert>
        }

        @if (IsMarkdownPreview())
        {
            @if (_mdPreviewMode)
            {
                <RadzenStack Gap="0.75rem" Class="ThaiX-md-focus-preview">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween"
                                 Wrap="FlexWrap.Wrap"
                                 Gap="0.5rem">
                        <RadzenButton Icon="edit_note"
                                      Text="@L[RK.Tools.MarkdownPreview.ShowEditor]"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="ShowMarkdownEditor"
                                      title="@L[RK.Tools.MarkdownPreview.ShowEditor]"
                                      aria-label="@L[RK.Tools.MarkdownPreview.ShowEditor]" />
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                            <RadzenButton Icon="content_copy"
                                          Text="@L[RK.Tools.MarkdownPreview.CopyAll]"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Disabled="@(string.IsNullOrWhiteSpace(_previewHtml))"
                                          Click="CopyPreviewTextAsync" />
                            <RadzenButton Icon="code"
                                          Text="@L[RK.Tools.MarkdownPreview.CopyHtml]"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Disabled="@(string.IsNullOrWhiteSpace(_previewHtml))"
                                          Click="CopyPreviewHtmlAsync" />
                        </RadzenStack>
                    </RadzenStack>
                    @* Inner HTML is owned by JS (ThaiXSetMarkdownPreview) — do not use MarkupString here. *@
                    <div @ref="_previewRef" class="ThaiX-md-preview border rounded p-3 ThaiX-md-preview--focus"
                         style="min-height: min(70vh, 40rem); overflow: auto;"></div>
                </RadzenStack>
            }
            else
            {
                <DualPane>
                    <Left>
                        <MarkdownEditor Value="@_state.Input" ValueChanged="OnMarkdownInputChanged"
                                        Label="@L[RK.Tools.Input]"
                                        Placeholder="@L[RK.Tools.MarkdownPreview.EditorPlaceholder]"
                                        Rows="@(Viewport.IsMobile ? 14 : 22)" />
                    </Left>
                    <Right>
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween"
                                     Wrap="FlexWrap.Wrap"
                                     Gap="0.5rem"
                                     Class="mb-1">
                            <RadzenLabel Text="@L[RK.Tools.MarkdownPreview.Preview]" Class="mb-0" />
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Icon="content_copy"
                                              Text="@L[RK.Tools.MarkdownPreview.CopyAll]"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Disabled="@(string.IsNullOrWhiteSpace(_previewHtml))"
                                              Click="CopyPreviewTextAsync" />
                                <RadzenButton Icon="code"
                                              Text="@L[RK.Tools.MarkdownPreview.CopyHtml]"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Disabled="@(string.IsNullOrWhiteSpace(_previewHtml))"
                                              Click="CopyPreviewHtmlAsync" />
                            </RadzenStack>
                        </RadzenStack>
                        <div @ref="_previewRef" class="ThaiX-md-preview border rounded p-3"
                             style="min-height: 16rem; overflow: auto;"></div>
                    </Right>
                </DualPane>
            }
        }
        else if (IsQr())
        {
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem" RowGap="0.5rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L[RK.Tools.FieldLabel.ErrorCorrection]" Class="w-100">
                            <RadzenDropDown TValue="string"
                                            Data="@QrErrorCorrectionOptions"
                                            Value="@(string.IsNullOrWhiteSpace(_state.Option) ? "medium" : _state.Option)"
                                            ValueChanged="OnOptionChanged"
                                            Class="w-100" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="@L[RK.Tools.FieldLabel.QuietZone]" Class="w-100">
                            <RadzenNumeric TValue="int"
                                           Value="@_state.Number"
                                           ValueChanged="@((int value) => OnNumberChanged(value))"
                                           Min="0" Max="16"
                                           Class="w-100"
                                           aria-label="@L[RK.Tools.FieldLabel.QuietZone]" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <MonoTextArea Value="@_state.Input" ValueChanged="OnInputChanged"
                              Label="@L[RK.Tools.Input]" Rows="4" />
                @if (!string.IsNullOrWhiteSpace(_qrSvg))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                                 Wrap="FlexWrap.Wrap" Gap="1rem">
                        <div class="ThaiX-qr-preview border rounded p-3">@((MarkupString)_qrSvg)</div>
                        <RadzenButton Icon="download" Text="@L[RK.Tools.QrDownload]"
                                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Disabled="@_busy" Click="DownloadQrAsync" />
                    </RadzenStack>
                }
            </RadzenStack>
        }
        else
        {
            @if (NeedsOptions())
            {
                <RadzenRow Gap="1rem" RowGap="0.5rem" Class="mb-2">
                    @if (SlugEquals("diff"))
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.Flag" ValueChanged="@((bool value) => OnFlagChanged(value))" Name="sideBySide" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.SideBySide]" Component="sideBySide" Class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.IgnoreWhitespace" ValueChanged="@((bool value) => OnIgnoreWhitespaceChanged(value))" Name="ignoreWhitespace" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.IgnoreWhitespace]" Component="ignoreWhitespace" Class="rz-ms-2" />
                        </RadzenColumn>
                    }
                    @if (SlugEquals("regex"))
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.Flag" ValueChanged="@((bool value) => OnFlagChanged(value))" Name="ignoreCase" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.IgnoreCase]" Component="ignoreCase" Class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.RegexMultiline" ValueChanged="@((bool value) => OnRegexMultilineChanged(value))" Name="regexMultiline" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.Multiline]" Component="regexMultiline" Class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.RegexSingleline" ValueChanged="@((bool value) => OnRegexSinglelineChanged(value))" Name="regexSingleline" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.Singleline]" Component="regexSingleline" Class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="@L[RK.Tools.FieldLabel.Replacement]" Class="w-100">
                                <RadzenTextBox Value="@_state.Option"
                                               ValueChanged="OnOptionChanged"
                                               Class="w-100" />
                            </RadzenFormField>
                        </RadzenColumn>
                    }
                    @if (SlugEquals("uuid"))
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.Flag" ValueChanged="@((bool value) => OnFlagChanged(value))" Name="v7" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.UuidV7]" Component="v7" Class="rz-ms-2" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L[RK.Tools.FieldLabel.Format]" Class="w-100">
                                <RadzenDropDown TValue="string"
                                                Data="@UuidFormats"
                                                Value="@(string.IsNullOrWhiteSpace(_state.Option) ? "D" : _state.Option)"
                                                ValueChanged="OnOptionChanged"
                                                Class="w-100" />
                            </RadzenFormField>
                        </RadzenColumn>
                    }
                    @if (SlugEquals("password-generator"))
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="@L[RK.Tools.FieldLabel.Length]" Class="w-100">
                                <RadzenNumeric TValue="int" Value="@_state.Number" ValueChanged="@((int value) => OnNumberChanged(value))" Min="4" Max="128" Class="w-100" aria-label="@L[RK.Tools.FieldLabel.Length]" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.Flag" ValueChanged="@((bool value) => OnFlagChanged(value))" Name="sym" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.Symbols]" Component="sym" Class="rz-ms-2" />
                        </RadzenColumn>
                    }
                    @if (SlugEquals("curl") || SlugEquals("conventional-commit") || SlugEquals("gitignore") || SlugEquals("cron"))
                    {
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="@L[RK.Tools.FieldLabel.Option]" Class="w-100">
                                <RadzenTextBox Value="@_state.Option" ValueChanged="OnOptionChanged" Class="w-100"
                                               Placeholder="@(SlugEquals("gitignore") ? L[RK.Tools.FieldLabel.GitignorePreset].Value : SlugEquals("curl") ? L[RK.Tools.FieldLabel.HttpMethod].Value : SlugEquals("cron") ? L[RK.Tools.FieldLabel.CronExpression].Value : L[RK.Tools.FieldLabel.CommitScope].Value)" />
                            </RadzenFormField>
                        </RadzenColumn>
                    }
                    @if (SlugEquals("conventional-commit"))
                    {
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenCheckBox TValue="bool" Value="@_state.Flag" ValueChanged="@((bool value) => OnFlagChanged(value))" Name="brk" />
                            <RadzenLabel Text="@L[RK.Tools.FieldLabel.Breaking]" Component="brk" Class="rz-ms-2" />
                        </RadzenColumn>
                    }
                </RadzenRow>
            }

            @if (UsesSecondInput())
            {
                <RadzenStack Gap="1rem">
                    <DualPane>
                        <Left>
                            <MonoTextArea Value="@_state.Input" ValueChanged="OnInputChanged"
                                          Label="@LeftLabel()" Rows="@(Viewport.IsMobile ? 8 : 12)" />
                        </Left>
                        <Right>
                            <MonoTextArea Value="@_state.Input2" ValueChanged="OnInput2Changed"
                                          Label="@RightLabel()" Rows="@(Viewport.IsMobile ? 8 : 12)" />
                        </Right>
                    </DualPane>
                    <MonoTextArea Value="@_state.Output" ValueChanged="OnOutputChanged"
                                  Label="@L[RK.Tools.Output]" Rows="@(Viewport.IsMobile ? 8 : 12)" />
                </RadzenStack>
            }
            else if (IsInputOnly())
            {
                <MonoTextArea Value="@_state.Input" ValueChanged="OnInputChanged"
                              Label="@L[RK.Tools.Input]"
                              IsValid="@_inputValid"
                              Rows="@(Viewport.IsMobile ? 12 : 20)" />
            }
            else
            {
                <DualPane>
                    <Left>
                        <MonoTextArea Value="@_state.Input" ValueChanged="OnInputChanged"
                                      Label="@L[RK.Tools.Input]"
                                      IsValid="@(SlugEquals("json-formatter") ? _inputValid : null)"
                                      Rows="@(Viewport.IsMobile ? 10 : 16)" />
                    </Left>
                    <Right>
                        <MonoTextArea Value="@_state.Output" ValueChanged="OnOutputChanged"
                                      Label="@L[RK.Tools.Output]" Rows="@(Viewport.IsMobile ? 10 : 16)" />
                    </Right>
                </DualPane>
            }
        }
        }
            </ChildContent>
            <ErrorContent Context="ex">
                @{
                    OnToolRenderError(ex);
                }
                <RadzenAlert AlertStyle="AlertStyle.Warning"
                             Shade="Shade.Lighter"
                             Variant="Variant.Flat"
                             AllowClose="true"
                             Close="@(() => { _warning = null; _toolErrorBoundary?.Recover(); })"
                             class="rz-mb-2">
                    <strong>@L[RK.Tools.ValidationTitle]</strong>
                    <div class="rz-mt-1">@(string.IsNullOrWhiteSpace(_warning) ? L[RK.Tools.ValidationGeneric] : _warning)</div>
                </RadzenAlert>
            </ErrorContent>
        </ErrorBoundary>
        </ChildContent>
    </ToolPageShell>
}

@code {
    private static readonly string[] UuidFormats = ["D", "N", "B", "P", "X"];
    private static readonly string[] QrErrorCorrectionOptions = ["low", "medium", "quartile", "high"];

    [Parameter] public string Slug { get; set; } = string.Empty;

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    private ToolDefinition? _tool;
    private ToolWorkspaceState _state = new();
    private CancellationTokenSource? _debounceCts;
    private bool _loaded;
    private bool _busy;
    private string? _warning;
    private string _previewHtml = string.Empty;
    private string? _qrSvg;
    private ElementReference _previewRef;
    private bool _previewDirty;
    private int _previewEpoch;
    private bool _mdPreviewMode;
    private string? _calculatorAutoCalculateToken;
    private ErrorBoundary? _toolErrorBoundary;
    private string? _lastBoundaryErrorId;
    private bool? _inputValid;
    private string? _saveStatusKey;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _warning = null;
        _inputValid = null;
        _saveStatusKey = null;
        _qrSvg = null;
        _previewHtml = string.Empty;
        _mdPreviewMode = false;
        _calculatorAutoCalculateToken = null;
        _tool = ToolCatalog.Find(Slug);
        _state = new ToolWorkspaceState();
        if (_tool is null) return;

        try
        {
            await ToolStateStore.RecordLastUsedAsync(_tool);
        }
        catch
        {
            // Recent history is best-effort and must not block opening a tool.
        }

        try
        {
            var envelope = await ToolStateStore.LoadAsync(_tool);
            if (envelope is not null && !string.IsNullOrWhiteSpace(envelope.StateJson))
            {
                try { _state = JsonSerializer.Deserialize<ToolWorkspaceState>(envelope.StateJson, JsonOptions) ?? new(); }
                catch (JsonException) { _state = new ToolWorkspaceState { Input = envelope.StateJson }; }
            }

            if (envelope is null && ToolSampleCatalog.ShouldSeedSample(_tool, _state))
            {
                _state = ToolSampleCatalog.Create(_tool.Slug);
                if (IsCalculator())
                    _calculatorAutoCalculateToken = Guid.NewGuid().ToString("N");
            }

            if (IsCalculator())
            {
                _state.Fields ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                CalculatorFieldCatalog.EnsureDefaults(_tool.Slug, _state.Fields);
            }

            if (IsMarkdownPreview() && !string.IsNullOrWhiteSpace(_state.Input))
                await RefreshMarkdownAsync();
            if (IsQr() && !string.IsNullOrWhiteSpace(_state.Input))
            {
                try { _qrSvg = GeneratorToolTransforms.QrSvg(_state.Input, _state.Number, _state.Option); }
                catch (Exception ex) { ReportToolIssue(ex); }
            }
        }
        catch (Exception ex)
        {
            ReportToolIssue(ex);
        }

        _loaded = true;
    }

    private sealed class WorkspaceImportException(string resourceKey) : Exception
    {
        public string ResourceKey { get; } = resourceKey;
    }

    private async Task ExportWorkspaceAsync()
    {
        if (_tool is null) return;

        _busy = true;
        try
        {
            var export = new ToolWorkspaceExport
            {
                ToolSlug = _tool.Slug,
                State = _state
            };
            var content = JsonSerializer.SerializeToUtf8Bytes(export, JsonOptions);
            if (content.Length > ToolCatalog.MaxWorkspaceBytes)
                throw new WorkspaceImportException(RK.Tools.WorkspaceTooLarge);

            await FileDownloadService.DownloadAsync(
                $"{_tool.Slug}-workspace.json",
                "application/json",
                content);
            NotificationService.NotifySuccess(L[RK.Tools.ExportSuccess]);
        }
        catch (WorkspaceImportException ex)
        {
            NotificationService.NotifyWarning(L[RK.Tools.ValidationTitle], L[ex.ResourceKey]);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.Tools.ExportFailed], L[RK.Tools.ValidationGeneric]);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportWorkspaceAsync(InputFileChangeEventArgs args)
    {
        if (_tool is null) return;

        _busy = true;
        _warning = null;
        try
        {
            var file = args.File;
            if (file.Size > ToolCatalog.MaxWorkspaceBytes)
                throw new WorkspaceImportException(RK.Tools.WorkspaceTooLarge);

            await using var stream = file.OpenReadStream(ToolCatalog.MaxWorkspaceBytes);
            var export = await JsonSerializer.DeserializeAsync<ToolWorkspaceExport>(stream, JsonOptions);
            if (export is null || export.State is null)
                throw new WorkspaceImportException(RK.Tools.WorkspaceInvalid);
            if (export.Version != ToolCatalog.WorkspaceExportVersion)
                throw new WorkspaceImportException(RK.Tools.WorkspaceUnsupportedVersion);
            if (!export.ToolSlug.Equals(_tool.Slug, StringComparison.OrdinalIgnoreCase))
                throw new WorkspaceImportException(RK.Tools.WorkspaceWrongTool);

            _state = export.State;
            _state.Fields = _state.Fields is null
                ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                : new Dictionary<string, string>(_state.Fields, StringComparer.OrdinalIgnoreCase);

            if (IsCalculator())
            {
                CalculatorFieldCatalog.EnsureDefaults(_tool.Slug, _state.Fields);
                _calculatorAutoCalculateToken = Guid.NewGuid().ToString("N");
            }

            _previewHtml = string.Empty;
            _previewEpoch++;
            _previewDirty = false;
            _mdPreviewMode = false;
            _qrSvg = null;

            if (IsMarkdownPreview() && !string.IsNullOrWhiteSpace(_state.Input))
                await RefreshMarkdownAsync();
            if (IsQr() && !string.IsNullOrWhiteSpace(_state.Input))
                _qrSvg = GeneratorToolTransforms.QrSvg(_state.Input, _state.Number, _state.Option);

            await ToolStateStore.SaveLocalAsync(_tool, SerializeState());
            _saveStatusKey = RK.Tools.SaveSaved;
            NotificationService.NotifySuccess(L[RK.Tools.ImportSuccess]);
        }
        catch (WorkspaceImportException ex)
        {
            _warning = L[ex.ResourceKey];
        }
        catch (JsonException)
        {
            _warning = L[RK.Tools.WorkspaceInvalid];
        }
        catch (Exception ex)
        {
            ReportToolIssue(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool IsCalculator() => _tool?.Kind == ToolKind.Calculator;

    private async Task OnCalculatorStateChanged()
    {
        await ScheduleLocalSaveAsync();
    }

    private string SerializeState() => JsonSerializer.Serialize(_state, JsonOptions);

    private async Task OnDraftCleared()
    {
        // Clear means an explicitly saved empty workspace; do not re-seed samples after reload.
        _state = new ToolWorkspaceState();
        _previewHtml = string.Empty;
        _previewEpoch++;
        _previewDirty = false;
        _mdPreviewMode = false;
        _qrSvg = null;
        _warning = null;
        _inputValid = null;
        _toolErrorBoundary?.Recover();

        if (_tool is not null && IsCalculator())
        {
            _state.Fields ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            CalculatorFieldCatalog.EnsureDefaults(_tool.Slug, _state.Fields);
            _calculatorAutoCalculateToken = Guid.NewGuid().ToString("N");
        }

        if (_tool is not null)
        {
            _saveStatusKey = RK.Tools.SavePending;
            try
            {
                await ToolStateStore.SaveLocalAsync(_tool, SerializeState());
                _saveStatusKey = RK.Tools.SaveSaved;
            }
            catch (Exception ex)
            {
                _saveStatusKey = RK.Tools.SaveStatusFailed;
                ReportToolIssue(ex);
            }
        }
    }

    private void ShowMarkdownEditor()
    {
        _mdPreviewMode = false;
        // Preview host remounts in DualPane — re-apply HTML after render.
        _previewEpoch++;
        _previewDirty = true;
    }

    private void ReportToolIssue(Exception ex)
    {
        _warning = FormatToolIssue(ex);
    }

    private string FormatToolIssue(Exception ex) => ex switch
    {
        JsonException json when json.LineNumber is long line && json.BytePositionInLine is long column =>
            L[RK.Tools.ValidationJsonPosition, line + 1, column + 1],
        JsonException => L[RK.Tools.ValidationJson],
        CalculatorInputException => L[RK.Tools.ValidationFormat],
        FormatException or ArgumentException => L[RK.Tools.ValidationFormat],
        JSException => L[RK.Tools.ValidationBrowser],
        InvalidOperationException or NotSupportedException => L[RK.Tools.ValidationOperation],
        _ => L[RK.Tools.ValidationGeneric]
    };

    private void OnToolRenderError(Exception ex)
    {
        var id = ex.GetHashCode().ToString();
        if (id == _lastBoundaryErrorId) return;
        _lastBoundaryErrorId = id;
        ReportToolIssue(ex);
        // Recover so the tool stays interactive (no full-page error / reload).
        _toolErrorBoundary?.Recover();
    }

    private bool SlugEquals(string value) => Slug.Equals(value, StringComparison.OrdinalIgnoreCase);

    private bool UsesSecondInput() =>
        SlugEquals("json-compare") || SlugEquals("diff") || SlugEquals("regex")
        || SlugEquals("curl") || SlugEquals("conventional-commit");

    private bool IsMarkdownPreview() => SlugEquals("markdown-preview");
    private bool IsQr() => SlugEquals("qr");
    private bool IsInputOnly() => SlugEquals("yaml-validator");
    private bool UsesInputValidity() => SlugEquals("json-formatter") || SlugEquals("yaml-validator");

    private bool NeedsOptions() =>
        SlugEquals("uuid") || SlugEquals("password-generator")
        || SlugEquals("curl") || SlugEquals("conventional-commit")
        || SlugEquals("gitignore") || SlugEquals("cron") || SlugEquals("regex") || SlugEquals("diff");

    private string LeftLabel() => Slug.ToLowerInvariant() switch
    {
        "regex" => L[RK.Tools.FieldLabel.InputText].Value,
        "curl" => L[RK.Tools.FieldLabel.Url].Value,
        "conventional-commit" => L[RK.Tools.FieldLabel.Subject].Value,
        _ => L[RK.Tools.Input].Value
    };

    private string RightLabel() => Slug.ToLowerInvariant() switch
    {
        "regex" => L[RK.Tools.FieldLabel.Pattern].Value,
        "curl" => L[RK.Tools.FieldLabel.Headers].Value,
        "conventional-commit" => L[RK.Tools.FieldLabel.Body].Value,
        _ => L[RK.Tools.Output].Value
    };

    private IEnumerable<(string Id, string Label, string Icon)> GetActions() => Slug.ToLowerInvariant() switch
    {
