    private async Task ScheduleLocalSaveAsync()
    {
        if (!_loaded || _tool is null) return;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        _saveStatusKey = RK.Tools.SavePending;
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(400, token);
            await ToolStateStore.SaveLocalAsync(_tool, SerializeState(), token);
            _saveStatusKey = RK.Tools.SaveSaved;
        }
        catch (OperationCanceledException) { }
        catch
        {
            _saveStatusKey = RK.Tools.SaveStatusFailed;
        }

        if (!token.IsCancellationRequested)
        {
            try { await InvokeAsync(StateHasChanged); }
            catch { /* component is being disposed */ }
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
