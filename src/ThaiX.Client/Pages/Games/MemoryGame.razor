@inherits GameBase

<div class="d-flex flex-wrap align-items-center justify-content-center gap-2 p-2">
    <span class="small text-muted">@L[ResourceKeys.Games.TypingDifficulty]</span>
    <button type="button" class="btn btn-sm @DifficultyButtonClass("easy")"
            aria-pressed="@(_difficulty == "easy")" @onclick="() => SetDifficulty("easy")">
        @L[ResourceKeys.Games.TypingEasy]
    </button>
    <button type="button" class="btn btn-sm @DifficultyButtonClass("medium")"
            aria-pressed="@(_difficulty == "medium")" @onclick="() => SetDifficulty("medium")">
        @L[ResourceKeys.Games.TypingMedium]
    </button>
    <button type="button" class="btn btn-sm @DifficultyButtonClass("hard")"
            aria-pressed="@(_difficulty == "hard")" @onclick="() => SetDifficulty("hard")">
        @L[ResourceKeys.Games.TypingHard]
    </button>
</div>

<svg class="game-svg" viewBox="@($"0 0 480 {_rows * 116 + 52}")">
    @for (var i = 0; i < _values.Length; i++)
    {
        var index = i;
        var left = 14 + i % 4 * 116;
        var top = 14 + i / 4 * 116;
        var shown = _open[i] || _matched[i];
        <g class="g-hit" @onclick="() => FlipAsync(index)">
            <rect x="@left" y="@top" width="104" height="104" rx="12" fill="@(shown ? "#e2e8f0" : "#334155")" />
            <g>
                <text x="@(left + 52)" y="@(top + 52)" font-size="@(shown ? 46 : 34)"
                      fill="@(shown ? "#0f172a" : "#f8fafc")">@(shown ? (MarkupString)FruitGlyph(_values[i]) : (MarkupString)"?")</text>
            </g>
            @if (_cursor == i)
            {
                <rect class="g-cursor" x="@(left + 3)" y="@(top + 3)" width="98" height="98" rx="10" />
            }
        </g>
    }
    <text class="g-muted" x="240" y="@(_rows * 116 + 38)">@L[ResourceKeys.Games.Moves]: @_moves</text>
</svg>

@code {
    private const int MismatchDelayMilliseconds = 700;
    private const int ColumnCount = 4;

    private static readonly int[] FruitCodePoints =
    [
        0x1F34E, 0x1F34C, 0x1F353, 0x1F349, 0x1F95D, 0x1F352,
        0x1F96D, 0x1F34D, 0x1F951, 0x1F347, 0x1F965, 0x1F350
    ];

    private int[] _values = [];
    private bool[] _open = [];
    private bool[] _matched = [];
    private int _first;
    private int _cursor;
    private int _moves;
    private int _round;
    private int _rows = 3;
    private bool _locked;
    private string _difficulty = "easy";

    protected override void Reset()
    {
        var pairCount = _difficulty switch
        {
            "medium" => 8,
            "hard" => 12,
            _ => 6
        };

        _rows = pairCount * 2 / ColumnCount;
        _values = Enumerable.Range(0, pairCount)
            .SelectMany(index => new[] { index, index })
            .ToArray();
        Random.Shared.Shuffle(_values);

        _open = new bool[_values.Length];
        _matched = new bool[_values.Length];
        _first = -1;
        _cursor = 0;
        _moves = 0;
        _locked = false;
        _round++;
    }

    protected override void OnKey(string key)
    {
        var (row, column) = (_cursor / ColumnCount, _cursor % ColumnCount);
        switch (key)
        {
            case "arrowleft": column = Math.Max(0, column - 1); break;
            case "arrowright": column = Math.Min(ColumnCount - 1, column + 1); break;
            case "arrowup": row = Math.Max(0, row - 1); break;
            case "arrowdown": row = Math.Min(_rows - 1, row + 1); break;
            case "enter" or " ": _ = FlipAsync(_cursor); return;
        }

        _cursor = row * ColumnCount + column;
    }

    private void SetDifficulty(string difficulty)
    {
        if (!CanPlay || _difficulty == difficulty)
            return;

        _difficulty = difficulty;
        Restart();
    }

    private string DifficultyButtonClass(string difficulty) =>
        _difficulty == difficulty ? "btn-primary" : "btn-outline-secondary";

    private static string FruitGlyph(int index) => char.ConvertFromUtf32(FruitCodePoints[index]);

    private async Task FlipAsync(int index)
    {
        if (!CanPlay || _locked || _open[index] || _matched[index])
            return;

        _cursor = index;
        _open[index] = true;
        if (_first < 0)
        {
            _first = index;
            return;
        }

        var first = _first;
        _first = -1;
        _moves++;
        if (_values[first] == _values[index])
        {
            _matched[first] = _matched[index] = true;
            if (_matched.All(matched => matched))
                Finish(_moves, _difficulty);
            return;
        }

        // Keep the mismatched pair visible briefly; a restart in the meantime cancels the flip back.
        _locked = true;
        var round = _round;
        StateHasChanged();
        await Task.Delay(MismatchDelayMilliseconds);
        if (round != _round)
            return;

        _open[first] = _open[index] = false;
        _locked = false;
        StateHasChanged();
    }
}
