@using ThaiX.Client.Services.Games
@inherits GameBase

<svg class="game-svg" viewBox="0 0 360 480" @onpointerdown="SwipeStart" @onpointerup="SwipeEnd">
    <text class="g-muted" x="145" y="15">@L[ResourceKeys.Games.Score]: @_engine.Score</text>
    <rect x="@Left" y="@Top" width="@(TetrisEngine.Columns * Cell)" height="@(TetrisEngine.Rows * Cell)" fill="#0b1220" />
    @for (var y = 0; y < TetrisEngine.Rows; y++)
    {
        for (var x = 0; x < TetrisEngine.Columns; x++)
        {
            var kind = _engine.Board[y, x];
            if (kind != 0)
            {
                <rect x="@(Left + x * Cell + 1)" y="@(Top + y * Cell + 1)" width="@(Cell - 2)" height="@(Cell - 2)" rx="3" fill="@PieceColor(kind)" />
            }
        }
    }
    @for (var y = 0; y < _engine.CurrentShape.Length; y++)
    {
        for (var x = 0; x < _engine.CurrentShape[y].Length; x++)
        {
            if (_engine.CurrentShape[y][x] != 0 && _engine.GhostY + y >= 0)
            {
                <rect x="@(Left + (_engine.PieceX + x) * Cell + 1)" y="@(Top + (_engine.GhostY + y) * Cell + 1)"
                      width="@(Cell - 2)" height="@(Cell - 2)" rx="3" fill="none" stroke="#94a3b8" stroke-width="1.5" opacity="0.7" />
            }
        }
    }
    @for (var y = 0; y < _engine.CurrentShape.Length; y++)
    {
        for (var x = 0; x < _engine.CurrentShape[y].Length; x++)
        {
            if (_engine.CurrentShape[y][x] != 0 && _engine.PieceY + y >= 0)
            {
                <rect x="@(Left + (_engine.PieceX + x) * Cell + 1)" y="@(Top + (_engine.PieceY + y) * Cell + 1)"
                      width="@(Cell - 2)" height="@(Cell - 2)" rx="3" fill="@PieceColor((int)_engine.CurrentKind)" />
            }
        }
    }
    @for (var i = 0; i < Buttons.Length; i++)
    {
        var button = Buttons[i];
        var left = 9 + i * 70;
        <g class="g-hit" @onclick="() => OnKey(button.Key)">
            <rect x="@left" y="440" width="62" height="34" rx="5" fill="#334155" />
            <text x="@(left + 31)" y="457" font-size="13">@(button.LabelKey is null ? button.Text : L[button.LabelKey].Value)</text>
        </g>
    }
</svg>

@code {
    private const int Cell = 20;
    private const int Left = 45;
    private const int Top = 30;

    private static readonly (string Key, string Text, string? LabelKey)[] Buttons =
    [
        ("arrowleft", "<", null),
        ("arrowup", string.Empty, ResourceKeys.Games.KeyRotate),
        ("arrowright", ">", null),
        (" ", string.Empty, ResourceKeys.Games.KeyDrop),
        ("c", "H", null)
    ];

    private readonly TetrisEngine _engine = new();

    protected override void Reset()
    {
        _engine.Reset();
        StartLoop(50, Tick);
    }

    protected override void OnKey(string key)
    {
        switch (key)
        {
            case "arrowleft" or "a":
                _engine.Move(-1, 0);
                break;
            case "arrowright" or "d":
                _engine.Move(1, 0);
                break;
            case "arrowdown" or "s":
                _engine.SoftDrop();
                break;
            case "arrowup" or "w":
                _engine.RotateClockwise();
                break;
            case " ":
                _engine.HardDrop();
                break;
            case "c":
                _engine.Hold();
                break;
        }

        if (_engine.IsFinished)
            Finish(_engine.Score);
    }

    private void Tick()
    {
        _engine.Advance(TimeSpan.FromMilliseconds(50));
        if (_engine.IsFinished)
            Finish(_engine.Score);
    }

    private static string PieceColor(int kind) => (TetrisPieceKind)kind switch
    {
        TetrisPieceKind.I => "#38bdf8",
        TetrisPieceKind.O => "#facc15",
        TetrisPieceKind.T => "#a78bfa",
        TetrisPieceKind.J => "#3b82f6",
        TetrisPieceKind.L => "#f59e0b",
        TetrisPieceKind.S => "#22c55e",
        TetrisPieceKind.Z => "#ef4444",
        _ => "#64748b"
    };
}
