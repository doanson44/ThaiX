@using System.Diagnostics
@using ThaiX.Client.Services.Games
@inherits GameBase

<div class="flappy-game">
    <button type="button" class="flappy-playfield"
            aria-label="@L[ResourceKeys.Games.NameFlappy]"
            aria-describedby="game-instructions"
            @onclick="Flap">
        <svg class="flappy-canvas" viewBox="0 0 @FlappyEngine.BoardWidth @FlappyEngine.BoardHeight" role="img" aria-label="@L[ResourceKeys.Games.NameFlappy]">
            <defs>
                <linearGradient id="flappy-sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0f4568" />
                    <stop offset="100%" stop-color="#0b6384" />
                </linearGradient>
                <linearGradient id="flappy-pipe" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#15803d" />
                    <stop offset="45%" stop-color="#22c55e" />
                    <stop offset="100%" stop-color="#166534" />
                </linearGradient>
            </defs>

            <rect width="720" height="480" fill="#101827" />
            <text class="flappy-title" x="360" y="31">@L[ResourceKeys.Games.NameFlappy]</text>
            <text class="flappy-score" x="24" y="31">@L[ResourceKeys.Games.Score]: @_engine.Score</text>
            <rect x="0" y="45" width="720" height="423" fill="url(#flappy-sky)" />

            <g class="flappy-clouds" aria-hidden="true">
                <path d="M45 112c0-13 11-23 24-23 5-15 27-19 37-6 16-3 29 9 29 24 0 2 0 4-1 5H46c-1 0-1-1-1-0Z" />
                <path d="M500 145c0-10 8-18 18-18 4-12 21-15 29-5 13-2 23 7 23 19 0 2 0 3-1 4h-68c-1 0-1 0-1 0Z" />
            </g>

            @foreach (var pipe in _engine.Pipes)
            {
                var gapTop = pipe.GapCenter - FlappyEngine.GapHeight / 2;
                var gapBottom = pipe.GapCenter + FlappyEngine.GapHeight / 2;
                <g class="flappy-pipe">
                    <rect x="@SvgNumber(pipe.X)" y="@SvgNumber(FlappyEngine.PlayTop)" width="@SvgNumber(FlappyEngine.PipeWidth)" height="@SvgNumber(Math.Max(0, gapTop - FlappyEngine.PlayTop))" fill="url(#flappy-pipe)" />
                    <rect x="@SvgNumber(pipe.X - 4)" y="@SvgNumber(gapTop - 12)" width="@SvgNumber(FlappyEngine.PipeWidth + 8)" height="12" rx="3" fill="#4ade80" />
                    <rect x="@SvgNumber(pipe.X + 7)" y="@SvgNumber(FlappyEngine.PlayTop)" width="4" height="@SvgNumber(Math.Max(0, gapTop - FlappyEngine.PlayTop - 12))" fill="#86efac" opacity="0.65" />

                    <rect x="@SvgNumber(pipe.X)" y="@SvgNumber(gapBottom)" width="@SvgNumber(FlappyEngine.PipeWidth)" height="@SvgNumber(Math.Max(0, FlappyEngine.FloorY - gapBottom))" fill="url(#flappy-pipe)" />
                    <rect x="@SvgNumber(pipe.X - 4)" y="@SvgNumber(gapBottom)" width="@SvgNumber(FlappyEngine.PipeWidth + 8)" height="12" rx="3" fill="#4ade80" />
                    <rect x="@SvgNumber(pipe.X + 7)" y="@SvgNumber(gapBottom + 12)" width="4" height="@SvgNumber(Math.Max(0, FlappyEngine.FloorY - gapBottom - 12))" fill="#86efac" opacity="0.65" />
                </g>
            }

            <rect x="0" y="@SvgNumber(FlappyEngine.FloorY)" width="720" height="12" fill="#075985" />
            <path d="M0 468h720" stroke="#38bdf8" stroke-width="2" opacity="0.65" />

            <g transform="@BirdTransform">
                <circle cx="@SvgNumber(FlappyEngine.BirdX)" cy="@SvgNumber(_engine.BirdY)" r="@SvgNumber(FlappyEngine.BirdRadius)" fill="#facc15" />
                <circle cx="110" cy="@SvgNumber(_engine.BirdY - 5)" r="2.5" fill="#0f172a" />
                <path d="M117 @SvgNumber(_engine.BirdY) l10 3-10 3Z" fill="#fb923c" />
                <path d="M95 @SvgNumber(_engine.BirdY + 12) q9 5 16 0" fill="none" stroke="#eab308" stroke-width="2" />
            </g>
        </svg>
    </button>
</div>

@code {
    private const int TickMilliseconds = 16;

    private readonly FlappyEngine _engine = new();
    private long _lastTickTimestamp;
    private bool? _lastPaused;

    private double BirdRotation => Math.Clamp(_engine.BirdVelocity / 10, -22, 65);
    private string BirdTransform => $"rotate({SvgNumber(BirdRotation)} {SvgNumber(FlappyEngine.BirdX)} {SvgNumber(_engine.BirdY)})";

    private string SvgNumber(double value) => Px(value);

    protected override void Reset()
    {
        _engine.Reset();
        _lastTickTimestamp = Stopwatch.GetTimestamp();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_lastPaused != IsPaused)
        {
            _lastTickTimestamp = Stopwatch.GetTimestamp();
            _lastPaused = IsPaused;
        }
    }

    protected override void OnKey(string key)
    {
        if (key is " " or "enter" or "arrowup")
            Flap();
    }

    private void Flap()
    {
        if (!CanPlay)
            return;

        var wasStarted = _engine.HasStarted;
        _engine.Flap();

        if (!wasStarted)
        {
            RestartClock();
            _lastTickTimestamp = Stopwatch.GetTimestamp();
            StartLoop(TickMilliseconds, Tick);
        }
    }

    private void Tick()
    {
        var now = Stopwatch.GetTimestamp();
        var elapsedSeconds = Stopwatch.GetElapsedTime(_lastTickTimestamp, now).TotalSeconds;
        _lastTickTimestamp = now;

        _engine.Advance(elapsedSeconds);

        if (_engine.IsFinished)
            Finish(_engine.Score);
    }
}
