@inherits GameBase

<div class="flappy-game">
    <button type="button" class="flappy-playfield"
            aria-label="@L[ResourceKeys.Games.NameFlappy]"
            aria-describedby="game-instructions"
            @onclick="Flap">
        <svg class="flappy-canvas" viewBox="0 0 720 480" role="img" aria-label="@L[ResourceKeys.Games.NameFlappy]">
            <defs>
                <linearGradient id="flappy-sky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0f4568" />
                    <stop offset="100%" stop-color="#0b6384" />
                </linearGradient>
                <linearGradient id="flappy-pipe" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#15803d" />
                    <stop offset="45%" stop-color="#22c55e" />
                    <stop offset="100%" stop-color="#166534" />
                </linearGradient>
            </defs>

            <rect width="720" height="480" fill="#101827" />
            <text class="flappy-title" x="360" y="31">@L[ResourceKeys.Games.NameFlappy]</text>
            <text class="flappy-score" x="24" y="31">@L[ResourceKeys.Games.Score]: @_score</text>
            <rect x="0" y="45" width="720" height="423" fill="url(#flappy-sky)" />

            <g class="flappy-clouds" aria-hidden="true">
                <path d="M45 112c0-13 11-23 24-23 5-15 27-19 37-6 16-3 29 9 29 24 0 2 0 4-1 5H46c-1 0-1-1-1-0Z" />
                <path d="M500 145c0-10 8-18 18-18 4-12 21-15 29-5 13-2 23 7 23 19 0 2 0 3-1 4h-68c-1 0-1 0-1 0Z" />
            </g>

            @foreach (var pipe in _pipes)
            {
                var gapTop = pipe.GapCenter - GapHeight / 2;
                var gapBottom = pipe.GapCenter + GapHeight / 2;
                <g class="flappy-pipe">
                    <rect x="@SvgNumber(pipe.X)" y="@SvgNumber(PlayTop)" width="@SvgNumber(PipeWidth)" height="@SvgNumber(Math.Max(0, gapTop - PlayTop))" fill="url(#flappy-pipe)" />
                    <rect x="@SvgNumber(pipe.X - 4)" y="@SvgNumber(gapTop - 12)" width="@SvgNumber(PipeWidth + 8)" height="12" rx="3" fill="#4ade80" />
                    <rect x="@SvgNumber(pipe.X + 7)" y="@SvgNumber(PlayTop)" width="4" height="@SvgNumber(Math.Max(0, gapTop - PlayTop - 12))" fill="#86efac" opacity="0.65" />

                    <rect x="@SvgNumber(pipe.X)" y="@SvgNumber(gapBottom)" width="@SvgNumber(PipeWidth)" height="@SvgNumber(Math.Max(0, FloorY - gapBottom))" fill="url(#flappy-pipe)" />
                    <rect x="@SvgNumber(pipe.X - 4)" y="@SvgNumber(gapBottom)" width="@SvgNumber(PipeWidth + 8)" height="12" rx="3" fill="#4ade80" />
                    <rect x="@SvgNumber(pipe.X + 7)" y="@SvgNumber(gapBottom + 12)" width="4" height="@SvgNumber(Math.Max(0, FloorY - gapBottom - 12))" fill="#86efac" opacity="0.65" />
                </g>
            }

            <rect x="0" y="@SvgNumber(FloorY)" width="720" height="12" fill="#075985" />
            <path d="M0 468h720" stroke="#38bdf8" stroke-width="2" opacity="0.65" />

            <g transform="@BirdTransform">
                <circle cx="105" cy="@SvgNumber(_birdY)" r="15" fill="#facc15" />
                <circle cx="110" cy="@SvgNumber(_birdY - 5)" r="2.5" fill="#0f172a" />
                <path d="M117 @SvgNumber(_birdY) l10 3-10 3Z" fill="#fb923c" />
                <path d="M95 @SvgNumber(_birdY + 12) q9 5 16 0" fill="none" stroke="#eab308" stroke-width="2" />
            </g>
        </svg>
    </button>
</div>

@code {
    private const double BirdX = 105;
    private const double BirdRadius = 15;
    private const double PipeWidth = 55;
    private const double GapHeight = 170;
    private const double PlayTop = 45;
    private const double FloorY = 468;
    private const int TickMilliseconds = 30;
    private const int PipeSpawnFrames = 95;

    private readonly List<Pipe> _pipes = [];
    private double _birdY;
    private double _velocity;
    private int _frame;
    private int _score;
    private bool _hasStarted;

    private double BirdRotation => Math.Clamp(_velocity * 3, -22, 65);
    private string BirdTransform => $"rotate({SvgNumber(BirdRotation)} 105 {SvgNumber(_birdY)})";

    private static string SvgNumber(double value) => Px(value);

    protected override void Reset()
    {
        _birdY = 230;
        _velocity = 0;
        _frame = 0;
        _score = 0;
        _hasStarted = false;
        _pipes.Clear();
        _pipes.Add(new Pipe(560, 235));
        StartLoop(TickMilliseconds, Tick);
    }

    protected override void OnKey(string key)
    {
        if (key is " " or "enter" or "arrowup")
            Flap();
    }

    private void Flap()
    {
        if (!CanPlay)
            return;

        // The round, and its clock, only start with the first flap.
        if (!_hasStarted)
        {
            _hasStarted = true;
            RestartClock();
        }

        _velocity = -6.5;
    }

    private void Tick()
    {
        if (_hasStarted && UpdateGame())
            Finish(_score);
    }

    private bool UpdateGame()
    {
        _frame++;
        _velocity += 0.42;
        _birdY += _velocity;

        if (_frame % PipeSpawnFrames == 0)
            _pipes.Add(new Pipe(740, 180 + Random.Shared.NextDouble() * 100));

        foreach (var pipe in _pipes)
            pipe.X -= 3;

        _pipes.RemoveAll(pipe => pipe.X < -PipeWidth - 8);

        foreach (var pipe in _pipes)
        {
            if (!pipe.Passed && pipe.X + PipeWidth + 4 < BirdX)
            {
                pipe.Passed = true;
                _score++;
            }

            var gapTop = pipe.GapCenter - GapHeight / 2;
            var gapBottom = pipe.GapCenter + GapHeight / 2;
            var overlapsPipe = BirdX + BirdRadius > pipe.X - 4
                && BirdX - BirdRadius < pipe.X + PipeWidth + 4;
            var outsideGap = _birdY - BirdRadius < gapTop
                || _birdY + BirdRadius > gapBottom;

            if (overlapsPipe && outsideGap)
            {
                FinishGame();
                return true;
            }
        }

        if (_birdY - BirdRadius < PlayTop || _birdY + BirdRadius > FloorY)
        {
            FinishGame();
            return true;
        }

        return false;
    }

    private void FinishGame() =>
        _birdY = Math.Clamp(_birdY, PlayTop + BirdRadius, FloorY - BirdRadius);

    private sealed class Pipe(double x, double gapCenter)
    {
        public double X { get; set; } = x;
        public double GapCenter { get; } = gapCenter;
        public bool Passed { get; set; }
    }
}
