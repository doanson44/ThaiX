@page "/games/{GameId}"
@using ThaiX.Client.Layout
@using System.Net
@using ThaiX.Client.Models.Games
@using ThaiX.Client.Services.Api
@using ThaiX.Client.Services.Games
@implements IAsyncDisposable
@implements IDisposable
@inherits ThaiXPageBase
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject GameScoreStore ScoreStore
@inject IGameLeaderboardClient LeaderboardClient

<PageTitle>@(Game is null ? L[ResourceKeys.Games.Title].Value : L[Game.TitleKey].Value) - ThaiX</PageTitle>

@if (Game is null)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" ShowValue="false" Class="w-100" />
}
else
{
    <RadzenStack Gap="1rem" Class="game-player">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <RadzenButton Text="@L[ResourceKeys.Games.BackToGames]" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                          Click="BackToGames" />
            <div class="d-flex gap-2">
                <RadzenButton Text="@L[ResourceKeys.Games.Restart]" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                              Click="RestartAsync" />
                <RadzenButton Text="@(_isPaused ? L[ResourceKeys.Games.Resume] : L[ResourceKeys.Games.Pause])"
                              Icon="@(_isPaused ? "play_arrow" : "pause")" ButtonStyle="ButtonStyle.Light"
                              Click="TogglePauseAsync" />
            </div>
        </div>

        <div>
            <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H5 : Viewport.IsTablet ? TextStyle.H4 : TextStyle.H3)" TagName="TagName.H1" Class="mb-1">
                @L[Game.TitleKey]
            </RadzenText>
            <p class="text-muted mb-0">@L[Game.DescriptionKey]</p>
        </div>

        <RadzenCard Class="game-stage">
            <div class="game-instructions mb-3">
                <strong>@L[ResourceKeys.Games.Instructions]:</strong>
                <span>@L[Game.InstructionsKey]</span>
            </div>
            <canvas @ref="_canvas" class="game-canvas" tabindex="0" role="application"
                    aria-label="@L[Game.TitleKey]"></canvas>
            @if (!string.IsNullOrWhiteSpace(_gameStatusMessage))
            {
                <p class="text-muted mt-2 mb-0" role="status" aria-live="polite">@_gameStatusMessage</p>
            }
            @if (Game.Id == "typing-speed")
            {
                <input @ref="_typingInput" class="form-control mt-3" type="text" autocomplete="off"
                       aria-label="@L[ResourceKeys.Games.NameTyping]" placeholder="@L[ResourceKeys.Games.InstructionsTyping]" />
            }
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <RadzenAlert AlertStyle="@(_syncFailed ? AlertStyle.Warning : AlertStyle.Info)" Variant="Variant.Flat" Class="mt-3 mb-0">
                    @_statusMessage
                </RadzenAlert>
                @if (_syncFailed)
                {
                    <RadzenButton Text="@L[ResourceKeys.Games.RetrySync]" Icon="refresh"
                                  ButtonStyle="ButtonStyle.Secondary" Click="RetrySyncAsync" Class="mt-2" />
                }
            }
        </RadzenCard>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenCard Class="h-100">
                    <div class="text-muted small">@L[ResourceKeys.Games.Best]</div>
                    <div class="fs-3 fw-semibold">@(_localScores.BestScore?.ToString("N0") ?? "—")</div>
                    <div class="small text-muted">@L[Game.ScoreKey]</div>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenCard Class="h-100">
                    <h2 class="h6">@L[ResourceKeys.Games.Leaderboard]</h2>
                    @if (_leaderboard.Count == 0)
                    {
                        <p class="text-muted mb-0">@L[ResourceKeys.Games.NoScores]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>@L[ResourceKeys.Games.Rank]</th><th>@L[ResourceKeys.Games.Player]</th><th>@L[Game.ScoreKey]</th></tr></thead>
                                <tbody>
                                    @for (var i = 0; i < _leaderboard.Count; i++)
                                    {
                                        <tr><td>@(i + 1)</td><td>@_leaderboard[i].PlayerName</td><td>@_leaderboard[i].Score.ToString("N0")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        @if (_showGuestPrompt)
        {
            <RadzenCard>
                <h2 class="h6">@L[ResourceKeys.Games.GuestPrompt]</h2>
                <RadzenTextBox @bind-Value="_guestName" Placeholder="@L[ResourceKeys.Games.GuestNickname]"
                               Class="w-100 mb-2" MaxLength="24" />
                <div class="d-flex flex-wrap gap-2">
                    <RadzenButton Text="@L[ResourceKeys.Games.JoinLeaderboard]" Icon="leaderboard"
                                  ButtonStyle="ButtonStyle.Primary" Disabled="@(!IsGuestNameValid)"
                                  Click="JoinLeaderboardAsync" />
                    <RadzenButton Text="@L[ResourceKeys.Games.LocalOnly]" ButtonStyle="ButtonStyle.Light"
                                  Click="KeepLocalAsync" />
                </div>
            </RadzenCard>
        }

        <RadzenCard>
            <h2 class="h6">@L[ResourceKeys.Games.History]</h2>
            @if (_localScores.History.Count == 0)
            {
                <p class="text-muted mb-0">@L[ResourceKeys.Games.NoScores]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>@L[ResourceKeys.Games.Date]</th><th>@L[Game.ScoreKey]</th><th>@L[ResourceKeys.Games.TimeSeconds]</th></tr></thead>
                        <tbody>
                            @foreach (var run in _localScores.History.Take(10))
                            {
                                <tr><td>@run.AchievedAtUtc.ToLocalTime().ToString("g")</td><td>@run.Score.ToString("N0")</td><td>@run.DurationSeconds</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </RadzenCard>
    </RadzenStack>
}

@code {
    [Parameter] public string GameId { get; set; } = string.Empty;

    private ElementReference _canvas;
    private ElementReference _typingInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<GamePlayer>? _dotNetReference;
    private GameLocalScoreState _localScores = new();
    private IReadOnlyList<GameLeaderboardEntryModel> _leaderboard = [];
    private GameDefinition? Game;
    private string _guestName = string.Empty;
    private string? _pendingMode;
    private Guid _pendingRunId;
    private decimal _pendingScore;
    private int _pendingDuration;
    private string? _statusMessage;
    private string? _gameStatusMessage;
    private bool _showGuestPrompt;
    private bool IsGuestNameValid => !string.IsNullOrWhiteSpace(_guestName) && _guestName.Trim().Length >= 2;
    private bool _isPaused;
    private bool _syncFailed;
    private bool _pendingAuthenticated;

    protected override void OnInitialized()
    {
        Viewport.OnBreakpointChanged += StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Game = GameCatalog.Find(GameId);
        if (Game is null)
        {
            Navigation.NavigateTo("/games");
            return;
        }

        _localScores = await ScoreStore.GetAsync(Game.Id);
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            _showGuestPrompt = false;
            _guestName = await ScoreStore.GetGuestNameAsync() ?? string.Empty;
        }

        await RefreshLeaderboardAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Viewport.InitializeAsync();
        StateHasChanged();
        if (Game is null)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/games.js");
        _dotNetReference = DotNetObjectReference.Create(this);
        var canvasText = new
        {
            title = L[Game.TitleKey].Value,
            gameOver = L[ResourceKeys.Games.GameOver].Value,
            paused = L[ResourceKeys.Games.Paused].Value,
            restartHint = L[ResourceKeys.Games.RestartHint].Value,
            score = L[ResourceKeys.Games.Score].Value,
            flags = L[ResourceKeys.Games.Flags].Value,
            moves = L[ResourceKeys.Games.Moves].Value,
            passed = L[ResourceKeys.Games.Passed].Value,
            wrongGuesses = L[ResourceKeys.Games.WrongGuesses].Value,
            time = L[ResourceKeys.Games.Time].Value,
            typingStart = L[ResourceKeys.Games.TypingStart].Value,
            youAreX = L[ResourceKeys.Games.YouAreX].Value,
            youAreYellow = L[ResourceKeys.Games.YouAreYellow].Value,
            wordleWords = L[ResourceKeys.Games.WordleWords].Value,
            hangmanWords = L[ResourceKeys.Games.HangmanWords].Value,
            typingPassage = L[ResourceKeys.Games.TypingPassage].Value
        };
        _controller = await _module.InvokeAsync<IJSObjectReference>("mount", _canvas, Game.Id, _dotNetReference, _typingInput, canvasText);
    }

    [JSInvokable]
    public async Task OnGameCompleted(double score, int durationSeconds, string? mode)
    {
        if (Game is null)
            return;

        _pendingRunId = Guid.NewGuid();
        _pendingScore = Convert.ToDecimal(score);
        _gameStatusMessage = $"{L[ResourceKeys.Games.GameOver].Value}: {L[ResourceKeys.Games.Score].Value} {_pendingScore:N0}";
        _pendingDuration = Math.Clamp(durationSeconds, 1, 86_400);
        _pendingMode = mode;
        _localScores = await ScoreStore.SaveAsync(Game.Id, _pendingRunId, _pendingScore, _pendingDuration, mode);
        await InvokeAsync(StateHasChanged);

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _pendingAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        if (_pendingAuthenticated)
        {
            await SubmitPendingScoreAsync(true);
            return;
        }

        var choice = await ScoreStore.GetGuestChoiceAsync();
        if (choice == "joined")
        {
            _guestName = await ScoreStore.GetGuestNameAsync() ?? "Guest";
            await SubmitPendingScoreAsync(false);
        }
        else if (choice is null)
        {
            _showGuestPrompt = true;
            _statusMessage = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task JoinLeaderboardAsync()
    {
        if (!IsGuestNameValid)
            return;

        await ScoreStore.SetGuestNameAsync(_guestName.Trim());
        await ScoreStore.SetGuestChoiceAsync(true);
        _showGuestPrompt = false;
        await SubmitPendingScoreAsync(false);
    }

    private async Task KeepLocalAsync()
    {
        await ScoreStore.SetGuestChoiceAsync(false);
        _showGuestPrompt = false;
        _statusMessage = null;
    }

    private async Task RetrySyncAsync() => await SubmitPendingScoreAsync(_pendingAuthenticated);

    private async Task SubmitPendingScoreAsync(bool authenticated)
    {
        if (Game is null)
            return;

        try
        {
            GuestSessionModel? guestSession = null;
            if (!authenticated)
            {
                guestSession = await ScoreStore.GetGuestSessionAsync();
                if (guestSession is null)
                {
                    guestSession = await LeaderboardClient.CreateGuestSessionAsync();
                    await ScoreStore.SaveGuestSessionAsync(guestSession);
                }
            }

            var model = new SubmitGameScoreModel(
                Game.Id,
                _pendingRunId,
                _pendingScore,
                _pendingDuration,
                _pendingMode,
                guestSession?.PlayerId.ToString("D"),
                guestSession?.Token,
                authenticated ? null : _guestName);
            SubmitGameScoreResultModel result;
            try
            {
                result = await LeaderboardClient.SubmitAsync(model);
            }
            catch (ApiException exception) when (!authenticated && exception.StatusCode == HttpStatusCode.Unauthorized)
            {
                guestSession = await LeaderboardClient.CreateGuestSessionAsync();
                await ScoreStore.SaveGuestSessionAsync(guestSession);
                model = model with
                {
                    GuestPlayerId = guestSession.PlayerId.ToString("D"),
                    GuestToken = guestSession.Token
                };
                result = await LeaderboardClient.SubmitAsync(model);
            }

            _syncFailed = false;
            _statusMessage = result.Rank > 0
                ? $"{L[ResourceKeys.Games.ScoreSaved].Value} {L[ResourceKeys.Games.Rank].Value}: #{result.Rank}"
                : L[ResourceKeys.Games.ScoreSaved];
            await RefreshLeaderboardAsync();
        }
        catch
        {
            _syncFailed = true;
            _statusMessage = L[ResourceKeys.Games.ScoreSyncFailed];
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshLeaderboardAsync()
    {
        if (Game is null)
            return;

        try
        {
            var result = await LeaderboardClient.GetAsync(Game.Id);
            _leaderboard = result.Entries;
        }
        catch
        {
            _leaderboard = [];
        }
    }

    private void BackToGames() => Navigation.NavigateTo("/games");

    private async Task RestartAsync()
    {
        if (_controller is not null)
            await _controller.InvokeVoidAsync("restart");
        _isPaused = false;
        _statusMessage = null;
        _gameStatusMessage = null;
    }

    private async Task TogglePauseAsync()
    {
        if (_controller is null)
            return;

        _isPaused = !_isPaused;
        await _controller.InvokeVoidAsync("pause", _isPaused);
    }

    public void Dispose() => Viewport.OnBreakpointChanged -= StateHasChanged;

    public async ValueTask DisposeAsync()
    {
        Dispose();
        try
        {
            if (_controller is not null)
            {
                try { await _controller.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
                await _controller.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _dotNetReference?.Dispose();
        }
    }
}
