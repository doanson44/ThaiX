@inherits GameBase

<svg class="game-svg" viewBox="0 0 400 450">
    @for (var y = 0; y < 9; y++)
    {
        for (var x = 0; x < 9; x++)
        {
            var (cx, cy) = (x, y);
            var left = 11 + x * 42;
            var top = 11 + y * 42;
            var fill = _selected == (x, y) ? "#075985" : (x / 3 + y / 3) % 2 == 1 ? "#1e293b" : "#273449";
            <g class="g-hit" @onclick="() => _selected = (cx, cy)">
                <rect x="@left" y="@top" width="42" height="42" fill="@fill" stroke="#64748b" />
                @if (_grid[y, x] != 0)
                {
                    <g><text x="@(left + 21)" y="@(top + 21)" font-size="20"
                          fill="@(_fixed[y, x] ? "#f8fafc" : "#7dd3fc")">@_grid[y, x]</text></g>
                }
            </g>
        }
    }
    @for (var i = 0; i <= 9; i += 3)
    {
        <g stroke="#e2e8f0" stroke-width="3">
            <line x1="@(11 + i * 42)" y1="11" x2="@(11 + i * 42)" y2="389" />
            <line x1="11" y1="@(11 + i * 42)" x2="389" y2="@(11 + i * 42)" />
        </g>
    }
    @for (var i = 1; i <= 10; i++)
    {
        var value = i % 10;
        var left = 11 + (i - 1) * 38;
        <g class="g-hit" @onclick="() => Enter(value)">
            <rect x="@left" y="402" width="34" height="36" rx="5" fill="#334155" />
            <text x="@(left + 17)" y="420" font-size="@(value == 0 ? 11 : 17)">@(value == 0 ? L[ResourceKeys.Games.KeyDelete].Value : value.ToString())</text>
        </g>
    }
</svg>

@code {
    private static readonly string[] Puzzle =
    [
        "530070000", "600195000", "098000060", "800060003", "400803001",
        "700020006", "060000280", "000419005", "000080079"
    ];

    private static readonly string[] Solution =
    [
        "534678912", "672195348", "198342567", "859761423", "426853791",
        "713924856", "961537284", "287419635", "345286179"
    ];

    private readonly int[,] _grid = new int[9, 9];
    private readonly bool[,] _fixed = new bool[9, 9];
    private (int X, int Y) _selected;

    protected override void Reset()
    {
        _selected = (0, 0);
        for (var y = 0; y < 9; y++)
        {
            for (var x = 0; x < 9; x++)
            {
                _grid[y, x] = Puzzle[y][x] - '0';
                _fixed[y, x] = _grid[y, x] != 0;
            }
        }
    }

    protected override void OnKey(string key)
    {
        var (x, y) = _selected;
        switch (key)
        {
            case "arrowleft": _selected = (Math.Max(0, x - 1), y); break;
            case "arrowright": _selected = (Math.Min(8, x + 1), y); break;
            case "arrowup": _selected = (x, Math.Max(0, y - 1)); break;
            case "arrowdown": _selected = (x, Math.Min(8, y + 1)); break;
            case "backspace" or "delete": Enter(0); break;
            default:
                if (key.Length == 1 && char.IsAsciiDigit(key[0]))
                    Enter(key[0] - '0');
                break;
        }
    }

    private void Enter(int value)
    {
        var (x, y) = _selected;
        if (!CanPlay || _fixed[y, x])
            return;

        _grid[y, x] = value;
        for (var row = 0; row < 9; row++)
            for (var column = 0; column < 9; column++)
                if (_grid[row, column] != Solution[row][column] - '0')
                    return;

        Finish(ElapsedSeconds, "easy");
    }
}
