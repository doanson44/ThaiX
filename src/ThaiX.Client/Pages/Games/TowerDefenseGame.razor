@inherits GameBase
@using ThaiX.Client.Models.Games
@using ThaiX.Client.Pages.Games.TowerDefense
@inject GameScoreStore ScoreStore

@if (!_progressLoaded)
{
    <div class="td-loading" role="status">@L[ResourceKeys.Games.Loading]</div>
}
else if (_engine.Mode is null)
{
    <section class="td-menu">
        <header class="td-menu-header">
            <span class="td-eyebrow">THAIX STRATEGY</span>
            <h2>@L[ResourceKeys.Games.TowerDefenseTitle]</h2>
            <p>@L[ResourceKeys.Games.TowerDefenseChooseMode]</p>
        </header>
        <div class="td-mode-grid">
            <article class="td-mode-card">
                <div class="td-mode-icon">TD</div>
                <h3>@L[ResourceKeys.Games.TowerDefenseCampaign]</h3>
                <p>@L[ResourceKeys.Games.TowerDefenseCampaignDescription]</p>
                <div class="td-progress-track"><span style="width:@(_progress.UnlockedMission / 14d * 100)%"></span></div>
                <small>@L[ResourceKeys.Games.TowerDefenseUnlocked]: @_progress.UnlockedMission / 14</small>
                <div class="td-mission-grid">
                    @for (var index = 0; index < TowerDefenseEngine.Missions.Count; index++)
                    {
                        var missionNumber = index + 1;
                        var unlocked = missionNumber <= _progress.UnlockedMission;
                        var stars = _progress.MissionStars.GetValueOrDefault(missionNumber);
                        <button type="button" class="td-mission-button" disabled="@(!unlocked)"
                                @onclick="_missionClicks[missionNumber - 1]"
                                aria-label="@($"{L[ResourceKeys.Games.TowerDefenseMission]} {missionNumber}")">
                            <span>@missionNumber</span>
                            <small>@L[MissionMapNameKey(missionNumber)]</small>
                            <small>@(stars == 0 ? (unlocked ? L[ResourceKeys.Games.TowerDefenseOpen].Value : L[ResourceKeys.Games.TowerDefenseLocked].Value) : new string('*', stars))</small>
                        </button>
                    }
                </div>
            </article>
            <article class="td-mode-card td-endless-card">
                <div class="td-mode-icon">END</div>
                <h3>@L[ResourceKeys.Games.TowerDefenseEndless]</h3>
                <p>@L[ResourceKeys.Games.TowerDefenseEndlessDescription]</p>
                <ul>
                    <li>@L[ResourceKeys.Games.TowerDefenseEndlessWaves]</li>
                    <li>@L[ResourceKeys.Games.TowerDefenseEndlessBosses]</li>
                    <li>@L[ResourceKeys.Games.TowerDefenseEndlessScaling]</li>
                </ul>
                <button type="button" class="btn btn-warning w-100" @onclick="StartEndless">
                    @L[ResourceKeys.Games.TowerDefenseStartEndless]
                </button>
            </article>
        </div>
        <div class="td-arsenal-preview">
            <strong>@L[ResourceKeys.Games.TowerDefenseArsenal]</strong>
            <span>@TowerDefenseEngine.TowerDefinitions.Count @L[ResourceKeys.Games.TowerDefenseTowerTypes]</span>
            <span>@TowerDefenseEngine.EnemyDefinitions.Count @L[ResourceKeys.Games.TowerDefenseEnemyTypes]</span>
            <span>@TowerDefenseEngine.Maps.Count @L[ResourceKeys.Games.TowerDefenseMaps]</span>
        </div>
    </section>
}
else
{
    <section class="td-game">
        <div class="td-hud">
            <div><small>@L[ResourceKeys.Games.TowerDefenseMode]</small><strong>@( _engine.Mode == TowerDefenseMode.Campaign ? L[ResourceKeys.Games.TowerDefenseCampaign].Value : L[ResourceKeys.Games.TowerDefenseEndless].Value)</strong></div>
            <div><small>@L[ResourceKeys.Games.Wave]</small><strong>@(_engine.Mode == TowerDefenseMode.Campaign ? $"{_engine.Wave}/{_engine.TotalWaves}" : _engine.Wave)</strong></div>
            <div><small>@L[ResourceKeys.Games.Lives]</small><strong class="td-lives">@_engine.Lives</strong></div>
            <div><small>@L[ResourceKeys.Games.Gold]</small><strong class="td-gold">@_engine.Gold</strong></div>
            <div><small>@L[ResourceKeys.Games.Score]</small><strong>@_engine.Score</strong></div>
        </div>
        <svg class="game-svg td-board" viewBox="0 0 480 424" role="img" aria-label="@L[ResourceKeys.Games.TowerDefenseBattlefield]">
            <defs>
                <pattern id="td-ground" width="48" height="48" patternUnits="userSpaceOnUse">
                    <rect width="48" height="48" fill="#527b3d" />
                    <path d="M6 11l2 -5 2 5M30 23l2 -5 2 5M16 39l2 -5 2 5" fill="none" stroke="#3d652b" stroke-width="1.5" />
                    <circle cx="24" cy="8" r="1.5" fill="#83a95b" />
                    <circle cx="39" cy="30" r="1.5" fill="#83a95b" />
                </pattern>
                <g id="td-tower-base">
                    <circle r="15" fill="#44403c" stroke="#d6b98c" stroke-width="4" stroke-dasharray="8 2" />
                    <circle r="10" fill="#57534e" />
                </g>
            </defs>
            <rect y="40" width="480" height="336" fill="url(#td-ground)" />
            <polyline points="@PathPoints" fill="none" stroke="#5f4a2c" stroke-width="42" stroke-linejoin="round" />
            <polyline points="@PathPoints" fill="none" stroke="#a3824f" stroke-width="36" stroke-linejoin="round" />
            <polyline points="@PathPoints" fill="none" stroke="#c3a16b" stroke-width="2" stroke-dasharray="9 10" />
            @foreach (var obstacle in _engine.CurrentMap!.Obstacles)
            {
                <g transform="translate(@TowerDefenseEngine.CellX(obstacle) @TowerDefenseEngine.CellY(obstacle))" pointer-events="none">
                    <path d="M-12 8L-9 -8L3 -13L13 -3L10 10L-3 13Z" fill="#78716c" stroke="#44403c" stroke-width="2" />
                    <path d="M-9 -8L3 -13L5 -2L-5 2Z" fill="#a8a29e" />
                </g>
            }
            @for (var cell = 0; cell < TowerDefenseEngine.Columns * TowerDefenseEngine.Rows; cell++)
            {
                if (!_engine.BlockedCells.Contains(cell))
                {
                    <rect class="td-cell-hit" x="@(TowerDefenseEngine.CellX(cell) - 21)" y="@(TowerDefenseEngine.CellY(cell) - 21)"
                          width="42" height="42" rx="6" @onclick="_cellClicks[cell]" />
                }
            }
            @if (_engine.SelectedTower is { } selectedTower)
            {
                <circle cx="@TowerDefenseEngine.CellX(selectedTower.Cell)" cy="@TowerDefenseEngine.CellY(selectedTower.Cell)"
                        r="@Px(selectedTower.Range)" fill="#f8fafc" fill-opacity="0.08" stroke="#f8fafc"
                        stroke-opacity="0.65" stroke-dasharray="5 5" />
            }
            @foreach (var tower in _engine.Towers)
            {
                <g transform="translate(@TowerDefenseEngine.CellX(tower.Cell) @TowerDefenseEngine.CellY(tower.Cell))">
                    <use href="#td-tower-base" />
                    <rect x="0" y="-4" width="22" height="8" rx="3" fill="@tower.Definition.Color"
                          stroke="#1f2937" stroke-width="2" transform="rotate(@Px(tower.Angle))" />
                    <circle r="7" fill="@tower.Definition.Color" stroke="#1f2937" stroke-width="2" />
                    @if (tower.TotalLevel > 0)
                    {
                        <circle cx="0" cy="18" r="4" fill="#facc15" stroke="#713f12" />
                    }
                    @if (_engine.SelectedCell == tower.Cell)
                    {
                        <circle r="19" fill="none" stroke="#facc15" stroke-width="2.5" />
                    }
                </g>
            }
            @foreach (var enemy in _engine.Enemies)
            {
                <g transform="translate(@Px(enemy.X) @Px(enemy.Y))">
                    <circle r="@(enemy.Definition.IsBoss ? 14 : enemy.Definition.IsFlying ? 8 : 10)"
                            fill="@enemy.Definition.Color" stroke="#292524" stroke-width="2" />
                    @if (enemy.Definition.IsBoss)
                    {
                        <path d="M-8 -2L-4 -9L0 -3L4 -9L8 -2L6 6L-6 6Z" fill="#fca5a5" />
                    }
                    else if (enemy.Definition.IsFlying)
                    {
                        <path d="M-13 0L-4 -4L0 -8L4 -4L13 0L4 3L0 7L-4 3Z" fill="#e2e8f0" />
                    }
                    else
                    {
                        <path d="M-5 -3L5 -3L7 5L-7 5Z" fill="#292524" />
                    }
                    @if (enemy.SlowTicks > 0)
                    {
                        <circle r="@(enemy.Definition.IsBoss ? 18 : 13)" fill="none" stroke="#a5f3fc" stroke-width="2" />
                    }
                    <rect x="-12" y="-20" width="24" height="4" fill="#450a0a" />
                    <rect x="-12" y="-20" width="@Px(24 * Math.Clamp(enemy.Health / enemy.MaxHealth, 0, 1))" height="4" fill="#4ade80" />
                </g>
            }
            @foreach (var shot in _engine.Shots)
            {
                <line x1="@Px(shot.X1)" y1="@Px(shot.Y1)" x2="@Px(shot.X2)" y2="@Px(shot.Y2)"
                      stroke="@shot.Color" stroke-width="2.5" stroke-linecap="round" />
            }
            @foreach (var effect in _engine.Effects)
            {
                <circle cx="@Px(effect.X)" cy="@Px(effect.Y)" r="@effect.Radius" fill="none"
                        stroke="@effect.Color" stroke-width="3" opacity="0.65" />
            }
            <rect x="456" y="278" width="22" height="52" rx="5" fill="#44403c" stroke="#1c1917" stroke-width="2" />
            <rect x="460" y="282" width="14" height="44" rx="3" fill="#78716c" />
            <circle cx="467" cy="304" r="6" fill="#2563eb" stroke="#dbeafe" stroke-width="1.5" />
            <rect width="480" height="40" fill="#0b1220" />
            <rect y="376" width="480" height="48" fill="#0b1220" />
            <text x="60" y="20" fill="#e2e8f0">@L[ResourceKeys.Games.Wave]: @_engine.Wave</text>
            <text x="180" y="20" fill="#fca5a5">@L[ResourceKeys.Games.Lives]: @_engine.Lives</text>
            <text x="300" y="20" fill="#facc15">@L[ResourceKeys.Games.Gold]: @_engine.Gold</text>
            <text x="420" y="20" fill="#e2e8f0">@L[ResourceKeys.Games.Score]: @_engine.Score</text>
            @for (var index = 0; index < 3; index++)
            {
                <rect x="@(index * 160 + 4)" y="380" width="152" height="40" rx="8" fill="#1e293b" stroke="#334155" />
                <text x="@(index * 160 + 80)" y="404" fill="#e2e8f0" font-size="12" text-anchor="middle">@L[TowerDefenseEngine.TowerDefinitions[index].NameKey]</text>
            }
        </svg>
        <div class="td-shop" aria-label="@L[ResourceKeys.Games.TowerDefenseArsenal]">
            @for (var index = 0; index < TowerDefenseEngine.TowerDefinitions.Count; index++)
            {
                var definition = TowerDefenseEngine.TowerDefinitions[index];
                <button type="button" class="td-shop-item @(_engine.SelectedTowerType == index ? "selected" : "")"
                        disabled="@(!_engine.IsRunning)" @onclick="_towerClicks[index]">
                    <span class="td-shop-swatch" style="background:@definition.Color"></span>
                    <span>@L[definition.NameKey]</span>
                    <strong>@definition.Cost</strong>
                </button>
            }
        </div>
        @if (_engine.SelectedTower is { } tower)
        {
            <div class="td-tower-panel">
                <div class="td-panel-heading">
                    <strong>@L[tower.Definition.NameKey]</strong>
                    <span>@L[ResourceKeys.Games.TowerDefenseLevel] @tower.TotalLevel</span>
                </div>
                <div class="td-upgrade-grid">
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="UpgradeDamage">
                        @L[ResourceKeys.Games.TowerDefenseDamage] - Lv.@tower.DamageLevel
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="UpgradeRange">
                        @L[ResourceKeys.Games.TowerDefenseRange] - Lv.@tower.RangeLevel
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="UpgradeRate">
                        @L[ResourceKeys.Games.TowerDefenseFireRate] - Lv.@tower.RateLevel
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="SellSelected">
                        @L[ResourceKeys.Games.TowerDefenseSell]
                    </button>
                </div>
                <label class="td-targeting-label">
                    @L[ResourceKeys.Games.TowerDefenseTargeting]
                    <select class="form-select form-select-sm" value="@tower.Targeting" @onchange="ChangeTargeting">
                        <option value="First">@L[ResourceKeys.Games.TowerDefenseTargetingFirst]</option>
                        <option value="Last">@L[ResourceKeys.Games.TowerDefenseTargetingLast]</option>
                        <option value="Strongest">@L[ResourceKeys.Games.TowerDefenseTargetingStrongest]</option>
                        <option value="Weakest">@L[ResourceKeys.Games.TowerDefenseTargetingWeakest]</option>
                        <option value="Closest">@L[ResourceKeys.Games.TowerDefenseTargetingClosest]</option>
                        <option value="Farthest">@L[ResourceKeys.Games.TowerDefenseTargetingFarthest]</option>
                    </select>
                </label>
            </div>
        }
        <div class="td-abilities">
            <strong>@L[ResourceKeys.Games.TowerDefenseAbilities]</strong>
            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(!_engine.IsRunning || _engine.AbilityCooldownRemaining("airstrike") > 0)" @onclick="_abilityClicks[0]">@L[ResourceKeys.Games.TowerDefenseAirstrike] - 100</button>
            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(!_engine.IsRunning || _engine.AbilityCooldownRemaining("artillery") > 0)" @onclick="_abilityClicks[1]">@L[ResourceKeys.Games.TowerDefenseArtillery] - 125</button>
            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(!_engine.IsRunning || _engine.AbilityCooldownRemaining("emp") > 0)" @onclick="_abilityClicks[2]">@L[ResourceKeys.Games.TowerDefenseEmp] - 90</button>
            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(!_engine.IsRunning || _engine.AbilityCooldownRemaining("reinforce") > 0)" @onclick="_abilityClicks[3]">@L[ResourceKeys.Games.TowerDefenseReinforce] - 150</button>
            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@(!_engine.IsRunning || _engine.AbilityCooldownRemaining("supply") > 0)" @onclick="_abilityClicks[4]">@L[ResourceKeys.Games.TowerDefenseSupply]</button>
        </div>
        <div class="td-controls">
            <span>@L[ResourceKeys.Games.TowerDefenseControls]</span>
            <span>1-0: @L[ResourceKeys.Games.TowerDefenseSelectTower]</span>
            <span>Arrow keys: @L[ResourceKeys.Games.TowerDefenseMoveCursor]</span>
            <span>Enter: @L[ResourceKeys.Games.TowerDefenseBuild]</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BackToModes">@L[ResourceKeys.Games.TowerDefenseBackToModes]</button>
        </div>
    </section>
}

@code {
    private const int TickMilliseconds = 33;
    private TowerDefenseEngine _engine = new();
    private TowerDefenseProgress _progress = new();
    private Action[] _cellClicks = [];
    private Action[] _towerClicks = [];
    private Action[] _missionClicks = [];
    private Action[] _abilityClicks = [];
    private bool _progressLoaded;
    private bool _completionReported;

    private string PathPoints => string.Join(' ', _engine.Path.Select(point => $"{Px(point.X)},{Px(point.Y)}"));

    private static string MissionMapNameKey(int mission) => mission switch
    {
        <= 3 => ResourceKeys.Games.TowerDefenseMapGreenValley,
        <= 6 => ResourceKeys.Games.TowerDefenseMapDesertOutpost,
        <= 9 => ResourceKeys.Games.TowerDefenseMapFrozenMountains,
        <= 12 => ResourceKeys.Games.TowerDefenseMapUrbanBattlefield,
        _ => ResourceKeys.Games.TowerDefenseMapMilitaryBase
    };

    protected override void Reset()
    {
        _engine = new TowerDefenseEngine();
        _engine.SetProgress(_progress.UnlockedMission);
        _completionReported = false;
        _cellClicks = [.. Enumerable.Range(0, TowerDefenseEngine.Columns * TowerDefenseEngine.Rows)
            .Select(cell => (Action)(() => SelectCell(cell)))];
        _towerClicks = [.. Enumerable.Range(0, TowerDefenseEngine.TowerDefinitions.Count)
            .Select(index => (Action)(() => SelectTower(index)))];
        _missionClicks = [.. Enumerable.Range(1, TowerDefenseEngine.Missions.Count)
            .Select(mission => (Action)(() => StartCampaign(mission)))];
        _abilityClicks =
        [
            () => UseAbility("airstrike"),
            () => UseAbility("artillery"),
            () => UseAbility("emp"),
            () => UseAbility("reinforce"),
            () => UseAbility("supply")
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _progress = await ScoreStore.GetTowerDefenseProgressAsync();
        _engine.SetProgress(_progress.UnlockedMission);
        _progressLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnKey(string key)
    {
        if (!_engine.IsRunning)
            return;

        switch (key)
        {
            case "arrowleft": _engine.MoveSelection(-1, 0); break;
            case "arrowright": _engine.MoveSelection(1, 0); break;
            case "arrowup": _engine.MoveSelection(0, -1); break;
            case "arrowdown": _engine.MoveSelection(0, 1); break;
            case "enter": SelectCell(_engine.SelectedCell); break;
            case "delete": SellSelected(); break;
            case "escape": _engine.SelectedCell = -1; break;
            default:
                if (key.Length == 1 && "1234567890".Contains(key[0]))
                    _engine.SelectedTowerType = key[0] == '0' ? 9 : key[0] - '1';
                break;
        }
    }

    private void StartCampaign(int mission)
    {
        _engine.StartCampaign(mission);
        StartGameLoop();
    }

    private void StartEndless()
    {
        _engine.StartEndless();
        StartGameLoop();
    }

    private void StartGameLoop()
    {
        if (!_engine.IsRunning)
            return;

        _completionReported = false;
        StartLoop(TickMilliseconds, Tick);
    }

    private void Tick()
    {
        _engine.Tick();
        if (_engine.IsFinished && !_completionReported)
        {
            _completionReported = true;
            _ = CompleteRunAsync();
        }
    }

    private async Task CompleteRunAsync()
    {
        if (_engine.Mode == TowerDefenseMode.Campaign && _engine.MissionCompleted)
        {
            var mission = _engine.MissionNumber;
            var stars = _engine.CalculateStars();
            _progress.MissionStars[mission] = Math.Max(_progress.MissionStars.GetValueOrDefault(mission), stars);
            _progress.UnlockedMission = Math.Max(_progress.UnlockedMission, Math.Min(14, mission + 1));
            _engine.SetProgress(_progress.UnlockedMission);
            await ScoreStore.SaveTowerDefenseProgressAsync(_progress);
        }

        Finish(_engine.Score, _engine.Mode == TowerDefenseMode.Campaign ? "campaign" : "endless");
    }

    private void SelectCell(int cell)
    {
        _engine.SelectedCell = cell;
        if (_engine.Towers.Any(tower => tower.Cell == cell))
            return;

        _engine.Build(cell, _engine.SelectedTowerType);
    }

    private void SelectTower(int index) => _engine.SelectedTowerType = index;
    private void UpgradeDamage() => _engine.Upgrade(_engine.SelectedCell, "damage");
    private void UpgradeRange() => _engine.Upgrade(_engine.SelectedCell, "range");
    private void UpgradeRate() => _engine.Upgrade(_engine.SelectedCell, "rate");
    private void SellSelected() => _engine.Sell(_engine.SelectedCell);
    private void UseAbility(string ability) => _engine.UseAbility(ability);

    private void ChangeTargeting(ChangeEventArgs args)
    {
        if (Enum.TryParse<TowerTargeting>(args.Value?.ToString(), out var targeting))
            _engine.SetTargeting(_engine.SelectedCell, targeting);
    }

    private void BackToModes()
    {
        Restart();
    }
}