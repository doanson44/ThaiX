@inherits GameBase
@using ThaiX.Client.Services.Games.TowerDefense
@inject GameScoreStore ScoreStore

@if (_match is null)
{
    <div class="td-menu" @onkeydown:stopPropagation>
        <h2 class="td-menu-title">@L[ResourceKeys.Games.TdMenuTitle]</h2>
        <div role="group" aria-label="@L[ResourceKeys.Games.TdMap]">
            <div class="td-menu-label">@L[ResourceKeys.Games.TdMap]</div>
            <div class="td-choices">
                @for (var i = 0; i < TowerDefenseData.Maps.Count; i++)
                {
                    var index = i;
                    var locked = !IsUnlocked(index);
                    <button type="button" class="td-choice @(_mapIndex == index ? "is-active" : "")" aria-pressed="@(_mapIndex == index)"
                            disabled="@locked" @onclick="() => _mapIndex = index">
                        <span>@L[TowerDefenseData.Maps[index].NameKey]</span>
                        @if (locked)
                        {
                            <small>
                                @if (TowerDefenseData.Maps[index].IsBonus)
                                {
                                    @L[ResourceKeys.Games.TdBonusLocked, TowerDefenseData.Maps[index].UnlockCost]
                                }
                                else
                                {
                                    @L[ResourceKeys.Games.TdMapLocked, L[TowerDefenseData.Maps[index - 1].NameKey].Value]
                                }
                            </small>
                        }
                    </button>
                }
            </div>
        </div>
        <div role="group" aria-label="@L[ResourceKeys.Games.TdDifficulty]">
            <div class="td-menu-label">@L[ResourceKeys.Games.TdDifficulty]</div>
            <div class="td-choices">
                @for (var i = 0; i < TowerDefenseData.Difficulties.Count; i++)
                {
                    var index = i;
                    <button type="button" class="td-choice @(_difficultyIndex == index ? "is-active" : "")" aria-pressed="@(_difficultyIndex == index)"
                            @onclick="() => _difficultyIndex = index">
                        @L[TowerDefenseData.Difficulties[index].NameKey]
                    </button>
                }
            </div>
        </div>
        <div role="group" aria-label="@L[ResourceKeys.Games.TdMode]">
            <div class="td-menu-label">@L[ResourceKeys.Games.TdMode]</div>
            <div class="td-choices">
                <button type="button" class="td-choice @(!_endless ? "is-active" : "")" aria-pressed="@(!_endless)" @onclick="() => _endless = false">
                    @L[ResourceKeys.Games.TdModeCampaign]
                </button>
                <button type="button" class="td-choice @(_endless ? "is-active" : "")" aria-pressed="@_endless" @onclick="() => _endless = true">
                    @L[ResourceKeys.Games.TdModeEndless]
                </button>
            </div>
        </div>
        <div class="td-warmart">
            <button type="button" class="btn btn-outline-warning" aria-expanded="@_showWarMart" @onclick="() => _showWarMart = !_showWarMart">
                <ThaiXIcon Name="cart" Size="1rem" /> @L[ResourceKeys.Games.TdWarMart]
                <span class="td-warmart-balance">@_warMartCredits</span>
            </button>
            @if (_showWarMart)
            {
                <div class="td-warmart-panel">
                    <strong>@L[ResourceKeys.Games.TdWarMartCredits, _warMartCredits]</strong>
                    <div class="td-choices">
                        @foreach (var option in TowerDefenseData.Towers.Where(tower => TowerDefenseData.TowerUnlockCost(tower.Kind) > 0))
                        {
                            var kind = option.Kind;
                            var cost = TowerDefenseData.TowerUnlockCost(kind);
                            var unlocked = _unlockedTowers.Contains(kind);
                            <button type="button" class="td-choice td-shop-item" disabled="@(unlocked || _warMartCredits < cost)" @onclick="() => BuyTower(kind)">
                                <ThaiXIcon Name="@option.Icon" Size="1.25rem" style="@($"color:{option.Color}")" />
                                <span>@L[option.NameKey]</span>
                                <strong>@(unlocked ? L[ResourceKeys.Games.TdUnlocked].Value : $"{L[ResourceKeys.Games.TdBuy].Value} {cost}")</strong>
                            </button>
                        }
                    </div>
                    <div class="td-bonus-missions">
                        <div class="td-menu-label">@L[ResourceKeys.Games.TdBonusMissions]</div>
                        <div class="td-choices">
                            @foreach (var mission in TowerDefenseData.Maps.Where(map => map.IsBonus))
                            {
                                var bonus = mission;
                                var purchased = _bonusMissions.Contains(bonus.Id);
                                <button type="button" class="td-choice td-shop-item" disabled="@(purchased || _warMartCredits < bonus.UnlockCost)" @onclick="() => BuyBonusMission(bonus.Id)">
                                    <ThaiXIcon Name="military_tech" Size="1.25rem" />
                                    <span>@L[bonus.NameKey]</span>
                                    <strong>@(purchased ? L[ResourceKeys.Games.TdUnlocked].Value : $"{L[ResourceKeys.Games.TdBuy].Value} {bonus.UnlockCost}")</strong>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-primary td-deploy" @onclick="Deploy">@L[ResourceKeys.Games.TdStartMission]</button>
    </div>
}
else
{
    var match = _match;
    <svg class="game-svg" viewBox="0 0 480 376">
        <defs>
            <pattern id="td-grass" width="48" height="48" patternUnits="userSpaceOnUse">
                <rect width="48" height="48" fill="#4f7d39" />
                <path d="M6 11l2 -5 2 5M30 23l2 -5 2 5M16 39l2 -5 2 5M40 44l2 -5 2 5" fill="none" stroke="#3d652b" stroke-width="1.5" />
                <circle cx="24" cy="8" r="1.5" fill="#6f9f4f" />
                <circle cx="39" cy="30" r="1.5" fill="#6f9f4f" />
                <circle cx="8" cy="27" r="1.5" fill="#6f9f4f" />
            </pattern>
            <g id="td-base">
                <circle r="17" fill="#44403c" stroke="#d6b98c" stroke-width="6" stroke-dasharray="9 2" />
                <circle r="13" fill="#57534e" />
            </g>
        </defs>

        <rect y="40" width="480" height="336" fill="url(#td-grass)" />
        @foreach (var points in _roadPoints)
        {
            <polyline points="@points" fill="none" stroke="#5f4a2c" stroke-width="42" stroke-linejoin="round" />
            <polyline points="@points" fill="none" stroke="#a3824f" stroke-width="36" stroke-linejoin="round" />
            <polyline points="@points" fill="none" stroke="#b6935c" stroke-width="18" stroke-linejoin="round" stroke-dasharray="14 10" />
        }
        @for (var i = 0; i < TowerDefenseMatch.Columns * TowerDefenseMatch.Rows; i++)
        {
            var blocked = match.IsBlocked(i);
            <rect class="g-hit" x="@(TowerDefenseMatch.CellX(i) - 21)" y="@(TowerDefenseMatch.CellY(i) - 21)" width="42" height="42" rx="6"
                  fill="@(blocked ? "transparent" : "#0b1220")" fill-opacity="@(blocked ? "0" : "0.14")"
                  stroke="@(blocked ? "none" : "#ecfccb")" stroke-opacity="0.2" @onclick="_cellClicks[i]" />
        }

        <g pointer-events="none">
            @foreach (var cell in match.Map.Trees)
            {
                <use href="@Href("leaf")" x="@(TowerDefenseMatch.CellX(cell) - 17)" y="@(TowerDefenseMatch.CellY(cell) - 17)" width="34" height="34" style="color:#14532d" />
            }
            @foreach (var cell in match.Map.Rocks)
            {
                <use href="@Href("cube")" x="@(TowerDefenseMatch.CellX(cell) - 14)" y="@(TowerDefenseMatch.CellY(cell) - 14)" width="28" height="28" style="color:#a8a29e" />
            }
            @foreach (var endY in match.Roads.Select(road => road[^1].Y).Distinct())
            {
                <rect x="456" y="@Px(endY - 26)" width="22" height="52" rx="5" fill="#44403c" stroke="#1c1917" stroke-width="2" />
                <use href="@Href("home")" x="457" y="@Px(endY - 10)" width="20" height="20" style="color:#60a5fa" />
            }
            @if (_selectedTower is { } selected)
            {
                <circle cx="@TowerDefenseMatch.CellX(selected.Cell)" cy="@TowerDefenseMatch.CellY(selected.Cell)" r="@Px(match.Range(selected))"
                        fill="#facc15" fill-opacity="0.12" stroke="#facc15" stroke-opacity="0.7" stroke-dasharray="5 4" />
                <rect x="@(TowerDefenseMatch.CellX(selected.Cell) - 22)" y="@(TowerDefenseMatch.CellY(selected.Cell) - 22)" width="44" height="44" rx="7"
                      fill="none" stroke="#facc15" stroke-width="2.5" />
            }
            @foreach (var placed in match.Towers)
            {
                var placedSpec = placed.Spec;
                var pips = placed.Levels.Sum();
                <g transform="translate(@TowerDefenseMatch.CellX(placed.Cell) @TowerDefenseMatch.CellY(placed.Cell))">
                    <use href="#td-base" />
                    <use href="@Href(placedSpec.Icon)" x="-12" y="-12" width="24" height="24" style="color:@placedSpec.Color" />
                    @if (placed.FlashUntil > match.Tick && placedSpec.Effect is TowerEffect.Single or TowerEffect.Splash)
                    {
                        <g transform="rotate(@Px(placed.Angle))">
                            <path d="M22 0L31 -5L28 0L31 5Z" fill="@(placedSpec.ShotColor ?? placedSpec.Color)" />
                        </g>
                    }
                    @for (var pip = 0; pip < pips; pip++)
                    {
                        <circle cx="@Px((pip - (pips - 1) / 2.0) * 4.6)" cy="19" r="1.8" fill="#facc15" stroke="#713f12" stroke-width="0.6" />
                    }
                </g>
            }
            @foreach (var enemy in match.Enemies.OrderBy(item => item.Spec.IsFlying))
            {
                var enemySpec = enemy.Spec;
                <g transform="translate(@Px(enemy.X) @Px(enemy.Y))">
                    @if (enemySpec.IsFlying)
                    {
                        <ellipse cx="0" cy="@(enemySpec.Radius + 6)" rx="@(enemySpec.Radius - 2)" ry="3" fill="#0b1220" fill-opacity="0.35" />
                    }
                    <use href="@Href(enemySpec.Icon)" x="@(-enemySpec.GlyphSize / 2)" y="@(-enemySpec.GlyphSize / 2)" width="@enemySpec.GlyphSize" height="@enemySpec.GlyphSize"
                         style="color:@(enemy.HitUntil > match.Tick ? "#ffffff" : enemySpec.Color)" />
                    @if (enemy.SlowTicks > 0)
                    {
                        <circle r="@(enemySpec.Radius + 3)" fill="#a5f3fc" fill-opacity="0.45" />
                    }
                    @if (enemy.PoisonTicks > 0)
                    {
                        <circle r="@(enemySpec.Radius + 5)" fill="none" stroke="#86efac" stroke-width="2" />
                    }
                    @if (enemy.Health < enemy.MaxHealth)
                    {
                        <rect x="-10" y="@(-enemySpec.Radius - 8)" width="20" height="3" fill="#450a0a" />
                        <rect x="-10" y="@(-enemySpec.Radius - 8)" width="@Px(20 * Math.Max(0, enemy.Health) / enemy.MaxHealth)" height="3" fill="#4ade80" />
                    }
                </g>
            }
            @foreach (var shot in match.Shots)
            {
                <line x1="@Px(shot.X1)" y1="@Px(shot.Y1)" x2="@Px(shot.X2)" y2="@Px(shot.Y2)" stroke="@shot.Color" stroke-width="2" stroke-linecap="round" />
            }
            @foreach (var blast in match.Blasts)
            {
                var age = (match.Tick - blast.Start) / (double)TowerDefenseMatch.BlastTicks;
                <circle cx="@Px(blast.X)" cy="@Px(blast.Y)" r="@Px(blast.Radius * (0.3 + 0.7 * age))" opacity="@Px(1 - age)"
                        fill="@(blast.Ring ? "none" : blast.Color)" stroke="@blast.Color" stroke-width="2" />
            }
            @foreach (var popup in match.Popups)
            {
                var age = match.Tick - popup.Start;
                @:<text x="@Px(popup.X)" y="@Px(popup.Y - 10 - age * 0.8)" fill="@popup.Color" opacity="@Px(1 - age / (double)TowerDefenseMatch.PopupTicks)" font-size="12">@popup.Text</text>
            }
            <rect class="g-cursor" x="@(TowerDefenseMatch.CellX(_cursor) - 21)" y="@(TowerDefenseMatch.CellY(_cursor) - 21)" width="42" height="42" rx="6" />
            @if (_airstrikeArmed)
            {
                <circle cx="@TowerDefenseMatch.CellX(_cursor)" cy="@TowerDefenseMatch.CellY(_cursor)" r="@TowerDefenseMatch.AirstrikeRadius"
                        fill="#ef4444" fill-opacity="0.15" stroke="#ef4444" stroke-dasharray="6 4" />
            }
            else if (CursorRange is { } cursorRange)
            {
                <circle cx="@TowerDefenseMatch.CellX(_cursor)" cy="@TowerDefenseMatch.CellY(_cursor)" r="@Px(cursorRange)" fill="none" stroke="#f8fafc" stroke-opacity="0.55" stroke-dasharray="4 4" />
            }
        </g>

        <rect width="480" height="40" fill="#0b1220" />
        <text class="g-muted" x="60" y="20">@WaveLabel</text>
        @if (match.NextWaveCountdownActive)
        {
            @:<text x="60" y="34" fill="#93c5fd" font-size="12">@L[ResourceKeys.Games.TdNextWaveIn, match.NextWaveCountdownSeconds]</text>
        }
        <text x="180" y="20" fill="#fca5a5">@L[ResourceKeys.Games.Lives]: @match.Lives</text>
        <text x="300" y="20" fill="#facc15">@L[ResourceKeys.Games.Gold]: @match.Gold</text>
        <text class="g-muted" x="420" y="20">@L[ResourceKeys.Games.Score]: @match.Score</text>
        @if (_airstrikeArmed)
        {
            <rect y="40" width="480" height="22" fill="#7f1d1d" fill-opacity="0.85" pointer-events="none" />
            @:<text x="240" y="51" fill="#fee2e2" font-size="13" pointer-events="none">@L[ResourceKeys.Games.TdAirstrikeArmed]</text>
        }
    </svg>

    <div class="td-panel" @onmousedown:preventDefault>
        <div class="td-actions">
            <button type="button" class="btn btn-sm btn-primary" tabindex="-1" disabled="@(!CanCallWave)" @onclick="CallWave">
                <kbd>N</kbd> @L[ResourceKeys.Games.TdStartWave]
            </button>
            <button type="button" class="btn btn-sm @(_airstrikeArmed ? "btn-danger" : "btn-outline-danger")" tabindex="-1"
                    disabled="@(!_airstrikeArmed && !(match.State == MatchState.Running && match.AirstrikeReady))" @onclick="ToggleAirstrike">
                <kbd>A</kbd> @(match.AirstrikeReady ? L[ResourceKeys.Games.TdAirstrike].Value : L[ResourceKeys.Games.TdAirstrikeCharging, (int)(match.AirstrikeCharge * 100)].Value)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" tabindex="-1" @onclick="ToggleSpeed">
                <kbd>G</kbd> @L[ResourceKeys.Games.TdSpeed, _speed]
            </button>
            @if (CanCallWave)
            {
                <small class="td-next">
                    @if (match.NextWaveCountdownActive)
                    {
                        @L[ResourceKeys.Games.TdNextWaveIn, match.NextWaveCountdownSeconds]
                        <span> &middot; </span>
                    }
                    @L[ResourceKeys.Games.TdNextWave, NextWaveSummary]
                </small>
            }
        </div>

        <div class="td-towers" role="group" aria-label="@L[ResourceKeys.Games.TowerGun]">
            @foreach (var option in TowerDefenseData.Towers.Where(option => match.Map.RequiredTower is null || option.Kind == match.Map.RequiredTower))
            {
                var kind = option.Kind;
                var unlocked = IsTowerUnlocked(kind);
                <button type="button" tabindex="-1" class="td-tower @(_buildKind == kind ? "is-active" : "") @(match.Gold < option.Cost ? "is-poor" : "")"
                        aria-pressed="@(_buildKind == kind)" disabled="@(!unlocked)" @onclick="() => SelectBuild(kind)">
                    <ThaiXIcon Name="@option.Icon" Size="1.5rem" style="@($"color:{option.Color}")" />
                    <span class="td-name"><kbd>@TowerKey(kind)</kbd> @L[option.NameKey]</span>
                    <span class="td-cost">@(unlocked ? option.Cost.ToString() : L[ResourceKeys.Games.TdWarMart].Value)</span>
                </button>
            }
        </div>

        <div class="td-info">
            @if (_selectedTower is { } chosen)
            {
                <div class="td-info-head">
                    <strong>@L[chosen.Spec.NameKey]</strong>
                    <span class="td-stats">
                        @L[ResourceKeys.Games.TdUpgradeDamage] @match.Damage(chosen).ToString("0.#") &middot;
                        @L[ResourceKeys.Games.TdUpgradeRange] @match.Range(chosen).ToString("0") &middot;
                        @L[ResourceKeys.Games.TdUpgradeFireRate] @ShotsPerSecond(match.CooldownTicks(chosen)).ToString("0.0")/s
                    </span>
                    <small class="text-muted">@L[chosen.Spec.HitsAir ? ResourceKeys.Games.TdAirAndGround : ResourceKeys.Games.TdGroundOnly]</small>
                </div>
                <div class="td-upgrades">
                    @foreach (var track in Enum.GetValues<UpgradeTrack>())
                    {
                        var current = track;
                        var cost = match.UpgradeCost(chosen, current);
                        <button type="button" class="btn btn-sm btn-outline-info" tabindex="-1"
                                disabled="@(cost is null || match.Gold < cost)" @onclick="() => Upgrade(current)">
                            <kbd>@UpgradeKey(current)</kbd> @L[UpgradeLabel(current)]
                            <small>@L[ResourceKeys.Games.TdLevel, chosen.Level(current)]</small>
                            <strong>@(cost?.ToString() ?? L[ResourceKeys.Games.TdMaxed].Value)</strong>
                        </button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-info" tabindex="-1" disabled="@(_movingTower is not null)" @onclick="ArmMove">
                        <kbd>M</kbd> @L[ResourceKeys.Games.TdMove]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" tabindex="-1" @onclick="CycleTarget">
                        <kbd>T</kbd> @L[ResourceKeys.Games.TdTargeting, L[TargetLabel(chosen.Mode)].Value]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" tabindex="-1" @onclick="SellSelected">
                        <kbd>X</kbd> @L[ResourceKeys.Games.TdSell, match.SellValue(chosen)]
                    </button>
                    @if (_movingTower is not null)
                    {
                        <small class="text-info">@L[ResourceKeys.Games.TdMoveHint]</small>
                    }
                </div>
            }
            else if (_buildKind is { } buildKind)
            {
                var buildSpec = TowerDefenseData.Tower(buildKind);
                <div class="td-info-head">
                    <strong>@L[buildSpec.NameKey]</strong>
                    <span class="td-stats">
                        @L[ResourceKeys.Games.TdUpgradeDamage] @buildSpec.Damage.ToString("0.#") &middot;
                        @L[ResourceKeys.Games.TdUpgradeRange] @buildSpec.Range.ToString("0") &middot;
                        @L[ResourceKeys.Games.TdUpgradeFireRate] @ShotsPerSecond(buildSpec.Cooldown).ToString("0.0")/s
                    </span>
                    <small class="text-muted">@L[buildSpec.HitsAir ? ResourceKeys.Games.TdAirAndGround : ResourceKeys.Games.TdGroundOnly]</small>
                </div>
                <small class="text-muted">@L[ResourceKeys.Games.TdSelectHint]</small>
            }
            else
            {
                <small class="text-muted">@L[ResourceKeys.Games.TdSelectHint]</small>
            }
        </div>
    </div>
}

@code {
    private const string GameKey = "tower-defense";

    private readonly HashSet<string> _cleared = [];
    private readonly HashSet<TowerKind> _unlockedTowers = [];
    private readonly HashSet<string> _bonusMissions = [];
    private int _warMartCredits;
    private bool _showWarMart;
    private Action[] _cellClicks = [];
    private string[] _roadPoints = [];
    private TowerDefenseMatch? _match;
    private TowerKind? _buildKind = TowerKind.Gunner;
    private Tower? _selectedTower;
    private Tower? _movingTower;
    private int _mapIndex;
    private int _difficultyIndex = 1;
    private int _cursor;
    private int _speed = 1;
    private bool _endless;
    private bool _airstrikeArmed;

    private string WaveLabel => _match!.Endless
        ? L[ResourceKeys.Games.TdWaveEndless, _match.Wave].Value
        : L[ResourceKeys.Games.TdWaveOf, _match.Wave, _match.TotalWaves].Value;

    private bool CanCallWave =>
        CanPlay && _match is { State: MatchState.Planning } match && (match.Endless || match.Wave < TowerDefenseData.CampaignWaves);

    private string NextWaveSummary => string.Join(", ", _match!.NextWaveGroups
        .Select(group => $"{group.Count}x {L[TowerDefenseData.Enemy(group.Kind).NameKey].Value}"));

    private double? CursorRange =>
        _match!.TowerAt(_cursor) is { } tower ? _match.Range(tower)
        : _buildKind is { } kind && !_match.IsBlocked(_cursor) ? TowerDefenseData.Tower(kind).Range
        : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await ScoreStore.GetProgressAsync(GameKey);
            foreach (var token in (saved ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (TowerDefenseData.Maps.Any(map => map.Id == token))
                    _cleared.Add(token);
                else if (token.StartsWith("tower:", StringComparison.Ordinal)
                    && Enum.TryParse<TowerKind>(token[6..], out var kind))
                    _unlockedTowers.Add(kind);
                else if (token.StartsWith("bonus:", StringComparison.Ordinal)
                    && TowerDefenseData.Maps.Any(map => map.IsBonus && map.Id == token[6..]))
                    _bonusMissions.Add(token[6..]);
                else if (token.StartsWith("credits:", StringComparison.Ordinal)
                    && int.TryParse(token[8..], out var credits))
                    _warMartCredits = Math.Max(0, credits);
            }
        }
        catch (JSException)
        {
        }
    }

    protected override void Reset()
    {
        // Cached so the per-tick render does not hand the renderer a new handler for every cell.
        if (_cellClicks.Length == 0)
            _cellClicks = [.. Enumerable.Range(0, TowerDefenseMatch.Columns * TowerDefenseMatch.Rows).Select(cell => (Action)(() => ActivateCell(cell)))];

        _match = null;
        _selectedTower = null;
        _movingTower = null;
        _airstrikeArmed = false;
        _speed = 1;
        if (!IsUnlocked(_mapIndex))
            _mapIndex = 0;
    }

    protected override void OnKey(string key)
    {
        if (_match is null)
        {
            if (key is "enter" or " ")
                Deploy();

            return;
        }

        var (column, row) = (_cursor % TowerDefenseMatch.Columns, _cursor / TowerDefenseMatch.Columns);
        switch (key)
        {
            case "arrowleft": column = Math.Max(0, column - 1); break;
            case "arrowright": column = Math.Min(TowerDefenseMatch.Columns - 1, column + 1); break;
            case "arrowup": row = Math.Max(0, row - 1); break;
            case "arrowdown": row = Math.Min(TowerDefenseMatch.Rows - 1, row + 1); break;
            case "1" or "2" or "3" or "4" or "5" or "6" or "7" or "8" or "9" or "0":
                SelectBuild((TowerKind)(key == "0" ? 9 : key[0] - '1'));
                break;
            case "enter" or " ": ActivateCell(_cursor); break;
            case "d": Upgrade(UpgradeTrack.Damage); break;
            case "r": Upgrade(UpgradeTrack.Range); break;
            case "f": Upgrade(UpgradeTrack.FireRate); break;
            case "x": SellSelected(); break;
            case "t": CycleTarget(); break;
            case "m": ArmMove(); break;
            case "n": CallWave(); break;
            case "a": ToggleAirstrike(); break;
            case "g": ToggleSpeed(); break;
            case "escape": _selectedTower = null; _movingTower = null; _buildKind = null; _airstrikeArmed = false; break;
        }

        _cursor = row * TowerDefenseMatch.Columns + column;
    }

    private bool IsUnlocked(int mapIndex)
    {
        var mission = TowerDefenseData.Maps[mapIndex];
        return mission.IsBonus
            ? _bonusMissions.Contains(mission.Id)
            : mapIndex == 0 || _cleared.Contains(TowerDefenseData.Maps[mapIndex - 1].Id);
    }

    private bool IsTowerUnlocked(TowerKind kind) => TowerDefenseData.TowerUnlockCost(kind) == 0 || _unlockedTowers.Contains(kind);

    private void Deploy()
    {
        if (!IsUnlocked(_mapIndex))
            return;

        var map = TowerDefenseData.Maps[_mapIndex];
        _match = new TowerDefenseMatch(map, TowerDefenseData.Difficulties[_difficultyIndex], _endless);
        _roadPoints = [.. _match.Roads.Select(road => string.Join(' ', road.Select(point => $"{Px(point.X)},{Px(point.Y)}")))];
        _cursor = _match.FirstFreeCell(3 * TowerDefenseMatch.Columns + 4);
        _buildKind = map.RequiredTower ?? TowerKind.Gunner;
        _selectedTower = null;
        _movingTower = null;
        _airstrikeArmed = false;
        RestartClock();
        StartLoop(TowerDefenseMatch.TickMilliseconds, Tick);
    }

    private void Tick()
    {
        for (var i = 0; i < _speed && !_match!.IsOver; i++)
            _match!.Advance();

        if (!_match!.IsOver)
            return;

        var won = _match.State == MatchState.Won;
        if (won && _cleared.Add(_match.Map.Id))
        {
            _warMartCredits += _match.MissionReward;
            _ = SaveProgressAsync();
        }

        var mode = $"{_match.Difficulty.Id}-{(_match.Endless ? "endless" : "campaign")}";
        Finish(_match.FinalScore, mode, won);
    }

    private async Task SaveProgressAsync()
    {
        try
        {
            var progress = _cleared.Order()
                .Concat(_unlockedTowers.Order().Select(kind => $"tower:{kind}"))
                .Concat(_bonusMissions.Order().Select(id => $"bonus:{id}"))
                .Append($"credits:{_warMartCredits}");
            await ScoreStore.SetProgressAsync(GameKey, string.Join(',', progress));
        }
        catch (JSException)
        {
        }
    }

    private async Task BuyTower(TowerKind kind)
    {
        var cost = TowerDefenseData.TowerUnlockCost(kind);
        if (cost <= 0 || _unlockedTowers.Contains(kind) || _warMartCredits < cost)
            return;

        _warMartCredits -= cost;
        _unlockedTowers.Add(kind);
        await SaveProgressAsync();
    }

    private async Task BuyBonusMission(string missionId)
    {
        var mission = TowerDefenseData.Maps.FirstOrDefault(map => map.Id == missionId && map.IsBonus);
        if (mission is null || _bonusMissions.Contains(missionId) || _warMartCredits < mission.UnlockCost)
            return;

        _warMartCredits -= mission.UnlockCost;
        _bonusMissions.Add(missionId);
        await SaveProgressAsync();
    }

    private void SelectBuild(TowerKind kind)
    {
        if (!CanPlay || !IsTowerUnlocked(kind) || (_match?.Map.RequiredTower is { } required && kind != required))
            return;

        _buildKind = kind;
        _selectedTower = null;
        _movingTower = null;
        _airstrikeArmed = false;
    }

    private void ActivateCell(int cell)
    {
        if (!CanPlay || _match is null)
            return;

        _cursor = cell;
        if (_movingTower is { } moving)
        {
            if (_match.Move(moving, cell))
            {
                _selectedTower = moving;
                _movingTower = null;
                _buildKind = null;
            }

            return;
        }

        if (_airstrikeArmed)
        {
            _match.Airstrike(TowerDefenseMatch.CellX(cell), TowerDefenseMatch.CellY(cell));
            _airstrikeArmed = false;
            return;
        }

        if (_match.TowerAt(cell) is { } tower)
        {
            _selectedTower = tower;
            return;
        }

        _selectedTower = _buildKind is { } kind ? _match.Build(cell, kind) : null;
    }

    private void Upgrade(UpgradeTrack track)
    {
        if (CanPlay && _selectedTower is { } tower)
            _match!.Upgrade(tower, track);
    }

    private void ArmMove()
    {
        if (CanPlay && _selectedTower is { } tower)
        {
            _movingTower = tower;
            _buildKind = null;
            _airstrikeArmed = false;
        }
    }

    private void SellSelected()
    {
        if (CanPlay && _selectedTower is { } tower && _match!.Sell(tower))
        {
            _selectedTower = null;
            _movingTower = null;
        }
    }

    private void CycleTarget()
    {
        if (CanPlay && _selectedTower is { } tower)
            _match!.CycleTarget(tower);
    }

    private void CallWave()
    {
        if (CanCallWave)
            _match!.StartWave();
    }

    private void ToggleAirstrike()
    {
        if (CanPlay)
        {
            _movingTower = null;
            _airstrikeArmed = !_airstrikeArmed && _match!.State == MatchState.Running && _match.AirstrikeReady;
        }
    }

    private void ToggleSpeed() => _speed = _speed == 1 ? 2 : 1;

    private static string Href(string icon) => $"{ThaixIcons.SpritePath}#{icon}";

    private static string TowerKey(TowerKind kind) => (int)kind == 9 ? "0" : ((int)kind + 1).ToString();

    private static double ShotsPerSecond(int cooldownTicks) => 1000.0 / (TowerDefenseMatch.TickMilliseconds * (cooldownTicks + 1));

    private static string UpgradeKey(UpgradeTrack track) => track switch
    {
        UpgradeTrack.Damage => "D",
        UpgradeTrack.Range => "R",
        _ => "F"
    };

    private static string UpgradeLabel(UpgradeTrack track) => track switch
    {
        UpgradeTrack.Damage => ResourceKeys.Games.TdUpgradeDamage,
        UpgradeTrack.Range => ResourceKeys.Games.TdUpgradeRange,
        _ => ResourceKeys.Games.TdUpgradeFireRate
    };

    private static string TargetLabel(TargetMode mode) => mode switch
    {
        TargetMode.Strongest => ResourceKeys.Games.TdTargetStrongest,
        TargetMode.Closest => ResourceKeys.Games.TdTargetClosest,
        _ => ResourceKeys.Games.TdTargetFirst
    };
}
