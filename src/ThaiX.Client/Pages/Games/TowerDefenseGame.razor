@inherits GameBase
@using ThaiX.Client.Services.Games.TowerDefense
@using ThaiX.Client.Services.Http.Demo
@inject GameScoreStore ScoreStore
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IGameProgressClient GameProgressClient
@inject ApiConnectivityState ConnectivityState
@inject ILogger<TowerDefenseGame> Logger

<svg class="td-sprite-bank" aria-hidden="true">
    <defs>
        <symbol id="td-tower-gunner" viewBox="0 0 161 128"><image href="/images/games/tower-defense/tower-gunner.png" width="161" height="128" /></symbol>
        <symbol id="td-tower-sniper" viewBox="0 0 161 128"><image href="/images/games/tower-defense/tower-sniper.png" width="161" height="128" /></symbol>
        <symbol id="td-tower-rocket" viewBox="0 0 161 170"><image href="/images/games/tower-defense/tower-rocket.png" width="161" height="170" /></symbol>
        <symbol id="td-tower-tesla" viewBox="0 0 109 128"><image href="/images/games/tower-defense/tower-tesla.png" width="109" height="128" /></symbol>
        <symbol id="td-tower-flamethrower" viewBox="0 0 108 128"><image href="/images/games/tower-defense/tower-flamethrower.png" width="108" height="128" /></symbol>
        <symbol id="td-tower-slowfield" viewBox="0 0 144 107"><image href="/images/games/tower-defense/tower-slowfield.png" width="144" height="107" /></symbol>
        <symbol id="td-tower-particlebeam" viewBox="0 0 197 171"><image href="/images/games/tower-defense/tower-particlebeam.png" width="197" height="171" /></symbol>
        <symbol id="td-tower-plasmacannon" viewBox="0 0 179 171"><image href="/images/games/tower-defense/tower-plasmacannon.png" width="179" height="171" /></symbol>
        <symbol id="td-tower-radar" viewBox="0 0 108 128"><image href="/images/games/tower-defense/tower-radar.png" width="108" height="128" /></symbol>
        <symbol id="td-tower-poweramplifier" viewBox="0 0 143 128"><image href="/images/games/tower-defense/tower-poweramplifier.png" width="143" height="128" /></symbol>
        <symbol id="td-enemy-soldier" viewBox="0 0 126 107"><image href="/images/games/tower-defense/enemy-soldier.png" width="126" height="107" /></symbol>
        <symbol id="td-enemy-armored" viewBox="0 0 161 107"><image href="/images/games/tower-defense/enemy-armored.png" width="161" height="107" /></symbol>
        <symbol id="td-enemy-jeep" viewBox="0 0 126 107"><image href="/images/games/tower-defense/enemy-jeep.png" width="126" height="107" /></symbol>
        <symbol id="td-enemy-helicopter" viewBox="0 0 162 107"><image href="/images/games/tower-defense/enemy-helicopter.png" width="162" height="107" /></symbol>
        <symbol id="td-enemy-tank" viewBox="0 0 179 107"><image href="/images/games/tower-defense/enemy-tank.png" width="179" height="107" /></symbol>
        <symbol id="td-enemy-boss" viewBox="0 0 108 107"><image href="/images/games/tower-defense/enemy-boss.png" width="108" height="107" /></symbol>
    </defs>
</svg>

@if (_match is null)
{
    <div class="td-menu" @onkeydown:stopPropagation>
        <h2 class="td-menu-title">@L[ResourceKeys.Games.TdMenuTitle]</h2>
        <div class="td-mission-group" role="group" aria-label="@L[ResourceKeys.Games.TdMap]">
            <div class="td-mission-heading">
                <div class="td-menu-label">@L[ResourceKeys.Games.TdMap]</div>
                <button type="button" class="btn btn-outline-warning" aria-expanded="@_showWarMart" @onclick="() => _showWarMart = !_showWarMart">
                    <ThaiXIcon Name="cart" Size="1rem" /> @L[ResourceKeys.Games.TdWarMart]
                    <span class="td-warmart-balance">@_warMartCredits</span>
                </button>
            </div>
            @if (_showWarMart)
            {
                <div class="td-warmart-panel">
                    <strong>@L[ResourceKeys.Games.TdWarMartCredits, _warMartCredits]</strong>
                    @if (_progressSyncFailed)
                    {
                        <small class="text-warning">@L[ResourceKeys.Games.TdProgressSyncFailed]</small>
                    }
                    <div class="td-shop-choices">
                        <button type="button" class="td-choice td-shop-item" disabled="@(_warMartCredits < TowerDefenseData.StartingFundsUpgradeCost(_bonusStartingGold))" @onclick="BuyStartingFunds">
                            <ThaiXIcon Name="account_balance_wallet" Size="1.25rem" />
                            <span>@L[ResourceKeys.Games.TdStartFunds]</span>
                            <strong>@L[ResourceKeys.Games.TdStartFundsOwned, _bonusStartingGold] <span aria-hidden="true">&#183;</span> @L[ResourceKeys.Games.TdBuy] @TowerDefenseData.StartingFundsUpgradeCost(_bonusStartingGold)</strong>
                        </button>
                        @foreach (var option in TowerDefenseData.Towers.Where(tower => TowerDefenseData.TowerUnlockCost(tower.Kind) > 0))
                        {
                            var kind = option.Kind;
                            var cost = TowerDefenseData.TowerUnlockCost(kind);
                            var unlocked = _unlockedTowers.Contains(kind);
                            <button type="button" class="td-choice td-shop-item" disabled="@(unlocked || _warMartCredits < cost)" @onclick="() => BuyTower(kind)">
                                <svg class="td-unit-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="@($"#td-tower-{kind.ToString().ToLowerInvariant()}")" width="100%" height="100%" /></svg>
                                <span>@L[option.NameKey]</span>
                                <strong>@(unlocked ? L[ResourceKeys.Games.TdUnlocked].Value : $"{L[ResourceKeys.Games.TdBuy].Value} {cost}")</strong>
                            </button>
                        }
                    </div>
                    <div class="td-bonus-missions">
                        <div class="td-menu-label">@L[ResourceKeys.Games.TdBonusMissions]</div>
                        <div class="td-shop-choices">
                            @foreach (var mission in TowerDefenseData.Maps.Where(map => map.IsBonus))
                            {
                                var bonus = mission;
                                var purchased = _bonusMissions.Contains(bonus.Id);
                                <button type="button" class="td-choice td-shop-item" disabled="@(purchased || _warMartCredits < bonus.UnlockCost)" @onclick="() => BuyBonusMission(bonus.Id)">
                                    <ThaiXIcon Name="military_tech" Size="1.25rem" />
                                    <span>@L[bonus.NameKey]</span>
                                    <strong>@(purchased ? L[ResourceKeys.Games.TdUnlocked].Value : $"{L[ResourceKeys.Games.TdBuy].Value} {bonus.UnlockCost}")</strong>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="td-mission-choices">
                @for (var i = 0; i < TowerDefenseData.Maps.Count; i++)
                {
                    var index = i;
                    var locked = !IsUnlocked(index);
                    <button type="button" class="td-choice td-mission-choice @(_mapIndex == index ? "is-active" : "")" aria-pressed="@(_mapIndex == index)"
                            disabled="@locked" @onclick="() => _mapIndex = index">
                        <span>@L[TowerDefenseData.Maps[index].NameKey]</span>
                        @if (locked)
                        {
                            <small>
                                @if (TowerDefenseData.Maps[index].IsBonus)
                                {
                                    @L[ResourceKeys.Games.TdBonusLocked, TowerDefenseData.Maps[index].UnlockCost]
                                }
                                else
                                {
                                    @L[ResourceKeys.Games.TdMapLocked, L[TowerDefenseData.Maps[index - 1].NameKey].Value]
                                }
                            </small>
                        }
                    </button>
                }
            </div>
        </div>
        <div role="group" aria-label="@L[ResourceKeys.Games.TdDifficulty]">
            <div class="td-menu-label">@L[ResourceKeys.Games.TdDifficulty]</div>
            <div class="td-choices">
                @for (var i = 0; i < TowerDefenseData.Difficulties.Count; i++)
                {
                    var index = i;
                    <button type="button" class="td-choice @(_difficultyIndex == index ? "is-active" : "")" aria-pressed="@(_difficultyIndex == index)"
                            @onclick="() => _difficultyIndex = index">
                        @L[TowerDefenseData.Difficulties[index].NameKey]
                    </button>
                }
            </div>
        </div>
        <div role="group" aria-label="@L[ResourceKeys.Games.TdMode]">
            <div class="td-menu-label">@L[ResourceKeys.Games.TdMode]</div>
            <div class="td-choices">
                <button type="button" class="td-choice @(!_endless ? "is-active" : "")" aria-pressed="@(!_endless)" @onclick="() => _endless = false">
                    @L[ResourceKeys.Games.TdModeCampaign]
                </button>
                <button type="button" class="td-choice @(_endless ? "is-active" : "")" aria-pressed="@_endless" @onclick="() => _endless = true">
                    @L[ResourceKeys.Games.TdModeEndless]
                </button>
            </div>
        </div>
        <button type="button" class="btn btn-primary td-deploy" @onclick="Deploy">@L[ResourceKeys.Games.TdStartMission]</button>
    </div>
}
else
{
    var match = _match;
    <div class="td-match-layout">
    <div class="td-board">
    <svg class="game-svg" viewBox="0 0 480 376">
        <defs>
            <pattern id="td-grass" width="48" height="48" patternUnits="userSpaceOnUse">
                <rect width="48" height="48" fill="#526f32" />
                <path d="M4 13l2 -6 2 6M13 34l2 -5 2 5M28 17l2 -6 2 6M39 40l2 -6 2 6M43 9l1 -4 2 4" fill="none" stroke="#405c29" stroke-width="1.5" />
                <path d="M19 7l2 -3 2 3M31 37l2 -4 2 4M7 43l2 -4 2 4" fill="none" stroke="#78934a" stroke-width="1.2" />
                <circle cx="24" cy="8" r="1.5" fill="#81994c" />
                <circle cx="39" cy="25" r="1.5" fill="#81994c" />
                <circle cx="8" cy="27" r="1.5" fill="#81994c" />
                <circle cx="28" cy="44" r="1" fill="#344f25" />
            </pattern>
            <pattern id="td-road" width="34" height="30" patternUnits="userSpaceOnUse">
                <rect width="34" height="30" fill="#a88a5a" />
                <path d="M-4 7L8 3L16 9L12 16L0 17ZM17 0L29 2L35 9L27 14L16 9ZM5 20L17 17L24 23L20 31L7 29ZM25 17L37 15L40 24L31 30L22 25Z"
                      fill="#b99b6b" stroke="#8d7149" stroke-width="1" />
                <path d="M8 3L12 8M27 2L25 8M17 17L15 23M31 30L29 24" stroke="#d0b181" stroke-width="1" opacity="0.65" />
            </pattern>
            <g id="td-base">
                <circle r="17" fill="#44403c" stroke="#d6b98c" stroke-width="6" stroke-dasharray="9 2" />
                <circle r="13" fill="#57534e" />
            </g>
        </defs>

        <rect y="40" width="480" height="336" fill="url(#td-grass)" />
        @foreach (var points in _roadPoints)
        {
            <polyline points="@points" fill="none" stroke="#3f3426" stroke-width="50" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="@points" fill="none" stroke="#765a36" stroke-width="44" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="@points" fill="none" stroke="url(#td-road)" stroke-width="38" stroke-linecap="round" stroke-linejoin="round" />
            <polyline points="@points" fill="none" stroke="#d0b181" stroke-opacity="0.45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 12" />
        }
        @for (var i = 0; i < TowerDefenseMatch.Columns * TowerDefenseMatch.Rows; i++)
        {
            var blocked = match.IsBlocked(i);
            <rect class="g-hit" x="@(TowerDefenseMatch.CellX(i) - 21)" y="@(TowerDefenseMatch.CellY(i) - 21)" width="42" height="42" rx="6"
                  fill="@(blocked ? "transparent" : "#0b1220")" fill-opacity="@(blocked ? "0" : "0.14")"
                  stroke="@(blocked ? "none" : "#ecfccb")" stroke-opacity="0.2" @onclick="_cellClicks[i]" />
        }

        <g pointer-events="none">
            @foreach (var cell in match.Map.Trees)
            {
                <g transform="translate(@TowerDefenseMatch.CellX(cell) @TowerDefenseMatch.CellY(cell))">
                    <ellipse cy="9" rx="17" ry="7" fill="#263b20" opacity="0.55" />
                    <circle cx="-6" cy="1" r="11" fill="#24532d" />
                    <circle cx="5" cy="-5" r="12" fill="#326b35" />
                    <circle cx="8" cy="5" r="9" fill="#477c3b" />
                    <circle cx="-2" cy="-9" r="4" fill="#78964a" />
                </g>
            }
            @foreach (var cell in match.Map.Rocks)
            {
                <g transform="translate(@TowerDefenseMatch.CellX(cell) @TowerDefenseMatch.CellY(cell))">
                    <ellipse cy="9" rx="14" ry="5" fill="#292524" opacity="0.45" />
                    <path d="M-13 7L-10 -5L-2 -13L8 -9L14 3L8 10L-7 11Z" fill="#78716c" stroke="#44403c" stroke-width="1.5" />
                    <path d="M-10 -5L-2 -13L8 -9L1 -2Z" fill="#a8a29e" />
                    <path d="M1 -2L8 -9L14 3L8 10Z" fill="#57534e" />
                    <path d="M-8 2L-2 -2" stroke="#d6d3d1" stroke-width="1.2" opacity="0.7" />
                </g>
            }
            @foreach (var endY in match.Roads.Select(road => road[^1].Y).Distinct())
            {
                <rect x="456" y="@Px(endY - 26)" width="22" height="52" rx="5" fill="#44403c" stroke="#1c1917" stroke-width="2" />
                <foreignObject x="457" y="@Px(endY - 10)" width="20" height="20"><span xmlns="http://www.w3.org/1999/xhtml" class="bi bi-house-fill" style="font-size:20px;color:#60a5fa"></span></foreignObject>
            }
            @if (_selectedTower is { } selected)
            {
                <circle cx="@TowerDefenseMatch.CellX(selected.Cell)" cy="@TowerDefenseMatch.CellY(selected.Cell)" r="@Px(match.Range(selected))"
                        fill="#facc15" fill-opacity="0.12" stroke="#facc15" stroke-opacity="0.7" stroke-dasharray="5 4" />
                <rect x="@(TowerDefenseMatch.CellX(selected.Cell) - 22)" y="@(TowerDefenseMatch.CellY(selected.Cell) - 22)" width="44" height="44" rx="7"
                      fill="none" stroke="#facc15" stroke-width="2.5" />
            }
            @if (_pendingBuildCell is { } pendingCell && _buildKind is { } pendingKind)
            {
                var placementValid = CanConfirmPlacement;
                <circle cx="@TowerDefenseMatch.CellX(pendingCell)" cy="@TowerDefenseMatch.CellY(pendingCell)"
                        r="@Px(match.RangeAt(pendingCell, pendingKind))"
                        fill="@(placementValid ? "#facc15" : "#ef4444")" fill-opacity="0.1"
                        stroke="@(placementValid ? "#facc15" : "#ef4444")" stroke-opacity="0.85" stroke-dasharray="5 4" />
                <rect x="@(TowerDefenseMatch.CellX(pendingCell) - 22)" y="@(TowerDefenseMatch.CellY(pendingCell) - 22)"
                      width="44" height="44" rx="7" fill="none"
                      stroke="@(placementValid ? "#facc15" : "#ef4444")" stroke-width="2.5" />
                <g class="td-placement-ghost" opacity="0.4" transform="translate(@TowerDefenseMatch.CellX(pendingCell) @TowerDefenseMatch.CellY(pendingCell))">
                    <use href="#td-base" />
                    <use href="@($"#td-tower-{pendingKind.ToString().ToLowerInvariant()}")" x="-12" y="-12" width="24" height="24" />
                </g>
            }
            @foreach (var placed in match.Towers)
            {
                var placedSpec = placed.Spec;
                var pips = placed.Levels.Sum();
                <g transform="translate(@TowerDefenseMatch.CellX(placed.Cell) @TowerDefenseMatch.CellY(placed.Cell))">
                    <use href="#td-base" />
                    <use href="@($"#td-tower-{placedSpec.Kind.ToString().ToLowerInvariant()}")" x="-12" y="-12" width="24" height="24" />
                    @if (placed.FlashUntil > match.Tick && placedSpec.Effect is TowerEffect.Single or TowerEffect.Splash)
                    {
                        <g transform="rotate(@Px(placed.Angle))">
                            <path d="M22 0L31 -5L28 0L31 5Z" fill="@(placedSpec.ShotColor ?? placedSpec.Color)" />
                        </g>
                    }
                    @for (var pip = 0; pip < pips; pip++)
                    {
                        <circle cx="@Px((pip - (pips - 1) / 2.0) * 4.6)" cy="19" r="1.8" fill="#facc15" stroke="#713f12" stroke-width="0.6" />
                    }
                </g>
            }
            @foreach (var enemy in match.Enemies.OrderBy(item => item.Spec.IsFlying))
            {
                var enemySpec = enemy.Spec;
                <g transform="translate(@Px(enemy.X) @Px(enemy.Y))">
                    @if (enemySpec.IsFlying)
                    {
                        <ellipse cx="0" cy="@(enemySpec.Radius + 6)" rx="@(enemySpec.Radius - 2)" ry="3" fill="#0b1220" fill-opacity="0.35" />
                    }
                    <use href="@($"#td-enemy-{enemySpec.Kind.ToString().ToLowerInvariant()}")" x="@(-enemySpec.GlyphSize / 2)" y="@(-enemySpec.GlyphSize / 2)" width="@enemySpec.GlyphSize" height="@enemySpec.GlyphSize"
                         style="color:@(enemy.HitUntil > match.Tick ? "#ffffff" : enemySpec.Color)" />
                    @if (enemy.SlowTicks > 0)
                    {
                        <circle r="@(enemySpec.Radius + 3)" fill="#a5f3fc" fill-opacity="0.45" />
                    }
                    @if (enemy.Health < enemy.MaxHealth)
                    {
                        <rect x="-10" y="@(-enemySpec.Radius - 8)" width="20" height="3" fill="#450a0a" />
                        <rect x="-10" y="@(-enemySpec.Radius - 8)" width="@Px(20 * Math.Max(0, enemy.Health) / enemy.MaxHealth)" height="3" fill="#4ade80" />
                    }
                </g>
            }
            @foreach (var shot in match.Shots)
            {
                <line x1="@Px(shot.X1)" y1="@Px(shot.Y1)" x2="@Px(shot.X2)" y2="@Px(shot.Y2)" stroke="@shot.Color" stroke-width="2" stroke-linecap="round" />
            }
            @foreach (var blast in match.Blasts)
            {
                var age = (match.Tick - blast.Start) / (double)TowerDefenseMatch.BlastTicks;
                <circle cx="@Px(blast.X)" cy="@Px(blast.Y)" r="@Px(blast.Radius * (0.3 + 0.7 * age))" opacity="@Px(1 - age)"
                        fill="@(blast.Ring ? "none" : blast.Color)" stroke="@blast.Color" stroke-width="2" />
            }
            @foreach (var popup in match.Popups)
            {
                var age = match.Tick - popup.Start;
                @:<text x="@Px(popup.X)" y="@Px(popup.Y - 10 - age * 0.8)" fill="@popup.Color" opacity="@Px(1 - age / (double)TowerDefenseMatch.PopupTicks)" font-size="12">@popup.Text</text>
            }
            <rect class="g-cursor" x="@(TowerDefenseMatch.CellX(_cursor) - 21)" y="@(TowerDefenseMatch.CellY(_cursor) - 21)" width="42" height="42" rx="6" />
            @if (_airstrikeArmed)
            {
                <circle cx="@TowerDefenseMatch.CellX(_cursor)" cy="@TowerDefenseMatch.CellY(_cursor)" r="@TowerDefenseMatch.AirstrikeRadius"
                        fill="#ef4444" fill-opacity="0.15" stroke="#ef4444" stroke-dasharray="6 4" />
            }
            else if (_pendingBuildCell is null && CursorRange is { } cursorRange)
            {
                <circle cx="@TowerDefenseMatch.CellX(_cursor)" cy="@TowerDefenseMatch.CellY(_cursor)" r="@Px(cursorRange)" fill="none" stroke="#f8fafc" stroke-opacity="0.55" stroke-dasharray="4 4" />
            }
        </g>

        @if (_pendingBuildCell is { } popCell && _buildKind is not null)
        {
            var placementValid = CanConfirmPlacement;            var px = TowerDefenseMatch.CellX(popCell);
            var py = TowerDefenseMatch.CellY(popCell);
            var popY = Math.Min(py + 16, 366);
            var popX = Math.Clamp(px, 28, 452);
            <g class="td-placement-popover" transform="translate(@popX @popY)">
                <rect x="-20" y="-9" width="40" height="18" rx="9" fill="#0f172a" fill-opacity="0.9" stroke="@(placementValid ? "#38bdf8" : "#64748b")" stroke-width="1" />
                <g class="td-popover-btn td-popover-confirm @(placementValid ? "td-btn-confirm" : "td-btn-disabled")"
                   role="button" aria-label="@L[ResourceKeys.Common.Confirm]"
                   @onclick="ConfirmPlacement" @onclick:stopPropagation="true">
                    <circle cx="-9" cy="0" r="11" fill="transparent" />
                    <circle cx="-9" cy="0" r="6.5" fill="@(placementValid ? "#16a34a" : "#334155")" stroke="@(placementValid ? "#22c55e" : "#475569")" stroke-width="1" />
                    <path d="M-12 0.2 L-9.6 2.4 L-6 -1.6" fill="none" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </g>
                <g class="td-popover-btn td-popover-cancel td-btn-cancel"
                   role="button" aria-label="@L[ResourceKeys.Common.Cancel]"
                   @onclick="CancelPlacement" @onclick:stopPropagation="true">
                    <circle cx="9" cy="0" r="11" fill="transparent" />
                    <circle cx="9" cy="0" r="6.5" fill="#dc2626" stroke="#ef4444" stroke-width="1" />
                    <path d="M6.6 -2.4 L11.4 2.4 M11.4 -2.4 L6.6 2.4" fill="none" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" />
                </g>
            </g>
        }

    </svg>
    <div class="td-hud" role="group" aria-label="@L[ResourceKeys.Games.TdMenuTitle]">
        <div class="td-hud-item td-hud-wave">
            <strong>@WaveLabel</strong>
            @if (match.NextWaveCountdownActive)
            {
                <small>@L[ResourceKeys.Games.TdNextWaveIn, match.NextWaveCountdownSeconds]</small>
            }
        </div>
        <div class="td-hud-item td-hud-lives">
            <span>@L[ResourceKeys.Games.Lives]</span>
            <strong>@match.Lives</strong>
        </div>
        <div class="td-hud-item td-hud-gold">
            <span>@L[ResourceKeys.Games.Gold]</span>
            <strong>@match.Gold</strong>
        </div>
        <div class="td-hud-item td-hud-score">
            <span>@L[ResourceKeys.Games.Score]</span>
            <strong>@match.Score</strong>
        </div>
    </div>
    @if (_airstrikeArmed)
    {
        <div class="td-airstrike-banner" role="status">@L[ResourceKeys.Games.TdAirstrikeArmed]</div>
    }
    </div>

    <div class="td-towers" role="group" aria-label="@L[ResourceKeys.Games.TowerGun]">
        @foreach (var option in TowerDefenseData.Towers.Where(option => match.Map.RequiredTower is null || option.Kind == match.Map.RequiredTower))
        {
            var kind = option.Kind;
            var unlocked = IsTowerUnlocked(kind);
            <button type="button" tabindex="-1" class="td-tower @(_buildKind == kind ? "is-active" : "") @(match.Gold < option.Cost ? "is-poor" : "")"
                    aria-label="@(unlocked ? $"{L[option.NameKey].Value}, {option.Cost}" : $"{L[option.NameKey].Value}, {option.Cost}, {L[ResourceKeys.Games.TdWarMart].Value}")" title="@L[option.NameKey]"
                    aria-pressed="@(_buildKind == kind)" disabled="@(!unlocked)" @onclick="() => SelectBuild(kind)">
                <svg class="td-unit-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="@($"#td-tower-{kind.ToString().ToLowerInvariant()}")" width="100%" height="100%" /></svg>
                @if (!unlocked)
                {
                    <span class="td-tower-lock" aria-hidden="true"><ThaiXIcon Name="lock" Size="0.75rem" /></span>
                }
            </button>
        }
    </div>

    <div class="td-panel" @onmousedown:preventDefault>
        <div class="td-actions">
            <button type="button" class="btn btn-sm btn-primary" tabindex="-1" disabled="@(!CanCallWave)" @onclick="CallWave">
                <kbd>N</kbd> @L[ResourceKeys.Games.TdStartWave]
            </button>
            <button type="button" class="btn btn-sm @(_airstrikeArmed ? "btn-danger" : "btn-outline-danger")" tabindex="-1"
                    disabled="@(!_airstrikeArmed && !(match.State == MatchState.Running && match.AirstrikeReady))" @onclick="ToggleAirstrike">
                <kbd>A</kbd> @(match.AirstrikeReady ? L[ResourceKeys.Games.TdAirstrike].Value : L[ResourceKeys.Games.TdAirstrikeCharging, (int)(match.AirstrikeCharge * 100)].Value)
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" tabindex="-1" @onclick="ToggleSpeed">
                <kbd>G</kbd> @L[ResourceKeys.Games.TdSpeed, _speed]
            </button>
            @if (CanCallWave)
            {
                <small class="td-next">
                    @if (match.NextWaveCountdownActive)
                    {
                        @L[ResourceKeys.Games.TdNextWaveIn, match.NextWaveCountdownSeconds]
                        <span> <span aria-hidden="true">&#183;</span> </span>
                    }
                    @L[ResourceKeys.Games.TdNextWave, NextWaveSummary]
                </small>
            }
        </div>

        <div class="td-info @(_selectedTower is null && _buildKind is not null ? "td-build-info" : "")">
            @if (_selectedTower is { } chosen)
            {
                <div class="td-info-head">
                    <strong>@L[chosen.Spec.NameKey]</strong>
                    <span class="td-stats">
                        @if (chosen.Spec.IsSupport)
                        {
                            <span>@L[chosen.Spec.Effect == TowerEffect.SupportRange ? ResourceKeys.Games.TdSupportRange : ResourceKeys.Games.TdSupportDamage]: @match.Damage(chosen).ToString("0.#")</span>
                        }
                        else
                        {
                            <span>@L[ResourceKeys.Games.TdUpgradeDamage]: @match.Damage(chosen).ToString("0.#")</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdUpgradeRange]: @match.Range(chosen).ToString("0")</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdUpgradeFireRate]: @ShotsPerSecond(match.CooldownTicks(chosen)).ToString("0.0")/s</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdDps]: @((match.Damage(chosen) * ShotsPerSecond(match.CooldownTicks(chosen))).ToString("0.#"))</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdKills]: @chosen.Kills</span>
                        }
                    </span>
                    @if (!chosen.Spec.IsSupport)
                    {
                        <small class="text-muted">@L[chosen.Spec.HitsAir ? ResourceKeys.Games.TdAirAndGround : ResourceKeys.Games.TdGroundOnly]</small>
                    }
                </div>
                <div class="td-upgrades">
                    @foreach (var track in Enum.GetValues<UpgradeTrack>().Where(track => !chosen.Spec.IsSupport || track != UpgradeTrack.FireRate))
                    {
                        var current = track;
                        var cost = match.UpgradeCost(chosen, current);
                        <button type="button" class="btn btn-sm btn-outline-info" tabindex="-1"
                                disabled="@(cost is null || match.Gold < cost)" @onclick="() => Upgrade(current)">
                            <kbd>@UpgradeKey(current)</kbd> @L[UpgradeLabel(current)]
                            <small>@L[ResourceKeys.Games.TdLevel, chosen.Level(current)]</small>
                            <strong>@(cost?.ToString() ?? L[ResourceKeys.Games.TdMaxed].Value)</strong>
                        </button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-info" tabindex="-1" disabled="@(_movingTower is not null)" @onclick="ArmMove">
                        <kbd>M</kbd> @L[ResourceKeys.Games.TdMove]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" tabindex="-1" @onclick="CycleTarget">
                        <kbd>T</kbd> @L[ResourceKeys.Games.TdTargeting, L[TargetLabel(chosen.Mode)].Value]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" tabindex="-1" @onclick="SellSelected">
                        <kbd>X</kbd> @L[ResourceKeys.Games.TdSell, match.SellValue(chosen)]
                    </button>
                    @if (_movingTower is not null)
                    {
                        <small class="text-info">@L[ResourceKeys.Games.TdMoveHint]</small>
                    }
                </div>
            }
            else if (_buildKind is { } buildKind)
            {
                var buildSpec = TowerDefenseData.Tower(buildKind);
                <div class="td-info-head">
                    <strong>@L[buildSpec.NameKey]</strong>
                    <span class="td-stats">
                        @if (buildSpec.IsSupport)
                        {
                            <span>@L[buildSpec.Effect == TowerEffect.SupportRange ? ResourceKeys.Games.TdSupportRange : ResourceKeys.Games.TdSupportDamage]: @buildSpec.SupportValue.ToString("0.#")</span>
                        }
                        else
                        {
                            <span>@L[ResourceKeys.Games.TdUpgradeDamage]: @buildSpec.Damage.ToString("0.#")</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdUpgradeRange]: @buildSpec.Range.ToString("0")</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdUpgradeFireRate]: @ShotsPerSecond(buildSpec.Cooldown).ToString("0.0")/s</span>
                            <span aria-hidden="true">&#183;</span>
                            <span>@L[ResourceKeys.Games.TdDps]: @((buildSpec.Damage * ShotsPerSecond(buildSpec.Cooldown)).ToString("0.#"))</span>
                        }
                    </span>
                    @if (!buildSpec.IsSupport)
                    {
                        <small class="text-muted">@L[buildSpec.HitsAir ? ResourceKeys.Games.TdAirAndGround : ResourceKeys.Games.TdGroundOnly]</small>
                    }
                </div>
                <small class="td-select-hint text-muted">@L[ResourceKeys.Games.TdSelectHint]</small>
            }
            else
            {
                <small class="td-select-hint text-muted">@L[ResourceKeys.Games.TdSelectHint]</small>
            }
        </div>
    </div>
    </div>
}

@code {
    private const string GameKey = "tower-defense";

    private readonly HashSet<string> _cleared = [];
    private readonly HashSet<TowerKind> _unlockedTowers = [];
    private readonly HashSet<string> _bonusMissions = [];
    private int _warMartCredits;
    private int _bonusStartingGold;
    private bool _showWarMart;
    private bool _isAuthenticated;
    private bool _progressSyncFailed;
    private Action[] _cellClicks = [];
    private string[] _roadPoints = [];
    private TowerDefenseMatch? _match;
    private TowerKind? _buildKind = TowerKind.Gunner;
    private Tower? _selectedTower;
    private Tower? _movingTower;
    private int? _pendingBuildCell;
    private int _mapIndex;
    private int _difficultyIndex = 1;
    private int _cursor;
    private int _speed = 1;
    private int _lastRewardedEndlessWave;
    private bool _endless;
    private bool _airstrikeArmed;
    private bool _resultRecorded;

    private string WaveLabel => _match!.Endless
        ? L[ResourceKeys.Games.TdWaveEndless, _match.Wave].Value
        : L[ResourceKeys.Games.TdWaveOf, _match.Wave, _match.TotalWaves].Value;

    private bool CanCallWave =>
        CanPlay && _match is { State: MatchState.Planning } match && (match.Endless || match.Wave < TowerDefenseData.CampaignWaves);

    private bool CanConfirmPlacement =>
        CanPlay && _match is not null && _pendingBuildCell is { } cell
            && _buildKind is { } kind && _match.CanBuild(cell, kind);

    private string NextWaveSummary => string.Join(", ", _match!.NextWaveGroups
        .Select(group => $"{group.Count}x {L[TowerDefenseData.Enemy(group.Kind).NameKey].Value}"));

    private double? CursorRange =>
        _match!.TowerAt(_cursor) is { } tower ? _match.Range(tower)
        : _buildKind is { } kind && (!_match.IsBlocked(_cursor) || _pendingBuildCell == _cursor)
            ? _match.RangeAt(_cursor, kind)
        : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await ScoreStore.GetProgressAsync(GameKey);
            foreach (var token in (saved ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {                if (TowerDefenseData.Maps.Any(map => map.Id == token))
                    _cleared.Add(token);
                else if (token.StartsWith("tower:", StringComparison.Ordinal)
                    && Enum.TryParse<TowerKind>(token[6..], out var kind))
                    _unlockedTowers.Add(kind);
                else if (token.StartsWith("bonus:", StringComparison.Ordinal)
                    && TowerDefenseData.Maps.Any(map => map.IsBonus && map.Id == token[6..]))
                    _bonusMissions.Add(token[6..]);
                else if (token.StartsWith("credits:", StringComparison.Ordinal)
                    && int.TryParse(token[8..], out var credits))
                    _warMartCredits = Math.Max(0, credits);
                else if (token.StartsWith("startfunds:", StringComparison.Ordinal)
                    && int.TryParse(token[11..], out var startingFunds))
                    _bonusStartingGold = Math.Max(0, startingFunds);
            }
        }
        catch (JSException)
        {
        }

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        if (_isAuthenticated && !ConnectivityState.IsDemoMode)
        {
            try
            {
                var savedProgress = await GameProgressClient.GetTowerDefenseProgressAsync();
                if (savedProgress is not null)
                {
                    _cleared.Clear();
                    foreach (var missionId in savedProgress.ClearedMissions)
                    {
                        if (TowerDefenseData.Maps.Any(map => !map.IsBonus && map.Id == missionId))
                            _cleared.Add(missionId);
                    }

                    _unlockedTowers.Clear();
                    foreach (var towerName in savedProgress.UnlockedTowers)
                    {
                        if (Enum.TryParse<TowerKind>(towerName, out var kind)
                            && TowerDefenseData.TowerUnlockCost(kind) > 0)
                            _unlockedTowers.Add(kind);
                    }

                    _bonusMissions.Clear();
                    foreach (var missionId in savedProgress.BonusMissions)
                    {
                        if (TowerDefenseData.Maps.Any(map => map.IsBonus && map.Id == missionId))
                            _bonusMissions.Add(missionId);
                    }

                    _warMartCredits = Math.Max(0, savedProgress.Credits);
                    _bonusStartingGold = Math.Max(0, savedProgress.BonusStartingGold);
                }
                else
                {
                    var savedGold = await GameProgressClient.GetTowerDefenseGoldAsync();
                    if (savedGold.HasValue)
                        _warMartCredits = savedGold.Value;

                    await SaveProgressAsync();
                }

                _progressSyncFailed = false;
            }
            catch (Exception exception)
            {
                _progressSyncFailed = true;
                Logger.LogWarning(exception, "Could not load the authenticated tower defense progress.");
            }
        }
    }

    protected override void Reset()
    {
        // Cached so the per-tick render does not hand the renderer a new handler for every cell.
        if (_cellClicks.Length == 0)
            _cellClicks = [.. Enumerable.Range(0, TowerDefenseMatch.Columns * TowerDefenseMatch.Rows).Select(cell => (Action)(() => ActivateCell(cell)))];

        _match = null;
        _selectedTower = null;
        _movingTower = null;
        _pendingBuildCell = null;
        _airstrikeArmed = false;
        _resultRecorded = false;
        _lastRewardedEndlessWave = 0;
        _speed = 1;
        if (!IsUnlocked(_mapIndex))
            _mapIndex = 0;
    }

    protected override void OnKey(string key)
    {
        if (_match is null)
        {
            if (key is "enter" or " ")
                Deploy();

            return;
        }

        var (column, row) = (_cursor % TowerDefenseMatch.Columns, _cursor / TowerDefenseMatch.Columns);
        switch (key)
        {
            case "arrowleft": column = Math.Max(0, column - 1); break;
            case "arrowright": column = Math.Min(TowerDefenseMatch.Columns - 1, column + 1); break;
            case "arrowup": row = Math.Max(0, row - 1); break;
            case "arrowdown": row = Math.Min(TowerDefenseMatch.Rows - 1, row + 1); break;
            case "1" or "2" or "3" or "4" or "5" or "6" or "7" or "8" or "9" or "0":
                var kindIndex = key == "0" ? 9 : key[0] - '1';
                if (Enum.IsDefined(typeof(TowerKind), kindIndex))
                    SelectBuild((TowerKind)kindIndex);
                break;
            case "enter" or " ":
                if (_pendingBuildCell is not null)
                    ConfirmPlacement();
                else
                    ActivateCell(_cursor);
                break;
            case "d": Upgrade(UpgradeTrack.Damage); break;
            case "r": Upgrade(UpgradeTrack.Range); break;
            case "f": Upgrade(UpgradeTrack.FireRate); break;
            case "x": SellSelected(); break;
            case "t": CycleTarget(); break;
            case "m": ArmMove(); break;
            case "n": CallWave(); break;
            case "a": ToggleAirstrike(); break;
            case "g": ToggleSpeed(); break;
            case "escape":
                _selectedTower = null;
                _movingTower = null;
                _pendingBuildCell = null;
                _buildKind = null;
                _airstrikeArmed = false;
                break;
        }

        _cursor = row * TowerDefenseMatch.Columns + column;
        if (_pendingBuildCell is not null && key is ("arrowleft" or "arrowright" or "arrowup" or "arrowdown"))
            _pendingBuildCell = _cursor;
    }

    private bool IsUnlocked(int mapIndex)
    {
        var mission = TowerDefenseData.Maps[mapIndex];
        return mission.IsBonus
            ? _bonusMissions.Contains(mission.Id)
            : mapIndex == 0 || _cleared.Contains(TowerDefenseData.Maps[mapIndex - 1].Id);
    }

    private bool IsTowerUnlocked(TowerKind kind) => TowerDefenseData.TowerUnlockCost(kind) == 0 || _unlockedTowers.Contains(kind);

    private int? NextMapIndex =>
        Enumerable.Range(_mapIndex + 1, Math.Max(0, TowerDefenseData.Maps.Count - _mapIndex - 1))
            .Where(IsUnlocked).Select(index => (int?)index).FirstOrDefault();

    public bool HasNextMission => NextMapIndex is not null;

    /// <summary>Deploys the current mission, or the next unlocked one, straight after a restart.</summary>
    public void StartMission(bool nextMission)    {
        if (nextMission && NextMapIndex is { } next)
            _mapIndex = next;

        Deploy();
        StateHasChanged();
    }

    private void Deploy()
    {
        if (!IsUnlocked(_mapIndex))
            return;

        var map = TowerDefenseData.Maps[_mapIndex];
        _match = new TowerDefenseMatch(map, TowerDefenseData.Difficulties[_difficultyIndex], _endless, _bonusStartingGold);
        _roadPoints = [.. _match.Roads.Select(road => string.Join(' ', road.Select(point => $"{Px(point.X)},{Px(point.Y)}")))];
        _cursor = _match.FirstFreeCell(3 * TowerDefenseMatch.Columns + 4);
        _buildKind = map.RequiredTower ?? TowerKind.Gunner;
        _selectedTower = null;
        _movingTower = null;
        _pendingBuildCell = null;
        _airstrikeArmed = false;
        _resultRecorded = false;
        _lastRewardedEndlessWave = 0;
        RestartClock();
        StartLoop(TowerDefenseMatch.TickMilliseconds, Tick);
    }

    private async void Tick()
    {
        if (_match is null || _resultRecorded)
            return;

        for (var i = 0; i < _speed && !_match.IsOver; i++)
            _match!.Advance();

        if (_match.Endless
            && _match.State == MatchState.Planning
            && TowerDefenseData.IsEndlessRewardWave(_match.Wave)
            && _match.Wave > _lastRewardedEndlessWave)
        {
            _lastRewardedEndlessWave = _match.Wave;
            _warMartCredits += _match.MissionReward;
            await SaveProgressAsync();
        }

        if (!_match.IsOver)
            return;

        _resultRecorded = true;
        var won = _match.State == MatchState.Won;
        if (won)
        {
            _cleared.Add(_match.Map.Id);
            _warMartCredits += _match.MissionReward;
        }

        var mode = $"{_match.Difficulty.Id}-{(_match.Endless ? "endless" : "campaign")}";
        Finish(_match.FinalScore, mode, won);
        await SaveProgressAsync();
    }

    private async Task SaveProgressAsync(bool syncAccount = true)
    {
        var progress = new TowerDefenseProgressModel(
            _warMartCredits,
            _bonusStartingGold,
            [.. _cleared.Order()],
            [.. _unlockedTowers.Order().Select(kind => kind.ToString())],
            [.. _bonusMissions.Order()]);

        try
        {
            var localProgress = progress.ClearedMissions
                .Concat(progress.UnlockedTowers.Select(kind => $"tower:{kind}"))
                .Concat(progress.BonusMissions.Select(id => $"bonus:{id}"))
                .Append($"credits:{progress.Credits}")
                .Append($"startfunds:{progress.BonusStartingGold}");
            await ScoreStore.SetProgressAsync(GameKey, string.Join(',', localProgress));
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not save local tower defense progress.");
        }

        if (!syncAccount || !_isAuthenticated || ConnectivityState.IsDemoMode)
            return;

        try
        {
            await GameProgressClient.SaveTowerDefenseProgressAsync(progress);
            _progressSyncFailed = false;
        }
        catch (Exception exception)
        {
            _progressSyncFailed = true;
            Logger.LogWarning(exception, "Could not save authenticated tower defense progress.");
        }
    }

    private async Task BuyStartingFunds()
    {
        var cost = TowerDefenseData.StartingFundsUpgradeCost(_bonusStartingGold);
        if (_warMartCredits < cost)
            return;

        _warMartCredits -= cost;
        _bonusStartingGold += TowerDefenseData.StartingFundsIncrement;
        await SaveProgressAsync();
    }

    private async Task BuyTower(TowerKind kind)
    {
        var cost = TowerDefenseData.TowerUnlockCost(kind);
        if (cost <= 0 || _unlockedTowers.Contains(kind) || _warMartCredits < cost)
            return;

        _warMartCredits -= cost;
        _unlockedTowers.Add(kind);
        await SaveProgressAsync();
    }

    private async Task BuyBonusMission(string missionId)
    {
        var mission = TowerDefenseData.Maps.FirstOrDefault(map => map.Id == missionId && map.IsBonus);
        if (mission is null || _bonusMissions.Contains(missionId) || _warMartCredits < mission.UnlockCost)
            return;

        _warMartCredits -= mission.UnlockCost;
        _bonusMissions.Add(missionId);
        await SaveProgressAsync();
    }

    private void SelectBuild(TowerKind kind)
    {
        if (!CanPlay || !IsTowerUnlocked(kind) || (_match?.Map.RequiredTower is { } required && kind != required))
            return;

        _buildKind = kind;
        _selectedTower = null;
        _movingTower = null;
        _pendingBuildCell = null;
        _airstrikeArmed = false;
    }

    private void ActivateCell(int cell)
    {
        if (!CanPlay || _match is null)
            return;

        _cursor = cell;
        if (_movingTower is { } moving)
        {
            if (_match.Move(moving, cell))
            {
                _selectedTower = moving;
                _movingTower = null;
                _pendingBuildCell = null;
                _buildKind = null;
            }

            return;
        }

        if (_airstrikeArmed)
        {
            _match.Airstrike(TowerDefenseMatch.CellX(cell), TowerDefenseMatch.CellY(cell));
            _airstrikeArmed = false;
            return;
        }

        if (_match.TowerAt(cell) is { } tower)
        {
            _pendingBuildCell = null;
            _selectedTower = tower;
            return;
        }

        _selectedTower = null;
        _pendingBuildCell = _buildKind is not null ? cell : null;
    }

    private void ConfirmPlacement()
    {
        if (!CanConfirmPlacement || _match is null || _buildKind is not { } kind
            || _pendingBuildCell is not { } cell)
            return;

        _selectedTower = _match.Build(cell, kind);
        _pendingBuildCell = null;
    }

    private void CancelPlacement() => _pendingBuildCell = null;

    private void Upgrade(UpgradeTrack track)
    {
        if (CanPlay && _selectedTower is { } tower)
            _match!.Upgrade(tower, track);
    }

    private void ArmMove()
    {
        if (CanPlay && _selectedTower is { } tower)
        {
            _movingTower = tower;
            _pendingBuildCell = null;
            _buildKind = null;
            _airstrikeArmed = false;
        }
    }

    private void SellSelected()
    {
        if (CanPlay && _selectedTower is { } tower && _match!.Sell(tower))
        {
            _selectedTower = null;
            _movingTower = null;
        }
    }

    private void CycleTarget()
    {
        if (CanPlay && _selectedTower is { } tower)
            _match!.CycleTarget(tower);
    }

    private void CallWave()
    {
        if (CanCallWave)
            _match!.StartWave();
    }

    private void ToggleAirstrike()
    {
        if (CanPlay)
        {
            _movingTower = null;
            _pendingBuildCell = null;
            _airstrikeArmed = !_airstrikeArmed && _match!.State == MatchState.Running && _match.AirstrikeReady;
        }
    }

    private void ToggleSpeed() => _speed = _speed >= 3 ? 1 : _speed + 1;


    private static string TowerKey(TowerKind kind) => (int)kind == 9 ? "0" : ((int)kind + 1).ToString();

    private static double ShotsPerSecond(int cooldownTicks) => 1000.0 / (TowerDefenseMatch.TickMilliseconds * (cooldownTicks + 1));

    private static string UpgradeKey(UpgradeTrack track) => track switch
    {
        UpgradeTrack.Damage => "D",
        UpgradeTrack.Range => "R",
        _ => "F"
    };

    private static string UpgradeLabel(UpgradeTrack track) => track switch
    {
        UpgradeTrack.Damage => ResourceKeys.Games.TdUpgradeDamage,
        UpgradeTrack.Range => ResourceKeys.Games.TdUpgradeRange,
        _ => ResourceKeys.Games.TdUpgradeFireRate
    };

    private static string TargetLabel(TargetMode mode) => mode switch
    {
        TargetMode.Strongest => ResourceKeys.Games.TdTargetStrongest,
        TargetMode.Closest => ResourceKeys.Games.TdTargetClosest,
        _ => ResourceKeys.Games.TdTargetFirst
    };
}