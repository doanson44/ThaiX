@inherits GameBase

<svg class="game-svg" viewBox="0 0 720 480">
    <line x1="360" y1="0" x2="360" y2="480" stroke="#334155" stroke-width="2" stroke-dasharray="10 10" />
    <text x="360" y="40" font-size="30">@_playerScore : @_aiScore</text>
    <rect x="38" y="@Px(_playerY)" width="12" height="@PaddleHeight" rx="6" fill="#38bdf8" />
    <rect x="@(Width - 50)" y="@Px(_aiY)" width="12" height="@PaddleHeight" rx="6" fill="#f8fafc" />
    <circle cx="@Px(_ballX)" cy="@Px(_ballY)" r="@BallRadius" fill="#facc15" />

    @* Hold the top or bottom half of the board to move the paddle. *@
    <rect class="g-hit" width="720" height="240" fill="transparent"
          @onpointerdown="() => _move = -1" @onpointerup="StopMoving" @onpointerleave="StopMoving" @onpointercancel="StopMoving" />
    <rect class="g-hit" y="240" width="720" height="240" fill="transparent"
          @onpointerdown="() => _move = 1" @onpointerup="StopMoving" @onpointerleave="StopMoving" @onpointercancel="StopMoving" />
</svg>

@code {
    private const int Width = 720;
    private const int Height = 480;
    private const int PaddleHeight = 100;
    private const int PaddleSpeed = 9;
    private const int BallRadius = 9;
    private const int WinningScore = 5;
    private const int TickMilliseconds = 30;
    private const double BallSpeed = 6;
    private const double MaxVerticalSpeed = 7;

    // Share of the distance to the ball the computer covers per tick; it lags behind steep shots.
    private const double AiTracking = 0.08;

    private double _playerY;
    private double _aiY;
    private double _ballX;
    private double _ballY;
    private double _speedX;
    private double _speedY;
    private int _move;
    private int _playerScore;
    private int _aiScore;

    protected override void Reset()
    {
        _playerY = _aiY = (Height - PaddleHeight) / 2.0;
        _playerScore = _aiScore = 0;
        _move = 0;
        Serve();
        StartLoop(TickMilliseconds, Tick);
    }

    protected override void OnKey(string key)
    {
        if (key is "arrowup" or "w")
            _move = -1;
        else if (key is "arrowdown" or "s")
            _move = 1;
    }

    protected override void OnKeyUp(string key)
    {
        if (key is "arrowup" or "w" or "arrowdown" or "s")
            _move = 0;
    }

    private void StopMoving() => _move = 0;

    // The ball is served toward whoever is behind.
    private void Serve()
    {
        _ballX = Width / 2.0;
        _ballY = Height / 2.0;
        _speedX = _playerScore > _aiScore ? -BallSpeed : BallSpeed;
        _speedY = Random.Shared.NextDouble() * 6 - 3;
    }

    private void Tick()
    {
        _playerY = Math.Clamp(_playerY + _move * PaddleSpeed, 0, Height - PaddleHeight);
        _ballX += _speedX;
        _ballY += _speedY;

        if (_ballY < BallRadius || _ballY > Height - BallRadius)
        {
            _ballY = Math.Clamp(_ballY, BallRadius, Height - BallRadius);
            _speedY = -_speedY;
        }

        _aiY = Math.Clamp(_aiY + (_ballY - PaddleHeight / 2.0 - _aiY) * AiTracking, 0, Height - PaddleHeight);

        if (_speedX < 0 && _ballX is > 35 and < 59 && Hits(_playerY))
        {
            // Hitting with the paddle edge adds spin so the player can outplay the computer.
            _speedX = BallSpeed;
            var offset = (_ballY - (_playerY + PaddleHeight / 2.0)) / (PaddleHeight / 2.0);
            _speedY = Math.Clamp(_speedY + offset * 3, -MaxVerticalSpeed, MaxVerticalSpeed);
        }
        else if (_speedX > 0 && _ballX is > Width - 59 and < Width - 35 && Hits(_aiY))
        {
            _speedX = -BallSpeed;
        }

        if (_ballX < 0)
        {
            _aiScore++;
            Serve();
        }
        else if (_ballX > Width)
        {
            _playerScore++;
            Serve();
        }

        if (_playerScore >= WinningScore)
            Finish(1);
        else if (_aiScore >= WinningScore)
            Finish(0);
    }

    private bool Hits(double paddleY) =>
        _ballY > paddleY - BallRadius && _ballY < paddleY + PaddleHeight + BallRadius;
}
