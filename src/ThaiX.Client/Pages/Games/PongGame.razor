@using System.Diagnostics
@using ThaiX.Client.Services.Games
@inherits GameBase

<svg class="game-svg" viewBox="0 0 @PongEngine.BoardWidth @PongEngine.BoardHeight">
    <line x1="360" y1="0" x2="360" y2="480" stroke="#334155" stroke-width="2" stroke-dasharray="10 10" />
    <text x="360" y="40" font-size="30">@_engine.PlayerScore : @_engine.AiScore</text>
    <rect x="38" y="@Px(_engine.PlayerPaddleY)" width="@PongEngine.PaddleWidth" height="@PongEngine.PaddleHeight" rx="6" fill="#38bdf8" />
    <rect x="@(PongEngine.BoardWidth - 50)" y="@Px(_engine.AiPaddleY)" width="@PongEngine.PaddleWidth" height="@PongEngine.PaddleHeight" rx="6" fill="#f8fafc" />
    <circle cx="@Px(_engine.BallX)" cy="@Px(_engine.BallY)" r="@PongEngine.BallRadius" fill="#facc15" />

    @* Hold the top or bottom half of the board to move the paddle. *@
    <rect class="g-hit" width="@PongEngine.BoardWidth" height="240" fill="transparent"
          @onpointerdown="() => _pointerDirection = -1" @onpointerup="StopMoving" @onpointerleave="StopMoving" @onpointercancel="StopMoving" />
    <rect class="g-hit" y="240" width="@PongEngine.BoardWidth" height="240" fill="transparent"
          @onpointerdown="() => _pointerDirection = 1" @onpointerup="StopMoving" @onpointerleave="StopMoving" @onpointercancel="StopMoving" />
</svg>

@code {
    private const int TickMilliseconds = 16;

    private readonly PongEngine _engine = new();
    private long _lastTickTimestamp;
    private bool? _lastPaused;
    private bool _upPressed;
    private bool _downPressed;
    private int _pointerDirection;

    protected override void Reset()
    {
        _engine.Reset();
        _upPressed = false;
        _downPressed = false;
        _pointerDirection = 0;
        _lastTickTimestamp = Stopwatch.GetTimestamp();
        StartLoop(TickMilliseconds, Tick);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_lastPaused != IsPaused)
        {
            _lastTickTimestamp = Stopwatch.GetTimestamp();
            _lastPaused = IsPaused;
        }
    }

    protected override void OnKey(string key)
    {
        if (key is "arrowup" or "w")
            _upPressed = true;
        else if (key is "arrowdown" or "s")
            _downPressed = true;
    }

    protected override void OnKeyUp(string key)
    {
        if (key is "arrowup" or "w")
            _upPressed = false;
        else if (key is "arrowdown" or "s")
            _downPressed = false;
    }

    private void StopMoving() => _pointerDirection = 0;

    private int PlayerDirection =>
        _upPressed == _downPressed
            ? _pointerDirection
            : _upPressed ? -1 : 1;

    private void Tick()
    {
        var now = Stopwatch.GetTimestamp();
        var elapsedSeconds = Stopwatch.GetElapsedTime(_lastTickTimestamp, now).TotalSeconds;
        _lastTickTimestamp = now;

        _engine.Advance(elapsedSeconds, PlayerDirection);

        if (_engine.IsFinished)
            Finish(_engine.PlayerScore >= PongEngine.WinningScore ? 1 : 0);
    }
}
