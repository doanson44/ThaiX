@using RK = ThaiX.Client.Constants.ResourceKeys
@inject Microsoft.Extensions.Localization.IStringLocalizer<ThaiX.Client.Localization.SharedResource> L

<RadzenPanelMenu class="h-100">
    <RadzenPanelMenuItem Path="/" ><Template><span class="tx-nav-item"><ThaiXIcon Name="home" /><span>@L[RK.Menu.Home]</span></span></Template></RadzenPanelMenuItem>
    <RadzenPanelMenuItem Path="blog" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Blog.Public.ListTitle]</span></span></Template></RadzenPanelMenuItem>
    <RadzenPanelMenuItem Path="tools" ><Template><span class="tx-nav-item"><ThaiXIcon Name="settings" /><span>@L[RK.Menu.Tools]</span></span></Template></RadzenPanelMenuItem>
    <RadzenPanelMenuItem Path="games" ><Template><span class="tx-nav-item"><ThaiXIcon Name="gamepad" /><span>@L[RK.Games.Title]</span></span></Template></RadzenPanelMenuItem>

    <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.Menu.MarketData]</span></span></Template>
        <RadzenPanelMenuItem Path="market-data/bank-interest-rates" ><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.BankInterestRates.Title]</span></span></Template></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Path="market-data/bank-deposit-rates" ><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.BankDepositRates.Title]</span></span></Template></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Path="market-data/sacombank-exchange-rates" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.SacombankExchangeRates.Title]</span></span></Template></RadzenPanelMenuItem>
        <RadzenPanelMenuItem Path="market-data/mexc/spot-ticker-socket" ><Template><span class="tx-nav-item"><ThaiXIcon Name="server" /><span>@L[RK.MexcSpotTicker24Hr.SocketTitle]</span></span></Template></RadzenPanelMenuItem>
        @* Pages with [Authorize] — only list when signed in *@
        <AuthorizeView>
            <Authorized>
                <RadzenPanelMenuItem Path="market-data/mexc/contract-ticker-socket" ><Template><span class="tx-nav-item"><ThaiXIcon Name="server" /><span>@L[RK.MexcContractTickers.SocketTitle]</span></span></Template></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Path="market-data/tcbs-top10" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.TcbsTop10.Title]</span></span></Template></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Path="market-data/power-655-analysis" ><Template><span class="tx-nav-item"><ThaiXIcon Name="gamepad" /><span>@L[RK.Power655.Title]</span></span></Template></RadzenPanelMenuItem>
            </Authorized>
        </AuthorizeView>
    </RadzenPanelMenuItem>

    <AuthorizeView>
        <Authorized Context="auth">

            @if (auth.User.HasClaim("scope", PermissionNames.MasterDataRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.Menu.MarketResearch]</span></span></Template>
                    <RadzenPanelMenuItem Path="market-research/vndirect/top-stocks" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.VnDirectTopStocks.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/mexc/contract-ticker" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.MexcContractTickers.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/mexc/spot-ticker" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.MexcSpotTicker24Hr.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/coingecko" ><Template><span class="tx-nav-item"><ThaiXIcon Name="cube" /><span>@L[RK.CoinGecko.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/dragon-capital" ><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.DragonCapitalFunds.Title]</span></span></Template></RadzenPanelMenuItem>
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.ChainBrokerDataRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="share" /><span>@L[RK.Menu.ChainBroker]</span></span></Template>
                    <RadzenPanelMenuItem Path="market-research/chainbroker/funds" ><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.ChainBrokerFunds.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/chainbroker/projects" ><Template><span class="tx-nav-item"><ThaiXIcon Name="lightning" /><span>@L[RK.ChainBrokerProjects.Title]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="market-research/chainbroker/unlocks" ><Template><span class="tx-nav-item"><ThaiXIcon Name="lock" /><span>@L[RK.ChainBrokerUnlocks.Title]</span></span></Template></RadzenPanelMenuItem>
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.PortfolioRead)
                || auth.User.HasClaim("scope", PermissionNames.PriceAlertRead)
                || auth.User.HasClaim("scope", PermissionNames.MarketScannerRuleRead)
                || auth.User.HasClaim("scope", PermissionNames.ExpenseTransactionRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.Menu.PortfolioGroup]</span></span></Template>
                    @if (auth.User.HasClaim("scope", PermissionNames.PortfolioRead))
                    {
                        <RadzenPanelMenuItem Path="portfolio/list" ><Template><span class="tx-nav-item"><ThaiXIcon Name="analytics" /><span>@L[RK.Menu.Portfolios]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.PriceAlertRead))
                    {
                        <RadzenPanelMenuItem Path="portfolio/price-alerts" ><Template><span class="tx-nav-item"><ThaiXIcon Name="bell" /><span>@L[RK.PriceAlerts.Title]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.MarketScannerRuleRead))
                    {
                        <RadzenPanelMenuItem Path="portfolio/market-scanner-rules" ><Template><span class="tx-nav-item"><ThaiXIcon Name="search" /><span>@L[RK.MarketScanner.Title]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.ExpenseTransactionRead))
                    {
                        <RadzenPanelMenuItem Path="portfolio/expense-tracker" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.ExpenseTracker]</span></span></Template></RadzenPanelMenuItem>
                    }
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.ContactRead) || auth.User.HasClaim("scope", PermissionNames.NoteRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="team" /><span>@L[RK.Menu.Crm]</span></span></Template>
                    @if (auth.User.HasClaim("scope", PermissionNames.ContactRead))
                    {
                        <RadzenPanelMenuItem Path="crm/contacts" ><Template><span class="tx-nav-item"><ThaiXIcon Name="team" /><span>@L[RK.Menu.Contacts]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.NoteRead))
                    {
                        <RadzenPanelMenuItem Path="crm/notes" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.Notes]</span></span></Template></RadzenPanelMenuItem>
                    }
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.MasterDataRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.MasterData]</span></span></Template>
                    <RadzenPanelMenuItem Path="master-data/countries" ><Template><span class="tx-nav-item"><ThaiXIcon Name="globe" /><span>@L[RK.Menu.MasterDataCountries]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="master-data/cities" ><Template><span class="tx-nav-item"><ThaiXIcon Name="globe" /><span>@L[RK.Menu.MasterDataCities]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="master-data/districts" ><Template><span class="tx-nav-item"><ThaiXIcon Name="globe" /><span>@L[RK.Menu.MasterDataDistricts]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="master-data/banks" ><Template><span class="tx-nav-item"><ThaiXIcon Name="wallet" /><span>@L[RK.Menu.MasterDataBanks]</span></span></Template></RadzenPanelMenuItem>
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.SystemAdmin)
                || auth.User.HasClaim("scope", PermissionNames.NotificationScheduleRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="bell" /><span>@L[RK.Menu.NotificationCenter]</span></span></Template>
                    @if (auth.User.HasClaim("scope", PermissionNames.SystemAdmin))
                    {
                        <RadzenPanelMenuItem Path="notifications/sender" ><Template><span class="tx-nav-item"><ThaiXIcon Name="share" /><span>@L[RK.Menu.NotificationSender]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.SystemAdmin)
                        || auth.User.HasClaim("scope", PermissionNames.NotificationScheduleRead))
                    {
                        <RadzenPanelMenuItem Path="notifications/schedules" ><Template><span class="tx-nav-item"><ThaiXIcon Name="calendar" /><span>@L[RK.Menu.NotificationSchedules]</span></span></Template></RadzenPanelMenuItem>
                    }
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.ApiClientRead)
                || auth.User.HasClaim("scope", PermissionNames.CredentialAccountRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="shield-check" /><span>@L[RK.Menu.Security]</span></span></Template>
                    @if (auth.User.HasClaim("scope", PermissionNames.ApiClientRead))
                    {
                        <RadzenPanelMenuItem Path="security/api-clients" ><Template><span class="tx-nav-item"><ThaiXIcon Name="lock" /><span>@L[RK.Menu.ApiClients]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.CredentialAccountRead))
                    {
                        <RadzenPanelMenuItem Path="security/credential-accounts" ><Template><span class="tx-nav-item"><ThaiXIcon Name="lock" /><span>@L[RK.Menu.CredentialAccounts]</span></span></Template></RadzenPanelMenuItem>
                    }
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.UserRead)
                || auth.User.HasClaim("scope", PermissionNames.SystemAdmin)
                || auth.User.HasClaim("scope", PermissionNames.SystemViewLogs)
                || auth.User.HasClaim("scope", PermissionNames.ResumeWrite)
                || auth.User.HasClaim("scope", PermissionNames.JsonBinRead)
                || auth.User.HasClaim("scope", PermissionNames.FileRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="settings" /><span>@L[RK.Menu.Administration]</span></span></Template>
                    @if (auth.User.HasClaim("scope", PermissionNames.UserRead))
                    {
                        <RadzenPanelMenuItem Path="admin/users" ><Template><span class="tx-nav-item"><ThaiXIcon Name="team" /><span>@L[RK.Menu.Users]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.SystemAdmin))
                    {
                        <RadzenPanelMenuItem Path="admin/command-tester" ><Template><span class="tx-nav-item"><ThaiXIcon Name="server" /><span>@L[RK.Menu.CommandTester]</span></span></Template></RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Path="admin/ai-tester" ><Template><span class="tx-nav-item"><ThaiXIcon Name="ai-chip" /><span>@L[RK.Menu.AiTester]</span></span></Template></RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Path="admin/cmsx-proxy-tester" ><Template><span class="tx-nav-item"><ThaiXIcon Name="link" /><span>@L[RK.Menu.CmsxProxyTester]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.SystemViewLogs))
                    {
                        <RadzenPanelMenuItem Path="admin/system-logs" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.SystemLogs]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.JsonBinRead))
                    {
                        <RadzenPanelMenuItem Path="admin/json-bins" ><Template><span class="tx-nav-item"><ThaiXIcon Name="database" /><span>@L[RK.Menu.JsonBins]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.FileRead))
                    {
                        <RadzenPanelMenuItem Path="admin/public-html" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.PublicHtmlPages]</span></span></Template></RadzenPanelMenuItem>
                    }
                    @if (auth.User.HasClaim("scope", PermissionNames.ResumeWrite))
                    {
                        <RadzenPanelMenuItem Path="admin/resume" ><Template><span class="tx-nav-item"><ThaiXIcon Name="user" /><span>@L[RK.Menu.Resume]</span></span></Template></RadzenPanelMenuItem>
                    }
                </RadzenPanelMenuItem>
            }

            @if (auth.User.HasClaim("scope", PermissionNames.BlogRead))
            {
                <RadzenPanelMenuItem Expanded="false"><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.Blog]</span></span></Template>
                    <RadzenPanelMenuItem Path="admin/blog/posts" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.BlogPosts]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="admin/blog/categories" ><Template><span class="tx-nav-item"><ThaiXIcon Name="applications" /><span>@L[RK.Menu.BlogCategories]</span></span></Template></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Path="admin/blog/tags" ><Template><span class="tx-nav-item"><ThaiXIcon Name="document" /><span>@L[RK.Menu.BlogTags]</span></span></Template></RadzenPanelMenuItem>
                </RadzenPanelMenuItem>
            }

            <RadzenPanelMenuItem Path="account/profile" ><Template><span class="tx-nav-item"><ThaiXIcon Name="user" /><span>@L[RK.Menu.Profile]</span></span></Template></RadzenPanelMenuItem>
        </Authorized>
        <NotAuthorized>
            <RadzenPanelMenuItem Path="auth/login" ><Template><span class="tx-nav-item"><ThaiXIcon Name="user" /><span>@L[RK.Menu.Login]</span></span></Template></RadzenPanelMenuItem>
            <RadzenPanelMenuItem Path="auth/register" ><Template><span class="tx-nav-item"><ThaiXIcon Name="team" /><span>@L[RK.Menu.Register]</span></span></Template></RadzenPanelMenuItem>
        </NotAuthorized>
    </AuthorizeView>
</RadzenPanelMenu>
