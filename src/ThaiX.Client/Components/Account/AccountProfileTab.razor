@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.Auth
@using ThaiX.Client.Constants
@using System.Text.RegularExpressions
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L

@if (_isLoading)
{
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" class="rz-mt-3" />
}
else if (_profile is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" class="rz-mt-3">
        @L[RK.Profile.LoadFailed]
    </RadzenAlert>
}
else
{
    <RadzenRow Gap="1rem" class="rz-pt-3">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Gap="0.5rem">
                    <RadzenText><strong>@L[RK.Profile.UserId]:</strong> @_profile.UserId</RadzenText>
                    <RadzenText><strong>@L[RK.Profile.Email]:</strong> @_profile.Email</RadzenText>
                    <RadzenText>
                        <strong>@L[RK.Profile.EmailConfirmed]:</strong>
                        @(_profile.EmailConfirmed ? L[RK.Common.Yes] : L[RK.Common.No])
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-mt-3">
        <RadzenStack Gap="1rem">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.H6" class="mb-0">@L[RK.Profile.Permissions]</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="text-muted">
                    @_profile.Permissions.Count @L[RK.Profile.PermissionsGranted]
                </RadzenText>
            </RadzenStack>
            @if (_profile.Permissions.Count == 0)
            {
                <RadzenText class="text-muted">@L[RK.Profile.NoPermissions]</RadzenText>
            }
            @if (_permissionGroups.Count > 0)
            {
                <RadzenRow Gap="1rem">
                    @foreach (var group in _permissionGroups)
                    {
                        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                            <RadzenCard Variant="Variant.Outlined" class="h-100">
                                <RadzenStack Gap="0.75rem">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center"
                                                 JustifyContent="JustifyContent.SpaceBetween"
                                                 Gap="0.5rem">
                                        <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">
                                            @group.DisplayName
                                        </RadzenText>
                                        <RadzenBadge Text="@($"{group.GrantedCount}/{group.Actions.Count}")"
                                                     BadgeStyle="@(group.GrantedCount == group.Actions.Count ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                                    </RadzenStack>
                                    <RadzenStack Gap="0.5rem">
                                        @foreach (var action in group.Actions)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal"
                                                         AlignItems="AlignItems.Center"
                                                         Gap="0.5rem">
                                                <RadzenCheckBox TValue="bool" Value="@action.IsGranted" Disabled="true" />
                                                <RadzenText TextStyle="TextStyle.Body2">@action.DisplayName</RadzenText>
                                            </RadzenStack>
                                        }
                                    </RadzenStack>
                                </RadzenStack>
                            </RadzenCard>
                        </RadzenColumn>
                    }
                </RadzenRow>
            }
        </RadzenStack>
    </RadzenCard>

    @if (_externalLogins is not null)
    {
        <RadzenCard Variant="Variant.Outlined" class="rz-mt-3">
            <RadzenStack Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H6">@L[RK.Account.ExternalLoginsTitle]</RadzenText>
                <RadzenText>@L[RK.Account.ExternalLoginsDescription]</RadzenText>
                @if (_externalLogins.ExternalLogins.Count == 0)
                {
                    <RadzenText>@L[RK.Account.ExternalLoginsNoLogins]</RadzenText>
                }
                else
                {
                    @if (_externalLogins.HasPassword)
                    {
                        <RadzenText TextStyle="TextStyle.Caption">@L[RK.Account.ExternalLoginsHasPassword]</RadzenText>
                    }
                    <RadzenStack Gap="0.25rem">
                        @foreach (var login in _externalLogins.ExternalLogins)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenText>@(login.ProviderDisplayName ?? login.LoginProvider)</RadzenText>
                                <RadzenButton Text="@L[RK.Account.ExternalLoginsRemove]"
                                              Icon="link_off"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.Small"
                                              Disabled="@(_removingLoginProvider == login.LoginProvider)"
                                              Click="@(() => RemoveExternalLoginAsync(login))" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    }
}

@code {
    private UserInfoResponse? _profile;
    private ExternalLoginsResponse? _externalLogins;
    private bool _isLoading = true;
    private string? _removingLoginProvider;
    private bool _loaded;
    private IReadOnlyList<PermissionGroupViewModel> _permissionGroups = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_loaded)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _profile = await AuthService.GetCurrentUserAsync();
            _permissionGroups = BuildPermissionGroups(_profile.Permissions);
            _externalLogins = await AuthService.GetExternalLoginsAsync();
            _loaded = true;
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/auth/login");
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Profile.LoadFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static IReadOnlyList<PermissionGroupViewModel> BuildPermissionGroups(IEnumerable<string> grantedPermissions)
    {
        var granted = grantedPermissions.ToHashSet(StringComparer.Ordinal);
        var allPermissions = PermissionNames.GetAll()
            .Concat(granted)
            .Distinct(StringComparer.Ordinal);

        return allPermissions
            .Select(permission =>
            {
                var separatorIndex = permission.IndexOf('.');
                return separatorIndex > 0 && separatorIndex < permission.Length - 1
                    ? new PermissionEntry(
                        permission[..separatorIndex],
                        permission[(separatorIndex + 1)..],
                        granted.Contains(permission))
                    : new PermissionEntry(permission, string.Empty, granted.Contains(permission));
            })
            .GroupBy(permission => permission.Feature, StringComparer.Ordinal)
            .OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group =>
            {
                var actions = group
                    .OrderBy(permission => permission.Action, StringComparer.Ordinal)
                    .Select(permission => new PermissionActionViewModel(
                        FormatPermissionName(permission.Action),
                        permission.IsGranted))
                    .ToArray();

                return new PermissionGroupViewModel(
                    FormatPermissionName(group.Key),
                    actions,
                    actions.Count(action => action.IsGranted));
            })
            .ToArray();
    }

    private static string FormatPermissionName(string value)
    {
        var withWordBoundaries = Regex.Replace(value, "([a-z0-9])([A-Z])", "$1 $2");
        return Regex.Replace(withWordBoundaries, "([A-Z])([A-Z][a-z])", "$1 $2");
    }

    private sealed record PermissionEntry(string Feature, string Action, bool IsGranted);

    private sealed record PermissionActionViewModel(string DisplayName, bool IsGranted);

    private sealed record PermissionGroupViewModel(
        string DisplayName,
        IReadOnlyList<PermissionActionViewModel> Actions,
        int GrantedCount);

    private async Task RemoveExternalLoginAsync(ExternalLoginDto login)
    {
        if (_removingLoginProvider != null)
        {
            return;
        }

        _removingLoginProvider = login.LoginProvider;
        try
        {
            await AuthService.RemoveExternalLoginAsync(new RemoveExternalLoginRequest
            {
                LoginProvider = login.LoginProvider,
                ProviderKey = login.ProviderKey
            });
            NotificationService.NotifySuccess(L[RK.Account.ExternalLoginsRemoveSuccess]);
            _externalLogins = await AuthService.GetExternalLoginsAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Account.ExternalLoginsRemoveFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _removingLoginProvider = null;
        }
    }
}
