@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IAuthService AuthService
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem" class="rz-pt-3">
    <RadzenText>@L[RK.Profile.ChangePasswordDescription]</RadzenText>

    <RadzenTemplateForm Data="@_model" Submit="@((ChangePasswordFormModel _) => OnSubmitAsync())">
        <RadzenStack Gap="0.75rem">
            <RadzenLabel Text="@L[RK.Profile.CurrentPassword]" />
            <RadzenPassword Name="currentPassword"
                            @bind-Value="_model.CurrentPassword"
                            class="w-100" />
            <RadzenRequiredValidator Component="currentPassword"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />

            <RadzenLabel Text="@L[RK.Profile.NewPassword]" />
            <RadzenPassword Name="newPassword"
                            @bind-Value="_model.NewPassword"
                            class="w-100" />
            <RadzenRequiredValidator Component="newPassword"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />

            <RadzenLabel Text="@L[RK.Profile.ConfirmNewPassword]" />
            <RadzenPassword Name="confirmPassword"
                            @bind-Value="_model.ConfirmPassword"
                            class="w-100" />
            <RadzenRequiredValidator Component="confirmPassword"
                                     Text="@L[RK.Validation.Required]"
                                     Popup="false" />
            <RadzenCompareValidator Component="confirmPassword"
                                    Value="@_model.NewPassword"
                                    Text="@L[RK.Validation.PasswordMismatch]"
                                    Popup="false" />

            <RadzenButton Text="@L[RK.Common.Save]"
                          Icon="save"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_isSubmitting"
                          Disabled="@_isSubmitting" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    private ChangePasswordFormModel _model = new();
    private bool _isSubmitting;

    private async Task OnSubmitAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            await AuthService.ChangePasswordAsync(new ChangePasswordRequest
            {
                CurrentPassword = _model.CurrentPassword,
                NewPassword = _model.NewPassword,
                ConfirmPassword = _model.ConfirmPassword
            });

            NotificationService.NotifySuccess(L[RK.Profile.ChangePasswordSuccess], L[RK.Profile.ChangePasswordSuccessDetail]);
            _model = new ChangePasswordFormModel();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Profile.ChangePasswordFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class ChangePasswordFormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
