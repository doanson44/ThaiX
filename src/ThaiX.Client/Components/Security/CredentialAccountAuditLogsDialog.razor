@inherits ThaiXPageBase
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.CredentialAccounts
@using ThaiX.Client.Services.CredentialAccounts
@inject ICredentialAccountService CredentialAccountService
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem">
    @if (!string.IsNullOrWhiteSpace(Username))
    {
        <RadzenText class="text-muted">@Username</RadzenText>
    }

    @if (!Viewport.IsMobile)
    {
        <RadzenDataGrid @ref="_grid"
                        TItem="CredentialAccountAuditDto"
                        Data="@_items"
                        Count="@_totalCount"
                        LoadData="@LoadDataAsync"
                        AllowPaging="true"
                        AllowSorting="false"
                        AllowFiltering="false"
                        FilterMode="FilterMode.Advanced"
                        PageSize="@DefaultPageSize"
                        PageSizeOptions="@PageSizeOptions"
                        ShowPagingSummary="true"
                        Density="Density.Compact"
                        IsLoading="@_isLoading"
                        class="w-100">
            <Columns>
                <RadzenDataGridColumn TItem="CredentialAccountAuditDto"
                                      Property="@nameof(CredentialAccountAuditDto.CreatedAt)"
                                      Title="@L[RK.CredentialAccounts.AuditCreatedAt]">
                    <Template Context="item">
                        @item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CredentialAccountAuditDto"
                                      Property="@nameof(CredentialAccountAuditDto.UserName)"
                                      Title="@L[RK.CredentialAccounts.AuditUser]" />
                <RadzenDataGridColumn TItem="CredentialAccountAuditDto"
                                      Property="@nameof(CredentialAccountAuditDto.Action)"
                                      Title="@L[RK.CredentialAccounts.AuditAction]" />
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
        <RadzenStack Gap="0.75rem">
            @if (_isLoading)
            {
                <RadzenText>@L[RK.Common.Loading]</RadzenText>
            }
            else if (_items.Count == 0)
            {
                <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <RadzenCard class="p-3">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Body1" class="mb-0">@item.Action</RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.AuditUser]: @item.UserName
                            </RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.AuditCreatedAt]: @item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                }

                <AdminListPager TotalCount="@_totalCount"
                                PageSize="@_pageSize"
                                CurrentPage="@_currentPage"
                                CurrentPageChanged="@GoToPageAsync"
                                Disabled="@_isLoading" />
            }
        </RadzenStack>
    }
</RadzenStack>

@code {
    private const int DefaultPageSize = 10;
    private static readonly IEnumerable<int> PageSizeOptions = [10, 20, 50];

    [Parameter] public Guid AccountId { get; set; }
    [Parameter] public string? Username { get; set; }

    private RadzenDataGrid<CredentialAccountAuditDto>? _grid;
    private List<CredentialAccountAuditDto> _items = [];
    private int _totalCount;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private bool _isLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.Reload();
            return;
        }

        await LoadPageAsync();
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _pageSize = args.Top ?? DefaultPageSize;
        _currentPage = _pageSize <= 0 ? 1 : ((args.Skip ?? 0) / _pageSize) + 1;
        await LoadPageAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (!Viewport.IsMobile && _grid is not null)
        {
            await _grid.GoToPage(page - 1);
            return;
        }

        _currentPage = page;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;

        try
        {
            var result = await CredentialAccountService.GetAuditLogsAsync(AccountId, new CredentialAccountAuditListRequest
            {
                PageNumber = _currentPage,
                PageSize = _pageSize
            });

            _items = result.Data?.ToList() ?? [];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.CredentialAccounts.AuditLoadFailed], ex.GetDisplayDetail());
            _items = [];
            _totalCount = 0;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

}
