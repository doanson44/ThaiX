@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IApiClientService ApiClientService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem">
    @if (_isLoading)
    {
        <RadzenText>@L[RK.Common.Loading]</RadzenText>
    }
    else
    {
        <RadzenText class="text-muted small">@L[RK.ApiClients.AvailableScopes]</RadzenText>

        <RadzenListBox @bind-Value="@_selectedScopes"
                       Data="@_availableScopes"
                       Multiple="true"
                       class="w-100"
                       Style="height: 320px; overflow-y: auto;" />

        <div class="d-flex flex-wrap gap-2">
            <RadzenButton Text="@L[RK.Common.Save]"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_isSaving"
                          Disabled="@_isSaving"
                          Click="@SaveAsync" />
            <RadzenButton Text="@L[RK.Common.Close]"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => DialogService.Close(false))" />
        </div>
    }
</RadzenStack>

@code {
    [Parameter] public Guid ClientGuid { get; set; }
    [Parameter] public IReadOnlyCollection<string> CurrentScopes { get; set; } = [];

    private IReadOnlyList<string> _availableScopes = [];
    private IEnumerable<string> _selectedScopes = [];
    private bool _isLoading = true;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _availableScopes = await ApiClientService.GetAvailableScopesAsync();
            _selectedScopes = CurrentScopes.ToList();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.LoadFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            await ApiClientService.UpdateScopesAsync(ClientGuid, new UpdateApiClientScopesRequest
            {
                Scopes = _selectedScopes.ToList()
            });
            NotificationService.NotifySuccess(L[RK.ApiClients.ScopesUpdatedSuccess]);
            DialogService.Close(true);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.ScopesUpdatedFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _isSaving = false;
        }
    }

}
