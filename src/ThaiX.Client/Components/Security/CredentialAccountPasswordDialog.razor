@using RK = ThaiX.Client.Constants.ResourceKeys
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@L[RK.CredentialAccounts.Username]" />
        <RadzenTextBox Value="@Username" ReadOnly="true" class="w-100" />
    </RadzenStack>

    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@L[RK.CredentialAccounts.Password]" />
        <RadzenTextBox Value="@Password" ReadOnly="true" class="w-100 font-monospace" />
    </RadzenStack>

    <RadzenButton Text="@L[RK.Common.Close]"
                  Icon="check"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => DialogService.Close())" />
</RadzenStack>

@code {
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;
}
