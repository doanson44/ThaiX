@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IStringLocalizer<SharedResource> L
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JS

<RadzenStack Gap="1rem">
    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">
        @L[RK.ApiClients.SecretNote]
    </RadzenAlert>

    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@L[RK.ApiClients.ClientId]" />
        <RadzenTextBox Value="@ClientId" ReadOnly="true" class="w-100" />
    </RadzenStack>

    <RadzenStack Gap="0.5rem">
        <RadzenLabel Text="@L[RK.ApiClients.SecretTitle]" />
        <div class="d-flex gap-2">
            <RadzenTextBox Value="@ClientSecret" ReadOnly="true" class="w-100 font-monospace" />
            <RadzenButton Icon="content_copy"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@CopySecretAsync"
                          title="@L[RK.Common.Copy]"
                          aria-label="@L[RK.Common.Copy]" />
        </div>
    </RadzenStack>

    <RadzenButton Text="@L[RK.Common.Close]"
                  Icon="check"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="@(() => DialogService.Close())" />
</RadzenStack>

@code {
    [Parameter] public string ClientId { get; set; } = string.Empty;
    [Parameter] public string ClientSecret { get; set; } = string.Empty;

    private async Task CopySecretAsync()
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("copyTextToClipboard", ClientSecret);
            if (!copied)
            {
                throw new InvalidOperationException("Clipboard copy command failed.");
            }

            NotificationService.NotifySuccess(L[RK.ApiClients.CopySuccess]);
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.ApiClients.CopyFailed], ex.Message);
        }
    }
}
