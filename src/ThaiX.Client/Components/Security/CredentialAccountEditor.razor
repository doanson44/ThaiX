@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.CredentialAccounts
@using ThaiX.Client.Services.CredentialAccounts
@inject ICredentialAccountService CredentialAccountService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem">
    @if (!UseDialog)
    {
        <RadzenText TextStyle="TextStyle.H6" class="mb-0">
            @(IsCreateMode ? L[RK.CredentialAccounts.CreateTitle] : L[RK.CredentialAccounts.EditTitle])
        </RadzenText>
    }

    <RadzenTemplateForm Data="@_model" Submit="@(async (CredentialAccountFormModel _) => await SaveAsync())">
        <RadzenRow Gap="1rem" RowGap="1rem">
            <RadzenColumn Size="12">
                <RadzenLabel Text="@L[RK.CredentialAccounts.Username]" />
                <RadzenTextBox Name="credentialAccountUsername"
                               @bind-Value="_model.Username"
                               class="w-100" />
                <RadzenRequiredValidator Component="credentialAccountUsername"
                                         Text="@L[RK.Validation.Required]"
                                         Popup="false" />
            </RadzenColumn>

            <RadzenColumn Size="12">
                <RadzenLabel Text="@L[RK.CredentialAccounts.Description]" />
                <RadzenTextArea @bind-Value="_model.Description"
                                Rows="4"
                                class="w-100" />
            </RadzenColumn>

            @if (IsCreateMode)
            {
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L[RK.CredentialAccounts.Password]" />
                    <RadzenPassword Name="credentialAccountPassword"
                                    @bind-Value="_model.Password"
                                    class="w-100" />
                    <RadzenRequiredValidator Component="credentialAccountPassword"
                                             Text="@L[RK.Validation.Required]"
                                             Popup="false" />
                </RadzenColumn>
            }
            else
            {
                <RadzenColumn Size="12">
                    <RadzenLabel Text="@L[RK.CredentialAccounts.NewPassword]" />
                    <RadzenPassword @bind-Value="_model.Password"
                                    class="w-100" />
                </RadzenColumn>
            }

            @if (!IsCreateMode)
            {
                <RadzenColumn Size="12">
                    <RadzenCard class="p-3">
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.Body1" class="mb-0">@L[RK.CredentialAccounts.Details]</RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.Status]: @(IsUsed ? L[RK.CredentialAccounts.Used] : L[RK.CredentialAccounts.Unused])
                            </RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.LastUsed]: @(string.IsNullOrWhiteSpace(LastUsedAgo) ? "--" : LastUsedAgo)
                            </RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.UsedBy]: @(string.IsNullOrWhiteSpace(UsedBy) ? "--" : UsedBy)
                            </RadzenText>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.CredentialAccounts.UsageCount]: @UsageCount
                            </RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }

            <RadzenColumn Size="12">
                <div class="d-flex flex-wrap gap-2">
                    <RadzenButton Text="@L[RK.Common.Save]"
                                  Icon="save"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@_isSaving"
                                  Disabled="@_isSaving" />
                    <RadzenButton Text="@L[RK.Common.Close]"
                                  Icon="close"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@CloseAsync"
                                  Disabled="@_isSaving" />
                </div>
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public string? InitialUsername { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public bool IsUsed { get; set; }
    [Parameter] public string? UsedBy { get; set; }
    [Parameter] public int UsageCount { get; set; }
    [Parameter] public string? LastUsedAgo { get; set; }
    [Parameter] public bool UseDialog { get; set; }
    [Parameter] public EventCallback<bool> Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }

    private readonly CredentialAccountFormModel _model = new();
    private string? _stateKey;
    private bool _isSaving;

    private bool IsCreateMode => AccountId is null;

    protected override void OnParametersSet()
    {
        var nextKey = $"{AccountId:N}|{InitialUsername}|{InitialDescription}|{IsUsed}|{UsedBy}|{UsageCount}|{LastUsedAgo}";
        if (string.Equals(_stateKey, nextKey, StringComparison.Ordinal))
        {
            return;
        }

        _stateKey = nextKey;
        _model.Username = InitialUsername ?? string.Empty;
        _model.Description = InitialDescription ?? string.Empty;
        _model.Password = string.Empty;
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;

        try
        {
            if (IsCreateMode)
            {
                await CredentialAccountService.CreateAsync(new CreateCredentialAccountRequest
                {
                    Username = _model.Username.Trim(),
                    Password = _model.Password,
                    Description = NormalizeOptional(_model.Description)
                });

                NotificationService.NotifySuccess(L[RK.CredentialAccounts.CreateSuccess]);
            }
            else
            {
                await CredentialAccountService.UpdateAsync(AccountId!.Value, new UpdateCredentialAccountRequest
                {
                    Username = _model.Username.Trim(),
                    Description = NormalizeOptional(_model.Description)
                });

                NotificationService.NotifySuccess(L[RK.CredentialAccounts.UpdateSuccess]);

                if (!string.IsNullOrWhiteSpace(_model.Password))
                {
                    await CredentialAccountService.ChangePasswordAsync(AccountId.Value, new ChangeCredentialAccountPasswordRequest
                    {
                        Password = _model.Password
                    });

                    NotificationService.NotifySuccess(L[RK.CredentialAccounts.PasswordChangedSuccess]);
                }
            }

            await CompleteAsync(true);
        }
        catch (ApiException ex)
        {
            if (IsCreateMode)
            {
                NotificationService.NotifyError(L[RK.CredentialAccounts.CreateFailed], ex.GetDisplayDetail());
            }
            else
            {
                NotificationService.NotifyError(L[RK.CredentialAccounts.UpdateFailed], ex.GetDisplayDetail());
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CloseAsync()
    {
        await CompleteAsync(false);
    }

    private async Task CompleteAsync(bool saved)
    {
        if (Saved.HasDelegate && saved)
        {
            await Saved.InvokeAsync(true);
        }

        if (!saved && Cancelled.HasDelegate)
        {
            await Cancelled.InvokeAsync();
        }

        if (UseDialog)
        {
            await Task.Delay(100);
            DialogService.Close(saved);
        }
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private sealed class CredentialAccountFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
