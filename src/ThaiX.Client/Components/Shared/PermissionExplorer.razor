@using System.Text.RegularExpressions
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap"
                 Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.Body2" class="text-muted mb-0">
            @L[RK.PermissionExplorer.Summary, SelectedSet.Count, _permissions.Count]
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="@L[RK.PermissionExplorer.All]"
                          Size="ButtonSize.Small"
                          ButtonStyle="@(_filter == PermissionFilter.All ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Click="@(() => SetFilter(PermissionFilter.All))" />
            <RadzenButton Text="@L[RK.PermissionExplorer.Granted]"
                          Size="ButtonSize.Small"
                          ButtonStyle="@(_filter == PermissionFilter.Granted ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Click="@(() => SetFilter(PermissionFilter.Granted))" />
            <RadzenButton Text="@L[RK.PermissionExplorer.Missing]"
                          Size="ButtonSize.Small"
                          ButtonStyle="@(_filter == PermissionFilter.Missing ? ButtonStyle.Primary : ButtonStyle.Light)"
                          Click="@(() => SetFilter(PermissionFilter.Missing))" />
        </RadzenStack>
    </RadzenStack>

    <RadzenTextBox @bind-Value="_searchTerm"
                   Placeholder="@L[RK.PermissionExplorer.SearchPlaceholder]"
                   class="w-100"
                   aria-label="@L[RK.PermissionExplorer.SearchPlaceholder]" />

    @if (VisibleGroups.Count == 0)
    {
        <RadzenText class="text-muted py-3">@L[RK.PermissionExplorer.NoResults]</RadzenText>
    }
    else
    {
        <RadzenRow Gap="0.75rem" RowGap="0.75rem">
            @foreach (var group in VisibleGroups)
            {
                <RadzenColumn Size="12" SizeMD="6" SizeLG="6">
                    <RadzenCard Variant="Variant.Outlined" class="h-100">
                        <RadzenStack Gap="0.5rem">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween"
                                         Gap="0.5rem">
                                <RadzenButton Text="@group.DisplayName"
                                              Icon="@(_collapsedGroups.Contains(group.Name) ? "keyboard_arrow_right" : "keyboard_arrow_down")"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Text"
                                              class="text-start"
                                              Click="@(() => ToggleGroup(group.Name))" />
                                <RadzenBadge Text="@($"{group.GrantedCount}/{group.TotalCount}")"
                                             BadgeStyle="@(group.GrantedCount == group.TotalCount ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                            </RadzenStack>
                            @if (!_collapsedGroups.Contains(group.Name))
                            {
                                <RadzenStack Gap="0.5rem">
                                    @foreach (var permission in group.Permissions)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal"
                                                     AlignItems="AlignItems.Center"
                                                     Gap="0.5rem">
                                            <RadzenCheckBox TValue="bool"
                                                            Value="@SelectedSet.Contains(permission.Name)"
                                                            Disabled="@(!Editable)"
                                                            Change="@((bool value) => TogglePermission(permission.Name, value))" />
                                            <RadzenText TextStyle="TextStyle.Body2" class="mb-0 text-break">
                                                @permission.DisplayAction
                                            </RadzenText>
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Permissions { get; set; } = [];
    [Parameter] public IEnumerable<string>? SelectedPermissions { get; set; }
    [Parameter] public EventCallback<IEnumerable<string>> SelectedPermissionsChanged { get; set; }
    [Parameter] public bool Editable { get; set; }

    private string _searchTerm = string.Empty;
    private PermissionFilter _filter;
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);

    private HashSet<string> SelectedSet => (SelectedPermissions ?? []).ToHashSet(StringComparer.Ordinal);

    private IReadOnlyList<PermissionGroup> _permissions => Permissions
        .Distinct(StringComparer.Ordinal)
        .Select(name =>
        {
            var separatorIndex = name.IndexOf('.');
            var feature = separatorIndex > 0 && separatorIndex < name.Length - 1
                ? name[..separatorIndex]
                : name;
            var action = separatorIndex > 0 && separatorIndex < name.Length - 1
                ? name[(separatorIndex + 1)..]
                : string.Empty;

            return new PermissionItem(name, feature, action);
        })
        .GroupBy(item => item.Feature, StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal)
        .Select(group =>
        {
            var items = group
                .OrderBy(item => item.Action, StringComparer.Ordinal)
                .Select(item => item with { DisplayAction = FormatPermissionName(item.Action) })
                .ToArray();
            var grantedCount = items.Count(item => SelectedSet.Contains(item.Name));

            return new PermissionGroup(
                group.Key,
                FormatPermissionName(group.Key),
                items,
                grantedCount,
                items.Length);
        })
        .ToArray();

    private IReadOnlyList<PermissionGroup> VisibleGroups => _permissions
        .Select(group => group with
        {
            Permissions = group.Permissions
                .Where(item => _filter switch
                {
                    PermissionFilter.Granted => SelectedSet.Contains(item.Name),
                    PermissionFilter.Missing => !SelectedSet.Contains(item.Name),
                    _ => true
                })
                .Where(item => string.IsNullOrWhiteSpace(_searchTerm) ||
                    item.Name.Contains(_searchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    item.DisplayAction.Contains(_searchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    group.DisplayName.Contains(_searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToArray()
        })
        .Where(group => group.Permissions.Count > 0)
        .ToArray();

    private async Task TogglePermission(string permission, bool isGranted)
    {
        if (!Editable)
        {
            return;
        }

        var selected = SelectedSet;
        if (isGranted)
        {
            selected.Add(permission);
        }
        else
        {
            selected.Remove(permission);
        }

        await SelectedPermissionsChanged.InvokeAsync(
            selected.OrderBy(value => value, StringComparer.Ordinal).ToArray());
    }

    private void SetFilter(PermissionFilter filter) => _filter = filter;

    private void ToggleGroup(string group)
    {
        if (!_collapsedGroups.Add(group))
        {
            _collapsedGroups.Remove(group);
        }
    }

    private static string FormatPermissionName(string value)
    {
        var withWordBoundaries = Regex.Replace(value, "([a-z0-9])([A-Z])", "$1 $2");
        return Regex.Replace(withWordBoundaries, "([A-Z])([A-Z][a-z])", "$1 $2");
    }

    private enum PermissionFilter
    {
        All,
        Granted,
        Missing
    }

    private sealed record PermissionItem(string Name, string Feature, string Action)
    {
        public string DisplayAction { get; init; } = Action;
    }

    private sealed record PermissionGroup(
        string Name,
        string DisplayName,
        IReadOnlyList<PermissionItem> Permissions,
        int GrantedCount,
        int TotalCount);
}
