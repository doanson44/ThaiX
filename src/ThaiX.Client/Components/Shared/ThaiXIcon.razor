@if (BootstrapIcon is not null)
{
    <i class="bi bi-@BootstrapIcon @Class"
       style="@ResolvedStyle"
       title="@Title"
       role="@(HasTitle ? "img" : null)"
       aria-hidden="@(HasTitle ? null : "true")"
       @attributes="AdditionalAttributes"></i>
}
else if (UseCustomFallback)
{
    <svg class="tx-icon @Class"
         width="@Size"
         height="@Size"
         viewBox="0 0 24 24"
         fill="currentColor"
         preserveAspectRatio="xMidYMid meet"
         role="@(HasTitle ? "img" : null)"
         aria-hidden="@(HasTitle ? null : "true")"
         focusable="false"
         style="@Style"
         @attributes="AdditionalAttributes">
        @if (HasTitle)
        {
            <title>@Title</title>
        }
        <use href="@SpriteReference" />
    </svg>
}
else
{
    <RadzenIcon Icon="@ResolvedName"
                Class="@Class"
                Style="@ResolvedStyle"
                title="@Title"
                role="@(HasTitle ? "img" : null)"
                aria-hidden="@(HasTitle ? null : "true")"
                @attributes="AdditionalAttributes" />
}

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Icon
    {
        get => Name;
        set
        {
            if (!string.IsNullOrWhiteSpace(value))
                Name = value;
        }
    }

    [Parameter]
    public string Size { get; set; } = "1em";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string ResolvedName => ThaixIcons.Resolve(string.IsNullOrWhiteSpace(Name) ? Icon : Name);

    private string? BootstrapIcon =>
        ThaixIcons.ResolveBootstrapIcon(string.IsNullOrWhiteSpace(Name) ? Icon : Name);

    private bool UseCustomFallback => ThaixIcons.UsesCustomFallback(ResolvedName);

    private string SpriteReference => $"{ThaixIcons.SpritePath}#{ResolvedName}";

    private string ResolvedStyle
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Style) &&
                Style.Contains("font-size:", StringComparison.OrdinalIgnoreCase))
            {
                return Style;
            }

            var size = string.IsNullOrWhiteSpace(Size) ? "1em" : Size;
            return string.IsNullOrWhiteSpace(Style)
                ? $"font-size: {size};"
                : $"{Style.Trim().TrimEnd(';')}; font-size: {size};";
        }
    }
}
