<svg class="tx-icon @Class"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     role="@(HasTitle ? "img" : null)"
     aria-hidden="@(HasTitle ? null : "true")"
     focusable="false">
    @if (HasTitle)
    {
        <title>@Title</title>
    }
    @if (IsKnownIcon)
    {
        <use href="@($"/icons/system-design.svg#{Name}")" />
    }
</svg>

@code {
    private static readonly HashSet<string> KnownIcons =
    [
        "home", "analytics", "team", "wallet", "database", "document",
        "shield-check", "ai-chip", "cube", "link", "gamepad", "video",
        "image", "settings", "globe", "leaf", "lightning", "cart", "bell",
        "alert", "lock", "cloud", "server", "search", "chat", "heart",
        "user", "share"
    ];

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Size { get; set; } = "1em";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);
    private bool IsKnownIcon => KnownIcons.Contains(Name);
}