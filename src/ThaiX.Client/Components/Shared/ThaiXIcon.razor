<svg class="tx-icon @Class"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     role="@(HasTitle ? "img" : null)"
     aria-hidden="@(HasTitle ? null : "true")"
     focusable="false"
     style="@Style">
    @if (HasTitle)
    {
        <title>@Title</title>
    }
    @if (ResolvedName is not null)
    {
        <use href="@($"/icons/system-design.svg#{ResolvedName}")" />
    }
</svg>

@code {
    private static readonly HashSet<string> KnownIcons =
    [
        "home", "analytics", "team", "wallet", "database", "document", "calendar",
        "shield-check", "ai-chip", "cube", "link", "gamepad", "video",
        "image", "settings", "globe", "leaf", "lightning", "cart", "bell",
        "alert", "lock", "cloud", "server", "search", "chat", "heart",
        "user", "share", "menu", "arrow-left", "logout"
    ];

    private static readonly IReadOnlyDictionary<string, string> IconAliases =
        new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["check_circle"] = "shield-check",
            ["verified"] = "shield-check",
            ["cancel"] = "alert",
            ["search_off"] = "search",
            ["code"] = "document",
            ["chevron_right"] = "link",
            ["camera_alt"] = "image",
            ["person"] = "user",
            ["account_circle"] = "user",
            ["groups"] = "team",
            ["sports_esports"] = "gamepad",
            ["article"] = "document",
            ["description"] = "document",
            ["account_balance"] = "wallet",
            ["account_balance_wallet"] = "wallet",
            ["trending_up"] = "analytics",
            ["bar_chart"] = "analytics",
            ["notifications"] = "bell",
            ["schedule"] = "calendar",
            ["notifications_active"] = "bell",
            ["security"] = "shield-check",
            ["lock"] = "lock",
            ["settings"] = "settings",
            ["public"] = "globe",
            ["psychology"] = "ai-chip",
            ["database"] = "database",
            ["cloud"] = "cloud",
            ["search"] = "search",
            ["share"] = "share",
            ["add"] = "lightning",
            ["arrow_back"] = "arrow-left",
            ["arrow_upward"] = "analytics",
            ["arrow_downward"] = "analytics",
            ["auto_awesome"] = "ai-chip",
            ["calculate"] = "analytics",
            ["check"] = "shield-check",
            ["chevron_left"] = "arrow-left",
            ["chevron_right"] = "link",
            ["keyboard_arrow_right"] = "link",
            ["keyboard_arrow_down"] = "arrow-left",
            ["close"] = "alert",
            ["content_copy"] = "document",
            ["delete"] = "alert",
            ["delete_forever"] = "alert",
            ["download"] = "document",
            ["edit"] = "document",
            ["edit_note"] = "document",
            ["email"] = "chat",
            ["format_list_bulleted"] = "document",
            ["format_quote"] = "document",
            ["format_strikethrough"] = "document",
            ["insights"] = "analytics",
            ["link_off"] = "link",
            ["local_cafe"] = "heart",
            ["lock_reset"] = "lock",
            ["login"] = "user",
            ["logout"] = "logout",
            ["money_off"] = "wallet",
            ["person_add"] = "team",
            ["play_arrow"] = "video",
            ["pause"] = "video",
            ["refresh"] = "analytics",
            ["restart_alt"] = "analytics",
            ["save"] = "database",
            ["send"] = "share",
            ["star"] = "heart",
            ["swap_horiz"] = "link",
            ["sync"] = "analytics",
            ["unpublished"] = "document",
            ["upload_file"] = "document",
            ["visibility"] = "search"
        };

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Size { get; set; } = "1em";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    private string? ResolvedName =>
        KnownIcons.Contains(Name) ? Name :
        IconAliases.TryGetValue(Name, out var alias) ? alias : "cube";

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);
}