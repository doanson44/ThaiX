@using ThaiX.Client.Models.ExternalData
@using ThaiX.Client.Services.ExternalData
@using ThaiX.Client.Localization
@using Microsoft.Extensions.Localization
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IExternalDataService ExternalDataService
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<RadzenCard Class="h-100 w-100">
    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center p-4">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="w-100" />
        </div>
    }
    else if (_data is null || !_data.Success)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @(_data?.Message ?? L[RK.VnDirectChangePrices.LoadFailed])
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="@(Viewport.IsMobile ? TextStyle.H6 : TextStyle.H5)" TagName="TagName.H2" Class="mb-0">@L[RK.VnDirectChangePrices.Title]</RadzenText>

                @if (TotalPages > 1)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                        <RadzenButton Icon="chevron_left"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Disabled="@(_pageIndex <= 0)"
                                      title="@L[RK.VnDirectChangePrices.Previous]"
                                      Click="PreviousPage" />
                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0 text-nowrap">
                            @string.Format(L[RK.VnDirectChangePrices.PageOf], _pageIndex + 1, TotalPages)
                        </RadzenText>
                        <RadzenButton Icon="chevron_right"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Disabled="@(_pageIndex >= TotalPages - 1)"
                                      title="@L[RK.VnDirectChangePrices.Next]"
                                      Click="NextPage" />
                    </RadzenStack>
                }
            </RadzenStack>

            <RadzenRow>
                @foreach (var item in VisibleItems)
                {
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                        <RadzenCard Class="p-3 h-100" Style="border: 1px solid var(--rz-border-color);">
                            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mb-1">@L[RK.VnDirectChangePrices.IndexValue]</RadzenText>
                            <RadzenText TextStyle="TextStyle.H6" Class="mb-1"><strong>@item.Name (@item.Code)</strong></RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Class="text-muted">@L[RK.VnDirectChangePrices.LastUpdated]: @item.LastUpdated</RadzenText>

                            <RadzenRow Class="mt-3">
                                <RadzenColumn Size="4">
                                    <RadzenText TextStyle="TextStyle.Caption">@L[RK.VnDirectChangePrices.IndexValue]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2"><strong>@($"{item.Price:N2}")</strong></RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenText TextStyle="TextStyle.Caption">@L[RK.VnDirectChangePrices.Change]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Class="@(item.Change >= 0 ? "text-success" : "text-danger")"><strong>@($"{item.Change:N2}")</strong></RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenText TextStyle="TextStyle.Caption">@L[RK.VnDirectChangePrices.ChangePct]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Class="@(item.ChangePct >= 0 ? "text-success" : "text-danger")"><strong>@($"{item.ChangePct:N2}")%</strong></RadzenText>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenCard>
                    </RadzenColumn>
                }
            </RadzenRow>
        </RadzenStack>
    }
</RadzenCard>

@code {
    private const int PageSize = 6;

    private VnDirectChangePricesResponseDto? _data;
    private bool _isLoading;
    private int _pageIndex;

    private IReadOnlyList<VnDirectChangePriceItemDto> Items =>
        _data?.Data ?? (IReadOnlyList<VnDirectChangePriceItemDto>)Array.Empty<VnDirectChangePriceItemDto>();

    private int TotalPages =>
        Items.Count == 0 ? 1 : (int)Math.Ceiling(Items.Count / (double)PageSize);

    private IEnumerable<VnDirectChangePriceItemDto> VisibleItems =>
        Items.Skip(_pageIndex * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var response = await ExternalDataService.GetVnDirectChangePricesAsync();
            if (response is { Data: not null })
            {
                _data = response.Data;
                _pageIndex = 0;
            }
        }
        catch
        {
            // Keep _data null so widget shows load failure.
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PreviousPage()
    {
        if (_pageIndex > 0)
        {
            _pageIndex--;
        }
    }

    private void NextPage()
    {
        if (_pageIndex < TotalPages - 1)
        {
            _pageIndex++;
        }
    }
}
