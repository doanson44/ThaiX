@using Microsoft.AspNetCore.Components.Forms
@using ThaiX.Client.Constants
@using ThaiX.Client.Services.PublicHtml
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IPublicHtmlPageService PublicHtmlService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenStack Gap="1rem">
    <RadzenRow Gap="0.75rem">
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L[RK.PublicHtmlPages.PageTitle]" Class="w-100">
                <RadzenTextBox @bind-Value="_title" Class="w-100" MaxLength="200" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@L[RK.PublicHtmlPages.Slug]" Class="w-100">
                <RadzenTextBox @bind-Value="_slug" Class="w-100" MaxLength="80" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <div>
        <label class="rz-label mb-1" for="public-html-file">@L[RK.PublicHtmlPages.File]</label>
        <InputFile id="public-html-file" OnChange="OnFileSelected" accept=".html,.htm" />
        <div class="text-muted small mt-1">@L[RK.PublicHtmlPages.SelectFile]</div>
        @if (_selectedFile is not null)
        {
            <div class="small mt-1">@_selectedFile.Name (@_selectedFile.Size.ToString("N0") @L[RK.PublicHtmlPages.Bytes])</div>
        }
    </div>
    <div class="d-flex flex-wrap justify-content-end gap-2">
        <RadzenButton Text="@L[RK.Common.Cancel]" Icon="close" ButtonStyle="ButtonStyle.Light"
                      Disabled="@_isSubmitting" Click="@Cancel" />
        <RadzenButton Text="@L[RK.PublicHtmlPages.Upload]" Icon="upload_file" ButtonStyle="ButtonStyle.Primary"
                      Disabled="@(_isSubmitting || _selectedFile is null)" Click="@UploadAsync" />
    </div>
</RadzenStack>

@code {
    private const long MaxFileSize = 5 * 1024 * 1024;
    private IBrowserFile? _selectedFile;
    private string _title = string.Empty;
    private string _slug = string.Empty;
    private bool _isSubmitting;

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        if (_selectedFile is null)
            return;

        var extension = Path.GetExtension(_selectedFile.Name);
        if (_selectedFile.Size <= 0 || _selectedFile.Size > MaxFileSize
            || (!extension.Equals(".html", StringComparison.OrdinalIgnoreCase)
                && !extension.Equals(".htm", StringComparison.OrdinalIgnoreCase)))
        {
            NotificationService.Notify(NotificationSeverity.Warning, L[RK.PublicHtmlPages.InvalidFile]);
            _selectedFile = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_title))
            _title = Path.GetFileNameWithoutExtension(_selectedFile.Name);
        if (string.IsNullOrWhiteSpace(_slug))
            _slug = Slugify(Path.GetFileNameWithoutExtension(_selectedFile.Name));
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null || string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_slug))
        {
            NotificationService.Notify(NotificationSeverity.Warning,
                string.IsNullOrWhiteSpace(_title) ? L[RK.PublicHtmlPages.TitleRequired] : L[RK.PublicHtmlPages.SlugRequired]);
            return;
        }

        _isSubmitting = true;
        try
        {
            await PublicHtmlService.UploadAsync(_selectedFile, _title.Trim(), _slug.Trim());
            NotificationService.Notify(NotificationSeverity.Success, L[RK.PublicHtmlPages.UploadSuccess]);
            DialogService.Close(true);
        }
        catch
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.PublicHtmlPages.UploadFailed]);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => DialogService.Close(false);

    private static string Slugify(string value)
    {
        var chars = value.Trim().ToLowerInvariant()
            .Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-')
            .ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }
}
