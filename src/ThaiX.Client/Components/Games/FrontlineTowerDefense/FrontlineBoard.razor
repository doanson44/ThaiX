@namespace ThaiX.Client.Components.Games.FrontlineTowerDefense
@using ThaiX.Client.Services.Games.FrontlineTowerDefense
@inject IStringLocalizer<SharedResource> L

<div class="frontline-board"
     role="grid"
     aria-label="@L[ResourceKeys.Games.FrontlineBoard]">
    @foreach (var cell in VisibleCells)
    {
        var isPath = Level.WalkableCells.Contains(cell);
        var isBlocked = Level.BlockedCells.Contains(cell);

        <button @key="cell"
                type="button"
                role="gridcell"
                class="@GetCellClass(isPath, isBlocked)"
                aria-label="@L[ResourceKeys.Games.FrontlineGridCell, cell.X + 1, cell.Y + 1]"
                disabled="@(!IsPlacementEnabled || !CellSelected.HasDelegate)"
                @onclick="() => CellSelected.InvokeAsync(ToCellCenter(cell))">
        </button>
    }

    @foreach (var start in Level.StartPoints)
    {
        <span @key="start"
              class="frontline-board__endpoint frontline-board__endpoint--start"
              style="@GetEndpointStyle(start)"
              aria-hidden="true"></span>
    }

    @foreach (var end in Level.EndPoints)
    {
        <span @key="end"
              class="frontline-board__endpoint frontline-board__endpoint--end"
              style="@GetEndpointStyle(end)"
              aria-hidden="true"></span>
    }

    <svg class="frontline-board__projectiles"
         viewBox="0 0 672 480"
         preserveAspectRatio="none"
         aria-hidden="true">
        @foreach (var effect in Simulation.AreaEffects)
        {
            <circle @key="effect.GetHashCode()"
                    class="frontline-board__area-effect frontline-board__area-effect--@GetAreaEffectStyle(effect)"
                    cx="@FormatCoordinate(effect.Position.X)"
                    cy="@FormatCoordinate(effect.Position.Y)"
                    r="@FormatCoordinate(effect.Radius)" />
        }
        @foreach (var trace in Simulation.CombatTraces)
        {
            <line @key="trace.GetHashCode()"
                  class="frontline-board__trace frontline-board__trace--@GetTraceStyle(trace)"
                  x1="@FormatCoordinate(trace.Start.X)"
                  y1="@FormatCoordinate(trace.Start.Y)"
                  x2="@FormatCoordinate(trace.End.X)"
                  y2="@FormatCoordinate(trace.End.Y)" />
        }
        @foreach (var supportProjectile in Simulation.SupportProjectiles)
        {
            <circle @key="supportProjectile.GetHashCode()"
                    class="frontline-board__projectile frontline-board__projectile--support"
                    cx="@FormatCoordinate(supportProjectile.Impact.X)"
                    cy="@FormatCoordinate(supportProjectile.Impact.Y - supportProjectile.Height)"
                    r="4" />
        }
        @foreach (var projectile in Simulation.Projectiles)
        {
            <circle @key="projectile.Id"
                    class="frontline-board__projectile frontline-board__projectile--@GetProjectileStyle(projectile)"
                    cx="@FormatCoordinate(projectile.Position.X)"
                    cy="@FormatCoordinate(projectile.Position.Y - projectile.Height)"
                    r="@FormatCoordinate(GetProjectileRadius(projectile))" />
        }
    </svg>

    @foreach (var tower in Simulation.Towers)
    {
        <button @key="tower.Id"
                type="button"
                class="@GetTowerClass(tower)"
                style="@GetPositionStyle(tower.Position)"
                aria-label="@L[ResourceKeys.Games.FrontlineSelectTower, tower.Definition.Id]"
                aria-pressed="@(SelectedTowerId == tower.Id)"
                disabled="@(!TowerSelected.HasDelegate)"
                @onclick="() => TowerSelected.InvokeAsync(tower.Id)">
            <svg class="frontline-board__tower-art" viewBox="0 0 32 32" aria-hidden="true">
                <circle cx="16" cy="16" r="13" class="frontline-board__tower-base" />
                <path d="M9 17h14l-2-5H11z" class="frontline-board__tower-body" />
                <path d="M14 12V6h4v6" class="frontline-board__tower-barrel" />
                <circle cx="16" cy="17" r="3" class="frontline-board__tower-core" />
            </svg>
        </button>
    }

    @foreach (var enemy in Simulation.Enemies)
    {
        <button @key="enemy.Id"
                type="button"
                class="@GetEnemyClass(enemy)"
                style="@GetPositionStyle(enemy.Position)"
                aria-label="@L[ResourceKeys.Games.FrontlineEnemy, enemy.Definition.Id]"
                disabled="@(!EnemySelected.HasDelegate)"
                @onclick="() => EnemySelected.InvokeAsync(enemy.Id)">
            <svg class="frontline-board__enemy-art" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2 21 8v9l-9 5-9-5V8z" class="frontline-board__enemy-shape" />
                <path d="m8 10 4-3 4 3v5l-4 2-4-2z" class="frontline-board__enemy-detail" />
            </svg>
            <span class="frontline-board__health">
                <span style="@GetHealthStyle(enemy)"></span>
            </span>
        </button>
    }
</div>

@code {
    private const double BoardWidth = FrontlineLevelMapDefinition.BuildableWidth * FrontlinePath.DefaultGridCellSize;
    private const double BoardHeight = FrontlineLevelMapDefinition.BuildableHeight * FrontlinePath.DefaultGridCellSize;

    private static readonly IReadOnlyList<FrontlineGridPoint> VisibleCells =
        Enumerable.Range(0, FrontlineLevelMapDefinition.BuildableHeight)
            .SelectMany(y => Enumerable.Range(0, FrontlineLevelMapDefinition.BuildableWidth)
                .Select(x => new FrontlineGridPoint(x, y)))
            .ToArray();

    [Parameter, EditorRequired]
    public FrontlineLevelMapDefinition Level { get; set; } = default!;

    [Parameter, EditorRequired]
    public FrontlineGameSimulation Simulation { get; set; } = default!;

    [Parameter]
    public bool IsPlacementEnabled { get; set; }

    [Parameter]
    public long? SelectedTowerId { get; set; }

    [Parameter]
    public EventCallback<FrontlinePoint> CellSelected { get; set; }

    [Parameter]
    public EventCallback<long> TowerSelected { get; set; }

    [Parameter]
    public EventCallback<long> EnemySelected { get; set; }

    private static string GetCellClass(bool isPath, bool isBlocked)
    {
        if (isPath)
            return "frontline-board__cell frontline-board__cell--path";

        return isBlocked
            ? "frontline-board__cell frontline-board__cell--blocked"
            : "frontline-board__cell frontline-board__cell--buildable";
    }

    private string GetTowerClass(FrontlineTower tower)
    {
        var archetype = tower.Definition.Id switch
        {
            "tower1" => "missile",
            "tower4" => "electro",
            "tower5" => "shotgun",
            "tower6" => "beam",
            "tower7" or "tower8" => "bio",
            "tower9" => "flame",
            "tower11" => "plasma",
            _ => "ballistic"
        };
        var classes = tower.Definition.IsSupport
            ? "frontline-board__tower frontline-board__tower--support"
            : $"frontline-board__tower frontline-board__tower--{archetype}";

        return SelectedTowerId == tower.Id
            ? $"{classes} frontline-board__tower--selected"
            : classes;
    }

    private static string GetEnemyClass(FrontlineEnemy enemy) =>
        enemy.Definition.IsMetal
            ? "frontline-board__enemy frontline-board__enemy--metal"
            : "frontline-board__enemy";

    private static string GetProjectileStyle(FrontlineProjectile projectile) =>
        projectile.Profile.Kind switch
        {
            FrontlineProjectileKind.HomingMissile => "missile",
            FrontlineProjectileKind.BallisticShell => "shell",
            FrontlineProjectileKind.TrackingPoison => "poison",
            FrontlineProjectileKind.TrackingFlame => "flame",
            _ => "default"
        };

    private static string GetAreaEffectStyle(FrontlineGameSimulation.FrontlineAreaEffect effect) =>
        effect.Damage.Burn > 0 ? "fire" : "poison";

    private static string GetTraceStyle(FrontlineCombatTrace trace) =>
        trace.Kind switch
        {
            FrontlineCombatTraceKind.Lightning => "lightning",
            FrontlineCombatTraceKind.Shotgun => "shotgun",
            FrontlineCombatTraceKind.EnergyBeam => "beam",
            _ => "bullet"
        };

    private static double GetProjectileRadius(FrontlineProjectile projectile) =>
        Math.Clamp(projectile.Profile.CollisionRadius, 2, 7);

    private static string FormatCoordinate(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string GetPositionStyle(FrontlinePoint position) =>
        FormattableString.Invariant(
            $"left:{position.X / BoardWidth * 100:0.####}%;top:{position.Y / BoardHeight * 100:0.####}%;");

    private static string GetEndpointStyle(FrontlineGridPoint cell)
    {
        var x = cell.X * FrontlinePath.DefaultGridCellSize + FrontlinePath.DefaultGridCellSize * 0.5;
        var y = cell.Y * FrontlinePath.DefaultGridCellSize + FrontlinePath.DefaultGridCellSize * 0.5;
        x = Math.Clamp(x, 0, BoardWidth);
        y = Math.Clamp(y, 0, BoardHeight);

        return FormattableString.Invariant(
            $"left:{x / BoardWidth * 100:0.####}%;top:{y / BoardHeight * 100:0.####}%;");
    }

    private static string GetHealthStyle(FrontlineEnemy enemy)
    {
        var health = enemy.Definition.Health <= 0
            ? 0
            : Math.Clamp(enemy.Health / enemy.Definition.Health, 0, 1) * 100;

        return FormattableString.Invariant($"width:{health:0.##}%;");
    }

    private static FrontlinePoint ToCellCenter(FrontlineGridPoint cell) =>
        new(
            cell.X * FrontlinePath.DefaultGridCellSize + FrontlinePath.DefaultGridCellSize * 0.5,
            cell.Y * FrontlinePath.DefaultGridCellSize + FrontlinePath.DefaultGridCellSize * 0.5);
}
