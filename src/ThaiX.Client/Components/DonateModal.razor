@using System.Net.Http.Json
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IStringLocalizer<SharedResource> L
<div class="text-center rz-p-3">
    <p class="text-muted small mb-2">@L[RK.Donate.ScanQr]</p>
    <SafeImage Src="@_qrImage"
               Alt="@L[RK.Donate.QrAlt]"
               Style="max-width:260px;min-width:160px;min-height:160px;border-radius:12px;margin:0 auto;"
               FallbackIcon="qr_code"
               FallbackClass="safe-image-fallback" />
    <div class="mt-2 small text-muted">
        <div>@_accountName</div>
        <div>@_accountNumber</div>
    </div>
    <div class="mt-2">
        <span class="badge bg-primary-subtle text-primary me-1">Momo</span>
        <span class="badge bg-primary-subtle text-primary me-1">VietQR</span>
        <span class="badge bg-primary-subtle text-primary">Napas247</span>
    </div>
    <p class="mt-3 text-muted" style="font-size: 0.8rem;">@L[RK.Donate.ThankYou]</p>
</div>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;

    private string _qrImage = "images/qr-donate.png";
    private string _accountName = string.Empty;
    private string _accountNumber = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _qrImage = Configuration["Donate:QrImage"] ?? _qrImage;

        try
        {
            var response = await Http.GetFromJsonAsync<ThaiX.Client.Models.PublicDonateConfigurationResponse>(
                "/api/public/donate-config");

            if (response?.Success != true || response.Data is null)
            {
                return;
            }

            _qrImage = string.IsNullOrWhiteSpace(response.Data.QrImage) ? _qrImage : response.Data.QrImage;
            _accountName = response.Data.AccountName;
            _accountNumber = response.Data.AccountNumber;
        }
        catch (HttpRequestException)
        {
        }
        catch (System.Text.Json.JsonException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }
}
