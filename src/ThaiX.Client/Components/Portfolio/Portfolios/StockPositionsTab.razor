@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.AssetPositions
@using ThaiX.Client.Components.Portfolio.Portfolios
@inject IAssetPositionService AssetPositionService
@inject IExternalDataService ExternalDataService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inherits ThaiXPageBase

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap"
                 Gap="0.5rem">
        <RadzenBadge Text="@_totalCount.ToString()" BadgeStyle="BadgeStyle.Info" />
        <div class="d-flex gap-2 align-items-center">
            @if (_pricesLoading)
            {
                <RadzenProgressBarCircular ShowValue="false" Size="ProgressBarCircularSize.ExtraSmall" />
            }
            else if (_lastPriceUpdate.HasValue)
            {
                <small class="text-muted">@_lastPriceUpdate.Value.ToLocalTime().ToString("HH:mm")</small>
            }
            <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                          Click="@RefreshPricesAsync" Disabled="@_pricesLoading"
                          title="@L[RK.AssetPositions.RefreshPrices]" />
            @if (CanWrite)
            {
                <ResponsiveIconButton Text="@L[RK.AssetPositions.StockTitle]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Click="@OpenCreateDialogAsync" />
            }
        </div>
    </RadzenStack>

    @if (!Viewport.IsMobile)
    {
        <RadzenDataGrid @ref="_grid"
                        TItem="StockPositionListItemDto"
                        Data="@_items"
                        Count="@_totalCount"
                        LoadData="@LoadDataAsync"
                        AllowPaging="true"
                        AllowSorting="false"
                        PageSize="10"
                        ShowPagingSummary="true"
                        Density="Density.Compact"
                        IsLoading="@_isLoading">
            <Columns>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="Symbol" Title="@L[RK.AssetPositions.Symbol]" Width="100px" />
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="Exchange" Title="@L[RK.AssetPositions.Exchange]" Width="80px" />
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="Quantity" Title="@L[RK.AssetPositions.Quantity]" Width="100px" />
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="AverageEntryPrice" Title="@L[RK.AssetPositions.AverageEntryPrice]">
                    <Template Context="item">@item.AverageEntryPrice.ToString("N2")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="TotalInvested" Title="@L[RK.AssetPositions.TotalInvested]">
                    <Template Context="item">@item.TotalInvested.ToString("N2")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="RealizedPnl" Title="@L[RK.AssetPositions.RealizedPnl]">
                    <Template Context="item">
                        <span class="@(item.RealizedPnl >= 0 ? "text-success" : "text-danger")">@item.RealizedPnl.ToString("N2")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Title="@L[RK.AssetPositions.CurrentPrice]" Sortable="false" Width="110px">
                    <Template Context="item">
                        @if (!item.IsClosed && _livePrices.TryGetValue(item.Symbol, out var cp))
                        {
                            <span>@cp.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Title="@L[RK.AssetPositions.UnrealizedPnl]" Sortable="false" Width="120px">
                    <Template Context="item">
                        @{
                            var upnl = (!item.IsClosed && _livePrices.TryGetValue(item.Symbol, out var upcp))
                                ? (decimal?)((upcp - item.AverageEntryPrice) * item.Quantity)
                                : null;
                            var upnlCls = upnl.HasValue && upnl.Value >= 0 ? "text-success" : (upnl.HasValue ? "text-danger" : "text-muted");
                            var upnlTxt = upnl.HasValue ? upnl.Value.ToString("N2") : "-";
                        }
                        <span class="@upnlCls">@upnlTxt</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Property="IsClosed" Title="@L[RK.AssetPositions.Status]" Width="90px">
                    <Template Context="item">
                        <RadzenBadge Text="@(item.IsClosed ? L[RK.AssetPositions.Closed] : L[RK.AssetPositions.Open])"
                                     BadgeStyle="@(item.IsClosed ? BadgeStyle.Secondary : BadgeStyle.Success)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="StockPositionListItemDto" Title="@L[RK.Common.Actions]" Sortable="false" Width="110px">
                    <Template Context="item">
                        <div class="d-flex gap-1">
                            @if (CanWrite && !item.IsClosed)
                            {
                                <RadzenButton Icon="add" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                              Click="@(() => OpenAddTransactionDialogAsync(item))" />
                            }
                            @if (CanDelete)
                            {
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              Click="@(() => ConfirmDeleteAsync(item))" />
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    
    }

    @if (Viewport.IsMobile)
    {
        <RadzenStack Gap="0.5rem">
            @if (_isLoading)
            {
                <RadzenText>@L[RK.Common.Loading]</RadzenText>
            }
            else if (_items.Count == 0)
            {
                <RadzenText class="text-muted">@L[RK.Common.NoDataFound]</RadzenText>
            }
            else
            {
                <Virtualize Items="@_items" TItem="StockPositionListItemDto" Context="pos" OverscanCount="5">
                    <div class="mb-2">
                    <RadzenCard class="p-3 m-0">
                        <RadzenStack Gap="0.25rem">
                            <div class="d-flex align-items-center justify-content-between">
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="mb-0">@pos.Symbol (@pos.Exchange)</RadzenText>
                                <RadzenBadge Text="@(pos.IsClosed ? L[RK.AssetPositions.Closed] : L[RK.AssetPositions.Open])"
                                             BadgeStyle="@(pos.IsClosed ? BadgeStyle.Secondary : BadgeStyle.Success)" />
                            </div>
                            <RadzenText class="text-muted small mb-0">
                                @L[RK.AssetPositions.Quantity]: @pos.Quantity | @L[RK.AssetPositions.AverageEntryPrice]: @pos.AverageEntryPrice.ToString("N2")
                            </RadzenText>
                            @{
                                var livePnl = (!pos.IsClosed && _livePrices.TryGetValue(pos.Symbol, out var lcp))
                                    ? (decimal?)((lcp - pos.AverageEntryPrice) * pos.Quantity)
                                    : null;
                            }
                            <div class="d-flex gap-2 flex-wrap">
                                <small class="text-muted">@L[RK.AssetPositions.RealizedPnl]: @pos.RealizedPnl.ToString("N2")</small>
                                @if (livePnl.HasValue)
                                {
                                    <small class="@(livePnl.Value >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                                        @L[RK.AssetPositions.UnrealizedPnl]: @livePnl.Value.ToString("N2")
                                    </small>
                                }
                            </div>
                            <div class="d-flex gap-2 mt-1">
                                @if (CanWrite && !pos.IsClosed)
                                {
                                    <ResponsiveIconButton Text="@L[RK.AssetPositions.AddTransaction]" Icon="add" ButtonStyle="ButtonStyle.Info"
                                                  Size="ButtonSize.Small" Click="@(() => OpenAddTransactionDialogAsync(pos))" />
                                }
                                @if (CanDelete)
                                {
                                    <ResponsiveIconButton Text="@L[RK.Common.Delete]" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small" Click="@(() => ConfirmDeleteAsync(pos))" />
                                }
                            </div>
                        </RadzenStack>
                    </RadzenCard>
                    </div>
                </Virtualize>
            }
        </RadzenStack>
    
    }
</RadzenStack>

@code {
    [Parameter] public Guid PortfolioId { get; set; }
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    private RadzenDataGrid<StockPositionListItemDto>? _grid;
    private List<StockPositionListItemDto> _items = [];
    private int _totalCount;
    private bool _isLoading;
    private readonly Dictionary<string, decimal> _livePrices = [];
    private bool _pricesLoading;
    private DateTime? _lastPriceUpdate;
    private CancellationTokenSource _cts = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid is not null)
            await _grid.Reload();
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        _isLoading = true;
        try
        {
            int pageSize = args.Top ?? 10;
            int pageNumber = pageSize <= 0 ? 1 : ((args.Skip ?? 0) / pageSize) + 1;

            var result = await AssetPositionService.GetStockPositionsAsync(new StockPositionsListRequest
            {
                PortfolioId = PortfolioId,
                PageNumber = pageNumber,
                PageSize = pageSize
            }, _cts.Token);

            _items = [.. result.Data ?? []];
            _totalCount = result.Metadata.TotalCount;
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, L[RK.AssetPositions.LoadFailed]);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
        await RefreshPricesAsync();
    }

    private async Task RefreshPricesAsync()
    {
        _pricesLoading = true;
        StateHasChanged();
        try
        {
            var resp = await ExternalDataService.GetVnDirectChangePricesAsync(_cts.Token);
            if (resp.Data?.Data is { } stocks)
            {
                _livePrices.Clear();
                foreach (var s in stocks)
                {
                    if (!string.IsNullOrEmpty(s.Code))
                        _livePrices[s.Code.ToUpperInvariant()] = s.Price;
                }
                _lastPriceUpdate = DateTime.UtcNow;
            }
        }
        catch { /* ignore price fetch errors */ }
        finally
        {
            _pricesLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var result = await DialogService.OpenAsync<CreateStockPositionDialog>(
            L[RK.AssetPositions.StockTitle],
            parameters: new Dictionary<string, object?> { ["PortfolioId"] = PortfolioId },
            options: new DialogOptions { Width = "520px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            NotificationService.Notify(NotificationSeverity.Success, L[RK.AssetPositions.CreateSuccess]);
            if (_grid is not null) await _grid.Reload();
        }
    }

    private async Task OpenAddTransactionDialogAsync(StockPositionListItemDto item)
    {
        var result = await DialogService.OpenAsync<AddStockTransactionDialog>(
            L[RK.AssetPositions.AddTransaction],
            parameters: new Dictionary<string, object?> { ["PositionId"] = item.Id, ["Symbol"] = item.Symbol },
            options: new DialogOptions { Width = "480px", CloseDialogOnOverlayClick = false });

        if (result is true)
        {
            NotificationService.Notify(NotificationSeverity.Success, L[RK.AssetPositions.CreateSuccess]);
            if (_grid is not null) await _grid.Reload();
        }
    }

    private async Task ConfirmDeleteAsync(StockPositionListItemDto item)
    {
        var confirmed = await DialogService.ConfirmDeleteAsync(L, L[RK.AssetPositions.ConfirmDelete]);

        if (confirmed is true)
        {
            try
            {
                await AssetPositionService.DeleteStockPositionAsync(item.Id, _cts.Token);
                NotificationService.Notify(NotificationSeverity.Success, L[RK.AssetPositions.DeleteSuccess]);
                if (_grid is not null) await _grid.Reload();
            }
            catch (Exception)
            {
                NotificationService.Notify(NotificationSeverity.Error, L[RK.AssetPositions.DeleteFailed]);
            }
        }
    }
}
