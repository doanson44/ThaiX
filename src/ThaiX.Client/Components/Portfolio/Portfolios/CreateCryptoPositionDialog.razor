@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.AssetPositions
@using ThaiX.Client.Models.MasterData
@using ThaiX.Client.Models.PriceAlerts
@using ThaiX.Client.Services.MasterData
@using ThaiX.Client.Services.PriceAlerts
@inject IMasterDataService MasterDataService
@inject IAssetPositionService AssetPositionService
@inject IPriceAlertService PriceAlertService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IStringLocalizer<SharedResource> L

<RadzenTemplateForm TItem="CreateCryptoPositionFormModel" Data="_model" Submit="SaveAsync">
    <RadzenStack Gap="1rem">

        <RadzenFormField Text="@L[RK.AssetPositions.Symbol]" Class="w-100">
            <ChildContent>
                <AsyncSearchSelect TItem="SymbolSearchItemDto"
                                   Value="@_model.Symbol"
                                   ValueChanged="@(v => _model.Symbol = v ?? string.Empty)"
                                   LoadDataAsync="@LoadCryptoSymbolsAsync"
                                   GetValue="@(t => t.Symbol)"
                                   GetText="@(t => t.DisplayText)"
                                   Placeholder="@L[RK.AssetPositions.CryptoSymbolPlaceholder]"
                                   AllowClear="true"
                                   Class="w-100" />
            </ChildContent>
            <Helper>
                @if (_symbolError)
                {
                    <span class="rz-messages-error">@L[RK.Validation.Required]</span>
                }
            </Helper>
        </RadzenFormField>

        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.Quantity]" Class="w-100">
                    <ChildContent>
                        <RadzenNumeric Value="_model.InitialQuantity"
                                       ValueChanged="@((decimal v) => { _model.InitialQuantity = v; _quantityError = false; })"
                                       TValue="decimal" Min="0" Step="0.0001m" class="w-100" />
                    </ChildContent>
                    <Helper>
                        @if (_quantityError)
                        {
                            <span class="rz-messages-error">@L[RK.Validation.MustBeGreaterThanZero]</span>
                        }
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.Price]" Class="w-100">
                    <ChildContent>
                        <RadzenNumeric Value="_model.InitialPrice"
                                       ValueChanged="@((decimal v) => { _model.InitialPrice = v; _priceError = false; })"
                                       TValue="decimal" Min="0" Step="0.0001m" class="w-100" />
                    </ChildContent>
                    <Helper>
                        @if (_priceError)
                        {
                            <span class="rz-messages-error">@L[RK.Validation.MustBeGreaterThanZero]</span>
                        }
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.Fee]" Class="w-100">
                    <RadzenNumeric @bind-Value="_model.InitialFee" TValue="decimal" Min="0" Step="0.01m" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.TransactedAt]" Class="w-100">
                    <RadzenDatePicker @bind-Value="_model.TransactedAt" ShowTime="true" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.TargetPrice]" Class="w-100">
                    <RadzenNumeric @bind-Value="_model.TargetPrice" TValue="decimal?" Min="0" Step="0.0001m" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.StopLoss]" Class="w-100">
                    <RadzenNumeric @bind-Value="_model.StopLoss" TValue="decimal?" Min="0" Step="0.0001m" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenSwitch @bind-Value="_model.EnablePriceAlerts" />
            <RadzenLabel Text="@L[RK.AssetPositions.EnablePriceAlerts]" />
        </RadzenStack>
        @if (_model.EnablePriceAlerts)
        {
            <small class="text-muted">@L[RK.AssetPositions.EnablePriceAlertsHint]</small>
        }

        <RadzenFormField Text="@L[RK.AssetPositions.Note]" Class="w-100">
            <RadzenTextArea @bind-Value="_model.Note" class="w-100" Rows="2" MaxLength="500" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="@L[RK.Common.Cancel]" ButtonStyle="ButtonStyle.Light"
                          Click="@(_ => DialogService.Close(false))" />
            <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit" Disabled="_isSaving" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid PortfolioId { get; set; }

    private CreateCryptoPositionFormModel _model = new();
    private bool _isSaving;
    private bool _symbolError;
    private bool _quantityError;
    private bool _priceError;

    private sealed class CreateCryptoPositionFormModel
    {
        public string Symbol { get; set; } = string.Empty;
        public decimal InitialQuantity { get; set; }
        public decimal InitialPrice { get; set; }
        public decimal InitialFee { get; set; }
        public DateTime TransactedAt { get; set; } = DateTime.UtcNow;
        public decimal? TargetPrice { get; set; }
        public decimal? StopLoss { get; set; }
        public bool EnablePriceAlerts { get; set; }
        public string? Note { get; set; }
    }

    private async Task SaveAsync()
    {
        _symbolError = string.IsNullOrWhiteSpace(_model.Symbol);
        _quantityError = _model.InitialQuantity <= 0;
        _priceError = _model.InitialPrice <= 0;
        if (_symbolError || _quantityError || _priceError || _isSaving) return;
        _isSaving = true;
        try
        {
            var symbol = _model.Symbol.ToUpperInvariant();
            await AssetPositionService.CreateCryptoPositionAsync(new CreateCryptoPositionRequest
            {
                PortfolioId = PortfolioId,
                Symbol = symbol,
                Quantity = _model.InitialQuantity,
                Price = _model.InitialPrice,
                Fee = _model.InitialFee,
                TransactedAt = _model.TransactedAt,
                TargetPrice = _model.TargetPrice,
                StopLoss = _model.StopLoss,
                Note = _model.Note
            });

            if (_model.EnablePriceAlerts)
            {
                await CreatePriceAlertsAsync(symbol);
            }

            DialogService.Close(true);
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.AssetPositions.CreateFailed], ex.GetDisplayDetail());
        }
        catch (Exception ex)
        {
            NotificationService.NotifyError(L[RK.AssetPositions.CreateFailed], ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Creates standalone price alerts for the target/stop-loss set on this position.
    /// Matched purely by symbol + asset type, so the existing PositionClosedEventHandler
    /// will auto-disable them once the position is fully closed.
    /// </summary>
    private async Task CreatePriceAlertsAsync(string symbol)
    {
        if (_model.TargetPrice is > 0)
        {
            await TryCreatePriceAlertAsync(symbol, "Above", _model.TargetPrice.Value, $"Target price for {symbol} position");
        }

        if (_model.StopLoss is > 0)
        {
            await TryCreatePriceAlertAsync(symbol, "Below", _model.StopLoss.Value, $"Stop-loss for {symbol} position");
        }
    }

    private async Task TryCreatePriceAlertAsync(string symbol, string condition, decimal targetPrice, string note)
    {
        try
        {
            await PriceAlertService.CreateAsync(new CreatePriceAlertRequest
            {
                Symbol = symbol,
                AssetType = "CryptoSpot",
                Condition = condition,
                TargetPrice = targetPrice,
                Note = note,
                IsOneTime = true
            });
        }
        catch (Exception ex)
        {
            // The position itself was already created successfully; only warn about the alert.
            NotificationService.NotifyWarning(
                L[RK.PriceAlerts.CreateFailed],
                ex is ApiException apiEx ? apiEx.GetDisplayDetail() : ex.Message);
        }
    }

    private async Task<(IReadOnlyList<SymbolSearchItemDto> items, int totalCount)>
        LoadCryptoSymbolsAsync(int page, int pageSize, string? search, CancellationToken ct)
    {
        try
        {
            var result = await MasterDataService.SearchSymbolsAsync(
                "CryptoSpot", search, page, pageSize, ct);
            return (result.Items, result.TotalCount);
        }
        catch
        {
            return ([], 0);
        }
    }
}
