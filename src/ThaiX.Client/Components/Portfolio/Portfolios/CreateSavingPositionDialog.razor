@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.AssetPositions
@inject IAssetPositionService AssetPositionService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenTemplateForm TItem="CreateSavingFormModel" Data="_model" Submit="SaveAsync">
    <RadzenStack Gap="1rem">

        <RadzenFormField Text="@L[RK.AssetPositions.BankName]" Class="w-100">
            <ChildContent>
                <RadzenTextBox @bind-Value="_model.BankName" Name="BankName" class="w-100" MaxLength="100" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="BankName" Text="@L[RK.Validation.Required]" />
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="@L[RK.AssetPositions.AccountNumber]" Class="w-100">
            <RadzenTextBox @bind-Value="_model.AccountNumber" class="w-100" MaxLength="50" />
        </RadzenFormField>

        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.PrincipalAmount]" Class="w-100">
                    <RadzenNumeric @bind-Value="_model.PrincipalAmount" TValue="decimal" Min="0" Step="1000000" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.InterestRate]" Class="w-100">
                    <RadzenNumeric @bind-Value="_model.InterestRate" TValue="decimal" Min="0" Max="100" Step="0.1m" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="@L[RK.AssetPositions.InterestType]" Class="w-100">
            <RadzenDropDown @bind-Value="_model.InterestType"
                            Data="_interestTypeOptions"
                            TextProperty="Label"
                            ValueProperty="Value"
                            class="w-100" />
        </RadzenFormField>

        <RadzenRow Gap="0.75rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.DepositDate]" Class="w-100">
                    <RadzenDatePicker @bind-Value="_model.DepositDate" ShowTime="false" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="@L[RK.AssetPositions.MaturityDate]" Class="w-100">
                    <RadzenDatePicker @bind-Value="_model.MaturityDate" ShowTime="false" class="w-100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="@L[RK.AssetPositions.Note]" Class="w-100">
            <RadzenTextArea @bind-Value="_model.Note" class="w-100" Rows="2" MaxLength="500" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="@L[RK.Common.Cancel]" ButtonStyle="ButtonStyle.Light"
                          Click="@(_ => DialogService.Close(false))" />
            <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit" Disabled="_isSaving" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid PortfolioId { get; set; }

    private CreateSavingFormModel _model = new();
    private bool _isSaving;

    private sealed record TypeOption(string Label, string Value);
    private List<TypeOption> _interestTypeOptions = [];

    protected override void OnInitialized()
    {
        _interestTypeOptions =
        [
            new(L[RK.AssetPositions.InterestTypeSimple], "Simple"),
            new(L[RK.AssetPositions.InterestTypeCompound], "Compound")
        ];
    }

    private sealed class CreateSavingFormModel
    {
        public string BankName { get; set; } = string.Empty;
        public string? AccountNumber { get; set; }
        public decimal PrincipalAmount { get; set; }
        public decimal InterestRate { get; set; }
        public string InterestType { get; set; } = "Simple";
        public DateTime DepositDate { get; set; } = DateTime.UtcNow;
        public DateTime? MaturityDate { get; set; }
        public string? Note { get; set; }
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            await AssetPositionService.CreateSavingPositionAsync(new CreateSavingPositionRequest
            {
                PortfolioId = PortfolioId,
                BankName = _model.BankName,
                AccountNumber = _model.AccountNumber,
                PrincipalAmount = _model.PrincipalAmount,
                InterestRate = _model.InterestRate,
                InterestType = _model.InterestType,
                DepositDate = DateOnly.FromDateTime(_model.DepositDate),
                MaturityDate = _model.MaturityDate.HasValue ? DateOnly.FromDateTime(_model.MaturityDate.Value) : null,
                Note = _model.Note
            });
            DialogService.Close(true);
        }
        catch (Exception)
        {
            DialogService.Close(false);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
