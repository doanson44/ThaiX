@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Models.Portfolios
@inject IPortfolioService PortfolioService
@inject DialogService DialogService
@inject IStringLocalizer<SharedResource> L

<RadzenTemplateForm TItem="PortfolioFormModel" Data="_model" Submit="SaveAsync">
    <RadzenStack Gap="1rem">

        <RadzenFormField Text="@L[RK.Portfolios.Name]" Class="w-100">
            <ChildContent>
                <RadzenTextBox @bind-Value="_model.Name" Name="Name" class="w-100" MaxLength="200" />
            </ChildContent>
            <Helper>
                <RadzenRequiredValidator Component="Name" Text="@L[RK.Validation.Required]" />
            </Helper>
        </RadzenFormField>

        <RadzenFormField Text="@L[RK.Portfolios.PortfolioType]">
            <RadzenDropDown @bind-Value="_model.PortfolioType"
                            Data="_typeOptions"
                            TextProperty="Label"
                            ValueProperty="Value"
                            class="w-100" />
        </RadzenFormField>

        <RadzenFormField Text="@L[RK.Portfolios.Description]" Class="w-100">
            <RadzenTextArea @bind-Value="_model.Description" class="w-100" Rows="3" MaxLength="500" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="@L[RK.Common.Cancel]"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(_ => DialogService.Close(false))" />
            <RadzenButton Text="@L[RK.Common.Save]"
                          ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit"
                          Disabled="_isSaving" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid PortfolioId { get; set; }
    [Parameter] public string PortfolioName { get; set; } = string.Empty;
    [Parameter] public string PortfolioDescription { get; set; } = string.Empty;
    [Parameter] public string CurrentPortfolioType { get; set; } = "Trading";

    private PortfolioFormModel _model = new();
    private bool _isSaving;

    private sealed record TypeOption(string Label, string Value);

    private List<TypeOption> _typeOptions = [];

    private sealed class PortfolioFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string PortfolioType { get; set; } = "Trading";
    }

    protected override void OnInitialized()
    {
        _typeOptions =
        [
            new(L[RK.Portfolios.TypeTrading], "Trading"),
            new(L[RK.Portfolios.TypeLongTerm], "LongTerm"),
            new(L[RK.Portfolios.TypeRetirement], "Retirement"),
            new(L[RK.Portfolios.TypeSavings], "Savings")
        ];
    }

    protected override void OnParametersSet()
    {
        _model.Name = PortfolioName;
        _model.Description = PortfolioDescription;
        _model.PortfolioType = CurrentPortfolioType;
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try
        {
            await PortfolioService.UpdateAsync(PortfolioId, new UpdatePortfolioRequest
            {
                Name = _model.Name,
                Description = _model.Description,
                PortfolioType = _model.PortfolioType
            });
            DialogService.Close(true);
        }
        catch (Exception)
        {
            DialogService.Close(false);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
