@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@using RK = ThaiX.Client.Constants.ResourceKeys

<div class="ThaiX-md-editor">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <RadzenLabel Text="@Label" Class="ThaiX-md-editor__label" />
    }

    <div class="ThaiX-md-editor__toolbar" role="toolbar" aria-label="@L[RK.Tools.MarkdownPreview.Toolbar]">
        <RadzenButton Icon="title" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Heading]" Click="@(() => WrapAsync("# ", "", "Heading"))" Disabled="@Disabled" />
        <RadzenButton Icon="format_bold" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Bold]" Click="@(() => WrapAsync("**", "**", "bold"))" Disabled="@Disabled" />
        <RadzenButton Icon="format_italic" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Italic]" Click="@(() => WrapAsync("*", "*", "italic"))" Disabled="@Disabled" />
        <RadzenButton Icon="format_strikethrough" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Strike]" Click="@(() => WrapAsync("~~", "~~", "text"))" Disabled="@Disabled" />
        <span class="ThaiX-md-editor__sep" aria-hidden="true"></span>
        <RadzenButton Icon="format_quote" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Quote]" Click="@(() => WrapAsync("> ", "", "quote"))" Disabled="@Disabled" />
        <RadzenButton Icon="format_list_bulleted" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.BulletList]" Click="@(() => WrapAsync("- ", "", "item"))" Disabled="@Disabled" />
        <RadzenButton Icon="format_list_numbered" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.NumberedList]" Click="@(() => WrapAsync("1. ", "", "item"))" Disabled="@Disabled" />
        <span class="ThaiX-md-editor__sep" aria-hidden="true"></span>
        <RadzenButton Icon="code" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.InlineCode]" Click="@(() => WrapAsync("`", "`", "code"))" Disabled="@Disabled" />
        <RadzenButton Icon="terminal" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.CodeBlock]" Click="@(() => WrapAsync("```\n", "\n```", "code"))" Disabled="@Disabled" />
        <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.Link]" Click="@(() => WrapAsync("[", "](https://)", "text"))" Disabled="@Disabled" />
        <RadzenButton Icon="remove" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                      title="@L[RK.Tools.MarkdownPreview.HorizontalRule]" Click="@(() => InsertAsync("\n\n---\n\n"))" Disabled="@Disabled" />
    </div>

    <textarea @ref="_textarea"
              class="ThaiX-md-editor__page"
              value="@Value"
              @oninput="OnInput"
              rows="@Rows"
              disabled="@Disabled"
              placeholder="@Placeholder"
              spellcheck="true"></textarea>
</div>

@code {
    private ElementReference _textarea;

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 18;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    private Task OnInput(ChangeEventArgs args) =>
        ValueChanged.InvokeAsync(args.Value?.ToString());

    private async Task WrapAsync(string before, string after, string placeholder)
    {
        try
        {
            var next = await JS.InvokeAsync<string>("insertMarkdownSyntax", _textarea, before, after, placeholder);
            await ValueChanged.InvokeAsync(next);
        }
        catch
        {
            try
            {
                var fallback = $"{before}{placeholder}{after}";
                await ValueChanged.InvokeAsync((Value ?? string.Empty) + fallback);
            }
            catch
            {
                /* keep page interactive */
            }
        }
    }

    private async Task InsertAsync(string text)
    {
        try
        {
            var next = await JS.InvokeAsync<string>("insertTextAtCursor", _textarea, text);
            await ValueChanged.InvokeAsync(next);
        }
        catch
        {
            try
            {
                await ValueChanged.InvokeAsync((Value ?? string.Empty) + text);
            }
            catch
            {
                /* keep page interactive */
            }
        }
    }
}
