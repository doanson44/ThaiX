@inherits ThaiXPageBase

<RadzenButton ButtonStyle="@ButtonStyle"
              ButtonType="@ButtonType"
              Size="@Size"
              IsBusy="@IsBusy"
              Disabled="@Disabled"
              title="@AccessibleName"
              aria-label="@AccessibleName"
              class="@Class"
              Click="@Click">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            @if (ThaiXIconName is not null)
            {
                <ThaiXIcon Name="@ThaiXIconName" />
            }
            else
            {
                <RadzenIcon Icon="@Icon" />
            }
        }
        @if (DisplayText is not null)
        {
            <span>@DisplayText</span>
        }
    </ChildContent>
</RadzenButton>

@code {
    private static readonly IReadOnlyDictionary<string, string> IconMap =
        new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["home"] = "home",
            ["dashboard"] = "dashboard",
            ["analytics"] = "analytics",
            ["trending_up"] = "analytics",
            ["bar_chart"] = "analytics",
            ["groups"] = "team",
            ["people"] = "team",
            ["person"] = "user",
            ["account_circle"] = "user",
            ["wallet"] = "wallet",
            ["account_balance_wallet"] = "wallet",
            ["account_balance"] = "wallet",
            ["database"] = "database",
            ["description"] = "document",
            ["article"] = "document",
            ["document"] = "document",
            ["security"] = "shield-check",
            ["verified_user"] = "shield-check",
            ["psychology"] = "ai-chip",
            ["smart_toy"] = "ai-chip",
            ["cube"] = "cube",
            ["link"] = "link",
            ["sports_esports"] = "gamepad",
            ["videocam"] = "video",
            ["image"] = "image",
            ["settings"] = "settings",
            ["public"] = "globe",
            ["language"] = "globe",
            ["eco"] = "leaf",
            ["bolt"] = "lightning",
            ["shopping_cart"] = "cart",
            ["notifications"] = "bell",
            ["notifications_active"] = "bell",
            ["warning"] = "alert",
            ["lock"] = "lock",
            ["cloud"] = "cloud",
            ["dns"] = "server",
            ["search"] = "search",
            ["chat"] = "chat",
            ["favorite"] = "heart",
            ["share"] = "share"
        };

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;

    [Parameter]
    public ButtonType ButtonType { get; set; } = ButtonType.Button;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Medium;

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback Click { get; set; }

    private string? DisplayText => Viewport.IsMobile ? null : Text;
    private string? ThaiXIconName => IconMap.TryGetValue(Icon, out var name) ? name : null;
    private string AccessibleName => string.IsNullOrWhiteSpace(Text) ? Icon : Text;
}