@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using RK = ThaiX.Client.Constants.ResourceKeys
@using ThaiX.Client.Localization
@using ThaiX.Client.Services.Blog
@inject IBlogService BlogService
@inject IStringLocalizer<SharedResource> L

<div class="rich-text-editor">
    <RadzenHtmlEditor @ref="_editor" Value="@Value" ValueChanged="@OnEditorValueChanged" style="@HeightStyle" />

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="rich-text-editor-image-row">
        <InputFile OnChange="HandleImageFileSelectedAsync" accept="image/*" disabled="@_isUploadingImage" />
        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@L[RK.Blog.Editor.InsertImage]</RadzenText>
        @if (_isUploadingImage)
        {
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
        }
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(_uploadError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter" Class="mt-1">
            @_uploadError
        </RadzenAlert>
    }
</div>

@code {
    private RadzenHtmlEditor? _editor;
    private string? _uploadError;
    private bool _isUploadingImage;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public int Rows { get; set; } = 18;

    private int Height => Math.Max(320, Rows * 24);
    private string HeightStyle => $"height: {Height}px";

    private async Task OnEditorValueChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task HandleImageFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        _isUploadingImage = true;
        StateHasChanged();

        try
        {
            const long maxSizeBytes = 5 * 1024 * 1024;
            var file = e.File;
            if (file.Size > maxSizeBytes)
            {
                _uploadError = L[RK.Blog.Editor.ImageTooLarge];
                return;
            }

            await using var stream = file.OpenReadStream(maxSizeBytes);
            var url = await BlogService.UploadImageAsync(stream, file.Name, file.ContentType);

            if (_editor is not null)
            {
                // Plain <img> HTML for the editor; broken loads are handled by wwwroot/js/imageFallback.js.
                await _editor.ExecuteCommandAsync(HtmlEditorCommands.InsertHtml, $"<img src=\"{url}\" alt=\"\" style=\"max-width:100%;\" />");
            }
        }
        catch
        {
            _uploadError = L[RK.Blog.Editor.ImageUploadFailed];
        }
        finally
        {
            _isUploadingImage = false;
            StateHasChanged();
        }
    }
}
