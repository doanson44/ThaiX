                            @if (DetailForView is not null && DetailForView.IdentityDocuments.Count > 0) { <RadzenStack Gap="0.25rem">@foreach (var d in DetailForView.IdentityDocuments) { <RadzenText>@d.DocumentType | ****@d.DocumentNumberLast4 | @d.IssuedBy | @d.IssuedDate.ToString("yyyy-MM-dd")</RadzenText> }</RadzenStack> }
