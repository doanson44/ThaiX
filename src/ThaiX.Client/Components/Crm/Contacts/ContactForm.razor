                                    else { <RadzenStack Gap="0.25rem">@foreach (var d in DetailForView.IdentityDocuments) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@d.DocumentType | ****@d.DocumentNumberLast4 | @d.IssuedBy</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveIdentityDocumentAsync(d.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                    <div class="row g-2">
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.DocumentType]" /><RadzenTextBox @bind-Value="_identity.DocumentType" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.DocumentNumber]" /><RadzenTextBox @bind-Value="_identity.DocumentNumber" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.IssuedDate]" /><RadzenDatePicker @bind-Value="_identity.IssuedDate" class="w-100" DateFormat="yyyy-MM-dd" /></div>
