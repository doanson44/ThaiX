                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                <div class="row g-2">
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.Name]" /><RadzenTextBox @bind-Value="_tagName" Placeholder="@L[RK.Contacts.Name]" class="w-100" /></div>
                                    <div class="col-12 col-md-6 d-grid d-md-flex align-items-md-end"><RadzenButton Text="@L[RK.Contacts.AddNew]" ButtonStyle="ButtonStyle.Primary" Click="@AddPendingTag" class="w-100" /></div>
