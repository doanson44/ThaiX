                            @if (DetailForView is not null && DetailForView.CustomFields.Count > 0)
                            {
                                <RadzenStack Gap="0.25rem">@foreach (var f in DetailForView.CustomFields) { <RadzenText>@f.Key: @f.Value</RadzenText> }</RadzenStack>
                            }
                            else { <RadzenText class="text-muted">--</RadzenText> }
                        }
                        else if (IsEditMode && DetailForView is not null)
                        {
                            <RadzenStack Gap="0.75rem">
                                @if (DetailForView.CustomFields.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                else { <RadzenStack Gap="0.25rem">@foreach (var f in DetailForView.CustomFields) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@f.Key: @f.Value</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveCustomFieldAsync(f.Key))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                <div class="row g-2">
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Key]" /><RadzenTextBox @bind-Value="_customFieldKey" Placeholder="@L[RK.Contacts.Key]" class="w-100" /></div>
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Value]" /><RadzenTextBox @bind-Value="_customFieldValue" Placeholder="@L[RK.Contacts.Value]" class="w-100" /></div>
                                    <div class="col-12 col-md-4 d-grid d-md-flex align-items-md-end"><RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@AddCustomFieldAsync" IsBusy="_savingCustomField" Disabled="_savingCustomField" class="w-100" /></div>
                                </div>
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenStack Gap="0.75rem">
                                @if (_pendingCustomFields.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                else { <RadzenStack Gap="0.25rem">@foreach (var f in _pendingCustomFields) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@f.Key: @f.Value</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemovePendingCustomField(f))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                <div class="row g-2">
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Key]" /><RadzenTextBox @bind-Value="_customFieldKey" Placeholder="@L[RK.Contacts.Key]" class="w-100" /></div>
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Value]" /><RadzenTextBox @bind-Value="_customFieldValue" Placeholder="@L[RK.Contacts.Value]" class="w-100" /></div>
                                    <div class="col-12 col-md-4 d-grid d-md-flex align-items-md-end"><RadzenButton Text="@L[RK.Contacts.AddNew]" ButtonStyle="ButtonStyle.Primary" Click="@AddPendingCustomField" class="w-100" /></div>
                                </div>
                            </RadzenStack>
                        }
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
        <div class="row g-2 mt-1">
            @if (IsViewMode)
            {
                <div class="col-12 col-md-auto ms-md-auto">
                    <RadzenButton Text="@L[RK.Common.Close]" ButtonStyle="ButtonStyle.Light" Click="@OnBack" class="w-100" />
                </div>
            }
            else if (IsEditMode)
            {
                <div class="col-12 col-md-auto ms-md-auto">
                    <RadzenButton Text="@L[RK.Common.Back]" ButtonStyle="ButtonStyle.Light" Click="@OnBack" class="w-100" />
                </div>
            }
            else
            {
                <div class="col-12 col-md-auto ms-md-auto">
                    <RadzenButton Text="@L[RK.Common.Cancel]" ButtonStyle="ButtonStyle.Light" Click="@OnBack" class="w-100" />
                </div>
                <div class="col-12 col-md-auto">
                    <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" IsBusy="@IsBusy" Disabled="@IsBusy" class="w-100" />
                </div>
            }
        </div>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public ContactFormDialogInitialData? InitialData { get; set; }
    [Parameter] public ContactDetailDto? DetailForView { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback<ContactFormDialogResult> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSectionSaved { get; set; }

    [Inject] private IStringLocalizer<SharedResource> L { get; set; } = null!;
    [Inject] private IMasterDataService MasterDataService { get; set; } = null!;
    [Inject] private IContactService ContactService { get; set; } = null!;
    [Inject] private IUserService UserService { get; set; } = null!;
    [Inject] private NotificationService NotificationService { get; set; } = null!;

    private Guid? EditContactId => InitialData is ContactFormDialogInitialDataWithId withId ? withId.Id : null;

    private static readonly IReadOnlyList<CurrencyOption> CurrencyOptions =
    [
        new CurrencyOption("VND"),
        new CurrencyOption("USD"),
        new CurrencyOption("EUR"),
        new CurrencyOption("GBP"),
        new CurrencyOption("JPY"),
        new CurrencyOption("THB"),
        new CurrencyOption("SGD"),
        new CurrencyOption("AUD"),
        new CurrencyOption("CHF"),
        new CurrencyOption("CNY"),
        new CurrencyOption("KRW")
    ];

    private IReadOnlyList<CurrencyOption> _currencyOptions => CurrencyOptions;

    private readonly ContactProfileFormModel _profile = new();
    private DateTime? _birthday;
    private string? _email;
    private string? _phone;
    private bool _emailIsPrimary = true;
    private bool _phoneIsPrimary = true;
    private bool _newEmailIsPrimary = true;
    private bool _newPhoneIsPrimary = true;
    private readonly AddressFormModel _address = new();
    private readonly IdentityDocumentFormModel _identity = new();
    private readonly BankAccountFormModel _bank = new();
    private bool _loaded;
    private Guid? _boundContactId;
    private bool _savingGeneral;
    private bool _savingContactInfo;
    private bool _savingAddress;
    private bool _savingBank;
    private bool _savingIdentity;
    private bool _savingTag;
    private bool _savingSocial;
    private bool _savingCustomField;
    private string? _tagName;
    private string? _socialPlatform;
    private string? _socialUrl;
    private string? _customFieldKey;
    private string? _customFieldValue;
    private string? _avatarUrlOverride;
    private bool _uploadingAvatar;
    private bool _removingAvatar;
    private IReadOnlyList<SuggestedUserDto> _suggestedUsers = [];
    private bool _loadingSuggestions;
    private bool _suggestedUsersLoaded;
    private readonly HashSet<Guid> _linkingUserIds = [];
    private string? _selectedUserIdForLink;
    private bool _unlinkingUser;
    private readonly List<string> _pendingTags = [];
    private readonly List<ContactFormSocialLinkPart> _pendingSocialLinks = [];
    private readonly List<ContactFormCustomFieldPart> _pendingCustomFields = [];
    private string FormModeLabel => IsViewMode
        ? L[RK.Contacts.View].Value
        : IsEditMode
            ? L[RK.Contacts.Edit].Value
            : L[RK.Contacts.CreateTitle].Value;

    private BadgeStyle FormModeBadgeStyle => IsViewMode
        ? BadgeStyle.Info
        : IsEditMode
            ? BadgeStyle.Warning
            : BadgeStyle.Success;

    private string? DisplayAvatarUrl => _avatarUrlOverride ?? DetailForView?.AvatarUrl;

    private string GetAvatarImageUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (!url.StartsWith("/", StringComparison.Ordinal)) return url;
        var baseUrl = (Configuration["Api:BaseUrl"] ?? "http://localhost:5005").TrimEnd('/');
        return baseUrl + url;
    }

    /// <summary>
    /// Appends a cache-busting query parameter so the browser fetches a fresh image after upload (same path, new file).
    /// </summary>
    private static string AppendCacheBuster(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return url;
        var separator = url.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return url + separator + "t=" + DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    }

    protected override void OnParametersSet()
    {
        var editId = EditContactId;
        if (editId.HasValue && editId != _boundContactId)
        {
            _boundContactId = editId;
            _avatarUrlOverride = null;
            _loaded = false;
            _suggestedUsersLoaded = false;
            _selectedUserIdForLink = null;
        }
        if (_loaded) return;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EditContactId.HasValue && IsEditMode && !_suggestedUsersLoaded)
            await LoadSuggestedUsersAsync();
        if (_loaded) return;
        _loaded = true;
        if (InitialData is not null)
        {
            _profile.FirstName = InitialData.FirstName;
            _profile.LastName = InitialData.LastName;
            _profile.Company = InitialData.Company;
            _profile.JobTitle = InitialData.JobTitle;
            _profile.Notes = InitialData.Notes;
            _birthday = InitialData.Birthday?.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            _profile.Reset();
            _birthday = null;
            _email = null;
            _phone = null;
            _emailIsPrimary = true;
            _phoneIsPrimary = true;
            _newEmailIsPrimary = true;
            _newPhoneIsPrimary = true;
            _address.Reset();
            _identity.Reset();
            _bank.Reset();
            _pendingTags.Clear();
            _pendingSocialLinks.Clear();
            _pendingCustomFields.Clear();
            _tagName = null;
            _socialPlatform = null;
            _socialUrl = null;
            _customFieldKey = null;
            _customFieldValue = null;
        }
    }

    private async Task OnBack()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task SaveGeneralSectionAsync()
    {
        if (EditContactId is null || _savingGeneral) return;
        if (string.IsNullOrWhiteSpace(_profile.FirstName) || string.IsNullOrWhiteSpace(_profile.LastName))
        {
            NotificationService.NotifyWarning(L[RK.Validation.Required]);
            return;
        }
        var result = BuildResult();
        if (result is null) return;
        _savingGeneral = true;
        try
        {
            await OnSave.InvokeAsync(result);
        }
        finally { _savingGeneral = false; }
    }

    private async Task LoadSuggestedUsersAsync()
    {
        if (EditContactId is null || _loadingSuggestions) return;
        _loadingSuggestions = true;
        try
        {
            _suggestedUsers = await ContactService.GetSuggestedUsersAsync(EditContactId.Value);
            _suggestedUsersLoaded = true;
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Contacts.LoadFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _loadingSuggestions = false;
        }
    }

    private async Task LinkUserAsync(Guid userId)
    {
        if (EditContactId is null || _linkingUserIds.Contains(userId)) return;
        _linkingUserIds.Add(userId);
        try
        {
            await ContactService.LinkUserToContactAsync(EditContactId.Value, userId);
            _suggestedUsers = _suggestedUsers.Where(u => u.Id != userId).ToList();
            if (_selectedUserIdForLink == userId.ToString())
                _selectedUserIdForLink = null;
            NotificationService.NotifySuccess(L[RK.Contacts.UpdateSuccess]);
            await OnSectionSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Contacts.UpdateFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _linkingUserIds.Remove(userId);
        }
    }

    private async Task<(IReadOnlyList<UserListItemDto> items, int totalCount)> LoadUsersForLinkAsync(int pageNumber, int pageSize, string? search, CancellationToken cancellationToken)
    {
        var request = new GetUsersRequest
        {
            PageNumber = pageNumber,
            PageSize = pageSize,
            SearchTerm = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            SortBy = "email",
            SortDescending = false
        };
        var response = await UserService.GetUsersAsync(request, cancellationToken);
        var items = (IReadOnlyList<UserListItemDto>)(response.Data ?? []);
        var total = response.Metadata?.TotalCount ?? 0;
        return (items, total);
    }

    private void OnSelectedUserForLinkChanged(string? value)
    {
        _selectedUserIdForLink = value;
    }

    private async Task LinkSelectedUserAsync()
    {
        if (EditContactId is null || string.IsNullOrEmpty(_selectedUserIdForLink) || !Guid.TryParse(_selectedUserIdForLink, out var userId))
            return;
        await LinkUserAsync(userId);
        _selectedUserIdForLink = null;
    }

    private async Task UnlinkUserAsync()
    {
        if (EditContactId is null || _unlinkingUser) return;
        _unlinkingUser = true;
        try
        {
            await ContactService.UnlinkUserFromContactAsync(EditContactId.Value);
            NotificationService.NotifySuccess(L[RK.Contacts.UpdateSuccess]);
            await OnSectionSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Contacts.UpdateFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _unlinkingUser = false;
        }
    }

    private const long MaxAvatarSizeBytes = 2 * 1024 * 1024;

    private async Task HandleAvatarFileSelected(InputFileChangeEventArgs e)
    {
        if (EditContactId is null || _uploadingAvatar) return;
        var file = e.File;
        if (file.Size > MaxAvatarSizeBytes)
        {
            NotificationService.NotifyWarning(L[RK.Contacts.AvatarTooLarge]);
            return;
        }
        var contentType = file.ContentType;
        if (string.IsNullOrEmpty(contentType) || !contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            NotificationService.NotifyWarning(L[RK.Contacts.AvatarUploadFailed]);
            return;
        }
        _uploadingAvatar = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxAvatarSizeBytes);
            var url = await ContactService.UploadContactAvatarAsync(EditContactId.Value, stream, file.Name, contentType);
            _avatarUrlOverride = AppendCacheBuster(url);
            await OnSectionSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            NotificationService.NotifyError(L[RK.Contacts.AvatarUploadFailed], ex.GetDisplayDetail());
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }

