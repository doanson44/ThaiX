    private async Task OnSubmitAsync()
    {
        if (IsViewMode) return;
        var result = BuildResult();
        if (result is not null)
            await OnSave.InvokeAsync(result);
    }

    private ContactFormDialogResult? BuildResult()
    {
        if (string.IsNullOrWhiteSpace(_profile.FirstName) || string.IsNullOrWhiteSpace(_profile.LastName))
            return null;

        var trim = (string? x) => string.IsNullOrWhiteSpace(x) ? null : x.Trim();

        if (IsEditMode)
        {
            return new ContactFormDialogResult
            {
                EditId = InitialData is ContactFormDialogInitialDataWithId withId ? withId.Id : null,
                FirstName = _profile.FirstName.Trim(),
                LastName = _profile.LastName.Trim(),
                Company = trim(_profile.Company),
                JobTitle = trim(_profile.JobTitle),
                AvatarUrl = DisplayAvatarUrl,
                Birthday = _birthday.HasValue ? DateOnly.FromDateTime(_birthday.Value.Date) : null,
                Notes = trim(_profile.Notes)
            };
        }

        ContactFormAddressPart? addressPart = null;
        if (!string.IsNullOrWhiteSpace(_address.Street) && !string.IsNullOrWhiteSpace(_address.CountryCode))
            addressPart = new ContactFormAddressPart
            {
                Street = _address.Street!.Trim(),
                CountryCode = _address.CountryCode!.Trim(),
                CityCode = _address.CityCode ?? string.Empty,
                DistrictCode = _address.DistrictCode ?? string.Empty,
                PostalCode = _address.PostalCode ?? string.Empty,
                IsPrimary = true
            };

        ContactFormIdentityPart? identityPart = null;
        if (_identity.IssuedDate.HasValue && !string.IsNullOrWhiteSpace(_identity.DocumentType) && !string.IsNullOrWhiteSpace(_identity.DocumentNumber))
            identityPart = new ContactFormIdentityPart
            {
                DocumentType = _identity.DocumentType!,
                DocumentNumber = _identity.DocumentNumber!,
                IssuedBy = _identity.IssuedBy ?? string.Empty,
                IssuedPlace = _identity.IssuedPlace ?? string.Empty,
                IssuedDate = DateOnly.FromDateTime(_identity.IssuedDate.Value.Date),
                ExpiryDate = _identity.ExpiryDate.HasValue ? DateOnly.FromDateTime(_identity.ExpiryDate.Value.Date) : null,
                IsPrimary = true
            };

        ContactFormBankPart? bankPart = null;
        if (!string.IsNullOrWhiteSpace(_bank.BankCode) && !string.IsNullOrWhiteSpace(_bank.AccountNumber) && !string.IsNullOrWhiteSpace(_bank.AccountName) && !string.IsNullOrWhiteSpace(_bank.CurrencyCode))
            bankPart = new ContactFormBankPart
            {
                BankCode = _bank.BankCode!,
                BranchName = trim(_bank.BranchName),
                AccountNumber = _bank.AccountNumber!,
                AccountName = _bank.AccountName!,
                CurrencyCode = _bank.CurrencyCode!,
                IsPrimary = true
            };

        return new ContactFormDialogResult
        {
            FirstName = _profile.FirstName.Trim(),
            LastName = _profile.LastName.Trim(),
            Company = trim(_profile.Company),
            JobTitle = trim(_profile.JobTitle),
            Birthday = _birthday.HasValue ? DateOnly.FromDateTime(_birthday.Value.Date) : null,
            Notes = trim(_profile.Notes),
            Email = trim(_email),
            EmailIsPrimary = _emailIsPrimary,
            Phone = trim(_phone),
            PhoneIsPrimary = _phoneIsPrimary,
            Address = addressPart,
            Identity = identityPart,
            Bank = bankPart,
            Tags = _pendingTags.Count > 0 ? _pendingTags.ToList() : null,
            SocialLinks = _pendingSocialLinks.Count > 0 ? _pendingSocialLinks.ToList() : null,
            CustomFields = _pendingCustomFields.Count > 0 ? _pendingCustomFields.ToList() : null
        };
    }

