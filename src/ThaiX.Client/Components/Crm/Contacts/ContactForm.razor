                        else if (IsEditMode && DetailForView is not null)
                        {
                            <RadzenStack Gap="0.75rem">
                                @if (DetailForView.SocialLinks.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                else { <RadzenStack Gap="0.25rem">@foreach (var s in DetailForView.SocialLinks) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@s.Platform: @s.Url</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveSocialLinkAsync(s.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                <div class="row g-2">
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Platform]" /><RadzenTextBox @bind-Value="_socialPlatform" Placeholder="@L[RK.Contacts.Platform]" class="w-100" /></div>
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Url]" /><RadzenTextBox @bind-Value="_socialUrl" Placeholder="@L[RK.Contacts.Url]" class="w-100" /></div>
                                    <div class="col-md-4 d-flex align-items-end"><RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@AddSocialLinkAsync" IsBusy="_savingSocial" Disabled="_savingSocial" /></div>
                                </div>
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenStack Gap="0.75rem">
                                @if (_pendingSocialLinks.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                else { <RadzenStack Gap="0.25rem">@foreach (var s in _pendingSocialLinks) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@s.Platform: @s.Url</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemovePendingSocialLink(s))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                <div class="row g-2">
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Platform]" /><RadzenTextBox @bind-Value="_socialPlatform" Placeholder="@L[RK.Contacts.Platform]" class="w-100" /></div>
                                    <div class="col-md-4"><RadzenLabel Text="@L[RK.Contacts.Url]" /><RadzenTextBox @bind-Value="_socialUrl" Placeholder="@L[RK.Contacts.Url]" class="w-100" /></div>
                                    <div class="col-md-4 d-flex align-items-end"><RadzenButton Text="@L[RK.Contacts.AddNew]" ButtonStyle="ButtonStyle.Primary" Click="@AddPendingSocialLink" /></div>
