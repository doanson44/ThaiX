@namespace ThaiX.Client.Components.Crm.Contacts
@using Microsoft.AspNetCore.Components.Forms
@using ThaiX.Client.Models.Contacts
@using ThaiX.Client.Models.MasterData
@using ThaiX.Client.Models.Users
@using ThaiX.Client.Services.Api
@using ThaiX.Client.Services.Users
@using ThaiX.Client.Services.MasterData
@using ThaiX.Client.Services.Contacts
@using RK = ThaiX.Client.Constants.ResourceKeys
@inject IConfiguration Configuration

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.Center"
                 Wrap="FlexWrap.Wrap"
                 Gap="0.5rem">
        <div>
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <RadzenText TextStyle="TextStyle.H5" class="mb-0">@Title</RadzenText>
            }
            <RadzenText class="text-muted">@L[RK.Contacts.ProfileTitle]</RadzenText>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <RadzenBadge Text="@FormModeLabel" BadgeStyle="@FormModeBadgeStyle" />
            <RadzenButton Icon="arrow_back" Text="@L[RK.Common.Back]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@OnBack" aria-label="@L[RK.Common.Back]" />
        </div>
    </RadzenStack>
    <RadzenTemplateForm Data="@_profile" Submit="@(async (ContactProfileFormModel _) => await OnSubmitAsync())">
        <RadzenTabs class="overflow-auto">
            <Tabs>
                <RadzenTabsItem Text="@L[RK.Contacts.TabGeneral]" Value="general">
                    <div class="row g-2 pt-2">
                        @if (DetailForView is not null || _avatarUrlOverride is not null)
                        {
                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="position-relative">
                                        <SafeImage Src="@(DisplayAvatarUrl is not null ? GetAvatarImageUrl(DisplayAvatarUrl) : null)"
                                                   Alt="@L[RK.Contacts.AvatarAlt]"
                                                   Class="rounded-circle"
                                                   Style="width: 80px; height: 80px; object-fit: cover;"
                                                   FallbackIcon="person"
                                                   FallbackClass="safe-image-fallback rounded-circle bg-light">
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                                <RadzenIcon Icon="person" style="font-size: 2rem; color: var(--rz-base-400);" />
                                            </div>
                                        </SafeImage>
                                        @if (IsEditMode && EditContactId is not null)
                                        {
                                            <label class="btn btn-sm btn-outline-primary position-absolute bottom-0 end-0 mb-0 me-0 rounded-circle p-1" style="cursor: pointer;" title="@L[RK.Contacts.ChangeAvatar]">
                                                <InputFile Accept="image/jpeg,image/png,image/webp" OnChange="HandleAvatarFileSelected" style="display: none;" />
                                                <RadzenIcon Icon="camera_alt" />
                                            </label>
                                        }
                                    </div>
                                    @if (IsEditMode && EditContactId is not null)
                                    {
                                        <div>
                                            <RadzenText TextStyle="TextStyle.Caption">@L[RK.Contacts.AvatarUrl]</RadzenText>
                                            <RadzenText class="d-block text-muted small">@L[RK.Contacts.ChangeAvatar] (@L[RK.Contacts.AvatarFormatHint])</RadzenText>
                                            @if (DisplayAvatarUrl is not null)
                                            {
                                                <ResponsiveIconButton ButtonStyle="ButtonStyle.Light"
                                                             Size="ButtonSize.Small"
                                                             Icon="delete"
                                                             Text="@L[RK.Contacts.RemoveAvatar]"
                                                             Click="@RemoveAvatarAsync"
                                                             Disabled="@_removingAvatar"
                                                             class="mt-1" />
                                            }
                                            @if (_uploadingAvatar) { <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" /> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="col-md-6">
                            <RadzenLabel Text="@L[RK.Contacts.FirstName]" />
                            <RadzenTextBox Name="formFirstName" @bind-Value="_profile.FirstName" class="w-100" ReadOnly="@IsViewMode" />
                            @if (!IsViewMode)
                            {
                                <RadzenRequiredValidator Component="formFirstName" Text="@L[RK.Validation.Required]" Popup="false" />
                            }
                        </div>
                        <div class="col-md-6">
                            <RadzenLabel Text="@L[RK.Contacts.LastName]" />
                            <RadzenTextBox Name="formLastName" @bind-Value="_profile.LastName" class="w-100" ReadOnly="@IsViewMode" />
                            @if (!IsViewMode)
                            {
                                <RadzenRequiredValidator Component="formLastName" Text="@L[RK.Validation.Required]" Popup="false" />
                            }
                        </div>
                        <div class="col-md-6">
                            <RadzenLabel Text="@L[RK.Contacts.Company]" />
                            <RadzenTextBox @bind-Value="_profile.Company" class="w-100" ReadOnly="@IsViewMode" />
                        </div>
                        <div class="col-md-6">
                            <RadzenLabel Text="@L[RK.Contacts.JobTitle]" />
                            <RadzenTextBox @bind-Value="_profile.JobTitle" class="w-100" ReadOnly="@IsViewMode" />
                        </div>
                        <div class="col-md-6">
                            <RadzenLabel Text="@L[RK.Contacts.Birthday]" />
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="_birthday" class="w-100" DateFormat="yyyy-MM-dd" ReadOnly="@IsViewMode" Disabled="@IsViewMode" />
                        </div>
                        <div class="col-12">
                            <RadzenLabel Text="@L[RK.Contacts.Notes]" />
                            <RadzenTextArea @bind-Value="_profile.Notes" class="w-100" Rows="2" ReadOnly="@IsViewMode" />
                        </div>
                        @if (IsViewMode && DetailForView is not null)
                        {
                            <div class="col-12 pt-2">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.LinkedUser]</RadzenText>
                                <RadzenText class="d-block pt-1">@(DetailForView.LinkedUserId is not null ? (DetailForView.LinkedUserEmail ?? DetailForView.LinkedUserId.ToString()) : L[RK.Contacts.NoLinkedUser].Value)</RadzenText>
                            </div>
                        }
                        @if (IsEditMode && EditContactId is not null)
                        {
                            <div class="col-12">
                                <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@SaveGeneralSectionAsync" IsBusy="_savingGeneral" Disabled="_savingGeneral" />
                            </div>
                            <div class="col-12 pt-2">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.LinkedUser]</RadzenText>
                                @if (DetailForView?.LinkedUserId is not null)
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                                        <RadzenText class="mb-0">@(DetailForView.LinkedUserEmail ?? DetailForView.LinkedUserId.ToString())</RadzenText>
                                        <RadzenButton Icon="link_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Text="@L[RK.Contacts.UnlinkUser]" Click="@UnlinkUserAsync" Disabled="_unlinkingUser" aria-label="@L[RK.Contacts.UnlinkUser]" />
                                    </div>
                                }
                                else
                                {
                                    <RadzenText class="text-muted small">@L[RK.Contacts.NoLinkedUser]</RadzenText>
                                }
                            </div>
                            <div class="col-12 pt-2">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.SuggestedUsers]</RadzenText>
                                @if (_loadingSuggestions)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                }
                                else if (_suggestedUsers.Count == 0)
                                {
                                    <RadzenText class="text-muted small">@L[RK.Contacts.SuggestedUsersNone]</RadzenText>
                                }
                                else
                                {
                                    <RadzenStack Gap="0.25rem" class="pt-1">
                                        @foreach (var u in _suggestedUsers)
                                        {
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <RadzenText class="mb-0">@u.Email @(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "" : "(" + u.PhoneNumber + ")")</RadzenText>
                                                <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Text="@L[RK.Contacts.LinkUser]" Click="@(() => LinkUserAsync(u.Id))" Disabled="_linkingUserIds.Contains(u.Id)" aria-label="@L[RK.Contacts.LinkUser]" />
                                            </div>
                                        }
                                    </RadzenStack>
                                }
                            </div>
                            <div class="col-12 pt-2">
                                <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.LinkToUserSection]</RadzenText>
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="pt-1 flex-wrap align-items-end">
                                    <AsyncSearchSelect TItem="UserListItemDto"
                                                       Value="@_selectedUserIdForLink"
                                                       ValueChanged="@OnSelectedUserForLinkChanged"
                                                       LoadDataAsync="LoadUsersForLinkAsync"
                                                       GetText="x => x.Email"
                                                       GetValue="x => x.Id.ToString()"
                                                       Placeholder="@L[RK.Contacts.SelectUserToLinkPlaceholder]"
                                                       SearchPlaceholder="@L[RK.Common.Search]"
                                                       LoadingText="@L[RK.Common.Loading]"
                                                       EmptyText="@L[RK.MasterData.SelectEmpty]"
                                                       MoreHint="@L[RK.MasterData.SelectScrollMore]"
                                                       AllowClear="true"
                                                       Class="w-100 tx-control-max-20" />
                                    <RadzenButton Icon="link"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.Medium"
                                                  Text="@L[RK.Contacts.LinkSelectedUser]"
                                                  Click="@LinkSelectedUserAsync"
                                                  Disabled="@(string.IsNullOrEmpty(_selectedUserIdForLink) || _linkingUserIds.Count > 0)"
                                                  aria-label="@L[RK.Contacts.LinkSelectedUser]" />
                                </RadzenStack>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L[RK.Contacts.TabContactInfo]" Value="contact">
                    <div class="pt-2">
                        @if (IsViewMode)
                        {
                            @if (DetailForView is not null)
                            {
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.Emails]</RadzenText>
                                    @if (DetailForView.Emails.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { @foreach (var e in DetailForView.Emails) { <RadzenText>@e.Value @(e.IsPrimary ? "(" + L[RK.Contacts.IsPrimary].Value + ")" : "")</RadzenText> } }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.Phones]</RadzenText>
                                    @if (DetailForView.Phones.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { @foreach (var p in DetailForView.Phones) { <RadzenText>@p.Value @(p.IsPrimary ? "(" + L[RK.Contacts.IsPrimary].Value + ")" : "")</RadzenText> } }
                                </RadzenStack>
                            }
                            else { <RadzenText class="text-muted">--</RadzenText> }
                        }
                        else
                        {
                            @if (IsEditMode && DetailForView is not null)
                            {
                                <RadzenStack Gap="0.75rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.Emails]</RadzenText>
                                    @if (DetailForView.Emails.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { <RadzenStack Gap="0.25rem">@foreach (var e in DetailForView.Emails) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@e.Value @(e.IsPrimary ? "(" + L[RK.Contacts.IsPrimary].Value + ")" : "")</RadzenText>@if (!e.IsPrimary) { <RadzenButton Icon="star" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Text="@L[RK.Contacts.SetAsPrimary]" Click="@(() => SetEmailPrimaryAsync(e.Id))" aria-label="@L[RK.Contacts.SetAsPrimary]" /> }<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveEmailAsync(e.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.Phones]</RadzenText>
                                    @if (DetailForView.Phones.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { <RadzenStack Gap="0.25rem">@foreach (var p in DetailForView.Phones) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@p.Value @(p.IsPrimary ? "(" + L[RK.Contacts.IsPrimary].Value + ")" : "")</RadzenText>@if (!p.IsPrimary) { <RadzenButton Icon="star" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Text="@L[RK.Contacts.SetAsPrimary]" Click="@(() => SetPhonePrimaryAsync(p.Id))" aria-label="@L[RK.Contacts.SetAsPrimary]" /> }<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemovePhoneAsync(p.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <RadzenLabel Text="@L[RK.Contacts.Emails]" />
                                            <RadzenTextBox @bind-Value="_email" Placeholder="@L[RK.Contacts.Value]" class="w-100" />
                                            <RadzenCheckBox @bind-Value="_newEmailIsPrimary" Name="newEmailPrimary" />
                                            <RadzenLabel Text="@L[RK.Contacts.IsPrimary]" Component="newEmailPrimary" />
                                        </div>
                                        <div class="col-md-6">
                                            <RadzenLabel Text="@L[RK.Contacts.Phones]" />
                                            <RadzenTextBox @bind-Value="_phone" Placeholder="@L[RK.Contacts.Value]" class="w-100" />
                                            <RadzenCheckBox @bind-Value="_newPhoneIsPrimary" Name="newPhonePrimary" />
                                            <RadzenLabel Text="@L[RK.Contacts.IsPrimary]" Component="newPhonePrimary" />
                                        </div>
                                    </div>
                                    <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@SaveContactInfoSectionAsync" IsBusy="_savingContactInfo" Disabled="_savingContactInfo" />
                                </RadzenStack>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <RadzenLabel Text="@L[RK.Contacts.Emails]" />
                                        <RadzenTextBox @bind-Value="_email" Placeholder="@L[RK.Contacts.Value]" class="w-100" />
                                        <RadzenCheckBox @bind-Value="_emailIsPrimary" Name="emailPrimary" />
                                        <RadzenLabel Text="@L[RK.Contacts.IsPrimary]" Component="emailPrimary" />
                                    </div>
                                    <div class="col-md-6">
                                        <RadzenLabel Text="@L[RK.Contacts.Phones]" />
                                        <RadzenTextBox @bind-Value="_phone" Placeholder="@L[RK.Contacts.Value]" class="w-100" />
                                        <RadzenCheckBox @bind-Value="_phoneIsPrimary" Name="phonePrimary" />
                                        <RadzenLabel Text="@L[RK.Contacts.IsPrimary]" Component="phonePrimary" />
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L[RK.Contacts.Addresses]" Value="addresses">
                    <div class="pt-2">
                        @if (IsViewMode)
                        {
                            @if (DetailForView is not null && DetailForView.Addresses.Count > 0) { <RadzenStack Gap="0.25rem">@foreach (var a in DetailForView.Addresses) { <RadzenText>@a.Street, @a.CountryCode @a.CityCode @a.DistrictCode @a.PostalCode @(a.IsPrimary ? "(" + L[RK.Contacts.IsPrimary].Value + ")" : "")</RadzenText> }</RadzenStack> }
                            else { <RadzenText class="text-muted">--</RadzenText> }
                        }
                        else
                        {
                            @if (IsEditMode && DetailForView is not null)
                            {
                                <RadzenStack Gap="0.75rem">
                                    @if (DetailForView.Addresses.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { <RadzenStack Gap="0.25rem">@foreach (var a in DetailForView.Addresses) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@a.Street, @a.CountryCode @a.CityCode @a.DistrictCode @a.PostalCode</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveAddressAsync(a.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                    <div class="row g-2">
                                        <div class="col-12"><RadzenLabel Text="@L[RK.Contacts.Street]" /><RadzenTextBox @bind-Value="_address.Street" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.CountryCode]" /><AsyncSearchSelect TItem="CountryListItemDto" Value="@_address.CountryCode" ValueChanged="OnCountryCodeChanged" LoadDataAsync="LoadCountriesAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.CityCode]" /><AsyncSearchSelect TItem="CityListItemDto" Value="@_address.CityCode" ValueChanged="OnCityCodeChanged" LoadDataAsync="LoadCitiesAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.DistrictCode]" /><AsyncSearchSelect TItem="DistrictListItemDto" @bind-Value="_address.DistrictCode" LoadDataAsync="LoadDistrictsAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.PostalCode]" /><RadzenTextBox @bind-Value="_address.PostalCode" class="w-100" /></div>
                                    </div>
                                    <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@SaveAddressSectionAsync" IsBusy="_savingAddress" Disabled="_savingAddress" />
                                </RadzenStack>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-12"><RadzenLabel Text="@L[RK.Contacts.Street]" /><RadzenTextBox @bind-Value="_address.Street" class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.CountryCode]" /><AsyncSearchSelect TItem="CountryListItemDto" Value="@_address.CountryCode" ValueChanged="OnCountryCodeChanged" LoadDataAsync="LoadCountriesAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.CityCode]" /><AsyncSearchSelect TItem="CityListItemDto" Value="@_address.CityCode" ValueChanged="OnCityCodeChanged" LoadDataAsync="LoadCitiesAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.DistrictCode]" /><AsyncSearchSelect TItem="DistrictListItemDto" @bind-Value="_address.DistrictCode" LoadDataAsync="LoadDistrictsAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.PostalCode]" /><RadzenTextBox @bind-Value="_address.PostalCode" class="w-100" /></div>
                                </div>
                            }
                        }
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="@L[RK.Contacts.BankAccounts]" Value="bank">
                    <div class="pt-2">
                        @if (IsViewMode)
                        {
                            @if (DetailForView is not null && DetailForView.BankAccounts.Count > 0) { <RadzenStack Gap="0.25rem">@foreach (var b in DetailForView.BankAccounts) { <RadzenText>@b.BankCode @(string.IsNullOrWhiteSpace(b.BranchName) ? "" : " | " + b.BranchName) | ****@b.AccountNumberLast4 | @b.AccountName | @b.CurrencyCode</RadzenText> }</RadzenStack> }
                            else { <RadzenText class="text-muted">--</RadzenText> }
                        }
                        else
                        {
                            @if (IsEditMode && DetailForView is not null)
                            {
                                <RadzenStack Gap="0.75rem">
                                    @if (DetailForView.BankAccounts.Count == 0) { <RadzenText class="text-muted">--</RadzenText> }
                                    else { <RadzenStack Gap="0.25rem">@foreach (var b in DetailForView.BankAccounts) { <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2"><RadzenText class="mb-0">@b.BankCode | ****@b.AccountNumberLast4 | @b.AccountName</RadzenText><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => RemoveBankAccountAsync(b.Id))" aria-label="@L[RK.Common.Remove]" /></div> }</RadzenStack> }
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@L[RK.Contacts.AddNew]</RadzenText>
                                    <div class="row g-2">
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.BankCode]" /><AsyncSearchSelect TItem="BankListItemDto" @bind-Value="_bank.BankCode" LoadDataAsync="LoadBanksAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.BranchName]" /><RadzenTextBox @bind-Value="_bank.BranchName" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.AccountNumber]" /><RadzenTextBox @bind-Value="_bank.AccountNumber" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.AccountName]" /><RadzenTextBox @bind-Value="_bank.AccountName" class="w-100" /></div>
                                        <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.CurrencyCode]" /><RadzenDropDown TValue="string?" @bind-Value="_bank.CurrencyCode" Data="@_currencyOptions" TextProperty="Code" ValueProperty="Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" AllowClear="true" Style="width: 100%;" class="w-100" /></div>
                                    </div>
                                    <RadzenButton Text="@L[RK.Common.Save]" ButtonStyle="ButtonStyle.Primary" Click="@SaveBankSectionAsync" IsBusy="_savingBank" Disabled="_savingBank" />
                                </RadzenStack>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.BankCode]" /><AsyncSearchSelect TItem="BankListItemDto" @bind-Value="_bank.BankCode" LoadDataAsync="LoadBanksAsync" GetText="x => x.DisplayText" GetValue="x => x.Code" Placeholder="@L[RK.MasterData.SelectPlaceholder]" SearchPlaceholder="@L[RK.MasterData.SearchPlaceholder]" LoadingText="@L[RK.Common.Loading]" EmptyText="@L[RK.MasterData.SelectEmpty]" MoreHint="@L[RK.MasterData.SelectScrollMore]" AllowClear="true" Style="min-width: 100%;" Class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.BranchName]" /><RadzenTextBox @bind-Value="_bank.BranchName" class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.AccountNumber]" /><RadzenTextBox @bind-Value="_bank.AccountNumber" class="w-100" /></div>
                                    <div class="col-md-6"><RadzenLabel Text="@L[RK.Contacts.AccountName]" /><RadzenTextBox @bind-Value="_bank.AccountName" class="w-100" /></div>
