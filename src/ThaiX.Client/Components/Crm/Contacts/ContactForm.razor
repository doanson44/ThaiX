                </RadzenTabsItem>
                <RadzenTabsItem Text="@L[RK.Contacts.SocialLinks]" Value="social">
                    <div class="pt-2">
                        @if (IsViewMode)
                        {
                            @if (DetailForView is not null && DetailForView.SocialLinks.Count > 0)
                            {
                                <RadzenStack Gap="0.25rem">@foreach (var s in DetailForView.SocialLinks) { <RadzenText>@s.Platform: @s.Url</RadzenText> }</RadzenStack>
