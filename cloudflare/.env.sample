# =============================
# Required
# =============================
BACKEND_URL=http://app.example.invalid

# =============================
# Slack: Signing Secret + Bot Token
# =============================
SLACK_SIGNING_SECRET=REPLACE_WITH_SLACK_SIGNING_SECRET
SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN

# =============================
# M2M token for backend API calls
# =============================
BACKEND_CLIENT_ID=THAIX_BOT
BACKEND_CLIENT_SECRET=REPLACE_WITH_BACKEND_CLIENT_SECRET

# =============================
# Telegram (optional)
# =============================
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_TELEGRAM_WEBHOOK_SECRET
